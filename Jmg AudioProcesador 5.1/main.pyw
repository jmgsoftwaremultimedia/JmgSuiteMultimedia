            if hasattr(self,"var_bandeja"):prefs["bandeja"]=bool(self.var_bandeja.get())
            r=getattr(self,"_vp_r",{}).get("def") or (self._vpan_ratio() if self._vpan_ctx()=="def" else None)
            if r:prefs["panel_ratio"]=r
            if self.var_guardar_sal.get()=="guardar":
                prefs.update({"formato":self.var_formato.get(),"bitrate":self.var_bitrate.get(),"remux":self.var_remux.get(),"remux_subs":self.var_remux_subs.get(),"remux_caps":self.var_remux_caps.get(),"remux_adj":self.var_remux_adj.get(),"remux_meta":self.var_remux_meta.get(),"remux_nucleo":self.var_remux_nucleo.get(),"destino_modo":self.var_destino_modo.get(),"destino_carpeta":self.var_destino_carpeta.get(),"dup_modo":self.var_dup_modo.get(),"upmix":self.var_upmix.get(),"upmix_central":self.var_upmix_central.get(),"upmix_voz":self.var_upmix_voz.get(),"downmix":self.var_downmix.get(),"layout":self.var_layout_sal.get(),"downmix_modo":self.var_downmix_modo.get(),"downmix_lfe":self.var_downmix_lfe.get()})
            prefs.update(getattr(self,"_prefs_x",{}))   # carpeta de FFmpeg y donde esta Jmg VideoEncoder
            prefs["aften"]=dict(getattr(self,"_aften",AFTEN_DEF))   # (JMG, 8-11) codificador AC3 y ajustes de Aften: siempre
            with open(self._cfg_path(),"w",encoding="utf-8") as f:
                json.dump(prefs,f,indent=2,ensure_ascii=False)
            self._ls(f"[CFG] Guardado ({'completo' if 'formato' in prefs else 'prefs'})")
            return True
        except Exception as e:
            self._ls(f"[CFG] Error: {e}")
            return False

    def _load_cfg(self):
        """Prefs siempre; ajustes solo si modo guardar."""
        p=self._cfg_path()
        if not os.path.exists(p):return False
        try:
            with open(p,encoding="utf-8") as f:datos=json.load(f)
            self._prefs_x={k:datos[k] for k in ("ffmpeg_dir","otro_exe") if datos.get(k)}
            if isinstance(datos.get("aften"),dict):
                self._aften=dict(AFTEN_DEF);self._aften.update({k:v for k,v in _af_migrar(datos["aften"]).items() if k in AFTEN_DEF})
                try:self._aften_pintar()
                except Exception:pass
            self._ver_dia=str(datos.get("ver_comprobada",""))
            if "tema" in datos and datos.get("tema_v")==2:
                self.var_tema.set(datos["tema"])
                self._aplicar_tema()
            try:self.var_workers.set(int(datos.get("workers",1)))
            except Exception:pass
            if self.var_guardar_sal.get()!="guardar":
                self.var_al_terminar.set("nada")
                self.var_fps_to.set(self.var_fps_from.get())
                self._ls("[CFG] Solo prefs (modo Por defecto)")
                return True
            if "formato" in datos and datos["formato"] in self.formatos:
                self.var_formato.set(datos["formato"])
                ops=self.formatos[datos["formato"]]
                self.cmb_b.configure(values=ops)
                if self._br_valido(datos["formato"],datos.get("bitrate"),ops,6):self.var_bitrate.set(datos["bitrate"])   # (revisión) también el E-AC3 a mano
            self.var_remux.set(True)
            self.var_remux_subs.set(bool(datos.get("remux_subs",True)))
            self.var_remux_caps.set(bool(datos.get("remux_caps",True)))
            self.var_remux_adj.set(bool(datos.get("remux_adj",True)))
            self.var_remux_meta.set(bool(datos.get("remux_meta",True)))
            self.var_remux_nucleo.set(bool(datos.get("remux_nucleo",False)))
            self.var_destino_modo.set(datos.get("destino_modo","original"))
            self.var_destino_carpeta.set(datos.get("destino_carpeta",""))
            self.var_dup_modo.set(datos.get("dup_modo","rename"))
            self.var_al_terminar.set("nada")
            if self.var_al_terminar.get()=="reset": self.var_al_terminar.set("nada")
            self.var_upmix.set(datos.get("upmix","N"))
            try:self.var_upmix_central.set(int(datos.get("upmix_central",5)))
            except Exception:pass
            self.var_downmix.set(bool(datos.get("downmix",False)))
            _l=str(datos.get("layout","5.1"));self.var_layout_sal.set(_l if _l in ("2.0","1.0") else ("2.0" if datos.get("downmix") else _l))
            self.var_downmix_modo.set(datos.get("downmix_modo","dolby"))
            self.var_downmix_lfe.set(bool(datos.get("downmix_lfe",True)))
            self.var_fps_to.set(self.var_fps_from.get())
            self._ls("[CFG] Ajustes cargados")
            return True
        except Exception as e:
            self._ls(f"[CFG] Error: {e}")
            return False

    def _ocupado(self):
        return self.procesando or getattr(self,"_escaneando",False) or getattr(self,"_midiendo_ln",False) or getattr(self,"_combinando",False) or getattr(self,"_ripeando",False)
    def _on_close(self,silent=False):
        """Al cerrar: si hay un proceso en marcha se pregunta; se cancela, se espera a que se borren los archivos
        a medias y luego se cierra (antes FFmpeg seguia trabajando oculto)."""
        if getattr(self,"_cerrando",False):return
        if getattr(self,"_ed_por",None) and self._ed_sin_guardar() and not self._confirm(self._vt("Cambios sin guardar","Unsaved changes"),
                self._vt("Hay cambios del editor sin guardar.\n\n¿Salir y perderlos?","There are unsaved editor changes.\n\nExit and lose them?")):return
        if self._ocupado():
            if not self._confirm(self._vt("Proceso en marcha","Process running"),
                                 self._vt("Hay un proceso en marcha.\n\n¿Cancelarlo y salir? Los archivos a medias se borrarán.",
                                          "A process is running.\n\nCancel it and exit? Unfinished files will be deleted.")):return
            self._cerrando=True
            self._cancel()
            self._cerrar_espera(0);return
        self._cerrar_ya()
    def _cerrar_espera(self,n):
        if self._ocupado() and n<300:   # hasta 30 s
            self.root.after(100,self._cerrar_espera,n+1);return
        self._cerrar_ya()
    def _cerrar_ya(self):
        try:
            self._vis_gen+=1;self._vis_matar();self._vis_audio_cerrar();self._vis_restaurar()   # nada sigue escribiendo la escucha
        except Exception:pass
        try:self._limpia_temp()
        except Exception:pass
        try:self._save_cfg()
        except Exception:pass
        try:self.root.destroy()
        except Exception:pass
    def _limpia_temp(self):
        """al cerrar se borran los temporales del programa (la escucha de Visualizacion pesa GB). Si algo aun los tiene abiertos, un proceso
        aparte los borra en cuanto el programa haya salido del todo"""
        import shutil
        mios=getattr(self,"_tmp_mios",set())
        for j in range(10):   # FFmpeg o la escucha pueden tardar un momento en soltar el archivo
            mios={p for p in mios if os.path.exists(p)}
            if not mios:break
            for p in mios:shutil.rmtree(p,ignore_errors=True)
            if j:time.sleep(0.15)
        mios={p for p in mios if os.path.exists(p)}
        if mios:self._limpia_luego(mios)
        for p in getattr(self,"_tmp_arch",[]):
            try:os.remove(p)
            except OSError:pass
        self._limpia_viejos()
    @staticmethod
    def _limpia_luego(rutas):
        try:
            if sys.platform=="win32":
                orden=" & ".join('rmdir /s /q "%s"'%p for p in rutas)
                subprocess.Popen('cmd /c "ping -n 3 127.0.0.1 >nul & %s & ping -n 8 127.0.0.1 >nul & %s"'%(orden,orden),creationflags=CNW,stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,close_fds=True)
            else:
                import shlex
                subprocess.Popen(["sh","-c","sleep 3; rm -rf "+" ".join(shlex.quote(p) for p in rutas)],start_new_session=True)
        except Exception:pass
    @staticmethod
    def _limpia_viejos():
        """lo que dejo un cierre a las malas. Lo de menos de 10 min se deja: puede ser de otra ventana del programa abierta"""
        import tempfile,glob,shutil
        lim=time.time()-600
        for pre in ("apm_vis_*","jmg_voz_*","jmg_comb_*","jmg_auto_*","ffbat_*","fferr_*"):
            for p in glob.glob(os.path.join(glob.escape(tempfile.gettempdir()),pre)):
                try:
                    if os.path.getmtime(p)>lim:continue
                    if os.path.isdir(p):shutil.rmtree(p,ignore_errors=True)
                    else:os.remove(p)
                except OSError:pass

