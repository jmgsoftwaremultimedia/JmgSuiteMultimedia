            txt.insert("end",f"{os.path.basename(k[0])} #{k[1]}\n","tit")
            txt.insert("end","  "+V("desde      delay","from       delay")+"\n","nota")
            for c0,c1,v0,v1 in tl:
                d0_=dels.get(k,0.0)-v0;d1_=dels.get(k,0.0)-v1
                txt.insert("end",f"  {self._hms(c0)[:-4]}   {d0_:+7.0f} ms"+(f"  → {d1_:+.0f} ms" if abs(d1_-d0_)>=0.5 else "")+"\n")
        txt.configure(state="disabled")
        ttk.Button(f,text=V("Cerrar","Close"),command=w.destroy).pack(anchor="e",pady=(10,0))
        try:
            w.update_idletasks();w.geometry(f"+{padre.winfo_rootx()+40}+{padre.winfo_rooty()+40}")
        except Exception:pass
        self._tramos_top=w
    # ---------- Igualar tono: graves, medios y agudos de un canal como los del mismo canal de la pista de referencia ----------
    _TONO_F=(31.5,63,125,250,500,1000,2000,4000,8000,16000)   # bandas de octava
    _TONO_RET=0.05   # retraso del ecualizador de fase lineal (se compensa recortando el principio: la sincronizacion no se mueve)
    @staticmethod
    def _trozos(dur,n,L):
        """n trozos de L s repartidos por todo el archivo (menos en uno corto) -> (n, L, posiciones)"""
        n=n if dur>=1.25*n*L else max(1,min(n,int(dur//10)))
        L=min(L,dur/n)
        return n,L,[max(0.0,(dur-L)*(0.04+0.92*i/(n-1))) if n>1 else 0.0 for i in range(n)]
    def _ffm_texto(self,cmd,cb=None):
        """FFmpeg de medida (con -progress pipe:1): devuelve lo que escribe en stderr, llama a cb(segundos) mientras avanza y Cancelar lo corta"""
        kw={"stdout":subprocess.PIPE,"stderr":subprocess.PIPE,"text":True,"encoding":"utf-8","errors":"ignore","bufsize":1}
        if sys.platform=="win32":kw["creationflags"]=CNW
        pr=subprocess.Popen(cmd,**kw)
        with self._lock:self._procesos.append(pr)
        sl=[]
        def dr():
            try:
                for l in pr.stderr:sl.append(l)
            except Exception:pass
        ts=threading.Thread(target=dr,daemon=True);ts.start()
        try:
            for l in pr.stdout:
                if self._cancelar.is_set():
                    self._matar(pr);break
                if cb and l.startswith("out_time_ms="):
                    try:cb(int(l.split("=",1)[1])/1000000.0)
                    except ValueError:pass
            pr.wait()
        finally:
            with self._lock:
                if pr in self._procesos:self._procesos.remove(pr)
        ts.join(timeout=2)
        return "".join(sl)
    def _tono_medir(self,ruta,orden,ci,prog=None):
        """nivel medio (dB) de un canal en cada banda de octava: 12 trozos de 20 s repartidos por todo el archivo"""
        if not hasattr(self,"_tono_cache"):self._tono_cache={}
        k=(ruta,orden,ci)
        if k in self._tono_cache:return self._tono_cache[k]
        dur=self._dur(ruta)
        if dur<=1:return None
        n,L,pos=self._trozos(dur,12,20.0);F=self._TONO_F
        cmd=[FFMPEG,"-hide_banner","-nostats"]
        for p in pos:cmd+=["-ss",f"{p:.3f}","-t",f"{L:.3f}","-i",ruta]
        g="".join(";".join(self._comb_sub(f"{i}:a:{orden}",(ruta,orden,ci,""),f"q{i}"))+f";[q{i}]aresample=48000[s{i}];" for i in range(n))
        g+="".join(f"[s{i}]" for i in range(n))+f"concat=n={n}:v=0:a=1,asplit={len(F)}"+"".join(f"[b{j}]" for j in range(len(F)))
        for j,fc in enumerate(F):
            lo=20.0 if j==0 else fc/2**0.5;hi=20000.0 if j==len(F)-1 else fc*2**0.5
            g+=(f";[b{j}]highpass=f={lo:.1f}:p=2,highpass=f={lo:.1f}:p=2,lowpass=f={hi:.1f}:p=2,lowpass=f={hi:.1f}:p=2,"
                f"astats=measure_perchannel=none:measure_overall=RMS_level"+("[o]" if j==len(F)-1 else ",anullsink"))
        cmd+=["-filter_complex",g,"-map","[o]","-stats_period","0.2","-progress","pipe:1","-f","null","-"]
        txt=self._ffm_texto(cmd,(lambda t:prog(min(1.0,t/(n*L)))) if prog else None)
        val={}
        for l in txt.splitlines():
            m_=re.match(r"\[Parsed_astats_(\d+) @ [^\]]*\]\s*RMS level dB:\s*(\S+)",l)
            if m_:
                try:v=float(m_.group(2))
                except ValueError:v=None
                val[int(m_.group(1))]=v if (v is not None and v>-200) else None
        if len(val)!=len(F):
            if not self._cancelar.is_set():self._ls(f"[TONO] [ERR] {os.path.basename(ruta)} #{orden}: "+" | ".join(txt.strip().splitlines()[-3:]))
            return None
        res=[val[x] for x in sorted(val)];self._tono_cache[k]=res
        return res
    def _tono_curva(self,src,ref):
        """correccion (dB por banda) para que «src» suene como «ref»: sin cambiar el volumen (se iguala la media de
        125 Hz a 8 kHz), suavizada y limitada a +-6 dB. Las bandas casi vacias (60 dB por debajo) no se tocan."""
        ok=[v for v in list(src)+list(ref) if v is not None]
        if not ok:return None
        mx=max(ok);d=[]
        for a,b in zip(src,ref):d.append(None if (a is None or b is None or a<mx-60 or b<mx-60) else b-a)
        mid=[v for v in d[2:9] if v is not None]
        if len(mid)<4:return None
        m=sum(mid)/len(mid);d=[0.0 if v is None else v-m for v in d]
        s=[(d[max(0,i-1)]+2*d[i]+d[min(len(d)-1,i+1)])/4.0 for i in range(len(d))]
        return [round(max(-6.0,min(6.0,v))*2)/2.0 for v in s]
    def _tono_resumen(self,g):
        V=self._vt;f=lambda a:sum(a)/len(a)
        return (V("graves ","bass ")+"%+.1f · "%f(g[0:4])+V("medios ","mids ")+"%+.1f · "%f(g[4:7])+V("agudos ","treble ")+"%+.1f dB"%f(g[7:10])).replace("+0.0","0").replace("-0.0","0")
    def _tono_filtro(self,g):
        """ecualizador de fase lineal con la curva + recorte de su retraso (la pista no se mueve ni una muestra)"""
        e=";".join(f"entry({fc:g},{v:g})" for fc,v in zip(self._TONO_F,g));d=self._TONO_RET
        return f"firequalizer=gain='cubic_interpolate(f)':gain_entry='{e}':delay={d},atrim=start_sample={int(round(d*48000))},asetpts=PTS-STARTPTS"
    def _comb_tono(self,trabajos,fin):
        """hilo: mide el tono de cada canal y el de la referencia. trabajos=[(fila, canal, [(origen, referencia), ...])] con origen/referencia =
        (archivo, pista, canal); con varias parejas (canales que comparten las dos pistas) vale la media. fin({fila: curva}, lineas de informe)"""
        V=self._vt;res={};inf=[];tot=max(1,sum(2*len(q[2]) for q in trabajos));paso=0
        try:
            for j,(n,c,pares) in enumerate(trabajos):
                cur=[]
                for src,ref in pares:
                    if self._cancelar.is_set():return self._ui(fin,None,["cancel"])
                    txt=V("Midiendo el tono... ","Measuring the tone... ")+f"{c} ({j+1}/{len(trabajos)})"
                    self._ui(fin,"prog",[txt,paso/tot])
                    a=self._tono_medir(*src,prog=lambda x,p=paso:self._ui(fin,"prog",[txt,(p+x)/tot]));paso+=1
                    if self._cancelar.is_set():return self._ui(fin,None,["cancel"])
                    b=self._tono_medir(*ref,prog=lambda x,p=paso:self._ui(fin,"prog",[txt,(p+x)/tot]));paso+=1
                    g=self._tono_curva(a,b) if (a and b) else None
                    if g:cur.append(g)
                if not cur:inf.append("⚠ "+c+": "+V("no se ha podido medir el tono.","could not measure the tone."));continue
                g=[round(sum(q[i] for q in cur)/len(cur)*2)/2.0 for i in range(len(cur[0]))]
                res[n]=g;self._ls(f"[TONO] {c}: "+" ".join(f"{fc:g}Hz {v:+g}" for fc,v in zip(self._TONO_F,g)))
                inf.append(f"{c}: "+self._tono_resumen(g))
            self._ui(fin,res,inf)
        except Exception as e:
            self._ls(f"[TONO] [ERR] {e}")
            self._ui(fin,None,[V("No se ha podido medir el tono (mira Edit/Log).","Could not measure the tone (see Edit/Log).")])
    # ---------- Gama automatica: el eco de las voces en un canal se mide con el central de su misma pista ----------
    def _eco_niveles(self,ruta,orden,ci,cf,prog=None):
        """niveles (dB cada 100 ms) del canal ci y del central cf de la misma pista: 24 trozos de 15 s repartidos por el archivo"""
        import math,operator
        from array import array
        dur=self._dur(ruta)
        if dur<=1:return None
        n,L,pos=self._trozos(dur,24,15.0);sr=8000
        cmd=[FFMPEG,"-v","error"]
        for p in pos:cmd+=["-ss",f"{p:.3f}","-t",f"{L:.3f}","-i",ruta]
        g="".join(f"[{i}:a:{orden}]pan=stereo|c0=c{ci}|c1=c{cf},aresample={sr}[s{i}];" for i in range(n))
        cmd+=["-filter_complex",g+"".join(f"[s{i}]" for i in range(n))+f"concat=n={n}:v=0:a=1[o]","-map","[o]","-f","s16le","-"]
        kw={"stdout":subprocess.PIPE,"stderr":subprocess.DEVNULL}
        if sys.platform=="win32":kw["creationflags"]=CNW
        pr=subprocess.Popen(cmd,**kw)
        with self._lock:self._procesos.append(pr)
        b=bytearray();tot=n*L*sr*4
        try:
            while True:
                q=pr.stdout.read(1<<18)
                if not q:break
                b+=q
                if self._cancelar.is_set():
                    self._matar(pr);return None
                if prog:prog(min(1.0,len(b)/tot))
            pr.wait()
        finally:
            with self._lock:
                if pr in self._procesos:self._procesos.remove(pr)
        x=array("h");x.frombytes(bytes(b[:len(b)//4*4]))
        if sys.byteorder!="little":x.byteswap()
        def db(v):
            e=sum(map(operator.mul,v,v))/max(1,len(v))
            return 10.0*math.log10(e/1073741824.0) if e>0 else -120.0
        a=x[0::2];c=x[1::2];blq=sr//10
        return [db(a[i:i+blq]) for i in range(0,len(a)-blq+1,blq)],[db(c[i:i+blq]) for i in range(0,len(c)-blq+1,blq)]
    @staticmethod
    def _eco_nivel(lx,lc):
        """nivel (dBFS) del eco: lo que suena en el canal mientras habla el central, sin contar los momentos con musica o efectos
        fuertes (el canal a menos de 10 dB de la voz). None si no hay voz o momentos suficientes para decirlo"""
        act=sorted(v for v in lc if v>-60)
        if len(act)<50:return None
        voz=act[int(len(act)*0.9)]-15
        e=sorted(x for x,c in zip(lx,lc) if c>=voz and x>-80 and x<=c-10)
        return e[int(len(e)*0.75)] if len(e)>=30 else None
    @staticmethod
    def _silv_para(eco):
        """«Ajustar silencio»: lo que hay que bajar las voces del original (de 10 en 10 dB) para que su eco quede por debajo de -90 dBFS"""
        import math
        return int(max(1,min(10,math.ceil((eco+90.0)/10.0))))
    def _gama_para(self,eco):
        """nivel de gama dinamica (hasta 8: mas arriba se van tambien los ambientes) que baja el eco al menos 12 dB; 0 si ya no se oye"""
        if eco<-65:return 0
        x=eco+3.0   # el compand mira mas los picos que la media
        for v in range(1,9):
            if x-self._gd_curva(v)[1](x)>=12.0:return v
        return 8
    def _comb_gama_auto(self,trabajos,fin,para=None):
        """hilo: trabajos=[(grupo 0 delanteros / 1 traseros, canal, (archivo, pista, canal), canal del central de esa pista)].
        fin({grupo: nivel}, lineas de informe)"""
        V=self._vt;eco={};inf=[];N=len(trabajos)
        try:
            for j,(g,c,s,cf) in enumerate(trabajos):
                if self._cancelar.is_set():return self._ui(fin,None,["cancel"])
                txt=V("Midiendo el eco... ","Measuring the echo... ")+f"{c} ({j+1}/{N})"
                self._ui(fin,"prog",[txt,j/N])
                ni=self._eco_niveles(s[0],s[1],s[2],cf,prog=lambda x,j=j:self._ui(fin,"prog",[txt,(j+x)/N]))
                if self._cancelar.is_set():return self._ui(fin,None,["cancel"])
                e=self._eco_nivel(*ni) if ni else None
                if e is None:
                    inf.append("⚠ "+c+": "+V("no hay voz suficiente para medir el eco.","not enough voice to measure the echo."));continue
                self._ls(f"[GAMA] {c}: "+V("eco ","echo ")+f"{e:.1f} dBFS");eco.setdefault(g,[]).append(e)
            self._ui(fin,{g:(para or self._gama_para)(max(v)) for g,v in eco.items()},inf)
        except Exception as e:
            self._ls(f"[GAMA] [ERR] {e}")
            self._ui(fin,None,[V("No se ha podido medir el eco (mira Edit/Log).","Could not measure the echo (see Edit/Log).")])
    # ---------- Los ajustes de cada combinada se guardan para poder cambiarla mas adelante ----------
    def _comb_rec_ruta(self):
        return os.path.join(_data_dir(),"combinadas.json")
    def _comb_rec_leer(self):
        try:
            with open(self._comb_rec_ruta(),encoding="utf-8") as fh:d_=json.load(fh)
            return d_ if isinstance(d_,dict) else {}
        except (OSError,ValueError):return {}
    def _comb_rec_guardar(self,salida,rec):
        try:
            d_=self._comb_rec_leer()
            d_[os.path.normcase(os.path.abspath(salida))]={"tam":os.path.getsize(salida),"t":time.time(),"rec":rec}
            for k in sorted(d_,key=lambda k:d_[k].get("t",0))[:-200]:d_.pop(k)   # las 200 ultimas
            self._comb_rec_escribir(d_)
        except Exception as e:self._ls(f"[COMBINAR] [ERR] {e}")
    def _comb_rec_escribir(self,d_):
        p=self._comb_rec_ruta();q=p+".tmp"
        with open(q,"w",encoding="utf-8") as fh:json.dump(d_,fh,ensure_ascii=False)
        os.replace(q,p)
    def _comb_rec_borrar(self,ruta):
        """borra los ajustes guardados de esa combinada (tambien si la moviste de carpeta: por nombre y tamaño)"""
        try:
            d_=self._comb_rec_leer();k=os.path.normcase(os.path.abspath(ruta))
            if k not in d_:
                tam=os.path.getsize(ruta);nb=os.path.basename(k)
                k=next((a for a,v in d_.items() if os.path.basename(a)==nb and isinstance(v,dict) and v.get("tam")==tam),k)
            if k in d_:
                d_.pop(k);self._comb_rec_escribir(d_)
        except Exception as e:self._ls(f"[COMBINAR] [ERR] {e}")
    def _comb_rec_de(self,ruta):
        q=self._comb_rec_leer().get(os.path.normcase(os.path.abspath(ruta)))
        return q["rec"] if isinstance(q,dict) and isinstance(q.get("rec"),dict) else None
    def _comb_rec_sel(self):
        """(archivo, ajustes) de la pista combinada seleccionada; si no hay ninguna, (None, None). Si la moviste de carpeta, se reconoce por nombre y tamaño"""
        d_=self._comb_rec_leer()
        if not d_:return None,None
        sel=[self._multi_tracks[i][0] for i in self.lp.curselection() if i<len(self._multi_tracks)]
        sel+=[self.files[i] for i in self.la.curselection() if i<len(self.files)]
        for r in sel:
            q=d_.get(os.path.normcase(os.path.abspath(r)))
            if not q:
                try:tam=os.path.getsize(r)
                except OSError:continue
                nb=os.path.basename(os.path.normcase(r))
                q=next((v for k,v in d_.items() if os.path.basename(k)==nb and isinstance(v,dict) and v.get("tam")==tam),None)
            if isinstance(q,dict) and isinstance(q.get("rec"),dict):return r,q["rec"]
        return None,None
