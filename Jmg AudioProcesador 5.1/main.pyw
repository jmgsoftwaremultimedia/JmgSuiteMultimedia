    def _update_editlog(self):
        if not hasattr(self,"txt_edit"):return
        lines=[]
        try:
            lines.append(f"Master: {self._fv(self.var_master.get())} dB")
        except Exception:
            lines.append("Master: 0.0 dB")

        sel_count = len(self.lp.curselection())
        if sel_count > 1:
            lines.append(self._vt("[!] Master de la pista activa. Las demás conservan su escaneo.","[!] Master of the active track. The others keep their own scan."))

        lines.append(self._vt("Formato: ","Format: ")+self.var_formato.get())
        lines.append(f"Bitrate: {self._br_txt()}")
        k_=self._opc_ap_cod()
        if k_ and self._opc_cambiadas(k_,(getattr(self,"_opc_aud",{}) or {}).get(k_)):lines.append(self._vt("Opciones avanzadas: ","Advanced options: ")+self._opc_resumen(k_,self._opc_aud.get(k_)))   # (JMG, 12-11)
        lines.append("-"*30)
        try:
            ef, _ = self._re()
            efectos = [x for x in ef if not x.startswith("Master:")]
            if efectos:
                for item in efectos:
                    lines.append(item)
            else:
                lines.append(self._vt("(Sin efectos adicionales)","(No additional effects)"))
        except Exception as ex:
            lines.append(self._vt("[Error calculando efectos: ","[Error computing effects: ")+f"{ex}]")
            self._log(f"[ERROR EditLog] {ex}")

        self.txt_edit.delete("1.0","end")
        self.txt_edit.insert("1.0","\n".join(lines))

    def _guardar_cambios_edit(self):
        """Lee el texto, busca 'Clave: valor' y aplica a los sliders"""
        txt = self.txt_edit.get("1.0", "end-1c")
        cambios = 0
        for line in txt.splitlines():
            line = line.strip()
            if ":" not in line: continue
            key, val = line.split(":", 1)
            key = key.strip().lower()
            val = val.strip()

            num_match = re.search(r'(-?\d+\.?\d*)', val)
            num = float(num_match.group(1)) if num_match else None

            try:
                if key in ("master", "volumen master", "volumen", "master volume") and num is not None:
                    self.var_master.set(num); cambios+=1
                elif key == "bitrate" and val in tuple(self.cmb_b.cget("values")):   # solo valores validos
                    self.var_bitrate.set(val); cambios+=1
                elif key in ("formato", "format") and val in tuple(self.cmb_f.cget("values")):
                    if val!=self.var_formato.get():self.var_formato.set(val);self._fc()
                    cambios+=1
                elif key in ("voz", "voice") and num is not None:
                    self.var_voz.set(num); cambios+=1
                elif key in ("ambiente", "amb", "ambience") and num is not None:
                    self.var_amb.set(num); cambios+=1
                elif key in ("efectos", "efc", "effects") and num is not None:
                    self.var_efc.set(num); cambios+=1
                elif key in ("subwoofer", "sub") and num is not None:
                    self.var_sub.set(num); cambios+=1

            except Exception as ex:
                self._log(f"[EditLog] Error al aplicar {key}: {ex}")

        self._update_editlog()
        self._toast(self._vt("Guardar","Save"), self._vt(f"Se han aplicado {cambios} cambios al procesado.",f"{cambios} changes applied to processing."), tipo="info", seg=4)

    def _reset_edit(self):
        self._update_editlog()

    def _ccc(self,cfg=None):
        if cfg is None:
            fmt=self.var_formato.get();br=self.var_bitrate.get()
            dm=self.var_downmix.get()
        else:
            fmt=cfg.get("formato") or self.var_formato.get()
            br=cfg.get("bitrate") or self.var_bitrate.get()
            dm=cfg["downmix"] if "downmix" in cfg else self.var_downmix.get()   # (sin leer la pantalla si la pista ya lo trae: se llama desde el hilo de proceso)
        if dm:
            # 2.0 estereo / 1.0 mono
            _mn=(self._cfg_lay(cfg)=="1.0")
            n_=1 if _mn else 2;p_="mono" if _mn else "dm"
            b=(br or "").split()[0] if br else ""
            if fmt=="Passthrough":return "-c:a copy","mka","passthrough"
            if fmt in ("AC3 2.0","AC3 1.0"):fmt="AC3"   # nombres antiguos (presets)
            if fmt=="MP3":
                b=b if b.isdigit() else "192"
                return f"-c:a libmp3lame -b:a {b}k -ac {n_}","mp3",f"{p_}_mp3_{b}"
            if fmt in (AF_FMT,"AC3","EAC3","DTS","AAC","FLAC","WAV","RF64","W64"):
                if not (b.isdigit() or "bit" in (br or "") or "float" in (br or "")):br="256 kbps" if fmt!="DTS" else "768 kbps"
                c2=dict(cfg or {});c2.update({"downmix":False,"layout":"5.1","formato":fmt,"bitrate":br,"_nch":n_})
                cs_,ex_,tg_=self._ccc(c2)
                return f"{cs_} -ac {n_}",ex_,f"{p_}_{tg_}"
            return ("-c:a ac3 -b:a 128k -ac 1","ac3","mono_ac3_128") if _mn else ("-c:a ac3 -b:a 256k -ac 2","ac3","dm_ac3_256")
        _ly=self._cfg_lay(cfg)
        _ok=LAY_FMT.get(_ly)
        if _ok and fmt not in _ok:
            fmt=(DEF_FMT if DEF_FMT in _ok else "AC3") if "AC3" in _ok else "FLAC"
            br="448 kbps" if fmt in ("AC3",AF_FMT) else "16 bits"
        b=br.split()[0]
        if fmt=="Passthrough":return "-c:a copy","mka","passthrough"
        if fmt in ("AC3",AF_FMT):return f"-c:a ac3 -b:a {b}k","ac3",f"ac3_{b}"
        if fmt=="EAC3":
            b=self._eac3_b(b,(cfg or {}).get("_nch") or (4 if _ly=="4.0" else 6))   # (JMG, 16-11) el escrito a mano, dentro de lo que admite
            return f"-c:a eac3 -b:a {b}k","eac3",f"eac3_{b}"
        if fmt=="DTS":
            b="1536" if (b.isdigit() and int(b)>=1024) else "768"   # (JMG, 14-11) solo los estándar (un ajuste guardado con otro, al más cercano)
            return f"-c:a dca -b:a {b}k -strict -2","dts",f"dts_{b}"
        if fmt=="AAC":return f"-c:a aac -b:a {b}k","m4a",f"aac_{b}"
        if fmt=="FLAC":
            bits="s16" if "16" in br else "s32";tg="flac16" if "16" in br else "flac24"
            return f"-c:a flac -sample_fmt {bits} -compression_level 5","flac",tg
        if fmt=="WAV":
            if "float" in br and "32" in br:c="pcm_f32le";tg="wav32f"
            elif "24" in br:c="pcm_s24le";tg="wav24"
            else:c="pcm_s16le";tg="wav16"
            return f"-c:a {c} -rf64 auto","wav",tg   # > 4 GB (pelicula larga): pasa solo a RF64 en vez de dejar la cabecera mal
        if fmt=="WAV Split":
            if "float" in br and "32" in br:tg="split32f"
            elif "24" in br:tg="split24"
            else:tg="split16"
            return "-c:a pcm_s16le","wav",tg
        if fmt=="RF64":
            if "float" in br and "32" in br:c="pcm_f32le";tg="rf6432f"
            elif "24" in br:c="pcm_s24le";tg="rf6424"
            else:c="pcm_s16le";tg="rf6416"
            return f"-c:a {c} -f wav -rf64 always","wav",tg   # RF64 de verdad (EBU), no Sony Wave64
        if fmt=="W64":
            if "float" in br and "32" in br:c="pcm_f32le";tg="w6432f"
            elif "24" in br:c="pcm_s24le";tg="w6424"
            else:c="pcm_s16le";tg="w6416"
            return f"-c:a {c} -f w64","w64",tg   # Sony Wave64: lo abren Sound Forge y Vegas (las versiones antiguas no leen RF64)
        if fmt=="TRUEHD":
            try:
                t=rh([FFMPEG,"-hide_banner","-h","encoder=truehd"])
                th="truehd" in (t.stdout or "").lower()
            except Exception:th=False
            if not th:return "-c:a dca -b:a 1536k -strict -2","dts","dts_1536_fallback"
            if "16/48" in br:return "-c:a truehd -strict -2 -sample_fmt s16p -ar 48000 -ac 6 -channel_layout 5.1(side) -f matroska","mka","truehd_16"
            if "24/48" in br:return "-c:a truehd -strict -2 -sample_fmt s32p -ar 48000 -ac 6 -channel_layout 5.1(side) -f matroska","mka","truehd_24"
            return "-c:a truehd -strict -2 -sample_fmt s32p -ar 96000 -ac 6 -channel_layout 5.1(side) -f matroska","mka","truehd_96"
        return "-c:a ac3 -b:a 640k","ac3","ac3_640"
    def _cfg_lay(self,cfg):
