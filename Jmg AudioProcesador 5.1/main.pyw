        ps=self.pc.get(a,[])
        lang="und"
        if ps and 0<=p<len(ps):
            lang=ps[p].get("lang") or "und"
        lang_sfx = f"_{lang}" if lang != "und" else ""

        upmix_sfx = "_upmix" if cfg and cfg.get("upmix")=="S" else ""
        s=os.path.join(d,f"{b}{suffix}{upmix_sfx}{lang_sfx}_{et}.{ex}")
        if os.path.exists(s):
            if self._opt("dup_modo")=="rename":
                i=1
                while True:
                    s=os.path.join(d,f"{b}{suffix}{upmix_sfx}{lang_sfx}_{et}_{i}.{ex}")
                    if not os.path.exists(s):break
                    i+=1
                self._ls(f"    [!] Existe. Renombrado a {os.path.basename(s)}")
            else:
