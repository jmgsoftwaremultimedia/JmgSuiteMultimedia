        try:
            if silv:
                def prv(x):
                    self._ui(var_est.set,V("Buscando voces del original: ","Searching for voices of the original: ")+f"{100*x:.0f}%");self._ui(lambda v=100.0*x:pb.configure(value=v))
                q=self._comb_silenciar(sel,silv,prv,silv_db)
                if q is None:
                    if self._cancelar.is_set():self._ui(fin,False,"cancel")
                    else:
                        self._ls("[VOCES] [ERR] "+V("no se ha podido analizar","could not be analysed"));self._ui(fin,False,"")
                    return
                env,inf=q
                for l_ in inf:self._ls("[VOCES] "+l_)
