    def _elc(self):
        c=filedialog.askdirectory(title=T("destino"),initialdir=self.var_destino_carpeta.get() or os.path.expanduser("~"))
        if c:self.var_destino_carpeta.set(c)
    def _fc(self,e=None):
        fmt=self.var_formato.get()
        if fmt=="WAV Split" and self.var_remux.get():
            # WAV Split son WAV sueltos por canal: no se pueden meter en el MKV -> modo "solo audio"
            self.var_remux.set(False)
            try:self._rmx()
            except Exception:pass
        if self.var_downmix.get():
            ops=self._fd().get(fmt,[])
        else:
            ops=self.formatos.get(fmt,[])
        self.cmb_b.configure(values=ops)
        if ops:self.var_bitrate.set(self._br_defecto(fmt,ops))   # (JMG, 12/16-11) DTS 768; AC3 y E-AC3 640 / 192 / 128
        if e is not None:   # elegido a mano: igual que el bitrate, pasa a las demas pistas seleccionadas
            self._guardar_conf_pista()
            self._aplicar_formato_a_todas(fmt,self.var_bitrate.get())
    def _lay_nch(self):
        lay=self.var_layout_sal.get();return {"1.0":1,"2.0":2}.get(lay,6)
    def _br_defecto(self,fmt,ops,otro=None,n=None):
        """(JMG, 16-11) el bitrate con el que empieza cada formato: DTS 768; AC3 (Aften y FFmpeg) y E-AC3, 640 en 5.1, 192 en estéreo y
        128 en mono; los demás, el de siempre"""
        if not ops:return ""
        n=n or self._lay_nch()
        q="768 kbps" if fmt=="DTS" else ({1:"128 kbps",2:"192 kbps"}.get(n,"640 kbps") if fmt in ("AC3",AF_FMT,"EAC3") else None)
        if q and q in ops:return q
        return otro if (otro is not None and otro in ops) else ops[0]
    @staticmethod
    def _eac3_rango(nch):
        """(JMG, 16-11) E-AC3: admite cualquier bitrate (FFmpeg lo da exacto hasta 6144); desde 192 en 5.1 (JMG), 64 en estéreo y 48 en mono"""
        return (192 if nch>2 else (64 if nch==2 else 48)),6144
    def _br_valido(self,fmt,br,ops,n=None):
        """el bitrate vale: está en la lista o, con E-AC3, es uno escrito a mano dentro de su margen"""
        if br in ops:return True
        if fmt!="EAC3":return False
        try:k=int(str(br).split()[0])
        except (ValueError,IndexError):return False
        lo,hi=self._eac3_rango(n or self._lay_nch());return lo<=k<=hi
    def _eac3_b(self,b,nch):
        lo,hi=self._eac3_rango(nch)
        try:k=int(float(str(b).split()[0]))
        except (ValueError,IndexError):k=0
        return str(min(hi,max(lo,k)) if k else (640 if nch>2 else (192 if nch==2 else 128)))
    def _cmb_b_estado(self,*_):
        """(JMG, 16-11) con E-AC3 el bitrate se puede escribir; con los demás, solo elegir de la lista"""
        try:
            f=self.var_formato.get()
            vbr=f==AF_FMT and bool(AFTEN) and (getattr(self,"_aften",None) or {}).get("modo")=="vbr"   # con Aften en VBR manda su calidad
            q="disabled" if vbr else ("normal" if f=="EAC3" else "readonly")
            if str(self.cmb_b.cget("state"))!=q:self.cmb_b.configure(state=q)
        except Exception:pass
    def _bitrate_escrito(self,e=None):
        """(JMG, 16-11) E-AC3: el bitrate escrito a mano («500» o «500 kbps»), dentro de lo que admite; si no, al borde, y lo dice"""
        if self.var_formato.get()!="EAC3":return
        V=self._vt;n=self._lay_nch();lo,hi=self._eac3_rango(n)
        t=re.sub(r"[^0-9]","",str(self.var_bitrate.get()).lower().split("k")[0])
        k=int(t) if t else 0
        k2=min(hi,max(lo,k)) if k else int(self._eac3_b("",n))
        if k and k2!=k:self._toast(T("info_tit"),V(f"E-AC3: de {lo} a {hi} kbps con esta salida.",f"E-AC3: {lo} to {hi} kbps with this output."),seg=4)
        nuevo=f"{k2} kbps"
        cambio=nuevo!=getattr(self,"_br_antes",None) or (e is not None and getattr(e,"keysym","")=="Return")
        if nuevo!=self.var_bitrate.get():self.var_bitrate.set(nuevo)
        if cambio:self._br_antes=nuevo;self._bc()
    def _bc(self,e=None):
        br=self.cmb_b.get()
        self.var_bitrate.set(br)
        self._guardar_conf_pista()
        self._aplicar_formato_a_todas(self.var_formato.get(), br)

    def _aplicar_formato_a_todas(self,fmt=None,br=None):
        if not self.pactual: return
        sel=list(self.lp.curselection())
        if len(sel)<=1: return
        if fmt is None: fmt=self.var_formato.get()
        if br is None: br=self.var_bitrate.get()
        for i in sel:
            if i < len(self._multi_tracks):
                ruta, idx = self._multi_tracks[i]
                if (ruta,idx) != self.pactual:
                    if (ruta,idx) not in self.pconf:
                        self.pconf[(ruta,idx)] = self._snap_pista()
                    c = self.pconf[(ruta,idx)]
                    # solo si ese formato existe para los canales de salida de ESA pista (2.0 / 1.0 / 5.1...)
                    fd = self._ops_lay(c.get("layout","5.1"), self._nch(ruta,idx)<=2)
                    if fmt not in fd: continue
                    c['formato'] = fmt
                    n_={"1.0":1,"2.0":2}.get(c.get("layout","5.1"),6)   # (revisión, 17-11) con los canales de salida de ESA pista
                    c['bitrate'] = br if self._br_valido(fmt,br,fd[fmt],n_) else (self._br_defecto(fmt,fd[fmt],None,n_) if fd[fmt] else br)

    def _rmx(self):
        try:
            if self.var_remux.get():
                self.rmx_fr.grid()
                if self.var_formato.get()=="WAV Split":
                    self.var_formato.set(DEF_FMT)
                    self._fc()
            else:
                self.rmx_fr.grid_remove()
            self._fmt_refresh()
        except Exception:pass

    # ---------- Canales de salida (2.1 / 3.1 / 4.0 / 4.1 / 5.1) ----------
    def _ent_est(self):
        try:   # un WAV multicanal sin disposicion en la cabecera sigue siendo multicanal
            if self.pactual and int((self.pc.get(self.pactual[0]) or [])[self.pactual[1]].get("channels",0))>2:return False
        except Exception:pass
        lt=self.var_layout.get()
        return lt not in ("—","") and not self._es_m(lt)
    def _out_act(self):
        lay=self.var_layout_sal.get()
        if lay not in LAY_ACT:lay="5.1"   # 2.0: se procesan los 6 canales y luego se mezclan a estereo
        if self._ent_est() and lay=="5.1" and self.var_upmix.get()!="S":return {"FL","FR"}
        return set(LAY_ACT[lay])
    def _lay_up(self):
        """True si el motor crea los canales (Upmix o disposicion con origen estereo)"""
        return self.var_upmix.get()=="S" or (self._ent_est() and self.var_layout_sal.get() in LAY_ACT and self.var_layout_sal.get()!="5.1")
    def _fmt_keys(self):
        ks=list(self.formatos.keys())
        lay=self.var_layout_sal.get()
        ok=LAY_FMT.get(lay)
        if ok:ks=[k for k in ks if k in ok]
        if self.var_remux.get() and lay=="4.1":ks=["FLAC","WAV Split"]
        return ks
    def _fmt_refresh(self):
        try:
            if self.var_downmix.get():return
            ops=self._fmt_keys()
            self.cmb_f.configure(values=ops)
            if self.var_formato.get() not in ops:
                self.var_formato.set(DEF_FMT if DEF_FMT in ops else ("AC3" if "AC3" in ops else ops[0]))
                self._fc()
        except Exception:pass
    def _lay_estado(self):
        """Exclusiones: Upmix 5.1 / disposicion de canales (2.0 = estereo, 1.0 = mono)
        Origen estereo: fijo en 2.0 · con Upmix (Si) 5.1 · Origen mono: 1.0, 2.0 o canales creados"""
        if self._lay_g:return
        self._lay_g=True
        try:
            est=self._ent_est();ch=self._ch_pactual()
            estereo=(ch==2) if ch else est
            vals=["5.1","4.1","4.0","3.1","2.1","2.0","1.0"]
            self._cfgw(self.cmb_lay,values=vals,state="readonly" if (self.files and not estereo) else "disabled")
            if self.var_layout_sal.get() not in vals:self.var_layout_sal.set("5.1")
            lay=self.var_layout_sal.get();up=self.var_upmix.get()
            if estereo:
                # origen estereo: salida fija en 2.0 · con Upmix = Si, 5.1
                w="5.1" if up=="S" else "2.0"
                if lay!=w:self.var_layout_sal.set(w)
                lay=self.var_layout_sal.get()
                self._cfgw(self.rb_no,state="normal");self._cfgw(self.rb_si,state="normal")
            elif est:
                prev=getattr(self,"_lay_prev",None)
                if prev is not None and lay!=prev:
                    # se ha cambiado la disposicion: el Upmix la sigue (5.1 = Upmix)
                    w="S" if lay=="5.1" else "N"
                    if up!=w:self.var_upmix.set(w)
                elif up=="S" and lay!="5.1":
                    self.var_layout_sal.set("5.1")
                elif up!="S" and lay=="5.1":
                    self.var_layout_sal.set("2.0")   # estereo sin Upmix = salida estereo (nunca 5.1 con canales vacios)
                lay=self.var_layout_sal.get()
                self._cfgw(self.rb_no,state="normal");self._cfgw(self.rb_si,state="normal")
            dm=(lay in ("2.0","1.0"))
            if bool(self.var_downmix.get())!=dm:self.var_downmix.set(dm)
            if lay!="5.1" and not est:
                self._cfgw(self.rb_no,state="disabled");self._cfgw(self.rb_si,state="disabled")
                self._cfgw(self.sl_uc,state="disabled");self._cfgw(self.en_uc,state="readonly",readonlybackground=CDN,bg=CDN,fg=CA)
            self._lay_prev=lay
            self._dm_ui_sync()
        except AttributeError:pass
        finally:
            self._lay_g=False
    def _ch_pactual(self):
        """canales de la pista activa (0 si no se sabe). Se mira la pista, no la etiqueta de la pantalla,
        que al cambiar de archivo todavia muestra la entrada anterior"""
        try:
            ruta,idx=self.pactual
            return int((self.pc.get(ruta) or [])[idx].get("channels",0) or 0)
        except Exception:return 0
    def _multicanal(self):
        """True si la pista activa tiene mas de 2 canales (5.1, 7.1...)"""
        ch=self._ch_pactual()
        return ch>2 if ch else not self._ent_est()
    def _dm_ui_sync(self):
        """Radios «Downmix»: activos solo con pista multicanal (5.1 / 7.1...); Si = salida 2.0 / 1.0"""
        try:
            mc=bool(self.files) and self._multicanal()
            w="S" if (mc and self.var_layout_sal.get() in ("2.0","1.0")) else "N"
            if self.var_dm_ui.get()!=w:self.var_dm_ui.set(w)
            for r in (self.rb_dm_no,self.rb_dm_si):self._cfgw(r,state="normal" if mc else "disabled")
        except Exception:pass
    def _dm_radio(self):
        """Clic en «Downmix»: Si = salida estereo 2.0 · No = vuelven los canales de la pista (5.1...)"""
        try:
            if not self.files or not self._multicanal():self._dm_ui_sync();return
            lay=self.var_layout_sal.get()
            if self.var_dm_ui.get()=="S":
                if lay not in ("2.0","1.0"):self.var_layout_sal.set("2.0")
            elif lay in ("2.0","1.0"):
                d=self._lay_def();self.var_layout_sal.set(d if d not in ("2.0","1.0") else "5.1")
            self._dm_ui_sync()
        except Exception:pass
    def _lay_cambio(self):
        try:
            dm=(self.var_layout_sal.get() in ("2.0","1.0"))
            if bool(self.var_downmix.get())!=dm:self.var_downmix.set(dm)
            self._dmm()
            self._lay_estado()
            self._fmt_refresh()
            self._canales_ui()
        except Exception:pass
    def _cw_set(self,ws,ok):
        for w in ws:
            try:
                if w.winfo_class()=="Entry":
                    if ok:self._cfgw(w,state="normal",bg=CDN,fg=CT,insertbackground=CT)
                    else:self._cfgw(w,state="readonly",readonlybackground=CDN,bg=CDN,fg=CA)
                else:self._cfgw(w,state="normal" if ok else "disabled")
            except Exception:pass
    def _canales_ui(self):
        """Controles ligados a los canales que existen en la salida"""
        if not self.files:return
        self._uv_sync()
        act=self._out_act()
        for ch in ("FC","LFE","BL","BR"):
            self._cw_set(self._cw.get(ch,[]),ch in act)
        self._cw_set(self._cw.get("BMDB",[]),("LFE" in act))
        for k,ch in (("tras",("BL","BR")),("cent",("FC",))):
            r=self._eqr.get(k)
            if r is not None:
                try:self._cfgw(r,state="normal" if any(c in act for c in ch) else "disabled")
                except Exception:pass
        try:
            g=self.var_eq_group.get()
            if g=="tras" and not ("BL" in act or "BR" in act):self.var_eq_group.set("front");self._eqshow()
            elif g=="cent" and "FC" not in act:self.var_eq_group.set("front");self._eqshow()
        except Exception:pass
        self._ex()
    def _canales_ex(self):
        """Se llama al final de _ex(): apaga (y pone a 0) lo que depende de canales ausentes"""
        if not self.files:return
        act=self._out_act()
        if "FC" not in act and self._gx.get("dinfc"):self._cw_set(self._gx["dinfc"],False)
        if "LFE" not in act and self._gx.get("dinlfe"):self._cw_set(self._gx["dinlfe"],False)
        for key,var,ok in (("voz",self.var_voz,"FC" in act),("sub",self.var_sub,"LFE" in act),
                           ("tras",self.var_gdin_tras,("BL" in act or "BR" in act)),("cent",self.var_gdin_cent,"FC" in act)):
            ws=self._px.get(key) if key in ("voz","sub") else self._gx.get(key)
            if ok or not ws:continue
            try:
                if var.get()!=0:var.set(0)
            except Exception:pass
            self._cw_set(ws,False)

    def _cfe(self,a,idx,cfg,seg=None):
        c=dict(cfg) if cfg else self._snap()
        try:ch=int((self.pc.get(a) or [])[idx].get("channels",6))
        except Exception:ch=6
        c["ent_estereo"]=ch<=2;c["ent_mono"]=ch<=1
        t_=self.ptramos.get((a,idx))
        if t_ and abs(float(c.get("delay_init",0) or 0)-t_["d"])<0.5 and str(c.get("fps_from"))==str(c.get("fps_to")):   # medidos con ese delay y sin cambiar la velocidad
            c["_tramos"]=t_["tl"];c["_dur"]=float(seg) if seg else self._dur(a);c["_ini_ms"]=self._ini_ms(a,idx)
        try:
            if int(c.get("limp",0) or 0)>0 and "_ruido_nf" not in c:
                self._ls("    Midiendo ruido de fondo...")
                if seg is not None:self._ui(self._vis_est,self._vt("Midiendo el ruido de fondo...","Measuring background noise..."))
                if hasattr(self,"_fase"):self._fase[a]=self._vt("midiendo ruido de fondo","measuring background noise")
                c["_ruido_nf"]=self._ruido_medir(a,idx,seg)
                if hasattr(self,"_fase"):self._fase[a]=self._vt("procesando","processing")
        except Exception:pass
        try:
            if int(c.get("speech_norm",0) or 0)>0 and "_spn_i" not in c:
                self._ls("    Midiendo el nivel de los diálogos (SpeechNorm)...")
                if seg is not None:self._ui(self._vis_est,self._vt("Midiendo el nivel de los diálogos...","Measuring dialogue level..."))
                if hasattr(self,"_fase"):self._fase[a]=self._vt("midiendo diálogos","measuring dialogue")
                c["_spn_i"]=self._spn_medir(a,idx,seg)
                if hasattr(self,"_fase"):self._fase[a]=self._vt("procesando","processing")
        except Exception:pass
        try:
            if int(c.get("din_modo",0)) in (2,3) and "_din_med" not in c:
                self._ls("    Midiendo nivel y picos para Impacto...")
                if seg is not None:self._ui(self._vis_est,self._vt("Midiendo nivel y picos para Impacto...","Measuring level and peaks for Impact..."))
                if hasattr(self,"_fase"):self._fase[a]=self._vt("midiendo nivel para Impacto","measuring level for Impact")
                c["_din_med"]=self._din_medir(a,idx,seg)
                if hasattr(self,"_fase"):self._fase[a]=self._vt("procesando","processing")
        except Exception:pass
        return c

    def _lay_def(self,p=None):
        """Disposicion de salida por defecto = la de la entrada (mono 1.0, estereo 2.0, 5.1/7.1 -> 5.1...)"""
        try:
            if p is None:
                ruta,idx=self.pactual;p=(self.pc.get(ruta) or [])[idx]
            ch=int(p.get("channels",6));lt=str(p.get("layout","")).lower()
        except Exception:return "5.1"
        if ch<=1:return "1.0"
        if ch==2:return "2.0"
        for k in ("4.1","4.0","3.1","2.1"):
            if lt.startswith(k):return k
        if ch==3:return "2.1"
        if ch==4:return "4.0"
        if ch==5:return "4.1"
        return "5.1"
    def _cfg_limpia(self):
        """ajustes de una pista recien añadida: los de Resetear (sin ningun efecto), con el formato de salida que este elegido"""
        cur=self._snap_pista()
        try:
            self._reset_vars();lim=self._snap_pista()
        finally:
            self._dictc(cur)
        for k in ("formato","bitrate"):
            if k in cur:lim[k]=cur[k]
        return lim
    def _cfg_nueva(self,base,p):
        """Config de una pista recien añadida: la base (sin efectos), con la salida de los canales de SU entrada"""
        c=dict(base)
        lay=self._lay_def(p)
        c["layout"]=lay;c["downmix"]=lay in ("2.0","1.0");c["upmix"]="N"
        fd=self.formatos_mono if lay=="1.0" else (self.formatos_down if lay=="2.0" else None)
        if fd is not None:
            ok=list(fd.keys())+(["Passthrough"] if (lay=="2.0" and int(p.get("channels",6) or 6)<=2) else [])
        else:
            ok=LAY_FMT.get(lay) or list(self.formatos.keys())
        n_={"1.0":1,"2.0":2}.get(lay,6)
        if c.get("formato") not in ok:
            c["formato"]=DEF_FMT if DEF_FMT in ok else ("AC3" if "AC3" in ok else ok[0])
            c["bitrate"]=self._br_defecto(c["formato"],(fd or self.formatos).get(c["formato"]) or ["640 kbps"],None,n_)
        if c.get("formato") in ("AC3",AF_FMT,"EAC3"):   # (revisión, 17-11; JMG: «en estéreo 192 por defecto») con otros canales que lo que hay en pantalla: su bitrate de partida
            ops_=(fd or self.formatos).get(c["formato"]) or []
            scr_=self._lay_nch() if self.pactual else 6   # sin ninguna pista en pantalla (recién abierto, tras Limpiar): como al arrancar, 5.1
            if n_!=scr_ or not self._br_valido(c["formato"],c.get("bitrate"),ops_,n_):
                c["bitrate"]=self._br_defecto(c["formato"],ops_,None,n_) or c.get("bitrate")
        return c
    def _lay_def_aplicar(self):
        try:
            lay=self._lay_def()
            self.var_upmix.set("N")
            self._lay_prev=None
            if self.var_layout_sal.get()!=lay:self.var_layout_sal.set(lay)
            else:self._lay_cambio()
            self._lay_prev=self.var_layout_sal.get()
        except Exception:pass
    def _est_pactual(self):
        """True si la pista activa es mono/estereo (se mira la pista, no la etiqueta de la pantalla)"""
        try:
            ruta,idx=self.pactual
            return int((self.pc.get(ruta) or [])[idx].get("channels",6))<=2
        except Exception:
            return self._ent_est()
    def _ops_lay(self,lay,est=False):
        """formatos -> bitrates validos para una disposicion de salida"""
        if lay=="1.0":return self.formatos_mono
        if lay=="2.0":return ({"Passthrough":[self._vt("Sin conversión","No conversion")],**self.formatos_down} if est else self.formatos_down)
        ok=LAY_FMT.get(lay)
        return {k:v for k,v in self.formatos.items() if (not ok or k in ok)}
    def _fd(self):
        """Formatos para salida 2.0 / 1.0 (origen estereo en 2.0: tambien Passthrough)"""
        if self.var_layout_sal.get()=="1.0":return self.formatos_mono
        if self._ent_est():return {"Passthrough":[self._vt("Sin conversión","No conversion")],**self.formatos_down}
        return self.formatos_down
    def _dmm(self):
        if not self.files:return
        try:
            if self.var_downmix.get():
                est=self._ent_est();mono=(self.var_layout_sal.get()=="1.0")
                # Modo Dolby/Simple: solo 5.1 -> 2.0 · LFE: no aplica a origen estereo
                self._cfgw(self.cmb_dm,state="readonly" if (not est and not mono) else "disabled")
                self._cfgw(self.chk_dmlfe,state="normal" if not est else "disabled")
                fd=self._fd()
                ops=list(fd.keys())
                self._cfgw(self.cmb_f,values=ops)
                if self.var_formato.get() not in ops:
                    self.var_formato.set(DEF_FMT)
                sub_ops=fd.get(self.var_formato.get(),["256 kbps"])
                self._cfgw(self.cmb_b,values=sub_ops)
                if not self._br_valido(self.var_formato.get(),self.var_bitrate.get(),sub_ops):
                    self.var_bitrate.set(self._br_defecto(self.var_formato.get(),sub_ops,sub_ops[1] if len(sub_ops)>2 else sub_ops[0]))
                if not est:
                    self.var_upmix.set("N")
                    self._cfgw(self.rb_no,state="disabled");self._cfgw(self.rb_si,state="disabled")
                self._lay_estado()
            else:
                self._cfgw(self.cmb_dm,state="disabled")
                self._cfgw(self.chk_dmlfe,state="disabled")
                ops=self._fmt_keys()
                self._cfgw(self.cmb_f,values=ops)
                if self.var_formato.get() not in ops:
                    self.var_formato.set(DEF_FMT if DEF_FMT in ops else ("AC3" if "AC3" in ops else ops[0]))
                sub_ops=self.formatos.get(self.var_formato.get(),["640 kbps"])
                self._cfgw(self.cmb_b,values=sub_ops)
                if not self._br_valido(self.var_formato.get(),self.var_bitrate.get(),sub_ops):
                    self.var_bitrate.set(self._br_defecto(self.var_formato.get(),sub_ops))
                self._upmix()
            self._lay_estado();self._canales_ui()
        except AttributeError:pass

    def _on_tab_change(self,e=None):
        try:
            idx = self.nb.index(self.nb.select())
            # La ultima pestana siempre es Edit/Log
            if idx == len(self.nb.tabs()) - 1:
                self._update_editlog()
        except Exception as ex:
            self._log(f"[TabChange error] {ex}")

    # ================= VISUALIZACION (antes / despues) =================
    def _vt(self,es,en):
        return es if IDIOMA=="es" else en

    def _vis_mezcla(self,c1,c2,t):
        try:
            a=[int(c1[i:i+2],16) for i in (1,3,5)];b=[int(c2[i:i+2],16) for i in (1,3,5)]
            return "#%02x%02x%02x"%tuple(int(a[i]+(b[i]-a[i])*t) for i in range(3))
        except Exception:
            return c2

    def _vis_nombres(self,n):
        if n==1:return ["M"]
        if n==2:return ["L","R"]
        base=["FL","FR","FC","LFE","BL","BR","SL","SR"]
        return [base[i] if i<len(base) else "Ch%d"%(i+1) for i in range(n)]

    _VIS_CAN=["FL","FR","FC","LFE","BL","BR","SL","SR"]
    def _vis_nom_des(self,n,lay):
        l=LAY_ACT.get(lay or "")
        if l and len(l)==n:return list(l)
        return self._vis_nombres(n)
    # disposiciones de ENTRADA con menos de 6 canales: el orden real de FFmpeg (un 2.1 es FL FR LFE, no FL FR FC)
    _VIS_LAY_ENT={"2.1":["FL","FR","LFE"],"3.0":["FL","FR","FC"],"3.1":["FL","FR","FC","LFE"],"quad":["FL","FR","BL","BR"],
                  "4.0":["FL","FR","FC","BC"],"4.1":["FL","FR","FC","LFE","BC"],"5.0":["FL","FR","FC","BL","BR"]}
    def _vis_nom_ent(self,n,lay):
        l=self._VIS_LAY_ENT.get(str(lay or "").lower())
        if l and len(l)==n:return list(l)
        return self._vis_nombres(n)
    def _vis_can(self,nm):
        return {"L":"FL","R":"FR","M":"FC"}.get(nm,nm)
    def _vis_ci(self,nm):
        c=self._vis_can(nm)
        return self._VIS_CAN.index(c) if c in self._VIS_CAN else 0
    def _vis_color(self,i,n):
        if n<=2:return "#5c7cfa"
        g=["#5c7cfa","#5c7cfa","#e64980","#e64980","#d4a017","#d4a017","#22b8cf","#22b8cf"]
        return g[i%8]

    def _vis_fmt(self,t):
        t=int(round(t));h=t//3600;m=(t%3600)//60;s=t%60
        return "%d:%02d:%02d"%(h,m,s)

    def _tvis(self):
        outer=ttk.Frame(self.nb);self.nb.add(outer,text=T("vis"))
        if not hasattr(self,"_vis_gen"):
            self.var_vis_estado=tk.StringVar(value="")
            self.var_vis_tiempo=tk.StringVar(value="")
            self.var_vis_zoom=tk.StringVar(value="x1")  # zoom fijo en x1 (sin selector)
            self.var_vis_tramo_i=tk.IntVar(value=1)
            self.var_vis_modo_i=tk.IntVar(value=0)
            self._vis_data=None;self._vis_proc=None;self._vis_gen=0;self._vis_run=False;self._vis_redraw_id=None
            self._vis_tmp=None;self._vis_aud={};self._vis_play=None
            self._vis_pos=0.0;self._vis_pos0=0.0;self._vis_t0=0.0;self._vis_geom=None;self._vis_tick_id=None
            self.var_vis_zh=tk.StringVar(value="x1");self._vz=1.0;self._vv0=0.0;self._vpan=None
