            except Exception as e:
                self._ls(f"[AUTO] [ERR] {e}");inf.append(V("No se ha podido medir (mira Edit/Log).","Could not measure (see Edit/Log)."))
            self._ui(self._auto_fin,"ef",res,inf,ef)
        threading.Thread(target=tarea,daemon=True).start()
    # lo que cada «Auto» deja sin aplicar al medir (es lo que va a calcular); todo lo demas de la pista se aplica a la muestra
    _AUTO_NEUTRO={"vol":{"fl":0,"fr":0,"fc":0,"lfe":0,"bl":0,"br":0},
                  "pres":{"voz":0,"amb":0,"efc":0,"sub":0,"techo_pres":"Sin límite"},
                  "eq3":{"eq_bass":0,"eq_mids":0,"eq_treble":0},
                  "tono":{f"eq{g}_b{i}_g":0 for g in ("front","tras","cent") for i in (1,2,3)},
                  "suav":{"suav":0},
                  "gama":{"gdin_front":0,"gdin_tras":0,"gdin_cent":0,"gdin_vol":0,"techo_gd":"Sin límite"},
                  "din":{"din_modo":0,"din_vol":0,"techo_pd":"Sin límite"},
                  "bm":{"bm":0},"db":{"db":0},
                  "limp":{"limp":0,"declick":False,"declip":False},
                  "norm":{"master_auto":False,"dyn_norm":0,"speech_norm":0}}
    def _muestra_proc(self,ruta,idx,orden,cfg,ef,prog=None):
        """muestra de la pelicula (24 trozos de 15 s) con TODOS los ajustes de la pista aplicados menos los del propio «Auto» ef:
        se mide lo que de verdad va a sonar. Archivo temporal (WAV de 32 bits flotantes: nada se recorta) o None, y entonces se mide el original"""
        import tempfile,hashlib
        try:
            if not hasattr(self,"_muestras"):self._muestras={}
            try:fm=os.path.getmtime(ruta)
            except OSError:fm=0
            kc=(ruta,orden,fm);cru=self._muestras.get(kc)
            if not cru or not os.path.isfile(cru):
                dur=self._dur(ruta)
                if dur<=1:return None
                d_=tempfile.mkdtemp(prefix="jmg_auto_")
                if not hasattr(self,"_tmp_mios"):self._tmp_mios=set()
                self._tmp_mios.add(d_)
                cru=os.path.join(d_,"muestra.wav")
                n,L,pos=self._trozos(dur,24,15.0)
                cmd=[FFMPEG,"-hide_banner","-nostats","-y"]
                for p in pos:cmd+=["-ss",f"{p:.3f}","-t",f"{L:.3f}","-i",ruta]
                g="".join(f"[{i}:a:{orden}]aresample=48000[s{i}];" for i in range(n))+"".join(f"[s{i}]" for i in range(n))+f"concat=n={n}:v=0:a=1[o]"
                cmd+=["-filter_complex",g,"-map","[o]","-c:a","pcm_f32le","-rf64","auto","-progress","pipe:1","-stats_period","0.3",cru]
                self._ffm_texto(cmd,(lambda t:prog(0.5*min(1.0,t/(n*L)))) if prog else None)
                if self._cancelar.is_set() or not os.path.isfile(cru):return None
                self._muestras[kc]=cru
            p_=dict((self.pc.get(ruta) or [])[idx]);p_.update(orden=0,start=0,ini=0)
            self.pc[cru]=[p_]   # la muestra se procesa como la pista: con sus canales y su disposicion
            c=dict(cfg);c.update(self._AUTO_NEUTRO.get(ef,{}))
            c.update(delay_init=0,fps_to=c.get("fps_from","25"))   # la sincronia no cambia lo que se mide
            h=hashlib.md5(repr(sorted((k,str(v)) for k,v in c.items())).encode()).hexdigest()[:12]
            out=os.path.join(os.path.dirname(cru),f"proc_{h}.wav")
            if not os.path.isfile(out):
                for f_ in os.listdir(os.path.dirname(cru)):   # solo una procesada a la vez (pesan cientos de MB)
                    if f_.startswith("proc_"):
                        try:os.remove(os.path.join(os.path.dirname(cru),f_))
                        except OSError:pass
                lm=self._ln(cru,0,c.get("loudnorm_target"),cfg=c) if c.get("master_auto") else None
                fc=self._cf(0,self._cfe(cru,0,c),lm)
                du=self._dur(cru)
                cmd=[FFMPEG,"-hide_banner","-nostats","-y","-i",cru]+self._fc_arg(fc)+["-map","[outfinal]","-c:a","pcm_f32le","-rf64","auto","-progress","pipe:1","-stats_period","0.3",out+".part.wav"]
                self._ffm_texto(cmd,(lambda t:prog(0.5+0.5*min(1.0,t/max(1.0,du)))) if prog else None)
                if self._cancelar.is_set() or not os.path.isfile(out+".part.wav"):return None
                os.replace(out+".part.wav",out)
            r_=rh([FFPROBE,"-v","error","-select_streams","a:0","-show_entries","stream=channels","-of","csv=p=0",out],timeout=20)
            try:n_out=int((r_.stdout or "0").strip().split(",")[0])
            except ValueError:n_out=0
            up_=str(c.get("upmix","N"))=="S" and n_out==6   # con Upmix sale en 5.1: se mide el 5.1
            if not hasattr(self,"_muestra_chs"):self._muestra_chs={}
            self._muestra_chs[out]={"FL":0,"FR":1,"FC":2,"LFE":3,"BL":4,"BR":5} if up_ else None
            if up_:p_=dict(p_,channels=6,layout="5.1")
            if n_out!=int(p_.get("channels") or 0):
                self._ls(f"[AUTO] {os.path.basename(ruta)}: "+self._vt("la salida tiene otros canales (downmix / upmix): se mide el original.","the output has other channels (downmix / upmix): the original is measured."))
                return None
            self.pc[out]=[p_]
            return out
        except Exception as e:
            self._ls(f"[AUTO] [ERR] muestra: {e}");return None
    def _peli_medir(self,ruta,orden,chs,ef,prog=None):
        """lo que necesita el «Auto» de ef: volumen y rango de cada canal, tono de algunos o ruido de fondo. En cache: el segundo boton no mide otra vez"""
        if not chs:return None
        if not hasattr(self,"_peli_cache"):self._peli_cache={}
        esp={"pres":("FL","FR","FC"),"eq3":("FL","FR","FC","BL","BR"),"db":("FL","FR","LFE"),"suav":("FC",) if "FC" in chs else ("FL","FR")}.get(ef,())
        esp=[c for c in esp if c in chs];vol=ef not in ("suav","limp")
        tot=max(1,len(esp)+(1 if vol or ef=="limp" else 0));paso=[0]
        def p(x):
            if prog:prog(min(1.0,(paso[0]+x)/tot))
        try:fm=os.path.getmtime(ruta)
        except OSError:fm=0
        m={"chs":chs,"esp":{}};k=(ruta,orden,fm)
        if vol:
            r=self._peli_cache.get(k)
            if not r:
                r=self._vol_medida(ruta,orden,[(c,chs[c]) for c in ("FC","FL","FR","LFE","BL","BR") if c in chs],p)
                if not r:return None
                self._peli_cache[k]=r
            m["lufs"],m["lra"]=r;paso[0]+=1
        for c in esp:
            if self._cancelar.is_set():return None
            m["esp"][c]=self._tono_medir(ruta,orden,chs[c],prog=p);paso[0]+=1
        if ef=="limp":
            nf=self._peli_cache.get(k+("nf",))
            if nf is None:
                cs=[chs[c] for c in ("FL","FC","FR") if c in chs] or list(chs.values())
                ni=self._eco_niveles(ruta,orden,cs[0],cs[-1],prog=p)
                if not ni:return None
                nf=self._ruido_de(*ni);self._peli_cache[k+("nf",)]=nf
            m["nf"]=nf
        return m
    @staticmethod
    def _ruido_de(la,lb):
        """ruido de fondo (dBFS) con los niveles cada 100 ms de dos canales, con el mismo criterio que la Limpieza de audio"""
        v=sorted(max(a,b) for a,b in zip(la,lb) if max(a,b)>-90)
        if not v:return -90.0
        nf=min(v[max(0,int(len(v)*0.05)-1)],v[len(v)//2]-15.0)
        # lo mas flojo por encima de -50 dBFS es la propia musica o los dialogos, no un ruido de fondo (ninguno es tan fuerte): archivo limpio
        return nf if nf<=-50.0 else -90.0
    def _auto_calc(self,ef,m,cfg):
        """calculo del «Auto» de ef -> (ajustes, texto para el aviso); (None, motivo) si no se puede.
        Pulsarlo dos veces da lo mismo: no depende de lo que ya tuviera su propio control"""
        V=self._vt;P=self._AUTO_OBJ;L=m.get("lufs") or {};R=m.get("lra") or {};E=m.get("esp") or {};chs=m.get("chs") or {}
        pr_=bool(m.get("proc"))   # medido con los demas ajustes ya aplicados: no hay que sumar nada
        if not pr_:E={c:self._esp_con(c,v,cfg,ef) for c,v in E.items()}   # sin muestra procesada: se suman los ajustes de tono calculados
        ok=lambda c:L.get(c,-99.0)>-60
        med=lambda a:sum(a)/len(a)
        cl=lambda x,a,b:max(a,min(b,x))
        niv=lambda c:L[c]+(0.0 if pr_ else float(cfg.get(c.lower(),0) or 0))   # con lo que ya tienen sus deslizadores de volumen
        vF,vT,vS=P["vol"]
        fr=[niv(c) for c in ("FL","FR") if ok(c)];tr=[niv(c) for c in ("BL","BR") if ok(c)]
        fc=niv("FC") if ok("FC") else None
        def banda(cs,fs):
            v=[E[c][self._TONO_F.index(f)] for c in cs if E.get(c) for f in fs]
            v=[x for x in v if x is not None]
            return med(v) if v else None
        no=V("no se aplica a esta pista.","it does not apply to this track.")
        if ef in ("gama","din","bm","db","suav","limp","norm") and cfg.get("upmix")=="S":return None,V("con Upmix este efecto no se aplica.","with Upmix this effect does not apply.")
        aj={};txt=""
        if ef=="pres":
            if fc is not None and fr:aj["voz"]=self._eff_inv(cl(P["voz"]+cl((-vF-(fc-med(fr)))*0.25,-1.5,1.5),0.0,6.0),8,24)
            if fr:aj["amb"]=self._eff_inv(cl((med(fr)-med(tr)-(vF-vT))*0.25,-1.0,1.5) if tr else 0.0,7,14)
            a=banda(("FL","FR"),(4000,8000));b=banda(("FC",),(4000,8000))
            if fr:aj["efc"]=self._eff_inv(cl((-6.0-(a-b))*0.2,-1.0,1.5) if (a is not None and b is not None) else 0.0,7,14)
            if ok("LFE") and fc is not None:aj["sub"]=self._eff_inv(cl(vS-(niv("LFE")-fc),-6.0,6.0),9,20)
            if not aj:return None,no
            txt=" · ".join(f"{n} {aj[k]:+d}" for k,n in (("voz",V("Voz","Voice")),("amb",V("Ambiente","Ambience")),("efc",V("Efectos","Effects")),("sub","Subwoofer")) if k in aj)
            aj["techo_pres"]=V("Sin límite","No limit")   # JMG: el Auto de Presencia no pone techo
        elif ef=="eq3":
            cs=[c for c in ("FL","FR","FC","BL","BR") if ok(c)]
            g,me,a=banda(cs,(125,)),banda(cs,(1000,)),banda(cs,(4000,8000))
            if None in (g,me,a):return None,V("no se ha podido medir el tono.","could not measure the tone.")
            dg=cl(0.5*(-2.0-(g-me)),-3.0,3.0)
            da=0.0 if int(cfg.get("suav",0) or 0)>0 else cl(0.5*(-9.0-(a-me)),-2.0,3.0)   # con Suavizado no se devuelven los agudos que quita
            aj={"eq_bass":self._eff_inv(dg,10,14),"eq_mids":0,"eq_treble":self._eff_inv(da,10,14)}
            txt=V("graves ","bass ")+f"{aj['eq_bass']:+d} · "+V("medios ","mids ")+f"{aj['eq_mids']:+d} · "+V("agudos ","treble ")+f"{aj['eq_treble']:+d}"
        elif ef in ("bm","db"):
            if "LFE" not in chs:return None,V("esta pista no tiene subwoofer.","this track has no subwoofer.")
            if ef=="bm":
                ref=fc if fc is not None else (med(fr) if fr else None)
                if ref is None:return None,no
                # sin nada en el subwoofer se pide el maximo
                ne=vS-(niv("LFE")+(0.0 if pr_ else self._eff(cfg.get("sub",0),9,20))-ref) if ok("LFE") else 8.0
                n=0 if ne<=0.5 else next((i+1 for i,x in enumerate((1.5,3.2,4.8,6.4,8.0)) if x>=ne),5)
                aj={"bm":min(n,P["bm"]),"bm_corte":P["corte"]}
                txt=(V("intensidad ","amount ")+f"{aj['bm']} · {P['corte']} Hz") if aj["bm"] else V("el subwoofer ya está en su sitio: 0.","the subwoofer is already in place: 0.")
            else:
                # (JMG, 8-11) lo que arregla el Double Bass: altavoces flojos de graves profundos o subwoofer flojo o vacío (9 películas,
                # 14 pistas: en las mezclas originales, 63 Hz de los altavoces entre -3 y +5 dB respecto a 1 kHz y el subwoofer entre -7 y +2 dB)
                f63,f1k,l63=banda(("FL","FR"),(63,)),banda(("FL","FR"),(1000,)),banda(("LFE",),(63,))
                if f63 is None or f1k is None:return None,V("no se ha podido medir el tono.","could not measure the tone.")
                n,txt=_db_auto(f63,f1k,l63,P["db"],V)
                aj={"db":n,"db_corte":P["db_corte"]}
                txt=(V("intensidad ","amount ")+f"{n} · {P['db_corte']} Hz · " if n else "")+txt
        elif ef=="gama":
            lr=lambda cs:[R[c] for c in cs if ok(c) and c in R]
            T_=P["lra"];res=[]
            a=lr(("FL","FR"));b=lr(("BL","BR"));c=lr(("FC",))
            if a:aj["gdin_front"]=int(cl(round((T_-med(a))/1.5),0,P["gama"]));res.append(T("gd_front")+f" {aj['gdin_front']}")
            if b:aj["gdin_tras"]=int(cl(round((T_-med(b))/1.5),0,P["gama"]));res.append(T("gd_tras")+f" {aj['gdin_tras']}")
            if c:aj["gdin_cent"]=int(cl(round((T_-7.0-c[0])/1.5),0,2));res.append(T("gd_cent")+f" {aj['gdin_cent']}")
            if not aj:return None,no
            txt=" · ".join(res) if any(aj.values()) else V("la película ya tiene contraste de sobra: 0.","the movie already has plenty of contrast: 0.")
        elif ef=="din":
            # (JMG, 9-11) como el «Auto» de la Gama dinámica del VideoEncoder: el contraste de los delanteros Y los traseros
            # (en La Mangosta los traseros tienen 23-24 LU y los delanteros 20: mirando solo los delanteros se quedaba apagado)
            a=[R[c] for c in ("FL","FR","BL","BR") if ok(c) and c in R] or [R[c] for c in ("FC",) if ok(c) and c in R]
            if not a:return None,no
            ex=med(a)-P["lra"]
            if ex<=3.0:aj={"din_modo":0};txt=V(f"rango dinámico {med(a):.0f} LU: no hace falta, apagado.",f"dynamic range {med(a):.0f} LU: not needed, off.")
            else:   # demasiado contraste: Elevacion sube lo flojo, y en el central menos
                v=int(cl(round(ex/1.5)+2,1,6))
                aj={"din_modo":3,"din_ft":v,"din_fc":min(v,3),"din_lfe":0}   # (JMG, 9-11) modo 3: Elevación + Impacto
                txt=V(f"rango dinámico {med(a):.0f} LU · ",f"dynamic range {med(a):.0f} LU · ")+self._din_nom(3)+f" · "+V("F/T ","F/R ")+f"{v} · C {aj['din_fc']} · Sub 0"
        elif ef=="limp":
            nf=m.get("nf",-90.0)
            aj={"limp":next((i for i,x in enumerate((-72.0,-64.0,-58.0,-54.0)) if nf<=x),4)}
            txt=(V("ruido de fondo ","background noise ")+f"{nf:.0f} dBFS · "+V("intensidad ","amount ")+f"{aj['limp']}") if aj["limp"] else \
                V("no tiene ruido de fondo que quitar: este archivo no necesita corrección (0).","it has no background noise to remove: this file needs no correction (0).")
        elif ef=="norm":
            # la normalizacion que mejor le va: con mucho contraste y los dialogos flojos frente a los efectos, SpeechNorm (sube los dialogos);
            # con mucho contraste, DynAudNorm (sube lo flojo y baja lo fuerte poco a poco); si no, Loudnorm (solo el volumen, sin comprimir)
            a=[R[c] for c in ("FC","FL","FR") if ok(c) and c in R] or [v for v in R.values()]
            if not a:return None,no
            lra=max(a);dif=(fc-med(fr)) if (fc is not None and fr) else None
            if lra>=20.0 and dif is not None and dif<3.0:
                n=int(cl(round((lra-14.0)/2.0),2,6));aj={"master_auto":False,"dyn_norm":0,"speech_norm":n}
                txt=f"SpeechNorm {n}: "+V(f"mucho contraste ({lra:.0f} LU) y diálogos flojos frente a los efectos.",f"high contrast ({lra:.0f} LU) and quiet dialogue against the effects.")
            elif lra>=16.0:
                n=int(cl(round((lra-12.0)/2.0),2,5));aj={"master_auto":False,"dyn_norm":n,"speech_norm":0}
                txt=f"DynAudNorm {n}: "+V(f"mucho contraste ({lra:.0f} LU).",f"high contrast ({lra:.0f} LU).")
            else:
                aj={"master_auto":True,"dyn_norm":0,"speech_norm":0}
                txt="Loudnorm: "+V(f"el contraste ya es bueno ({lra:.0f} LU): solo se ajusta el volumen.",f"the contrast is already fine ({lra:.0f} LU): only the loudness is set.")
        elif ef=="suav":
            c="FC" if E.get("FC") else ("FL" if E.get("FL") else "FR")
            a=banda((c,),(4000,8000));b=banda((c,),(500,1000,2000))
            if a is None or b is None:return None,V("no se ha podido medir el tono.","could not measure the tone.")
            ex=a-b+18.0;aj={"suav":int(cl(round((ex-2.0)/4.0),0,5))}   # voz normal: los agudos, unos 18 dB por debajo de los medios. Escala de oido (JMG): +10 dB de mas = 2
            txt=V("agudos ","treble ")+f"{ex:+.0f} dB "+V("respecto a lo normal","against normal")+f" · "+V("intensidad ","amount ")+f"{aj['suav']}"
        # Gama y Procesado van de uno en uno, y las normalizaciones los apagan: el que se pide es el que se queda. Presencia va con todo
        pre={}
        activo=(ef=="gama" and any(aj.values())) or (ef=="din" and aj.get("din_modo"))
        if activo:
            otros=[]
            for k,z in (("master_auto",False),("dyn_norm",0),("speech_norm",0)):
                if cfg.get(k):pre[k]=z;otros.append(V("Normalización","Normalization"))
            if ef!="gama" and any(cfg.get(k) for k in ("gdin_front","gdin_tras","gdin_cent")):
                pre.update(gdin_front=0,gdin_tras=0,gdin_cent=0);otros.append(T("gama"))
            if ef!="din" and cfg.get("din_modo"):
                pre["din_modo"]=0;otros.append(T("pd"))
            if otros:txt+=V("\n  Se apaga ","\n  Switched off: ")+", ".join(dict.fromkeys(otros))+V(": van de uno en uno.",": they work one at a time.")
        # lo que no va junto se apaga: el que se pide es el que se queda
        _adv=[f"eq{g}_b{i}_g" for g in ("front","tras","cent") for i in (1,2,3)]
        GR={"norm":(["master_auto","dyn_norm","speech_norm"],V("Normalización","Normalization")),
            "eq3":(["eq_bass","eq_mids","eq_treble"],T("eq3")),"tono":(_adv,T("eq_adv")),"suav":(["suav"],V("Suavizado digital","Digital smoothing")),
            "limp":(["limp","declick","declip"],T("limp_tit")),"gama":(["gdin_front","gdin_tras","gdin_cent"],T("gama")),"din":(["din_modo"],T("pd"))}
        NO={"eq3":("tono","suav","limp"),"suav":("eq3","tono","limp"),"limp":("eq3","tono","suav","gama","din"),"gama":("limp",),"din":("limp",),"norm":("gama","din")}
        if ef in NO and any(aj.get(k) for k in GR[ef][0]):
            fuera=[]
            for g_ in NO[ef]:
                ks,nm=GR[g_]
                if any(cfg.get(k) for k in ks):
                    pre.update({k:(False if k in ("declick","declip") else 0) for k in ks});fuera.append(nm)
            if fuera:txt+=V("\n  Se apaga ","\n  Switched off: ")+", ".join(fuera)+V(": no van juntos.",": they do not go together.")
        return {**pre,**aj},txt
    def _scan_err(self,msg):
