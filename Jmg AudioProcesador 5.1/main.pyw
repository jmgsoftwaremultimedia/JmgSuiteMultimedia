def _data_dir_calc():
    """carpeta de ajustes y presets: junto al programa si se puede escribir (portable),
    si no (instalado en Archivos de programa) en %APPDATA%\\Jmg AudioProcesador"""
    a=_app_dir()
    try:
        t=os.path.join(a,".jmg_escritura_test")
        with open(t,"w") as f:f.write("ok")
        os.remove(t);return a
    except OSError:pass
    if sys.platform=="win32":
        d=os.path.join(os.environ.get("APPDATA") or os.path.expanduser("~"),"Jmg AudioProcesador")
    else:
        d=os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"),".config"),"jmg-audioprocesador")
    try:os.makedirs(d,exist_ok=True)
    except OSError:pass
    return d
def _area_trabajo(root):
    """zona util de la pantalla SIN la barra de tareas: (x, y, ancho, alto)"""
    if sys.platform=="win32":
        try:
            import ctypes
            from ctypes import wintypes
            r=wintypes.RECT()
            if ctypes.windll.user32.SystemParametersInfoW(0x30,0,ctypes.byref(r),0):   # SPI_GETWORKAREA
                return r.left,r.top,r.right-r.left,r.bottom-r.top
        except Exception:pass
    return 0,0,root.winfo_screenwidth(),root.winfo_screenheight()-60
