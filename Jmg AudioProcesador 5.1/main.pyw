        if d:self._ff_poner(os.path.normpath(d))
    def _ff_poner(self,d):
        V=self._vt
        if self.procesando:
            self._toast(T("warn_tit"),V("Espera a que termine el proceso en marcha.","Wait until the running process finishes."),tipo="warning",seg=4);return
        if d:
            r=_ff_carpeta_ok(d)
            if not r:
                self._toast(T("warn_tit"),V("En esa carpeta no están ffmpeg y ffprobe.","ffmpeg and ffprobe are not in that folder."),tipo="warning",seg=5);return
            try:ok=rh([r[0],"-version"],timeout=20).returncode==0
            except Exception:ok=False
            if not ok:
                self._toast(T("warn_tit"),V("Ese FFmpeg no funciona en este PC.","That FFmpeg does not work on this PC."),tipo="warning",seg=5);return
        _ff_aplicar(d);self._cfg_x("ffmpeg_dir",d);self._ff_txt();self._log("[FFMPEG] "+FFMPEG)
        falta=d and not _ff_carpeta_ok(d)[2]
        self._toast(T("info_tit"),(V("Hecho: desde ahora se usa ese FFmpeg.","Done: that FFmpeg is used from now on.") if d else V("Hecho: se usa el FFmpeg del programa.","Done: the program's own FFmpeg is used."))+
                    (V("\nFalta ffplay en esa carpeta: no se podrá reproducir.","\nffplay is missing in that folder: playback will not work.") if falta else ""),seg=6)
    # ---------- pasar los archivos al otro programa de Jmg Software ----------
    def _pasar_otro(self):
        """los archivos seleccionados (o todos) a Jmg VideoEncoder: si está abierto, a su lista; si no, se abre con ellos"""
        V=self._vt
        sel=[self.files[i] for i in self.la.curselection() if i<len(self.files)] or list(self.files)
        if not sel:
            self._toast(T("warn_tit"),V("Añade antes algún archivo a la lista.","Add some file to the list first."),tipo="warning",seg=4);return
        if _otro_enviar(sel):
            self._log(f"[->] {OTRO_NOMBRE}: "+", ".join(os.path.basename(x) for x in sel))
            self._toast(T("info_tit"),V(f"Pasados a {OTRO_NOMBRE}: {len(sel)} archivo(s).",f"Sent to {OTRO_NOMBRE}: {len(sel)} file(s)."),seg=4)
            self.root.after(700,self._on_close);return   # (JMG, 16-11) los dos no se quedan abiertos a la vez
        exe=_otro_buscar(self._cfg_x("otro_exe"))
        if not exe:
            if not self._confirm(OTRO_NOMBRE,V(f"No encuentro {OTRO_NOMBRE} en este PC.\n¿Lo buscas tú? (se recuerda para la próxima vez)",
                                               f"I cannot find {OTRO_NOMBRE} on this PC.\nWill you look for it? (it is remembered for next time)")):return
            f=filedialog.askopenfilename(title=OTRO_NOMBRE,filetypes=[(OTRO_NOMBRE,"*.exe *.pyw" if sys.platform=="win32" else "*"),(V("Todos los archivos","All files"),"*.*")])
            if not f:return
            exe=os.path.normpath(f);self._cfg_x("otro_exe",exe)
        try:
            cmd=[exe]+sel
            if exe.lower().endswith((".pyw",".py")):
                import shutil
                py=shutil.which("pythonw") or shutil.which("python") or shutil.which("python3")
                if not py:raise RuntimeError(V("no se encuentra Python para abrir ","Python not found to open ")+os.path.basename(exe))
                cmd=[py]+cmd
            subprocess.Popen(cmd,cwd=os.path.dirname(exe) or None)
            self._log(f"[->] {OTRO_NOMBRE} ({exe}): "+", ".join(os.path.basename(x) for x in sel))
            self._toast(T("info_tit"),V(f"Abriendo {OTRO_NOMBRE} con {len(sel)} archivo(s)...",f"Opening {OTRO_NOMBRE} with {len(sel)} file(s)..."),seg=5)
            self.root.after(700,self._on_close)   # (JMG, 16-11) los dos no se quedan abiertos a la vez
        except Exception as e:self._toast(T("error_tit"),str(e),tipo="error")
    def _traer_al_frente(self,archivos):
        """otra instancia nos ha pasado archivos: se añaden y la ventana se pone delante"""
        try:
            if self.root.state()=="iconic":self.root.deiconify()
            self.root.lift();self.root.attributes("-topmost",True)
            self.root.after(300,lambda:self.root.attributes("-topmost",False))
            self.root.focus_force()
        except Exception:pass
        if archivos:
            try:self._addl(archivos);self._vis_chk_files()
            except Exception as e:self._log(f"[!] Abrir con: {e}")
    def _normalizar_ya(self):
        """«Normalizar»: mide AHORA el volumen (Loudnorm) de las pistas marcadas, con barra de progreso.
        No procesa nada: la medida queda guardada y al PROCESAR se aplica en una sola pasada."""
        if self.procesando or getattr(self,"_midiendo_ln",False) or getattr(self,"_escaneando",False):return
        if not self.var_master_auto.get():return
        try:self._guardar_conf_pista()
        except Exception:pass
        pistas=[self._multi_tracks[i] for i in self.lp.curselection() if i<len(self._multi_tracks)]
        if not pistas and self.pactual:pistas=[self.pactual]
        if not pistas:
            self._toast(T("warn_tit"),self._vt("Selecciona al menos una pista primero","Select at least one track first"),tipo="warning");return
        trabajos=[]
        for ruta,idx in pistas:
            cfg=dict(self.pconf.get((ruta,idx)) or self._snap())
            if not cfg.get("master_auto"):continue
            trabajos.append((ruta,idx,cfg))   # la misma config de pista que usara PROCESAR (la medida sirve tal cual)
        if not trabajos:
            self._toast(T("warn_tit"),self._vt("Ninguna de las pistas marcadas tiene activada la normalización Loudnorm.","None of the selected tracks has Loudnorm enabled."),tipo="warning");return
        self._cancelar.clear();self._midiendo_ln=True
        self._cfgw(self.btn_norm,state="disabled",text=self._vt("Midiendo...","Measuring..."))
        try:self.btn_c.configure(state="normal")
        except Exception:pass
        self._set_prog(0);self._ls(self._vt(f"[LOUDNORM] Midiendo {len(trabajos)} pista(s)...",f"[LOUDNORM] Measuring {len(trabajos)} track(s)..."))
        def tarea():
            res=[];n=len(trabajos)
            for k,(ruta,idx,cfg) in enumerate(trabajos):
                if self._cancelar.is_set():break
                dur=self._dur(ruta) or 1.0
                self._st(self._vt(f"Midiendo volumen: {os.path.basename(ruta)} · pista #{idx}",f"Measuring loudness: {os.path.basename(ruta)} · track #{idx}"))
                def cb(t,k=k,dur=dur):self._set_prog(min(99.0,100.0*(k+min(1.0,t/dur))/n))
                m=self._ln(ruta,idx,cfg.get("loudnorm_target"),cb=cb,cfg=self._cfe(ruta,idx,cfg))
                res.append((ruta,idx,cfg,m))
            self._ui(self._normalizar_fin,res)
        threading.Thread(target=tarea,daemon=True).start()
    def _normalizar_fin(self,res):
        self._midiendo_ln=False
        self._cfgw(self.btn_norm,text=T("norm_ya"))
        try:self.btn_c.configure(state="disabled")
        except Exception:pass
        self._mst()
        if self._cancelar.is_set():
            self._set_prog(0);self._st("");self._toast(T("cancelado_tit"),self._vt("Medida cancelada.","Measurement cancelled."),tipo="info",seg=3);return
        self._set_prog(100);self._st(self._vt("Volumen medido: listo para procesar","Loudness measured: ready to process"))
        self._prog_vaciar()
        lin=[]
        for ruta,idx,cfg,m in res:
            t=_lnt(cfg.get("loudnorm_target"))
            if m is None:
                lin.append(self._vt(f"Pista #{idx}: no se pudo medir (¿silencio?)",f"Track #{idx}: could not be measured (silence?)"));continue
            g=float(t["I"])-float(m["input_i"])
            lin.append(self._vt(f"Pista #{idx} ({os.path.basename(ruta)}): {m['input_i']:.1f} LUFS → {t['I']} LUFS ({g:+.1f} dB)",
                                f"Track #{idx} ({os.path.basename(ruta)}): {m['input_i']:.1f} LUFS → {t['I']} LUFS ({g:+.1f} dB)"))
            self._log(f"[LOUDNORM] #{idx} {os.path.basename(ruta)}: I={m['input_i']:.1f} LUFS TP={m['input_tp']:.1f} LRA={m['input_lra']:.1f} -> {t['I']} LUFS ({g:+.1f} dB)")
        self._toast(self._vt("Volumen medido","Loudness measured"),"\n".join(lin)+self._vt("\n\nSe aplicará al PROCESAR, en una sola pasada.","\n\nIt will be applied when you PROCESS, in a single pass."),tipo="info",seg=10)
    def _lote_vacio(self,msg):
        """nada que procesar: se devuelve la interfaz a su estado normal (hilo principal)"""
        self.procesando=False;self._bp_poner(False)
        try:self.btn_p.configure(state="normal" if self.files else "disabled",text=T("procesar"))
        except Exception:pass
        try:self.btn_c.configure(state="disabled",text=T("cancelar"))
        except Exception:pass
        self._toast(T("warn_tit"),msg,tipo="warning")
    def _cancel(self):
        self._ls("[!] Boton cancelar pulsado.")
        if getattr(self,"_pausa_on",False):self._pausa_poner(False)   # (JMG, 13-11) en pausa: primero sigue (y así nada se queda parado)
        if getattr(self,"_ripeando",False):   # (JMG, 16-11) ripeando un disco: se para (y se borra lo de a medias)
            try:self._rip_cancelar()
            except Exception:pass

        # 1. Cancelar escaneo de volumen o medida de Loudnorm si estan activos
        if getattr(self, '_escaneando', False) or getattr(self, '_midiendo_ln', False):
            self._cancelar.set()
            self._ls("[!] Cancelando escaneo de volumen...")
            with self._lock: procs = list(self._procesos)
            for p in procs:
                if sys.platform == "win32":
                    subprocess.run(["taskkill", "/F", "/PID", str(p.pid), "/T"], creationflags=CNW, capture_output=True)
                else:
                    try: p.kill()
                    except Exception: pass
            return

        # 2. Cancelar procesado normal
        if not self.procesando:
            self._ls("[!] No hay proceso activo.")
            return

        self._ls("[!] Cancelando procesamiento...")
        self._cancelar.set() # Activar bandera de cancelación

        try: 
            self.btn_c.configure(state="disabled", text=T("cancelando_btn"))
            self.root.update_idletasks()
        except Exception: pass

        # Matar todos los procesos de FFmpeg activos (Windows)
        with self._lock:
            procs = list(self._procesos)

        for p in procs:
            if sys.platform == "win32":
                subprocess.run(["taskkill", "/F", "/PID", str(p.pid), "/T"], creationflags=CNW, capture_output=True)
            else:
                try: p.kill()
                except Exception: pass

        self._ls(f"[!] {len(procs)} proceso(s) terminados por la fuerza.")

    def _apa(self):
        linux=sys.platform!="win32"
        if not linux:
            try:subprocess.run(["shutdown","/s","/t","60","/c","Shutdown"],creationflags=CNW,check=False)
            except Exception:return
        self._apa_cancel=False
        top=tk.Toplevel(self.root);top.title(T("apagado_tit"));top.geometry("500x230");top.configure(bg=CF)
        top.transient(self.root);top.grab_set()
        ttk.Label(top,text=T("apagado_x"),font=("",11)).pack(pady=(20,5))
        c=tk.IntVar(value=60)
        ttk.Label(top,textvariable=c,font=("",36,"bold"),foreground=CAV).pack(pady=5)
        ttk.Label(top,text=T("apagado_seg"),font=("",10),foreground=CA).pack()
        def tk_():
            try:
                s=c.get()-1;c.set(s)
                if s<=0:
                    top.destroy()
                    if linux and not self._apa_cancel:
                        try:self._save_cfg()
                        except Exception:pass
                        try:subprocess.Popen(["systemctl","poweroff"])
                        except Exception:pass
                else:top.after(1000,tk_)
            except tk.TclError:pass
        top.after(1000,tk_)
        def cx():
            self._apa_cancel=True
            if not linux:
                try:subprocess.run(["shutdown","/a"],creationflags=CNW,check=False)
                except Exception:pass
            try:top.destroy()
            except tk.TclError:pass
        ttk.Button(top,text=T("cancelar_apagado"),command=cx).pack(pady=15)
    _SUSP_SEG=60
    def _suspender(self):
        """(JMG, 15-11) «Suspender el PC» al terminar: como el apagado, con 1 minuto para cancelarlo"""
        V_=self._vt
        top=tk.Toplevel(self.root);top.title(V_("Suspensión programada","Sleep scheduled"));top.configure(bg=CF);top.attributes("-topmost",True)
        ttk.Label(top,text=V_("El PC se suspenderá en 1 minuto.","The PC will go to sleep in 1 minute."),font=("",11,"bold")).pack(padx=30,pady=(20,10))
        def ya():
            try:top.destroy()
            except Exception:pass
            try:
                if sys.platform=="win32":
                    import ctypes;ctypes.windll.powrprof.SetSuspendState(False,False,False)
                else:subprocess.Popen(["systemctl","suspend"])
            except Exception as e:self._log(f"[!] {e}")
        aid=self.root.after(int(self._SUSP_SEG*1000),ya);self._susp_id=aid
        def no():
            try:self.root.after_cancel(aid)
            except Exception:pass
            try:top.destroy()
            except Exception:pass
        ttk.Button(top,text=V_("Cancelar la suspensión","Cancel sleep"),command=no).pack(pady=(0,20))
        top.protocol("WM_DELETE_WINDOW",no)
    # ---------- Combinar pistas: canales de varias pistas / archivos -> una sola pista multicanal ----------
    # salida -> (canales en orden, disposicion para el filtro join)
    _COMB_LAY={"2.0":(["FL","FR"],"stereo"),"2.1":(["FL","FR","LFE"],"2.1"),"3.1":(["FL","FR","FC","LFE"],"3.1"),
               "4.0":(["FL","FR","BL","BR"],"quad"),"4.1":(["FL","FR","LFE","BL","BR"],"FL+FR+LFE+BL+BR"),
               "5.1":(["FL","FR","FC","LFE","BL","BR"],"5.1"),"7.1":(["FL","FR","FC","LFE","BL","BR","SL","SR"],"7.1")}
    _COMB_FMT=("AC3","EAC3","DTS","AAC","FLAC","WAV","W64","RF64")
    def _comb_fuentes(self):
        """todos los canales de todas las pistas de la lista: [(etiqueta, (archivo, pista, canal, nombre o "" si es mono))]"""
        out=[]
        for ruta in list(self.files):
            ps=self.pc.get(ruta)
            if ps is None:
                ps=self._det(ruta);self.pc[ruta]=ps
            for p in ps or []:
                try:n=int(p.get("channels") or 0)
                except (TypeError,ValueError):n=0
                if n<=0 or p["orden"] in self.borrar_pistas.get(ruta,()):continue
                noms=self._vis_nom_ent(n,p.get("layout"))
                for ci in range(n):
                    nm=self._vis_can(noms[ci]) if n>1 else ""
                    out.append((f"{os.path.basename(ruta)} · #{p['orden']} [{p['lang']}] · {nm or 'mono'}",(ruta,p["orden"],ci,nm)))
                if n==2:   # de un estereo, como en el upmix (sin tener que hacerlo antes): la voz al central y L/R sin ella
                    for ci,nm,txt in (("C","C~",self._vt("C (voz extraída)","C (extracted voice)")),("L","L~",self._vt("L sin voz","L without voice")),
                                      ("R","R~",self._vt("R sin voz","R without voice"))):
                        out.append((f"{os.path.basename(ruta)} · #{p['orden']} [{p['lang']}] · {txt}",(ruta,p["orden"],ci,nm)))
        return out
    def _comb_up_params(self,ruta,orden):
        """«Presencia central» y «Quitar voz F/T» del upmix de esa pista (sus ajustes guardados; si no tiene, los de por defecto).
        Sin tocar Tk: se usa desde los hilos de Combinar (la pista activa se guarda antes, al pulsar el boton)"""
        uc,uv=5,8.0
        try:
            ps=self.pc.get(ruta) or []
            i=next(j for j,p in enumerate(ps) if p.get("orden")==orden)
            cf=self.pconf.get((ruta,i)) or {}
            uc=cf.get("upmix_central",uc);uv=cf.get("upmix_voz",uv)
        except Exception:pass
        try:uc=max(0,min(10,int(uc)))
        except (TypeError,ValueError):uc=5
        try:uv=max(0.0,min(10.0,float(uv)))
        except (TypeError,ValueError):uv=8.0
        return uc,uv
    def _comb_sub(self,ent,s,et):
        """filtros que sacan de la entrada [ent] (p. ej. 0:a:1) el canal de la fila como mono en [et]: un canal tal cual o, de una
        pista estereo, «C (voz extraída)» / «L sin voz» / «R sin voz» con la MISMA formula que los delanteros del upmix"""
        ci=s[2]
        if isinstance(ci,int):return [f"[{ent}]pan=mono|c0=c{ci}[{et}]"]
        uc,uv=self._comb_up_params(s[0],s[1])
        a=0.5*(uc/10.0);k=min(1.0,round((2.0-2.0*(1.0-a)**2)**0.5*0.85,4))
        fl=round(1.0-0.5*a,4);fx=round(0.5*a,4);kc=round(0.5*k,4);cb=round(uv/10.0*(fl-fx),4)
        if ci=="C":return [f"[{ent}]aformat=channel_layouts=stereo,pan=mono|c0={kc}*c0+{kc}*c1[{et}]"]
        a_,b_=("c0","c1") if ci=="L" else ("c1","c0")
        # la banda de la voz (200 Hz-5 kHz) de lo comun se resta con fase lineal (20 ms, compensados al final, como en el upmix)
        return [f"[{ent}]aformat=channel_layouts=stereo,asplit=2[{et}a][{et}b]",
                f"[{et}b]pan=mono|c0=0.5*c0+0.5*c1,firequalizer=gain_entry='entry(0,-70);entry(120,-70);entry(200,0);entry(5000,0);entry(8000,-70)':delay=0.02:fixed=1[{et}m]",
                f"[{et}a]adelay=delays=20|20[{et}d]",
                f"[{et}d][{et}m]amerge=inputs=2,pan=mono|c0={fl}*{a_}-{fx}*{b_}-{cb}*c2,atrim=start=0.02,asetpts=PTS-STARTPTS[{et}]"]
    def _comb_auto(self,fuentes,canales):
        """propuesta de origen para cada canal: archivos mono con el canal en el nombre (_FL, _FR... como
        los de WAV Split), pistas mono en orden; con un estereo y un multicanal, los frontales del estereo (sin voz y la voz al central)
        y el resto del multicanal; si no, los canales de la primera pista multicanal"""
        monos=[s for e,s in fuentes if not s[3]]
        asig=[None]*len(canales)
        for i,c in enumerate(canales):
            for s in monos:
                nb=os.path.splitext(os.path.basename(s[0]))[0].upper()
                if any(nb.endswith(x+c) for x in ("_","-","."," ")):asig[i]=s;break
        if any(asig):return asig
        multis=[s for e,s in fuentes if s[3]]
        # un doblaje estereo y un original multicanal (JMG): los tres frontales del doblaje (la voz extraida al central, L y R sin voz)
        # y el subwoofer y los traseros del original. Asi no se cuelan las voces del otro idioma y no hay ecos que corregir
        pistas={}
        for e,s in fuentes:
            if isinstance(s[2],int):pistas.setdefault((s[0],s[1]),[]).append(s)
        mc=[k for k,v in pistas.items() if len(v)>2];es=[k for k,v in pistas.items() if len(v)==2]
        if len(mc)==1 and len(es)==1:   # solo si esta claro: una pista multicanal y una estereo
            dob={s[3]:s for e,s in fuentes if (s[0],s[1])==es[0] and s[3] in ("C~","L~","R~")}
            ori={s[3]:s for e,s in fuentes if (s[0],s[1])==mc[0]}
            alt={"BL":"SL","BR":"SR","SL":"BL","SR":"BR"};fr_={"FC":"C~","FL":"L~","FR":"R~"}
            if len(dob)==3:
                return [dob[fr_[c]] if c in fr_ else (ori.get(c) or ori.get(alt.get(c,""))) for c in canales]
        if monos and not multis:
            return [monos[i] if i<len(monos) else None for i in range(len(canales))]
        if multis:
            r0,p0=multis[0][0],multis[0][1]
            mismos={s[3]:s for e,s in fuentes if s[0]==r0 and s[1]==p0}
            alt={"BL":"SL","BR":"SR","SL":"BL","SR":"BR"}
            return [mismos.get(c) or mismos.get(alt.get(c,"")) for c in canales]
        return asig
    def _comb_codec(self,fmt,br):
        """argumentos de FFmpeg y extension para el formato elegido"""
        br=br or "";b=br.split()[0] if br else "640"
        if fmt in ("AC3","EAC3","AAC","DTS"):
            c={"AC3":"ac3","EAC3":"eac3","AAC":"aac","DTS":"dca"}[fmt]
            return ["-c:a",c,"-b:a",f"{b}k"]+(["-strict","-2"] if fmt=="DTS" else []),{"AC3":"ac3","EAC3":"eac3","AAC":"m4a","DTS":"dts"}[fmt]
        if fmt=="FLAC":return ["-c:a","flac","-sample_fmt","s16" if "16" in br else "s32"],"flac"
        pcm="pcm_f32le" if ("float" in br and "32" in br) else ("pcm_s24le" if "24" in br else "pcm_s16le")
        if fmt=="W64":return ["-c:a",pcm,"-f","w64"],"w64"
        if fmt=="RF64":return ["-c:a",pcm,"-f","wav","-rf64","always"],"wav"
        return ["-c:a",pcm,"-rf64","auto"],"wav"
    def _comb_formatos(self,lay):
        base=self.formatos_down if lay=="2.0" else self.formatos
        ok=("AAC","FLAC","WAV","W64","RF64") if lay=="7.1" else LAY_FMT.get(lay)
        return {k:v for k,v in base.items() if k in self._COMB_FMT and (not ok or k in ok)}
    # ---------- Calcular delays: compara el sonido de las pistas (musica y efectos, sin el central) ----------
    def _sinc_trozo(self,ruta,orden,a,b,f0,sr=8000,con_fc=False):
        """trozo [a, b] s de la pista en la linea de tiempo de la salida (inicio respecto al video, sin delay), mono a 8 kHz
        y sin el canal central (los dialogos cambian con el idioma; la musica y los efectos no). Lista de muestras."""
        from array import array
        p_=(self.pc.get(ruta) or [])[orden]
        ini=float(p_.get("ini",0) or 0);st=float(p_.get("start") or 0)
        try:n=max(1,int(p_.get("channels") or 1))
        except (TypeError,ValueError):n=1
        noms=self._vis_nom_ent(n,p_.get("layout")) if n>1 else ["FC"]
        usa=[i for i in range(n) if con_fc or not (n>2 and self._vis_can(noms[i])=="FC")] or list(range(n))
        pan="mono|c0="+"+".join(f"{1.0/len(usa):.4f}*c{i}" for i in usa)
        t0=st+a-ini;t1=st+b-ini;pre=0
        if t0<st:pre=int(round((st-t0)*sr));t0=st      # el trozo empieza antes que la pista: silencio delante
        if t1<=t0:return [0]*int(round((b-a)*sr))
        cmd=[FFMPEG,"-v","error","-copyts","-ss",f"{max(0.0,t0-f0-3):.3f}","-i",ruta,"-map",f"0:a:{orden}",
             "-af",f"atrim=start={t0:.4f}:end={t1:.4f},asetpts=PTS-STARTPTS,pan={pan},aresample={sr}","-f","s16le","-ac","1","-"]
        r=subprocess.run(cmd,capture_output=True,timeout=300,creationflags=CNW)
        x=array("h");x.frombytes(r.stdout[:len(r.stdout)//2*2])
        return [0]*pre+list(x)
    @staticmethod
    def _sinc_corr(x,y,l0,l1,signo=False,todos=False):
        """correlacion normalizada de x con y desplazada (y[l:l+len(x)]) para l en [l0, l1] -> (mejor l, r)
        (todos=True: tambien {l: r} de todos los desplazamientos)"""
        import math,operator
        n=len(x);sx=math.sqrt(sum(map(operator.mul,x,x))) or 1.0
        cy=[0.0]
        for v in y:cy.append(cy[-1]+v*v)
        mejor=(None,0.0);rs={}
        for l in range(max(0,l0),min(l1,len(y)-n)+1):
            r=sum(map(operator.mul,x,y[l:l+n]))/(sx*(math.sqrt(max(cy[l+n]-cy[l],1e-9))))
            rs[l]=r
            if (abs(r) if signo else r)>(abs(mejor[1]) if signo else mejor[1]):mejor=(l,r)
        return mejor+(rs,) if todos else mejor
    @staticmethod
    def _sinc_env(x,blq=80,sr=8000,fc=300.0):
        """golpes de sonido cada 10 ms (subidas de la envolvente en dB, sin graves: los dialogos fuertes no tapan los golpes flojos), sin la media"""
        import math
        k=math.exp(-2*math.pi*fc/sr);h=[];yp=0.0;xp=0
        for v in x:
            yp=k*(yp+v-xp);xp=v;h.append(abs(yp))
        env=[math.log10(sum(h[i:i+blq])+blq) for i in range(0,len(h)-blq+1,blq)]
        on=[0.0]+[max(0.0,env[i]-env[i-1]) for i in range(1,len(env))]
        m=sum(on)/max(1,len(on));return [v-m for v in on]
    @staticmethod
    def _sinc_env_fino(x,sr=8000,fc=300.0):
        """golpes cada 1 ms: sin graves (sus ciclos enganan al afinar), envolvente de 4 ms y su subida en 4 ms, sin la media"""
        import math,itertools
        k=math.exp(-2*math.pi*fc/sr);h=[];yp=0.0;xp=0
        for v in x:
            yp=k*(yp+v-xp);xp=v;h.append(abs(yp))
        c=[0.0];c.extend(itertools.accumulate(h))
        hop=sr//1000;win=4*hop
        e=[c[i+win]-c[i] for i in range(0,len(h)-win+1,hop)]
        on=[0.0]*4+[max(0.0,e[i]-e[i-4]) for i in range(4,len(e))]
        m=sum(on)/max(1,len(on));return [v-m for v in on]
    def _sinc_medir(self,ref,otra,a,W,M,f0r,f0o,sr=8000,dr=0.0,do=0.0):
        """cuanto va «otra» por detras de «ref» (ms, + = mas tarde) en el trozo que empieza en a, y fiabilidad (0-1).
        dr / do: delay (s) ya puesto a cada pista (el trozo de la salida en a es el de la pista en a - delay)"""
        x=self._sinc_trozo(*ref,a-dr,a+W-dr,f0r,sr);y=self._sinc_trozo(*otra,a-M-do,a+W+M-do,f0o,sr)
        ex=self._sinc_env(x);ey=self._sinc_env(y);m=int(round(M*100))
        lc,rc,todos=self._sinc_corr(ex,ey,0,2*m,todos=True)
        if lc is None or rc<=0:return None,0.0
        # el pico tiene que destacar: el mejor de los demas (a mas de 100 ms) no puede acercarse (musica con ritmo, dialogos...)
        otro=max([v for l_,v in todos.items() if abs(l_-lc)>10] or [0.0])
        claro=rc>=0.12 and rc>=1.6*max(otro,0.0)
        # afinado al milisegundo con los golpes (no con la forma de onda: entre mezclas distintas se engancha a un ciclo vecino, +-5 ms),
        # +-15 ms alrededor de lo encontrado, y por debajo del ms con una parabola
        import math,operator
        fx=self._sinc_env_fino(x,sr);fy=self._sinc_env_fino(y,sr);M0=int(round(M*1000));c0=M0+(lc-m)*10
        n=len(fx);sx=math.sqrt(sum(map(operator.mul,fx,fx))) or 1.0;rs={}
        for l in range(max(0,c0-15),min(c0+15,len(fy)-n)+1):
            yy=fy[l:l+n];rs[l]=sum(map(operator.mul,fx,yy))/(sx*(math.sqrt(sum(map(operator.mul,yy,yy))) or 1.0))
        if not rs:return None,0.0
        l=max(rs,key=rs.get);rf=rs[l];d=0.0
        if l-1 in rs and l+1 in rs:
            den=rs[l-1]-2*rf+rs[l+1]
            if den<0:d=max(-0.5,min(0.5,0.5*(rs[l-1]-rs[l+1])/den))
        ms=l+d-M0
        # fiabilidad: la mejor de las dos envolventes, o la forma de onda si en ese punto tambien coincide
        # (en trozos de 4 s: basta con que en uno coincida, aunque en el resto tape el dialogo)
        p=int(round((ms/1000.0+M)*sr));rw=0.0
        for q in range(0,max(1,len(x)-4*sr+1),4*sr):
            xa=x[q:q+4*sr];xa=xa[:max(0,min(len(xa),len(y)-p-q))];ya=y[p+q:p+q+len(xa)]
            try:rw=max(rw,abs(sum(map(operator.mul,xa,ya)))/(math.sqrt(sum(map(operator.mul,xa,xa))*sum(map(operator.mul,ya,ya))) or 1.0))
            except Exception:pass
        # sin un pico grueso claro solo se fia si la forma de onda coincide de verdad (la misma mezcla)
        return ms,(max(0.3,rc,rf,rw) if claro or rw>=0.5 else min(rc,0.29))
    def _comb_sinc(self,grupos,fin):
        """hilo: delay de cada pista de origen para que todas coincidan. grupos = [(archivo, pista)], el 1º es la referencia.
        fin(resultado o None, lineas de informe)"""
        V=self._vt;inf=[]
        try:
            if not hasattr(self,"_tiempos"):self._tiempos={}
            f0={};ext=[]
            for k in grupos:
                if k not in self._tiempos:self._tiempos[k]=self._medir_tiempo(*k)
                ini,du=self._tiempos[k]
                if du is None:du=max(0.0,self._dur(k[0])-ini)
                ext.append((ini,ini+du))
                if k[0] not in f0:
                    q=rh([FFPROBE,"-v","error","-show_entries","format=start_time","-of","json",k[0]],timeout=15)
                    try:f0[k[0]]=float((json.loads(q.stdout or "{}").get("format") or {}).get("start_time") or 0)
                    except (ValueError,TypeError):f0[k[0]]=0.0
            lo=max(e[0] for e in ext);hi=min(e[1] for e in ext);T=hi-lo
            pal=self._comb_pal(grupos,[e[1]-e[0] for e in ext])
            if pal:return self._ui(fin,None,pal)
            if T<6:return self._ui(fin,None,[V("Las pistas coinciden muy poco tiempo (menos de 6 s): pon el delay a mano.","The tracks overlap for too short a time (under 6 s): set the delay by hand.")])
            W=min(40.0,T*0.4);M=min(10.0,T*0.2)
            puntos=[lo+T*fr-W/2 for fr in ((0.2,0.5,0.8) if T>=180 else (0.5,))]
            puntos=[min(max(a,lo+M),hi-W-M) for a in puntos]
            res={grupos[0]:0.0};n_=0;tot=(len(grupos)-1)*len(puntos)
            for k in grupos[1:]:
                med=[]
                for a in puntos:
                    if self._cancelar.is_set():return self._ui(fin,None,["cancel"])
                    n_+=1;self._ui(fin,"prog",[V("Comparando las pistas... ","Comparing the tracks... ")+f"{n_}/{tot}",(n_-1)/tot])
                    ms,r=self._sinc_medir((grupos[0][0],grupos[0][1]),(k[0],k[1]),a,W,M,f0[grupos[0][0]],f0[k[0]])
                    self._ls(f"[SINC] {os.path.basename(k[0])} #{k[1]} @ {self._hms(a)}: "+(f"{ms:+.1f} ms (r={r:.2f})" if ms is not None else "?"))
                    if ms is not None and r>=0.3:med.append(ms)
                nom=f"{os.path.basename(k[0])} #{k[1]}"
                if not med:
                    inf.append("⚠ "+nom+": "+V("no se parece lo bastante a la de referencia; pon su delay a mano.","not similar enough to the reference track; set its delay by hand."))
                    continue
                med.sort();res[k]=-med[len(med)//2]
                if med[-1]-med[0]>3:
                    inf.append("⚠ "+nom+": "+V("el desfase cambia a lo largo de la película (","the offset changes over the course of the movie (")+
                               " / ".join("%+d"%round(v) for v in med)+" ms)"+V(": puede que tengan distinta velocidad (fps).",": they may have a different speed (fps)."))
            # sin delays negativos: la que va mas adelantada se queda en 0
            m0=min(res.values());res={k:round(v-m0) for k,v in res.items()}
            self._ui(fin,res,inf)
        except Exception as e:
            self._ls(f"[SINC] [ERR] {e}")
            self._ui(fin,None,[V("No se ha podido calcular (mira Edit/Log).","Could not calculate (see Edit/Log).")])
    def _comb_pal(self,grupos,durs):
        """avisos si una pista dura un ~4 % mas o menos que la de referencia (la 1ª): 25 fps (PAL) frente a 23,976 / 24 fps.
        Ese desfase crece unos 2,5 s por minuto: no se arregla con delays, hay que cambiar antes el framerate"""
        V=self._vt;out=[];ref=durs[0];nr=f"{os.path.basename(grupos[0][0])} #{grupos[0][1]}"
        for k,d in zip(grupos[1:],durs[1:]):
            if ref<60 or d<60:continue
            q=ref/d;nom=f"{os.path.basename(k[0])} #{k[1]}"
            if 1.025<q<1.065:
                out.append("⚠ "+nom+V(f" dura un {(1-d/ref)*100:.1f} % menos que {nr}: parece que va a 25 fps (PAL) y la otra a 23,976 o 24. "
                                      "Conviértela antes (pestaña Volumen → Sincronización: framerate de 25 a 23,976) y combina la pista convertida.",
                                      f" is {(1-d/ref)*100:.1f} % shorter than {nr}: it seems to be 25 fps (PAL) and the other one 23.976 or 24 fps. "
                                      "Convert it first (Volume tab → Synchronization: framerate from 25 to 23.976) and combine the converted track."))
            elif 1/1.065<q<1/1.025:
                out.append("⚠ "+nom+V(f" dura un {(d/ref-1)*100:.1f} % más que {nr}: parece que {nr} va a 25 fps (PAL) y esta a 23,976 o 24. "
                                      "Convierte antes la de 25 fps (pestaña Volumen → Sincronización: framerate de 25 a 23,976) y combina la pista convertida.",
                                      f" is {(d/ref-1)*100:.1f} % longer than {nr}: {nr} seems to be 25 fps (PAL) and this one 23.976 or 24 fps. "
                                      "Convert the 25 fps one first (Volume tab → Synchronization: framerate from 25 to 23.976) and combine the converted track."))
        return out
    _COMP_TOL=4.0   # ms: hasta aqui se considera sincronizado
    def _comb_comprobar(self,grupos,dels,fin):
        """hilo: mide el desfase cada pocos minutos por toda la pelicula, ya con los delays puestos (dels: pista -> ms).
        grupos = [(archivo, pista)], el 1º es la referencia. fin(informe o None, lineas); informe = [(pista, [(t, ms o None, r)], resumen)]"""
        V=self._vt
        try:
            if not hasattr(self,"_tiempos"):self._tiempos={}
            f0={};ext=[]
            for k in grupos:
                if k not in self._tiempos:self._tiempos[k]=self._medir_tiempo(*k)
                ini,du=self._tiempos[k]
                if du is None:du=max(0.0,self._dur(k[0])-ini)
                d_=dels.get(k,0.0)/1000.0;ext.append((ini+d_,ini+d_+du))
                if k[0] not in f0:
                    q=rh([FFPROBE,"-v","error","-show_entries","format=start_time","-of","json",k[0]],timeout=15)
                    try:f0[k[0]]=float((json.loads(q.stdout or "{}").get("format") or {}).get("start_time") or 0)
                    except (ValueError,TypeError):f0[k[0]]=0.0
            lo=max(e[0] for e in ext);hi=min(e[1] for e in ext);T=hi-lo
            pal=self._comb_pal(grupos,[e[1]-e[0] for e in ext])
            if pal:return self._ui(fin,None,pal)
            if T<30:return self._ui(fin,None,[V("Las pistas coinciden muy poco tiempo para comprobarlas.","The tracks overlap for too short a time to check them.")])
            W=min(20.0,T*0.3);M=min(10.0,T*0.15)
            # un punto cada ~3 minutos (como mucho 40), repartidos de principio a fin
            n=max(3,min(40,int(T//180)+1));paso=(T-W-2*M)/(n-1)
            puntos=[lo+M+i*paso for i in range(n)]
            d0=dels.get(grupos[0],0.0);inf=[];n_=0;tot=(len(grupos)-1)*n
            for k in grupos[1:]:
                dk=dels.get(k,0.0);med=[]
                for a in puntos:
                    if self._cancelar.is_set():return self._ui(fin,None,["cancel"])
                    n_+=1;self._ui(fin,"prog",[V("Comprobando la sincronía... ","Checking the sync... ")+f"{n_}/{tot}",n_/tot])
                    # en la linea de tiempo de la salida: cada pista lleva su delay
                    ms,r=self._sinc_medir(grupos[0],k,a,W,M,f0[grupos[0][0]],f0[k[0]],dr=d0/1000.0,do=dk/1000.0)
                    ok=ms is not None and r>=0.3
                    self._ls(f"[SINC] comprobar {os.path.basename(k[0])} #{k[1]} @ {self._hms(a)}: "+(f"{ms:+.1f} ms (r={r:.2f})" if ms is not None else "?"))
                    med.append((a+W/2,ms if ok else None,r))
                inf.append((k,med,self._comp_resumen(med)))
            self._ui(fin,inf,[])
        except Exception as e:
            self._ls(f"[SINC] [ERR] {e}")
            self._ui(fin,None,[V("No se ha podido comprobar (mira Edit/Log).","Could not check (see Edit/Log).")])
    def _comp_resumen(self,med):
        """(clave, texto) a partir de los puntos [(t, ms o None, r)]: ok / fijo / deriva / salto / pocos"""
        V=self._vt;tol=self._COMP_TOL
        val=[(t,ms) for t,ms,r in med if ms is not None]
        if len(val)<max(2,len(med)//3):
            return ("pocos",V("Hay pocos sitios donde las pistas se parezcan lo bastante para medir: escucha la película para asegurarte.",
                              "There are few places where the tracks are similar enough to measure: listen to the movie to make sure."))
        vs=sorted(v for t,v in val);mediana=vs[len(vs)//2]
        if all(abs(v)<=tol for t,v in val):
            return ("ok",V("Sincronizada en toda la película","In sync throughout the movie")+f" ({len(val)} "+V("puntos medidos","points measured")+
                    ", "+V("desfase medio","average offset")+f" {mediana:+.1f} ms).")
        if all(abs(v-mediana)<=tol for t,v in val):
            return ("fijo",V("Va desfasada lo mismo en toda la película: ","It is off by the same amount throughout the movie: ")+
                    (V(f"llega {mediana:.0f} ms tarde. Quítale {mediana:.0f} ms de delay (o pulsa «🎯 Calcular delays»).",
                       f"it arrives {mediana:.0f} ms late. Take {mediana:.0f} ms off its delay (or press «🎯 Calculate delays»).") if mediana>0 else
                     V(f"llega {-mediana:.0f} ms antes. Ponle {-mediana:.0f} ms más de delay (o pulsa «🎯 Calcular delays»).",
                       f"it arrives {-mediana:.0f} ms early. Add {-mediana:.0f} ms of delay (or press «🎯 Calculate delays»).")))
        # deriva: recta por los puntos
        nn=len(val);mt=sum(t for t,v in val)/nn;mv=sum(v for t,v in val)/nn
        sxx=sum((t-mt)**2 for t,v in val) or 1.0;pend=sum((t-mt)*(v-mv) for t,v in val)/sxx
        if all(abs(v-(mv+pend*(t-mt)))<=tol for t,v in val) and abs(pend*(val[-1][0]-val[0][0]))>tol:
            ini=mv+pend*(val[0][0]-mt);fin_=mv+pend*(val[-1][0]-mt)
            return ("deriva",V("Se va desincronizando poco a poco: ","It drifts out of sync little by little: ")+f"{ini:+.0f} ms → {fin_:+.0f} ms "+
                    V(f"({pend*3600:+.0f} ms por hora). Las pistas tienen distinta velocidad: hay que corregirla (cambio de fps) antes de combinar.",
                      f"({pend*3600:+.0f} ms per hour). The tracks have a different speed: it must be fixed (fps change) before combining."))
        # saltos: el desfase cambia de golpe entre dos puntos seguidos y se queda
        sal=[]
        for i in range(1,nn):
            if abs(val[i][1]-val[i-1][1])>tol:sal.append((val[i-1][0],val[i][0],val[i][1]-val[i-1][1]))
        if len(sal)>3:
            return ("tramos",V(f"El desfase va cambiando por tramos, entre {vs[0]:+.0f} y {vs[-1]:+.0f} ms: esta pista no está sincronizada igual "
                               "en toda la película (doblaje montado por partes). Mira la lista para ver en qué minutos se nota más.",
                               f"The offset changes from part to part, between {vs[0]:+.0f} and {vs[-1]:+.0f} ms: this track is not equally in sync "
                               "throughout the movie (dub assembled in parts). See the list for the minutes where it shows the most."))
        txt=V("El desfase cambia de golpe (distinto montaje: una escena cortada o más larga en una de las pistas): ",
              "The offset jumps (different edit: a scene cut or extended in one of the tracks): ")
        return ("salto",txt+"; ".join(f"{self._hms(a)[:-4]}–{self._hms(b)[:-4]} {s:+.0f} ms" for a,b,s in sal[:6])+("…" if len(sal)>6 else "")+".")
    def _comp_ventana(self,padre,ref,res):
        """informe de «Comprobar sincronía»: minuto a minuto, cuanto va cada pista respecto a la de referencia"""
        V=self._vt;tol=self._COMP_TOL
        w=tk.Toplevel(padre);w.title(V("Comprobar sincronía","Check sync"));w.configure(bg=CF);w.transient(padre)
        f=ttk.Frame(w);f.pack(fill="both",expand=True,padx=14,pady=12)
        ttk.Label(f,text="🔍 "+V("Sincronía respecto a ","Sync against ")+f"{os.path.basename(ref[0])} #{ref[1]}",font=("",10,"bold")).pack(anchor="w")
        ttk.Label(f,text=V("Con los delays puestos. + = llega más tarde que la de referencia; − = llega antes. ",
                           "With the delays set. + = arrives later than the reference; − = arrives earlier. ")+
                 V(f"✓ hasta ±{tol:.0f} ms. «?» = en ese trozo no se parecen lo bastante (diálogos, silencio...).",
                   f"✓ up to ±{tol:.0f} ms. «?» = not similar enough in that part (dialogue, silence...)."),
                  foreground=CA,font=("",8,"italic"),wraplength=560,justify="left").pack(anchor="w",pady=(2,8))
        fam="Consolas" if sys.platform=="win32" else "Monospace"
        ft=ttk.Frame(f);ft.pack(fill="both",expand=True)
        txt=tk.Text(ft,wrap="word",font=(fam,10),bg=CDN,fg=CT,relief="flat",borderwidth=0,highlightthickness=1,highlightbackground=CSB,
                    padx=12,pady=8,width=70,height=22,cursor="arrow")
        sb=ttk.Scrollbar(ft,orient="vertical",command=txt.yview);txt.configure(yscrollcommand=sb.set)
        sb.pack(side="right",fill="y");txt.pack(side="left",fill="both",expand=True)
        txt.tag_configure("tit",font=(fam,10,"bold"),foreground=CID,spacing1=6,spacing3=4)
        txt.tag_configure("ok",foreground=CPB);txt.tag_configure("mal",foreground=CAV);txt.tag_configure("nota",foreground=CA)
        txt.tag_configure("res",font=("",9,"bold"),lmargin1=0,spacing1=6,spacing3=6)
        for k,med,(cl,res_txt) in res:
            txt.insert("end",f"{os.path.basename(k[0])} #{k[1]}\n","tit")
            for t,ms,r in med:
                if ms is None:txt.insert("end",f"  {self._hms(t)[:-4]}      ?\n","nota")
                else:txt.insert("end",f"  {self._hms(t)[:-4]}  {ms:+7.1f} ms  "+("✓" if abs(ms)<=tol else "⚠")+"\n","ok" if abs(ms)<=tol else "mal")
            txt.insert("end",("✓ " if cl=="ok" else "⚠ ")+res_txt+"\n\n",("res","ok" if cl=="ok" else "mal"))
        txt.configure(state="disabled")
        ttk.Button(f,text=V("Cerrar","Close"),command=w.destroy).pack(anchor="e",pady=(10,0))
        try:
            w.update_idletasks()
            w.geometry(f"+{padre.winfo_rootx()+40}+{padre.winfo_rooty()+40}")
        except Exception:pass
        self._comp_top=w
    # ---------- Corregir por tramos: doblajes montados por partes (en cada escena un desfase, y a veces resbalando) ----------
    # Se lee cada pista UNA vez y se guarda su «huella» (golpes cada 1 ms y nivel cada 10 ms); con eso se mide cada 5 s en un momento.
    # Cada escena es un tramo: su desfase, y si va resbalando, una recta (se corrige con un cambio de velocidad minimo).
    # Los cortes van en el momento mas silencioso. Resultado por pista: [(c0, c1, v0, v1)] en la linea de tiempo de la salida,
    # v = ms que llega tarde (con los delays que habia al medir) al principio y al final del tramo.
    _TRAMO_TOL=4.0   # ms: salto minimo entre escenas
    def _huella(self,ruta,orden,con_fc,prog=None):
        """recorre la pista entera: (golpes cada 1 ms, nivel cada 10 ms) como array('f'); indice 0 = primera muestra de la pista.
        None si se cancela. prog(fraccion)"""
        from array import array
        import math
        p_=(self.pc.get(ruta) or [])[orden]
        try:n=max(1,int(p_.get("channels") or 1))
        except (TypeError,ValueError):n=1
        noms=self._vis_nom_ent(n,p_.get("layout")) if n>1 else ["FC"]
        usa=[i for i in range(n) if con_fc or not (n>2 and self._vis_can(noms[i])=="FC")] or list(range(n))
        pan="mono|c0="+"+".join(f"{1.0/len(usa):.4f}*c{i}" for i in usa)
        du=max(1.0,self._dur(ruta))
        cmd=[FFMPEG,"-v","error","-i",ruta,"-map",f"0:a:{orden}","-af",f"pan={pan},highpass=f=300,aresample=8000","-f","s16le","-ac","1","-"]
        pr=subprocess.Popen(cmd,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,creationflags=CNW)
        e1=array("f");resto=b"";leido=0
        try:
            while True:
                if self._cancelar.is_set():
                    self._matar(pr);return None
                buf=pr.stdout.read(160000)
                if not buf:break
                buf=resto+buf;cut=len(buf)//16*16;resto=buf[cut:]
                a=array("h");a.frombytes(buf[:cut])
                e1.extend(sum(map(abs,a[i:i+8])) for i in range(0,len(a),8))
                leido+=cut
                if prog:prog(min(1.0,leido/16000.0/du))
        finally:
            try:pr.stdout.close()
            except Exception:pass
            try:pr.wait(timeout=10)
            except Exception:pass
        # golpes: subida en 4 ms de la envolvente de 4 ms (en dB); nivel cada 10 ms
        lg=array("f",[0.0])*len(e1);s4=0.0
        for i in range(len(e1)):
            s4+=e1[i]
            if i>=4:s4-=e1[i-4]
            lg[i]=math.log10(s4+4.0)
        on=array("f",[0.0])*len(e1)
        for i in range(4,len(e1)):
            d=lg[i]-lg[i-4]
            if d>0:on[i]=d
        nv=array("f",(sum(e1[i:i+10]) for i in range(0,len(e1),10)))
        return on,nv
    @staticmethod
    def _hu_corr(x,y,l0,l1):
        """r de x (media 0) con y[l:l+len(x)] para l en [l0, l1] -> {l: r}"""
        import math,operator
        n=len(x);sx=math.sqrt(sum(map(operator.mul,x,x))) or 1.0
        out={}
        for l in range(max(0,l0),min(l1,len(y)-n)+1):
            yy=y[l:l+n];sy=sum(yy);q=sum(map(operator.mul,yy,yy))-sy*sy/n
            out[l]=sum(map(operator.mul,x,yy))/(sx*math.sqrt(q)) if q>1e-12 else 0.0
        return out
    def _hu_medir(self,hr,ho,t,W,R,cand=None):
        """ms que «otra» llega tarde en la ventana [t, t+W] s de la salida (hr/ho = (golpes, desplazamiento en ms de su indice 0)),
        buscando en +-R s; cand: solo alrededor de esos valores. (ms o None)"""
        xr,br=hr;yo,bo=ho
        i0=int(round(t*1000))-br;w=int(W*1000);Rm=int(R*1000)
        j0=int(round(t*1000))-bo-Rm
        if i0<0 or i0+w>len(xr) or j0<0 or j0+w+2*Rm>len(yo):return None
        x=xr[i0:i0+w];y=yo[j0:j0+w+2*Rm]
        if cand is None:
            # grueso cada 10 ms en +-R: los 3 mejores picos (separados mas de 100 ms), que se afinan al ms
            x10=[sum(x[i:i+10]) for i in range(0,w,10)];m=sum(x10)/len(x10);x10=[v-m for v in x10]
            y10=[sum(y[i:i+10]) for i in range(0,len(y)-9,10)]
            g=self._hu_corr(x10,y10,0,2*Rm//10)
            if not g:return None
            cs=[]
            for l_,v in sorted(g.items(),key=lambda kv:-kv[1]):
                if all(abs(l_-c)>10 for c in cs):cs.append(l_)
                if len(cs)==3:break
            cs=[c*10 for c in cs]
        else:cs=[Rm+int(round(c)) for c in cand]
        m=sum(x)/w;x=[v-m for v in x];fin_=[]
        for c in cs:
            f=self._hu_corr(x,y,c-12,c+12)
            if f:l=max(f,key=f.get);fin_.append((f[l],l,f))
        if not fin_:return None
        fin_.sort(key=lambda q:-q[0])
        # el mejor pico tiene que ser claro: 1,6 veces el siguiente (musica con ritmo, dialogos...)
        if cand is None and (fin_[0][0]<=0 or (len(fin_)>1 and fin_[0][0]<1.6*max(fin_[1][0],0.0))):return None
        rf,l,f=fin_[0];d=0.0
        if l-1 in f and l+1 in f:
            den=f[l-1]-2*rf+f[l+1]
            if den<0:d=max(-0.5,min(0.5,0.5*(f[l-1]-f[l+1])/den))
        if cand is not None and rf<0.08:return None
        return l+d-Rm
    @staticmethod
    def _tramos_cambio(hr,ho,a,b,vA,vB):
        """instante (s) en que la pista pasa del desfase vA al vB, entre a y b: en cada golpe de la referencia se mira cual de los dos
        encaja; la suma acumulada de esa diferencia llega a su maximo justo en el cambio. None si no hay golpes que lo digan"""
        xr,br=hr;yo,bo=ho;va=int(round(vA));vb=int(round(vB));s=0.0;mx=0.0;tm=None;tot=0.0
        for t in range(int(a*1000),int(b*1000)):
            i=t-br;ja=t-bo+va;jb=t-bo+vb
            if i<0 or i>=len(xr) or min(ja,jb)<2 or max(ja,jb)+3>=len(yo):continue
            x=xr[i]
            if x<=0:continue
            ga=sum(yo[ja-2:ja+3]);gb=sum(yo[jb-2:jb+3])
            s+=x*(ga-gb);tot+=x*abs(ga-gb)
            if s>mx:mx=s;tm=t
        return tm/1000.0 if (tm is not None and tot>0 and mx>=0.05*tot) else None
    @staticmethod
    def _tramos_recta(pts):
        """recta por mínimos cuadrados v = a + b·(t - tm) (b en ms/s) -> (a, b, tm, error max)"""
        n=len(pts);tm=sum(t for t,v in pts)/n;vm=sum(v for t,v in pts)/n
        sxx=sum((t-tm)**2 for t,v in pts)
        b=sum((t-tm)*(v-vm) for t,v in pts)/sxx if sxx>1e-9 else 0.0
        return vm,b,tm,max(abs(v-(vm+b*(t-tm))) for t,v in pts)
    @staticmethod
    def _tramos_limpiar(vals,lim=400.0,rad=120.0):
        """quita las medidas falsas: [(t, ms o None)] -> igual, con None en las que se alejan mas de lim ms de la mediana de los
        +-rad s de alrededor. Las ventanas se solapan, asi que un pico falso sale en dos puntos seguidos y parece una escena;
        un desfase de verdad (aunque sea de segundos) dura lo bastante para mover esa mediana"""
        v=[(t,ms) for t,ms in vals if ms is not None];out=[];q=0
        if not v:return list(vals)
        tod=sorted(ms for t,ms in v);glob_=tod[len(tod)//2]
        i0=i1=0
        for t,ms in vals:
            if ms is None:out.append((t,None));continue
            while i0<len(v) and v[i0][0]<t-rad:i0+=1
            while i1<len(v) and v[i1][0]<=t+rad:i1+=1
            veci=sorted(x for _,x in v[i0:i1])
            med=veci[len(veci)//2] if len(veci)>=5 else glob_
            out.append((t,ms if abs(ms-med)<=lim else None))
        return out
    def _tramos_escenas(self,vals,tol=4.0):
        """[(t, ms o None)] cada 5 s -> escenas [[(t, ms)...]]: el desfase va seguido (puede resbalar despacio) y cambia de golpe
        entre escenas; un punto suelto distinto no abre escena"""
        v=[(t,ms) for t,ms in vals if ms is not None];esc=[];cur=[]
        for i,(t,ms) in enumerate(v):
            if cur:
                hueco=t-cur[-1][0];tl=tol+0.25*max(0.0,hueco-5.0)   # cuanto mas hueco, mas puede haber resbalado
                if abs(ms-cur[-1][1])<=tl:cur.append((t,ms));continue
                # cambio de escena si lo confirma el siguiente punto; si no, punto suelto
                if not (i+1<len(v) and abs(v[i+1][1]-ms)<=tol+0.25*max(0.0,v[i+1][0]-t-5.0)):continue
                if len(cur)>=2:esc.append(cur)
            cur=[(t,ms)]
        if len(cur)>=2:esc.append(cur)
        # una escena muy distinta de las de su lado tiene que durar (al menos 4 puntos): si no, no se le hace caso
        esc=[q for j,q in enumerate(esc) if len(q)>=4 or not ((j>0 and abs(q[0][1]-esc[j-1][-1][1])>300) or (j+1<len(esc) and abs(q[-1][1]-esc[j+1][0][1])>300))]
        # escenas seguidas con el mismo desfase (un hueco de dialogos en medio): una sola
        out=[]
        for q in esc:
            if out and abs(out[-1][-1][1]-q[0][1])<=tol:out[-1]=out[-1]+q
            else:out.append(q)
        return out
    def _tramos_modelo(self,pts,prof=0):
        """partes rectas de una escena: [(t_ini, t_fin, a, b, tm)]; si no cabe en una recta (+-3 ms), se parte donde mejor queda"""
        a,b,tm,err=self._tramos_recta(pts)
        if abs(b)<0.02:   # menos de 20 ppm: sin resbalon
            vs=sorted(v for t,v in pts);a=vs[len(vs)//2];b=0.0;err=max(abs(v-a) for t,v in pts)
        if err<=3.0 or len(pts)<8 or prof>=4:return [(pts[0][0],pts[-1][0],a,b,tm)]
        mejor=None
        for i in range(4,len(pts)-3):
            e=max(self._tramos_recta(pts[:i])[3],self._tramos_recta(pts[i:])[3])
            if mejor is None or e<mejor[0]:mejor=(e,i)
        i=mejor[1]
        return self._tramos_modelo(pts[:i],prof+1)+self._tramos_modelo(pts[i:],prof+1)
    @staticmethod
    def _tramos_silencio(nv,bo,a,b):
        """instante (s, salida) con menos nivel (100 ms) de la pista entre a y b; nv = nivel cada 10 ms, bo = desplazamiento en ms"""
        i0=max(0,int((a*1000-bo)/10));i1=min(len(nv)-10,int((b*1000-bo)/10))
        if i1<=i0:return (a+b)/2
        s=sum(nv[i0:i0+10]);mejor=(s,i0)
        for i in range(i0+1,i1):
            s+=nv[i+9]-nv[i-1]
            if s<mejor[0]:mejor=(s,i)
        return (mejor[1]*10+50+bo)/1000.0
    def _comb_tramos(self,grupos,dels,fin):
        """hilo: para cada pista que no es la referencia: huella de las dos, desfase cada 5 s, escenas, donde cambia cada una (a la
        decima de segundo) y corte en el momento mas silencioso. fin(resultado o None, lineas); resultado = {pista: [(c0, c1, v0, v1)]}"""
        V=self._vt;tol=self._TRAMO_TOL
        try:
            if not hasattr(self,"_tiempos"):self._tiempos={}
            ext={};bases={}
            for k in grupos:
                if k not in self._tiempos:self._tiempos[k]=self._medir_tiempo(*k)
                ini,du=self._tiempos[k]
                if du is None:du=max(0.0,self._dur(k[0])-ini)
                d_=dels.get(k,0.0)/1000.0;ext[k]=(ini+d_,ini+d_+du)
                bases[k]=int(round((ini+d_)*1000))   # ms de la salida donde cae la primera muestra de la pista
            lo=max(e[0] for e in ext.values());hi=min(e[1] for e in ext.values());T=hi-lo
            pal=self._comb_pal(grupos,[ext[k][1]-ext[k][0] for k in grupos])
            if pal:return self._ui(fin,None,pal)
            if T<60:return self._ui(fin,None,[V("Las pistas coinciden muy poco tiempo para partirlas en tramos.","The tracks overlap for too short a time to split them into parts.")])
            ref=grupos[0];nt=len(grupos)
            def pr_(fr,txt):self._ui(fin,"prog",[txt,fr])
            V1=V("Leyendo ","Reading ")
            hr=self._huella(ref[0],ref[1],False,lambda f:pr_(0.3*f/nt,V1+os.path.basename(ref[0])+f"... {int(f*100)} %"))
            if hr is None:return self._ui(fin,None,["cancel"])
            res={};inf=[];W=10.0;R=3.0;paso=5.0
            for g,k in enumerate(grupos[1:]):
                f_a=0.3*(g+1)/nt
                ho=self._huella(k[0],k[1],True,lambda f:pr_(f_a+0.3*f/nt,V1+os.path.basename(k[0])+f"... {int(f*100)} %"))
                if ho is None:return self._ui(fin,None,["cancel"])
                HR=(hr[0],bases[ref]);HO=(ho[0],bases[k])
                vals=[];t=lo+R
                puntos=[];
                while t<=hi-W-R:puntos.append(t);t+=paso
                for i,t in enumerate(puntos):
                    if self._cancelar.is_set():return self._ui(fin,None,["cancel"])
                    if i%20==0:pr_(0.6+0.3*(g+i/len(puntos))/(nt-1),V("Midiendo el desfase cada 5 s... ","Measuring the offset every 5 s... ")+f"{self._hms(t)[:-4]}")
                    vals.append((t+W/2,self._hu_medir(HR,HO,t,W,R)))
                nom=f"{os.path.basename(k[0])} #{k[1]}"
                n0=sum(1 for t,v in vals if v is not None)
                vals=self._tramos_limpiar(vals)
                esc=self._tramos_escenas(vals,tol)
                self._ls(f"[TRAMOS] {nom}: {sum(1 for t,v in vals if v is not None)}/{len(vals)} "+V("puntos medidos","points measured")+
                         f" ({n0-sum(1 for t,v in vals if v is not None)} "+V("falsos descartados","false ones discarded")+f"), {len(esc)} "+V("escenas","scenes"))
                if not esc:
                    inf.append("⚠ "+nom+": "+V("no se parece lo bastante a la de referencia para medirla.","not similar enough to the reference track to measure it."));continue
                # partes rectas de cada escena
                partes=[]
                for q in esc:partes.append(self._tramos_modelo(q))
                # donde cambia de una escena a la siguiente: se afina con ventanas de 3 s eligiendo entre los dos desfases
                def val(p,t):
                    t0,t1,a,b,tm=p;return a+b*(min(max(t,t0),t1)-tm)
                cortes=[]
                for j in range(len(esc)-1):
                    if self._cancelar.is_set():return self._ui(fin,None,["cancel"])
                    pA=partes[j][-1];pB=partes[j+1][0];l_=esc[j][-1][0];h_=esc[j+1][0][0]
                    while h_-l_>0.3:   # a la decima: el corte tiene que caer donde cambia de verdad, o la voz se va de los labios esos segundos
                        mid=(l_+h_)/2;vA=val(pA,mid);vB=val(pB,mid)
                        ms=self._hu_medir(HR,HO,mid-1.5,3.0,max(R,abs(vA)/1000+0.5,abs(vB)/1000+0.5),cand=[vA,vB])
                        if ms is None:break
                        if abs(ms-vA)<abs(ms-vB):l_=mid
                        else:h_=mid
                    # golpe a golpe, el cambio exacto; el corte va pegado a el (+-0,1 s). Sin golpes (solo dialogos): lo mas silencioso de la zona
                    a_=max(l_-3.0,(l_+h_)/2-90.0);b_=min(h_+3.0,(l_+h_)/2+90.0)
                    c_=self._tramos_cambio(HR,HO,a_,b_,val(pA,l_),val(pB,h_))
                    cortes.append(self._tramos_silencio(ho[1],bases[k],c_-0.1,c_+0.1) if c_ is not None else self._tramos_silencio(ho[1],bases[k],l_-1.0,h_+1.0))
                # tramos: entre cortes; dentro de cada escena, sus partes rectas (las uniones tambien en silencios, +-3 s)
                tl=[];ini_=0.0
                for j,ps in enumerate(partes):
                    fin_=cortes[j] if j<len(cortes) else hi+1.0
                    lim=[ini_]
                    for p,p2 in zip(ps,ps[1:]):
                        u=(p[1]+p2[0])/2;lim.append(min(fin_-0.1,max(lim[-1]+0.5,self._tramos_silencio(ho[1],bases[k],u-3,u+3))))
                    lim.append(fin_)
                    for i,p in enumerate(ps):
                        c0,c1=lim[i],lim[i+1]
                        if c1-c0<0.05:continue
                        v0,v1=val(p,c0),val(p,c1)
                        if abs(v1-v0)<0.5:v0=v1=float(round((v0+v1)/2))   # sin resbalon: al ms, como un delay normal
                        tl.append((c0,c1,v0,v1))
                    ini_=fin_
                res[k]=tl
                self._ls(f"[TRAMOS] {nom} → "+" · ".join(f"{self._hms(c0)[:-4]} {v0:+.0f}"+(f"→{v1:+.0f}" if abs(v1-v0)>=0.5 else "")
                                                       for c0,c1,v0,v1 in tl))
            pr_(1.0,"")
            self._ui(fin,res,inf)
        except Exception as e:
            self._ls(f"[TRAMOS] [ERR] {e}")
            self._ui(fin,None,[V("No se ha podido calcular (mira Edit/Log).","Could not calculate (see Edit/Log).")])
    def _tramos_ventana(self,padre,res,dels,al_aplicar=None):
        """lista de tramos de cada pista: desde cuando y con que delay"""
        V=self._vt
        w=tk.Toplevel(padre);w.title(V("Corregir por tramos","Fix by parts"));w.configure(bg=CF);w.transient(padre)
        f=ttk.Frame(w);f.pack(fill="both",expand=True,padx=14,pady=12)
        ttk.Label(f,text="✂ "+V("Tramos encontrados","Parts found"),font=("",10,"bold")).pack(anchor="w")
        ttk.Label(f,text=V("Cada tramo empieza en el momento más silencioso de la zona donde cambia el desfase y lleva su propio delay. "
                           "Con «→» la pista va resbalando dentro del tramo: el delay pasa poco a poco de un valor al otro (un cambio de velocidad "
                           "mínimo, sin cambio de tono apreciable). "+(al_aplicar[0] if al_aplicar else "Se aplica al combinar (casilla «Aplicar la corrección por tramos»)."),
                           "Each part starts at the quietest moment of the area where the offset changes and has its own delay. "
                           "With «→» the track drifts within the part: the delay goes little by little from one value to the other (a tiny "
                           "speed change, with no noticeable pitch change). "+(al_aplicar[1] if al_aplicar else "It is applied when combining («Apply the fix by parts» box).")),
                  foreground=CA,font=("",8,"italic"),wraplength=520,justify="left").pack(anchor="w",pady=(2,8))
        fam="Consolas" if sys.platform=="win32" else "Monospace"
        ft=ttk.Frame(f);ft.pack(fill="both",expand=True)
        txt=tk.Text(ft,wrap="word",font=(fam,10),bg=CDN,fg=CT,relief="flat",borderwidth=0,highlightthickness=1,highlightbackground=CSB,
                    padx=12,pady=8,width=60,height=18,cursor="arrow")
        sb=ttk.Scrollbar(ft,orient="vertical",command=txt.yview);txt.configure(yscrollcommand=sb.set)
        sb.pack(side="right",fill="y");txt.pack(side="left",fill="both",expand=True)
        txt.tag_configure("tit",font=(fam,10,"bold"),foreground=CID,spacing1=6,spacing3=4)
        txt.tag_configure("nota",foreground=CA)
