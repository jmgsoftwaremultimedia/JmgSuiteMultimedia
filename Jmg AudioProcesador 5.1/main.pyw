            lm=self._ln(a,p,cfg["loudnorm_target"],cfg=cfg)
            self._ls("    "+self._vt("Loudnorm: se usa la medida guardada (%.1f LUFS)","Loudnorm: using the saved measurement (%.1f LUFS)")%float(lm["input_i"]))
            self._fase[a]=self._vt("normalizando","normalizing")
            need_analysis=False
        elif need_analysis:
            self._ls("    "+T("analizando_ln"))
            self._fase[a]=self._vt("midiendo volumen (paso 1 de 2)","measuring loudness (step 1 of 2)")
            if cb:cb(0.01)
            def cb_an(t,dur=dur):
                if cb and dur>0:cb(min(dur,t)*0.5)
            lm=self._ln(a,p,cfg["loudnorm_target"],cb=cb_an,cfg=cfg)
            if lm is None:self._ls("    "+T("ln_fallo"))
