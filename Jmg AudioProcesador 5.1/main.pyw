            self.cv_vis.yview_scroll(int(-d),"units")
        except Exception:pass
    def _vis_espacio(self,e):
        """barra espaciadora en Visualizacion: empieza y para. Se para donde va y sigue desde ahi. En el editor, con un trozo marcado, escucha ese trozo"""
        try:
            if self.nb.select()!=str(self._vis_outer) or e.widget.winfo_toplevel() is not self.root:return None
            if e.widget.winfo_class() in ("Entry","TEntry","Text","TCombobox","TScale","TButton","TCheckbutton","TRadiobutton"):return None
        except Exception:return None
        if self._vis_play:self._vis_pausa()
        elif self._ed_activo() and self._ed_sel:self._ed_oir()
        else:
            cual=getattr(self,"_vis_ult",None)
            if not (cual and self._vis_puede(cual)):cual="antes" if (self._ed_activo() and not self._ed_oye("despues")) else "despues"
            if cual in self._vis_aud or self._ed_oye(cual):self._vis_iniciar(cual,self._vis_pos)
        return "break"
    def _vis_flecha(self,e,sen):
        """flechas izquierda y derecha: mueven la onda poco a poco (con Mayús, de 1/4 en 1/4 de lo que se ve). Hace falta zoom"""
        try:
            if self.nb.select()!=str(self._vis_outer) or not self._vis_geom or self._vz<=1.0:return None
            if e.widget.winfo_class() in ("Entry","TEntry","Text","TCombobox","TScale") or e.widget.winfo_toplevel() is not self.root:return None
        except Exception:return None
        dur=self._vis_geom[2];w=dur/self._vz
        self._vv0=max(0.0,min(dur-w,self._vis_rango()[0]+sen*w*(0.25 if e.state&1 else 0.02)))
        self._vis_dibujar();return "break"
    def _vis_zona(self,e):
        """editando, la regla del tiempo, la banda de arriba y los nombres de los canales son para mover la onda con la manita"""
        L_=getattr(self,"_vis_lanes",[]);g=self._vis_geom
        return bool(L_ and g and (self.cv_vis.canvasy(e.y)<L_[0][0] or self.cv_vis.canvasx(e.x)<g[0]))
    def _vis_xview(self,*a):
        """barra de abajo del editor"""
        if not self._vis_geom:return
        v0,v1,dur=self._vis_rango();w=v1-v0
        n=float(a[1])*dur if a[0]=="moveto" else v0+int(a[1])*(w if a[2]=="pages" else w*0.02)
        self._vv0=max(0.0,min(dur-w,n));self._vis_dibujar()
    def _vis_d3(self,e):
        self._vpan=(e.x,self._vis_rango()[0],False)
    def _vis_u3(self,e):
        """boton derecho: arrastrar mueve la onda; un clic quita la seleccion del editor"""
        p=self._vpan;self._vpan=None;self._vis_puntero(e)
        if p and not p[2] and self._ed_activo():self._ed_quita()
    def _vis_down(self,e):
        try:self.cv_vis.focus_set()   # las flechas mueven la onda
        except Exception:pass
        # editando, arrastrar marca un tramo; con Mayús se desplaza la vista
        if self._ed_activo() and not (e.state&1) and not self._vis_zona(e):
            self._cfgw(self.cv_vis,cursor="sb_h_double_arrow" if self._ed_borde(e) else "crosshair")
            self._ed_down(e);return
        self._vpan=(e.x,self._vis_rango()[0],False)
    def _vis_puntero(self,e=None):
        """manita donde arrastrar desplaza la onda. El puntero preciso del editor solo sale con el boton izquierdo pulsado; sobre un borde de la seleccion, las dos flechas"""
        if e and not self._ed_ar and self._ed_borde(e):
            self._cfgw(self.cv_vis,cursor="sb_h_double_arrow");return
        self._cfgw(self.cv_vis,cursor="hand2" if (self._vz>1.0 and (not self._ed_activo() or (e and (e.state&1 or self._vis_zona(e))))) else "")
    def _vis_mueve(self,e):
        if self._ed_ar:
            self._ed_mueve(e);return
        p=self._vpan;g=self._vis_geom
        if not p or not g or self._vz<=1.0:return
        x0,v0,mv=p
        if not mv and abs(e.x-x0)<4:return
        self._vpan=(x0,v0,True);self._cfgw(self.cv_vis,cursor="hand2")
        ancho,dur=g[1],g[2]
        w=dur/self._vz
        self._vv0=max(0.0,min(dur-w,v0-(e.x-x0)/float(ancho)*w))
        self._vis_dibujar()
    def _vis_up(self,e):
        if self._ed_ar:
            self._ed_up(e);self._vis_puntero(e);return
        p=self._vpan;self._vpan=None;self._vis_puntero(e)
        if p and p[2]:return
        self._vis_clic(e)

    def _vis_cfg(self,e=None):
        try:
            if self._vis_redraw_id:self.root.after_cancel(self._vis_redraw_id)
        except Exception:pass
        self._vis_redraw_id=self.root.after(120,self._vis_dibujar)

    def _vis_matar(self):
        for pr in (self._vis_proc,getattr(self,"_vis_proc2",None)):
            if pr is not None and pr.poll() is None:
                try:pr.kill()
                except Exception:pass

    def _vis_cancelar(self):
        self._vis_sig=None
        self._vis_gen+=1
        self._vis_matar()
        self._vis_run=False
        try:
            self.btn_vis.configure(state="normal");self.btn_vis_c.configure(state="disabled")
            self.prog_vis["value"]=0
            self.var_vis_estado.set(self._vt("Cancelado.","Cancelled."))
        except Exception:pass

    def _vis_prog(self,v):
        try:self.prog_vis["value"]=v
        except Exception:pass

    def _vis_est(self,m):
        try:self.var_vis_estado.set(m)
        except Exception:pass

    # ---------- reproduccion (MCI de Windows, sin dependencias) ----------
    def _mci(self,cmd):
        import ctypes
        try:
            wm=ctypes.windll.winmm
        except AttributeError:
            raise RuntimeError(self._vt("La reproducción solo está disponible en Windows.","Playback is only available on Windows."))
        buf=ctypes.create_unicode_buffer(256)
        err=wm.mciSendStringW(cmd,buf,255,0)
        if err:
            eb=ctypes.create_unicode_buffer(256)
            wm.mciGetErrorStringW(err,eb,255)
            raise RuntimeError("MCI: "+(eb.value or str(err)))
        return buf.value

    def _vis_lim(self):
        d=self._vis_data
        return float(d.get("lim",0)) if d else 0.0

    def _vis_posicion_actual(self):
        if self._vis_play:
            return min(self._vis_lim(),self._vis_pos0+(time.time()-self._vis_t0))
        return self._vis_pos

    def _vis_botones(self):
        try:
            hay=bool(self._vis_aud)
            ea="normal" if ("antes" in self._vis_aud) else "disabled"
            ed="normal" if ("despues" in self._vis_aud) else "disabled"
            cc=self._ed_oye("despues")   # con cambios del editor sin guardar
            self.btn_vis_pa.configure(state=ea,text=("❚❚ " if self._vis_play=="antes" else "▶ ")+(self._vt("Escuchar SIN CAMBIOS","Play WITHOUT CHANGES") if cc else self._vt("Escuchar ANTES","Play BEFORE")))
            self.btn_vis_pd.configure(state=ed,text=("❚❚ " if self._vis_play=="despues" else "▶ ")+(self._vt("Escuchar CON CAMBIOS","Play WITH CHANGES") if cc else self._vt("Escuchar DESPUÉS","Play AFTER")))
            self.btn_vis_st.configure(state="normal" if hay else "disabled")
            ult=getattr(self,"_vis_ult",None)
            if self._vis_play:
                self.btn_vis_pz.configure(state="normal",text="❚❚ "+self._vt("Pausa","Pause"))
            elif ult and self._vis_puede(ult) and self._vis_pos>0:
                self.btn_vis_pz.configure(state="normal",text="▶ "+self._vt("Continuar","Resume"))
            else:
                self.btn_vis_pz.configure(state="disabled",text="❚❚ "+self._vt("Pausa","Pause"))
            if not hay:self.var_vis_tiempo.set("")
        except Exception:pass

    def _vis_cursor(self,pos):
        try:
            cv=self.cv_vis;g=self._vis_geom
            cv.delete("cursor")
            if not g or not self._vis_aud:return
            ML,ancho,dur,alto=g
            v0,v1,_d=self._vis_rango()
            fr=(pos-v0)/max(1e-9,(v1-v0))
            if 0.0<=fr<=1.0:
                x=ML+fr*ancho
                cv.create_line(x,0,x,alto,fill="#ff5252",width=2,tags="cursor")
            q=self._vt("ANTES","BEFORE") if self._vis_play=="antes" else (self._vt("DESPUÉS","AFTER") if self._vis_play=="despues" else ("SOLO "+getattr(self,"_vis_solo_nom","") if self._vis_play=="solo" else ""))
            self.var_vis_tiempo.set("%s / %s  %s"%(self._hms(pos),self._hms(self._vis_lim()),q))
        except Exception:pass

    def _vis_parar_tick(self):
        try:
            if self._vis_tick_id:self.root.after_cancel(self._vis_tick_id)
        except Exception:pass
        self._vis_tick_id=None

    def _vis_stop_mci(self):
        m=getattr(self,"_vis_mc",None)
        if m is not None:
            self._vis_mc=None
            try:m.stop()
            except Exception:pass
        for al in list(self._vis_aud.values()):
            try:self._mci("stop %s"%al)
            except Exception:pass

    def _vis_puede(self,cual):
        """se puede (re)anudar esta escucha: estereo con su audio abierto, o canal solo en multicanal"""
        if cual in self._vis_aud or self._ed_oye(cual):return True
        return cual=="solo" and self._vis_es_mc() and bool(getattr(self,"_vis_solo_sel",None))
    def _vis_es_mc(self):
        return getattr(self,"var_vis_sal",None) is not None and self.var_vis_sal.get()=="mc"
    def _vis_sal_cambio(self,e=None):
        mc=(self.cmb_vis_sal.current()==1)
        self.var_vis_sal.set("mc" if mc else "est")
        try:self._cmb_sin_foco(e)
        except Exception:pass
        try:self._save_cfg()
        except Exception:pass
        # si estaba sonando, sigue desde el mismo punto con la nueva salida
        if self._vis_play:
            cual=self._vis_play;pos=self._vis_posicion_actual()
            self._vis_stop_mci()
            sel=getattr(self,"_vis_solo_sel",None)
            if cual=="solo" and sel and not mc:
                # canal solo al pasar a estereo: hay que preparar su WAV mono (en multicanal no hacia falta)
                self._vis_play=None;self._vis_aud.pop("solo",None)
                self._vis_solo(sel[0],sel[1],getattr(self,"_vis_solo_nom","").split(" · ")[0],pos)
            else:
                self._vis_iniciar(cual,pos)
    def _vis_mc_iniciar(self,cual,pos):
        """multicanal: antes/despues con todos sus canales; canal solo por su propio altavoz"""
        d=self._vis_data or {}
        if cual=="solo":
            sel=getattr(self,"_vis_solo_sel",None)
            if not sel:return False
            tipo,ich=sel
        else:
            tipo,ich=cual,None
        src=d.get(tipo+"6")
        if not src or not os.path.exists(src):return False
        nch=len(d.get(tipo) or []) or 6
        if pos>=self._vis_lim()-0.3:pos=0.0
        self._vis_stop_mci()
        try:self._vis_mc=_ReproMC(src,pos,nch,ich) if sys.platform=="win32" else _ReproFF(src,pos,nch,ich)
        except Exception as e:
            self._vis_play=None
            self._vis_est(self._vt("No se pudo reproducir en multicanal: ","Could not play multichannel: ")+str(e))
            self._vis_botones();return True
        self._vis_play=cual;self._vis_ult=cual;self._vis_pos0=pos;self._vis_t0=time.time();self._vis_pos=pos
        self._vis_botones();self._vis_tick()
        m=self._vis_mc;self.root.after(1200,lambda:self._vis_mc_chk(m,0))
        return True
    def _vis_mc_chk(self,m=None,n=0):
        """si Windows no acepta el formato o la salida sigue ocupada, se avisa (y queda en Edit/Log).
        Se mira a 1,2 s y otra vez a 2,7 s: la apertura se reintenta hasta 2 s."""
        if m is None:m=getattr(self,"_vis_mc",None)
        if m is None or m is not getattr(self,"_vis_mc",None):return   # ya se pulso otra cosa
        if m.err:
            _ay=(self._vt(" · Revisa en Windows: Sonido → tu salida → Configurar (5.1 / 7.1), o usa Estéreo."," · Check Windows: Sound → your output → Configure (5.1 / 7.1), or use Stereo.") if sys.platform=="win32"
                 else self._vt(" · Revisa la configuración de sonido (perfil 5.1 / 7.1), o usa Estéreo."," · Check your sound settings (5.1 / 7.1 profile), or use Stereo."))
            self._vis_est(self._vt("Multicanal no disponible: ","Multichannel not available: ")+m.err+_ay)
            self._log("[VIS] "+self._vt("Escucha multicanal: ","Multichannel playback: ")+str(m.err))
            self._vis_parar_tick();self._vis_play=None;self._vis_botones()
        elif n==0:
            self.root.after(1500,lambda:self._vis_mc_chk(m,1))
    def _vis_iniciar(self,cual,pos):
        if self._ed_oye(cual) and self._ed_play(cual,pos):return
        if self._vis_es_mc() and self._vis_mc_iniciar(cual,pos):return
        al=self._vis_aud.get(cual)
        if not al:   # nunca en silencio sin decir nada
            self._vis_est(self._vt("La escucha no está lista: genera de nuevo la visualización.","Playback is not ready: generate the visualization again."))
            self._log(f"[VIS] sin audio de escucha para «{cual}» (multicanal={self._vis_es_mc()})");return
        if sys.platform!="win32":     # Linux/macOS: estereo con ffplay (los WAV de escucha ya son estereo / mono)
            if cual!="solo" and getattr(self,"_vis_solo_sel",None):
                self._vis_solo_sel=None;self.root.after_idle(self._vis_dibujar)
            if pos>=self._vis_lim()-0.3:pos=0.0
            self._vis_stop_mci()
            self._vis_mc=_ReproFF(al,pos)
            if self._vis_mc.err:
                self._vis_play=None;self._vis_est(self._vt("No se pudo reproducir: ","Could not play: ")+self._vis_mc.err);self._vis_botones();return
            self._vis_play=cual;self._vis_ult=cual;self._vis_pos0=pos;self._vis_t0=time.time();self._vis_pos=pos
            self._vis_botones();self._vis_tick();self.root.after(1200,self._vis_mc_chk);return
        if cual!="solo" and getattr(self,"_vis_solo_sel",None):
            self._vis_solo_sel=None;self.root.after_idle(self._vis_dibujar)
        if pos>=self._vis_lim()-0.3:pos=0.0
        self._vis_stop_mci()
        try:
            self._mci("play %s from %d"%(al,int(pos*1000)))
        except Exception as e:
            self._vis_play=None
            self._vis_est(self._vt("No se pudo reproducir: ","Could not play: ")+str(e))
            self._vis_botones();return
        self._vis_play=cual;self._vis_ult=cual;self._vis_pos0=pos;self._vis_t0=time.time();self._vis_pos=pos
        self._vis_botones();self._vis_tick()

    def _vis_sigue(self,pos):
        """con zoom, la onda avanza mientras suena, con el cursor en el centro; si queda lejos, lo alcanza poco a poco. Si la estas moviendo tu, manda el raton"""
        g=self._vis_geom
        if self._vz<=1.0 or not g or self._vpan or self._ed_ar:return
        v0,v1,dur=self._vis_rango();w=v1-v0
        ob=max(0.0,min(dur-w,pos-0.5*w));n=ob if abs(ob-v0)>w else v0+(ob-v0)*0.35
        if abs(n-v0)/w*g[1]>=2.0:   # menos de 2 pixeles no se ve: no se redibuja
            self._vv0=n;self._vis_dibujar()
    def _vis_tick(self):
        self._vis_parar_tick()
        if not self._vis_play:return
        pos=self._vis_posicion_actual();oir=self._vis_play=="oir"
        if pos>=(self._ed_fin if oir else self._vis_lim()-0.05):
            self._vis_stop_mci();self._vis_play=None;self._vis_pos=self._ed_ini if oir else 0.0
            self._vis_botones();self._vis_cursor(self._vis_pos);return
        self._vis_pos=pos
        self._vis_sigue(pos)
        self._vis_cursor(pos)
        self._vis_tick_id=self.root.after(60,self._vis_tick)

    def _vis_play_ab(self,cual):
        if cual not in self._vis_aud:return
        if self._vis_play==cual:
            self._vis_pausa();return
        self._vis_iniciar(cual,self._vis_posicion_actual())

    def _vis_modo_txt(self,na=None,nd=None):
        """Texto del desplegable Vista con los canales REALES (p. ej. 2 + 2, 6 + 2)"""
        try:
            i=self.cmb_vis_modo.current()
            t=self._vt("Antes / Después","Before / After")
            if na and nd:t+=" (%d + %d)"%(na,nd)
            self.cmb_vis_modo.configure(values=[t,self._vt("Canal por canal","Channel by channel")])
            self.cmb_vis_modo.current(max(0,i))
        except Exception:pass
    def _vis_pausa_btn(self):
        if self._vis_play:self._vis_pausa();return
        ult=getattr(self,"_vis_ult",None)
        if ult and self._vis_puede(ult):self._vis_iniciar(ult,self._vis_pos)
    def _vis_pausa(self):
        pos=self._vis_posicion_actual()
        self._vis_parar_tick();self._vis_stop_mci()
        self._vis_play=None;self._vis_pos=pos
        self._vis_botones();self._vis_cursor(pos)

    def _vis_parar(self):
        if getattr(self,"_vis_solo_sel",None):
            self._vis_solo_sel=None;self.root.after_idle(self._vis_dibujar)
        self._vis_parar_tick();self._vis_stop_mci()
        try:p0=float(self._ed_sel[0]) if (self._ed_sel and self._ed_activo()) else 0.0   # con un trozo marcado, al principio de lo marcado
        except Exception:p0=0.0
        self._vis_play=None;self._vis_pos=p0;self._vis_ult=None
        self._vis_botones();self._vis_cursor(p0)

    def _vis_clic(self,e):
        g=self._vis_geom
        if not g or not self._vis_aud:return
        ML,ancho,dur,alto=g
        x=self.cv_vis.canvasx(e.x)
        if x<ML or x>ML+ancho:return
        v0,v1,_d=self._vis_rango()
        t=max(0.0,min(self._vis_lim(),v0+(x-ML)/float(ancho)*(v1-v0)))
        yc=self.cv_vis.canvasy(e.y)
        for (ya,yb,tipo,ich,nm) in getattr(self,"_vis_lanes",[]):
            if ya<=yc<yb:
                if getattr(self,"_vis_solo_sel",None)==(tipo,ich):
                    # segundo clic en el mismo canal: se deselecciona y vuelven a sonar todos los canales
                    sonaba=(self._vis_play=="solo")
                    pos=self._vis_posicion_actual()
                    self._vis_solo_sel=None
                    if sonaba and tipo in self._vis_aud:self._vis_iniciar("despues" if self._ed_oye("despues") else tipo,pos)
                    elif sonaba:self._vis_pausa()
                    self._vis_dibujar()
                    return
                self._vis_solo(tipo,ich,nm,t);return
        if self._vis_play:self._vis_iniciar(self._vis_play,t)
        else:
            self._vis_pos=t;self._vis_cursor(t)

    def _vis_solo_wav(self,src,tipo,ich):
        """WAV mono de un canal. Se escribe con otro nombre y se renombra al terminar:
        nunca se reproduce un archivo a medio escribir."""
        tmp=self._vis_tmp
        out=os.path.join(tmp,"solo_%s_%d.wav"%(tipo,ich))
        if not hasattr(self,"_vis_slock"):self._vis_slock=threading.Lock()
        with self._vis_slock:
            if os.path.exists(out):return out
            part=out[:-4]+".part.wav"
            kw={"stdout":subprocess.DEVNULL,"stderr":subprocess.DEVNULL}
            if sys.platform=="win32":kw["creationflags"]=CNW
            try:
                self._vis_proc2=subprocess.Popen([FFMPEG,"-hide_banner","-loglevel","error","-y","-i",src,"-af","pan=mono|c0=c%d"%ich,"-c:a","pcm_s16le",part],**kw)
                if self._vis_proc2.wait()!=0:return None
                os.replace(part,out);return out
            except Exception:return None
    def _vis_solo_pre(self,gid):
        """prepara en segundo plano todos los canales sueltos (clic instantaneo despues)"""
        d=self._vis_data or {}
        def tarea():
            for tipo in ("despues","antes"):
                src=d.get(tipo+"6")
                n=len(d.get(tipo) or [])
                for ich in range(n):
                    if gid!=self._vis_gen or not self._vis_tmp:return
                    if src and os.path.exists(src):self._vis_solo_wav(src,tipo,ich)
        threading.Thread(target=tarea,daemon=True).start()
    def _vis_solo(self,tipo,ich,nm,t):
        """Escuchar un solo canal (de ANTES o de DESPUES) desde el punto t"""
        d=self._vis_data or {}
        if self._vis_es_mc() or self._ed_oye("solo"):
            self._vis_solo_tok=getattr(self,"_vis_solo_tok",0)+1
            self._vis_solo_nom="%s · %s"%(nm,self._vt("ANTES","BEFORE") if tipo=="antes" else self._vt("DESPUÉS","AFTER"))
            self._vis_solo_sel=(tipo,ich)
            self._vis_iniciar("solo",t);self._vis_dibujar();return
        src=d.get(tipo+"6");tmp=self._vis_tmp
        if not src or not tmp or not os.path.exists(src):
            self._vis_pos=t;self._vis_cursor(t);return
        self._vis_pos=t;self._vis_cursor(t)
        gid=self._vis_gen
        self._vis_solo_tok=getattr(self,"_vis_solo_tok",0)+1;tok=self._vis_solo_tok
        def tarea():
            out=self._vis_solo_wav(src,tipo,ich)
            if gid==self._vis_gen and tok==self._vis_solo_tok:
                self._ui(self._vis_solo_play,tipo,nm,out,t,ich,tok)
        threading.Thread(target=tarea,daemon=True).start()
    def _vis_marco(self,cv,ML,y,ancho,LH):
        """carril que se esta escuchando en solitario: marco y etiqueta naranja"""
        cv.create_rectangle(ML+1,y+1,ML+ancho-1,y+LH-1,outline="#2ee86b",width=3)
        cv.create_text(ML+ancho-8,y+10,anchor="e",text="♪ SOLO",fill="#2ee86b",font=("",9,"bold"))
    def _vis_solo_play(self,tipo,nm,out,t,ich=None,tok=None):
        if tok is not None and tok!=getattr(self,"_vis_solo_tok",0):return   # ya se pulso otro canal
        if not out:
            self._vis_est(self._vt("No se pudo preparar el canal.","Could not prepare the channel."));return
        if sys.platform!="win32":
            self._vis_aud["solo"]=out
            self._vis_solo_nom="%s · %s"%(nm,self._vt("ANTES","BEFORE") if tipo=="antes" else self._vt("DESPUÉS","AFTER"))
            self._vis_solo_sel=(tipo,ich) if ich is not None else getattr(self,"_vis_solo_pend",None)
            self._vis_iniciar("solo",t);self._vis_dibujar();return
        try:
            if "solo" in self._vis_aud:
                try:self._mci("stop apmS")
                except Exception:pass
                try:self._mci("close apmS")
                except Exception:pass
                self._vis_aud.pop("solo",None)
            self._mci('open "%s" type waveaudio alias apmS'%out)
            self._vis_aud["solo"]="apmS"
        except Exception as e:
            self._vis_est(self._vt("No se pudo reproducir: ","Could not play: ")+str(e));return
        self._vis_solo_nom="%s · %s"%(nm,self._vt("ANTES","BEFORE") if tipo=="antes" else self._vt("DESPUÉS","AFTER"))
        self._vis_solo_sel=(tipo,ich) if ich is not None else getattr(self,"_vis_solo_pend",None)
        self._vis_iniciar("solo",t)
        self._vis_dibujar()
    def _vis_audio_abrir(self,res):
        self._vis_aud={}
        if sys.platform!="win32":     # Linux/macOS: se reproduce con ffplay directamente desde el archivo
            for k in ("antes","despues"):
                p=res.get(k+"_wav")
                if p and os.path.exists(p):self._vis_aud[k]=p
            if not os.path.isfile(FFPLAY) and not __import__("shutil").which(FFPLAY):
                raise RuntimeError(self._vt("falta ffplay (paquete ffmpeg)","ffplay missing (ffmpeg package)"))
            return
        try:
            import ctypes
            ctypes.windll.winmm.waveOutSetVolume(None,0xFFFFFFFF)   # al 100 %, como la escucha multicanal
        except Exception:pass
        for k,al in (("antes","apmA"),("despues","apmD")):
            p=res.get(k+"_wav")
            if p and os.path.exists(p):
                self._mci('open "%s" type waveaudio alias %s'%(p,al))
                self._vis_aud[k]=al

    def _vis_chk_files(self):
        """si el archivo de la visualizacion ya no esta en la lista, se borra la visualizacion"""
        try:
            d=self._vis_data
            ruta=(d or {}).get("ruta")
            if self._vis_run and self.pactual and self.pactual[0] not in self.files:self._vis_cancelar()
            if d and ruta not in self.files:
                self._vis_audio_cerrar();self._vis_data=None;self._vis_geom=None;self._vis_modo_txt()
                self.var_vis_estado.set("");self._vis_dibujar()
        except Exception:pass
    def _vis_audio_cerrar(self):
        self._vis_parar_tick()
        m=getattr(self,"_vis_mc",None)
        if m is not None:
            self._vis_mc=None
            try:m.stop()
            except Exception:pass
        for al in list(self._vis_aud.values()):
            try:self._mci("stop %s"%al)
            except Exception:pass
            try:self._mci("close %s"%al)
            except Exception:pass
        self._vis_aud={};self._vis_play=None;self._vis_pos=0.0;self._vis_solo_sel=None
        t=self._vis_tmp
        if t:
            import shutil
            shutil.rmtree(t,ignore_errors=True)
            self._vis_tmp=None
        self._vis_botones()

    # ---------- generacion ----------
    def _vis_generar(self):
        if self._vis_run:return
        if not self.pactual:
            self._toast(T("warn_tit"),self._vt("Selecciona primero un archivo y una pista.","Select a file and a track first."),tipo="warning")
            return
        try:self._guardar_conf_pista()
        except Exception:pass
        ruta,idx=self.pactual
        cfg=dict(self.pconf.get((ruta,idx)) or self._snap())
        seg=(0,300,600,1800)[max(0,min(3,self.cmb_vis_tramo.current()))]
        try:self._vis_sig=self._vis_firma()
        except Exception:self._vis_sig=None
        self._vis_audio_cerrar()
        import tempfile
        tmp=tempfile.mkdtemp(prefix="apm_vis_")
        self._vis_tmp=tmp
        if not hasattr(self,"_tmp_mios"):self._tmp_mios=set()
        self._tmp_mios.add(tmp)
        self._vis_run=True;self._vis_gen+=1;gid=self._vis_gen
        self.btn_vis.configure(state="disabled");self.btn_vis_c.configure(state="normal")
        self.prog_vis["value"]=0
        self.var_vis_estado.set(self._vt("Analizando audio original...","Analysing original audio..."))
        threading.Thread(target=self._vis_worker,args=(ruta,idx,cfg,seg,gid,tmp),daemon=True).start()

    def _vis_worker(self,ruta,idx,cfg,seg,gid,tmp):
        N=60000   # puntos de la onda: con zoom x64 aun llega casi a un punto por pixel
        res=None;err=None;nota=""
        try:
            dur=self._dur(ruta)
            if not dur or dur<=0:raise RuntimeError(self._vt("No se pudo leer la duración del archivo.","Could not read the file duration."))
            d=min(dur,seg) if seg else dur
            lim=min(d,14400.0)   # hasta 4 horas: el WAV de escucha pesa unos 450 MB por hora
            n=max(256,int(48000*d/N));N=max(1,int(48000*d/n))
            lm=None
            if cfg.get("master_auto") and cfg.get("upmix","N")!="S":
                self._ui(self._vis_est,self._vt("Midiendo el volumen para Loudnorm...","Measuring loudness for Loudnorm..."))
                lm=self._ln(ruta,idx,cfg.get("loudnorm_target"),cfg=cfg,seg=seg or None,vis_gid=gid)
                if gid!=self._vis_gen:return
                if lm is None:nota=self._vt(" · Loudnorm sin medida previa"," · Loudnorm without prior measurement")
            pre="aresample=48000,aformat=sample_fmts=fltp,asplit=3[pv][pp][pf]"
            def vis(nc):
                return ("[pv]asetnsamples=n=%d:p=0,astats=metadata=1:reset=1:measure_perchannel=Min_level+Max_level:measure_overall=none,"
                        "ametadata=mode=print:file=-[vis];[pp]aresample=32000,aformat=sample_fmts=fltp:channel_layouts=stereo,%saformat=sample_fmts=s16[ply];"
                        "[pf]aresample=32000,%saformat=sample_fmts=s16[pl6]")%(n,self._vis_gan(nc,False),self._vis_gan(nc,True))
            try:ne=int((self.pc.get(ruta) or [])[idx].get("channels",6))
            except Exception:ne=6
            wa=os.path.join(tmp,"antes.wav");wd=os.path.join(tmp,"despues.wav")
            salida=lambda w:["-map","[vis]","-f","null","-","-map","[ply]","-t","%.3f"%lim,"-c:a","pcm_s16le",w,
                             "-map","[pl6]","-t","%.3f"%lim,"-c:a","flac","-compression_level","0",w[:-4]+"6.flac"]
            base=[FFMPEG,"-hide_banner","-loglevel","error","-nostats","-y"]
            if seg:base+=["-t",str(seg)]
            antes=self._vis_ff(base+["-i",ruta,"-filter_complex","[0:a:%d]%s;%s"%(idx,pre,vis(ne))]+salida(wa),gid,0,40,N)
            if gid!=self._vis_gen:return
            self._ui(self._vis_est,self._vt("Aplicando tus ajustes y analizando el resultado...","Applying your settings and analysing the result..."))
            fc=self._cf(idx,self._cfe(ruta,idx,cfg,seg or 0),lm)
            desp=self._vis_ff(base+["-i",ruta]+self._fc_arg("%s;[outfinal]%s;%s"%(fc,pre,vis(self._LAY_N.get(str(cfg.get("layout")),ne))))+salida(wd),gid,40,100,N)
            if gid!=self._vis_gen:return
            res={"antes":antes,"despues":desp,"dur":d,"lim":lim,"nota":nota,"antes_wav":wa,"despues_wav":wd,
                 "titulo":"%s · %s #%d"%(os.path.basename(ruta),self._vt("pista","track"),idx),"lay":cfg.get("layout","5.1"),
                 "lay_in":str(((self.pc.get(ruta) or [])[idx:idx+1] or [{}])[0].get("layout","")),
                 "antes6":wa[:-4]+"6.flac","despues6":wd[:-4]+"6.flac","ruta":ruta,"idx":idx}
        except Exception as e:
            err=str(e) or e.__class__.__name__
        try:self._ui(self._vis_fin,gid,res,err)
        except Exception:pass

    def _vis_ff(self,cmd,gid,p0,p1,N):
        kw={"stdout":subprocess.PIPE,"stderr":subprocess.PIPE,"text":True,"encoding":"utf-8","errors":"ignore","bufsize":1}
        if sys.platform=="win32":kw["creationflags"]=CNW
        pr=subprocess.Popen(cmd,**kw)
        self._vis_proc=pr
        errl=[]
        def dr():
            try:
                for l in pr.stderr:errl.append(l)
            except Exception:pass
        te=threading.Thread(target=dr,daemon=True);te.start()
        rx=re.compile(r"lavfi\.astats\.(\d+)\.(Min|Max)_level=(\S+)")
        mins={};maxs={};fr=0;ult=0;paso=max(25,N//240)
        try:
            for l in pr.stdout:
                if gid!=self._vis_gen:break
                if l.startswith("frame:"):
                    fr+=1
                    if fr-ult>=paso:
                        ult=fr
                        self._ui(self._vis_prog,p0+(p1-p0)*min(1.0,fr/float(N)))
                    continue
                m=rx.match(l)
                if m:
                    try:v=float(m.group(3))
                    except ValueError:continue
                    if v!=v:v=0.0
                    v=max(-1.5,min(1.5,v))
                    (mins if m.group(2)=="Min" else maxs).setdefault(int(m.group(1)),[]).append(v)
        finally:
            if gid!=self._vis_gen:
                try:pr.kill()
                except Exception:pass
        try:pr.wait(timeout=60)
        except Exception:
            try:pr.kill()
            except Exception:pass
        te.join(timeout=2)
        if gid!=self._vis_gen:return None
        if pr.returncode!=0 or not mins:
            raise RuntimeError(("ffmpeg: "+"".join(errl[-6:])).strip())
        datos=[]
        for c in sorted(mins):
            a=mins[c];b=maxs.get(c,[0.0]*len(a));k=min(len(a),len(b));a=a[:k];b=b[:k]
            datos.append((a,b,max(max(b,default=0.0),-min(a,default=0.0))))   # el pico se guarda: la onda se redibuja mientras suena
        return datos

    def _vis_fin(self,gid,res,err):
        if gid!=self._vis_gen:return
        self._vis_run=False
        try:
            self.btn_vis.configure(state="normal");self.btn_vis_c.configure(state="disabled")
        except Exception:pass
        if err or not res:
            self._vis_sig=None
            self._vis_est(self._vt("Error al generar la visualización (mira el Log).","Error generating the visualization (see the Log)."))
            try:self._log("[VIS] "+str(err))
            except Exception:pass
            return
        self._vis_data=res
        self._vis_pos=0.0
        self._vis_modo_txt(len(res.get("antes") or []),len(res.get("despues") or []))
        self._vis_prog(100)
        extra=""
        try:self._vis_audio_abrir(res)
        except Exception as e:
            self._vis_aud={}
            extra=" · "+self._vt("audio no disponible: ","audio not available: ")+str(e)
        if res["lim"]<res["dur"]-1:
            extra+=" · "+self._vt("se puede escuchar hasta el min %d"%int(res["lim"]//60),"playable up to min %d"%int(res["lim"]//60))
        self._vis_est("%s · %s %s%s%s"%(res["titulo"],self._vt("analizado:","analysed:"),self._vis_fmt(res["dur"]),res["nota"],extra))
        self._vis_botones()
        self._vis_dibujar()
        try:
            if res["lim"]<=1800:self._vis_solo_pre(gid)   # con mas, cada canal se prepara al pedirlo (serian muchos GB)
        except Exception:pass
        if self.var_ed.get():self._ed_abrir(False)

    # ---------- dibujo ----------
    def _vis_dibujar(self):
        self._vis_redraw_id=None
        cv=getattr(self,"cv_vis",None)
        if cv is None:return
        try:
            cv.delete("all")
            W=max(cv.winfo_width(),460)
            H=max(cv.winfo_height(),300)
        except Exception:return
        data=self._vis_data
        if not self._ed_activo() and self.sb_vis_x.winfo_manager():self.sb_vis_x.pack_forget()
        if not data:
            self._vis_geom=None
            cv.create_text(W//2,70,width=max(200,W-80),justify="center",fill=CT,font=("",10),
                text=self._vt("Pulsa «Generar visualización» para comparar el audio original (antes) con el resultado de tus ajustes (después), con los seis canales diferenciados, y poder escucharlo.",
                              "Press “Generate visualization” to compare the original audio (before) with the result of your settings (after), with the six channels shown separately, and listen to it."))
            cv.configure(scrollregion=(0,0,W,140))
            return
        ML,MR,RH=92,12,22
        try:zoom=float(str(self.var_vis_zoom.get()).lstrip("x"))
        except ValueError:zoom=1.0
        ant=data["antes"] or [];des=data["despues"] or []
        nA=len(ant);nD=len(des)
        nch=max(nA,nD)
        nombres=self._vis_nombres(nch)
        nomA=self._vis_nom_ent(nA,data.get("lay_in"));nomD=self._vis_nom_des(nD,data.get("lay"))
        ancho=max(80,W-ML-MR)
        dur=max(0.001,float(data["dur"]))
        if self._vis_geom is None or abs(self._vis_geom[2]-dur)>1e-6:self._vz=1.0;self._vv0=0.0;self.var_vis_zh.set("x1")
        self._vis_geom=(ML,ancho,dur,0)
        v0,v1,_d=self._vis_rango();vw=v1-v0
        sep=self._vis_mezcla(CDN,CT,0.45);guia=self._vis_mezcla(CDN,CT,0.22);suave=self._vis_mezcla(CDN,CT,0.65)
        cv.create_rectangle(ML,0,ML+ancho,RH,fill=self._vis_mezcla(CDN,CT,0.08),outline="")
        paso=3600*2
        for p in (0.1,0.2,0.5,1,2,5,10,15,30,60,120,300,600,900,1800,3600):
            if p*ancho/vw>=90:paso=p;break
        t=int(v0/paso)*paso
        while t<=v1+1e-6:
            x=ML+(t-v0)/vw*ancho
            if x>=ML-1:
                cv.create_line(x,RH-6,x,RH,fill=suave)
                lb=self._vis_fmt(t) if paso>=1 else self._hms(t)
                cv.create_text(min(x+3,ML+ancho-2),RH/2-1,anchor="w" if x+40<ML+ancho else "e",text=lb,fill=suave,font=("",8))
            t+=paso
        y=RH
        self._vis_lanes=[]
        self._vf0=v0/dur;self._vf1=v1/dur
        if self._ed_activo():
            # editando: solo el archivo, con los cambios sin guardar ya puestos en la onda
            HDR=20;hist=self._ed_hist();dt=self._ed_det
            LH=int(max(44,min(150,(H-RH-HDR-4)/float(max(1,nA)))))
            cv.create_rectangle(0,y,ML+ancho+MR,y+HDR,fill=self._vis_mezcla(CDN,"#ffb020",0.35),outline="")
            cv.create_text(10,y+HDR/2.0,anchor="w",text=self._vt("EDITANDO  ·  ","EDITING  ·  ")+os.path.basename(self._ed_inf["ruta"]),fill=CT,font=("",9,"bold"))
            y+=HDR
            for i in range(nA):
                self._vis_lanes.append((y,y+LH,"antes",i,nomA[i]))
                if dt and dt[0]<=v0 and dt[1]>=v1 and i<len(dt[2]):
                    a_,b_=dt[0],dt[1];self._vf0=(v0-a_)/(b_-a_);self._vf1=(v1-a_)/(b_-a_);se=self._ed_serie(i,dt[2][i],a_,b_)
                else:
                    self._vf0=v0/dur;self._vf1=v1/dur;se=self._ed_serie(i,ant[i],0.0,dur)
                _sel=(getattr(self,"_vis_solo_sel",None)==("antes",i))
                self._vis_carril(cv,ML,y,ancho,LH,zoom,"#2ee86b" if _sel else self._vis_color(self._vis_ci(nomA[i]),8 if nA>2 else 2),nomA[i],"antes",se,sep,guia,suave,True)
                if _sel:self._vis_marco(cv,ML,y,ancho,LH)
                for ini,fin,chs,db in hist["hechos"]:
                    if i in chs and fin>v0 and ini<v1:
                        x0=ML+max(0.0,(ini-v0)/vw)*ancho;x1=ML+min(1.0,(fin-v0)/vw)*ancho
                        cv.create_rectangle(x0,y+1,x1,y+LH-1,outline="#ff5252")
                        cv.create_text(x0+3,y+9,anchor="w",text="%+g dB"%db,fill="#ff5252",font=("",8,"bold"))
                y+=LH
        elif self.var_vis_modo_i.get()==0:
            # BLOQUE 1: ANTES (todos los canales)  /  BLOQUE 2: DESPUES (todos los canales)
            HDR=20
            LH=int(max(34,min(90,(H-RH-2*HDR-4)/float(max(1,nA+nD)))))
            bloques=((ant,"antes",self._vt("ANTES  ·  audio original","BEFORE  ·  original audio"),"#8a94a6",nomA),
                     (des,"despues",self._vt("DESPUÉS  ·  con tus ajustes","AFTER  ·  with your settings"),"#3b82f6",nomD))
            for lista,tipo,titulo,tinte,nombres_b in bloques:
                cv.create_rectangle(0,y,ML+ancho+MR,y+HDR,fill=self._vis_mezcla(CDN,tinte,0.4),outline="")
                cv.create_text(10,y+HDR/2.0,anchor="w",text=titulo,fill=CT,font=("",9,"bold"))
                y+=HDR
                for i in range(len(lista)):
                    self._vis_lanes.append((y,y+LH,tipo,i,nombres_b[i]))
                    _sel=(getattr(self,"_vis_solo_sel",None)==(tipo,i))
                    self._vis_carril(cv,ML,y,ancho,LH,zoom,"#2ee86b" if _sel else self._vis_color(self._vis_ci(nombres_b[i]),8 if len(lista)>2 else 2),nombres_b[i],tipo,lista[i],sep,guia,suave,True)
                    if _sel:self._vis_marco(cv,ML,y,ancho,LH)
                    y+=LH
        else:
            LH=64
            if nch<=2:
                orden=[(nombres[i],i,i) for i in range(nch)]
            else:
                mA={self._vis_can(n):i for i,n in enumerate(nomA)};mD={self._vis_can(n):i for i,n in enumerate(nomD)}
                cu=[c for c in self._VIS_CAN if c in mA or c in mD]+sorted(c for c in set(mA)|set(mD) if c not in self._VIS_CAN)
                orden=[(c,mA.get(c),mD.get(c)) for c in cu]
            for nm,ia,idd in orden:
                col=self._vis_color(self._vis_ci(nm),8 if nch>2 else 2)
                for tipo,lista,ii in (("antes",ant,ia),("despues",des,idd)):
                    if ii is not None and ii<len(lista):self._vis_lanes.append((y,y+LH,tipo,ii,nm))
                    _sel=(ii is not None and getattr(self,"_vis_solo_sel",None)==(tipo,ii))
                    self._vis_carril(cv,ML,y,ancho,LH,zoom,"#2ee86b" if _sel else col,nm,tipo,lista[ii] if (ii is not None and ii<len(lista)) else None,sep,guia,suave)
                    if _sel:self._vis_marco(cv,ML,y,ancho,LH)
                    y+=LH
        cv.configure(scrollregion=(0,0,W,y+4))
        self._vis_geom=(ML,ancho,dur,y+4)
        if self._ed_activo():
            if not self.sb_vis_x.winfo_manager():self.sb_vis_x.pack(side="bottom",fill="x",before=cv)
            self.sb_vis_x.set(v0/dur,v1/dur)
        try:self.cmb_vis_zh.configure(state="readonly")
        except Exception:pass
        self._vis_cursor(self._vis_posicion_actual())
        if self._ed_activo():
            self._ed_marca();self._ed_pide_det()

    def _vis_carril(self,cv,ML,y,ancho,LH,zoom,col,nombre,tipo,serie,sep,guia,suave,solo_nombre=False):
        f0=getattr(self,'_vf0',0.0);f1=getattr(self,'_vf1',1.0)
        yc=y+LH/2.0;mitad=LH/2.0-3
        despues=(tipo=="despues")
        # ANTES = fondo claro, DESPUES = fondo oscuro
        if despues:
            bg="#0b0b0b";guia=self._vis_mezcla("#0b0b0b","#ffffff",0.18);suave="#9a9a9a";lin="#3b82f6"
        else:
            bg="#f5f5f5";guia="#d0d0d0";suave="#555555";lin="#9a9a9a"
            col={"#5c7cfa":"#3b5bdb","#e64980":"#c2255c","#d4a017":"#b07d00","#22b8cf":"#0b7285"}.get(col,col)
        cv.create_rectangle(ML,y,ML+ancho,y+LH,fill=bg,outline="")
        g=0.5*mitad*zoom
        if g<mitad:
            for s in (-1,1):cv.create_line(ML,yc+s*g,ML+ancho,yc+s*g,fill=guia)
        cv.create_rectangle(2,y+4,5,y+LH-4,fill=col,outline="")
        if solo_nombre:
            cv.create_text(10,yc-6,anchor="w",text=nombre,fill=CT,font=("",9,"bold"))
        else:
            cv.create_text(10,yc-8,anchor="w",text=nombre,fill=CT,font=("",9,"bold"))
            cv.create_text(10,yc+8,anchor="w",text=self._vt("Después","After") if despues else self._vt("Antes","Before"),fill=suave,font=("",8))
        if serie and len(serie[1])>=2:
            mins,maxs=serie[0],serie[1]
            pk=serie[2] if len(serie)>2 else max(max(maxs),-min(mins))
            k0=len(maxs);a0=int(f0*k0);b0=max(a0+2,int(round(f1*k0)))
            mins=mins[a0:b0];maxs=maxs[a0:b0];k=len(maxs)
            m=max(2,min(k,int(ancho)))
            sup=[];inf=[]
            for j in range(m):
                a=j*k//m;b=max(a+1,(j+1)*k//m)
                mx=max(maxs[a:b]);mn=min(mins[a:b])
                x=ML+j*(ancho-1)/float(m-1)
                y1=yc-max(-1.0,min(1.0,mx*zoom))*mitad
                y2=yc-max(-1.0,min(1.0,mn*zoom))*mitad
                if y2-y1<1.0:y2=y1+1.0
                sup.append((x,y1));inf.append((x,y2))
            pts=[]
            for p in sup+inf[::-1]:pts.extend(p)
            cv.create_line(ML,yc,ML+ancho,yc,fill=lin)
            cv.create_polygon(pts,fill=col,outline=col)
            if pk>1e-6:
                import math
                txt="%s %.1f dBFS"%(self._vt("pico","peak"),20*math.log10(pk))
            else:
                txt=self._vt("silencio","silence")
            cv.create_text(10,yc+(8 if solo_nombre else 20),anchor="w",text=txt,fill=self._vis_mezcla(CDN,CT,0.7),font=("",8))
        else:
