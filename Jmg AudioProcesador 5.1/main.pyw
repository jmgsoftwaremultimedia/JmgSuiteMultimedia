        if not hasattr(self,"_fase"):self._fase={}
        _nrm=bool(cfg and (cfg.get("master_auto") or int(cfg.get("dyn_norm",0) or 0)>0 or int(cfg.get("speech_norm",0) or 0)>0))
        self._fase[a]=self._vt("normalizando","normalizing") if _nrm else self._vt("procesando","processing")
        dur=self._dur(a) if need_analysis else 0.0
        cb_used=cb
        _ya_medido=False
        if need_analysis:
