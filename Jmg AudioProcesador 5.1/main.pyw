        if dl_init>0:
            pre.append(f"adelay=delays={int(round(dl_init))}:all=1")   # all=1: TODOS los canales (tambien 7.1)
        elif dl_init<0:
            pre.append(f"atrim=start={abs(dl_init)/1000.0:.3f},asetpts=PTS-STARTPTS")
        pre_str=(",".join(pre)+",") if pre else ""
        fuente=f"[0:a:{pista}]aresample=async=1:min_hard_comp=0.05,{pre_str}"   # (JMG, 17-11) los huecos de las marcas de tiempo (discos de varios trozos), con silencio
        if cfg.get("_tramos"):   # corregir por tramos (Volumen → Sincronizacion): con el delay ya puesto, como al medir
            tot=float(cfg.get("_dur") or 0) or cfg["_tramos"][-1][1]
            q_,c_=self._tramos_cad("v",fuente+"aresample=48000",[q for q in cfg["_tramos"] if q[0]<tot],tot)
            P.extend(q_);P.append(c_+"[atr]");fuente="[atr]"

        if up:
            # UPMIX estereo -> 5.1 por matriz Mid/Side:
            #  - Central: contenido comun (L+R); los frontales ceden parte de ese contenido (conserva la energia)
            #  - LFE: graves del contenido comun (paso bajo 100 Hz), suave
            #  - Traseros: ambiente (L-R) filtrado (150 Hz-7 kHz), retrasado 20 ms, en contrafase L/R
            a=0.5*(uc/10.0)
            k=min(1.0,round((2.0-2.0*(1.0-a)**2)**0.5*0.85,4))
            fl=round(1.0-0.5*a,4);fx=round(0.5*a,4);kc=round(0.5*k,4)
            sg=0.7 if uc>0 or True else 0.0
            # Quitar voz de frontales/traseros (0-10): la banda de la voz (200 Hz-5 kHz) del contenido
            # comun (M) se resta de los frontales con un filtro de fase lineal (resta exacta) y pasa al central;
            # en los traseros (ambiente L-R, donde queda la reverberacion de la voz) se atenua esa banda.
            try:gv=max(0.0,min(10.0,float(cfg.get("upmix_voz",8))))/10.0
            except (TypeError,ValueError):gv=0.8
            cb=round(gv*(fl-fx),4);dip=round(-9.0*gv,1)
            P.append(f"{fuente}aformat=channel_layouts=stereo,asplit=2[u0][uM]")
            P.append("[uM]pan=mono|c0=0.5*c0+0.5*c1,firequalizer=gain_entry='entry(0,-70);entry(120,-70);entry(200,0);entry(5000,0);entry(8000,-70)':delay=0.02:fixed=1[uMb]")
            P.append("[u0]adelay=delays=20|20,asplit=3[uA][uB][uC]")
            P.append("[uA][uMb]amerge=inputs=2"
                     f",pan=5.1|FL={fl}*c0-{fx}*c1-{cb}*c2|FR={fl}*c1-{fx}*c0-{cb}*c2|FC={kc}*c0+{kc}*c1|LFE=0*c0|BL=0*c0|BR=0*c0[upF]")
            P.append("[uB]pan=mono|c0=0.5*c0+0.5*c1,lowpass=f=100:poles=2,volume=0.8,pan=5.1|FL=0*c0|FR=0*c0|FC=0*c0|LFE=1*c0|BL=0*c0|BR=0*c0[upL]")
            _eqv=f",equalizer=f=1200:width_type=q:width=0.5:g={dip}" if dip<-0.05 else ""
            P.append(f"[uC]pan=mono|c0=0.5*c0-0.5*c1,highpass=f=150,lowpass=f=7000{_eqv},adelay=20,volume={sg},pan=5.1|FL=0*c0|FR=0*c0|FC=0*c0|LFE=0*c0|BL=1*c0|BR=-1*c0[upS]")
            P.append("[upF][upL][upS]amix=inputs=3:normalize=0,atrim=start=0.02,asetpts=PTS-STARTPTS,channelsplit=channel_layout=5.1[aFL][aFR][aFC][aLFE][aBL][aBR]")  # quita los 20 ms del filtro de fase lineal (sincronia con el video)
        else:
            # origen mono/estereo sin Upmix: primero a estereo (el mono va a L y R; si no, FFmpeg lo mete en el central y FL/FR quedan mudos)
            _pre_est="aformat=channel_layouts=stereo," if _est else ""
            P.append(f"{fuente}{_pre_est}aformat=channel_layouts='5.1|5.1(side)',channelsplit=channel_layout=5.1[aFL][aFR][aFC][aLFE][aBL][aBR]")

        _CE={"-2 dBFS":0.794,"-1 dBFS":0.891,"-0,5 dBFS":0.944}
        def _lim(k,dd):
            v=_CE.get(str(cfg.get(k,dd)))
            return f"alimiter=limit={v}:attack=5:release=80:level=0:latency=1" if v else None
        def peq(fr,g,q):return f"equalizer=f={fr}:width_type=q:width={q}:g={g}"
        def band_amb():return [peq(1000,pa,0.5),peq(4000,pa,0.5)] if pa else []
        def band_efc():return [peq(2000,pe,0.6),peq(6000,pe,0.6)] if pe else []
        # Voz: SOLO canal central (tres bandas que cubren 250 Hz-4 kHz)
        band_voz=[peq(300,round(pv*0.7,2),0.9),peq(1000,round(pv*0.8,2),0.8),peq(2800,round(pv*0.7,2),0.9)] if pv else []

        def cadena(ent,vol,bandas,sal):
            return f"[{ent}]volume={vol}"+("," + ",".join(bandas) if bandas else "")+f"[{sal}]"
        # Ambiente y Efectos: SOLO frontales y traseros (nunca el central)
        P.append(cadena("aFL",gFL,band_amb()+band_efc(),"vFL"))
        P.append(cadena("aFR",gFR,band_amb()+band_efc(),"vFR"))
        P.append(cadena("aFC",gFC,band_voz if "FC" in act else [],"vFC"))
        P.append(f"[aLFE]volume={lm}[vLFE]")
        P.append(cadena("aBL",gBL,(band_amb()+band_efc()) if "BL" in act else [],"vBL"))
        P.append(cadena("aBR",gBR,(band_amb()+band_efc()) if "BR" in act else [],"vBR"))

        P.append("[vFL][vFR][vFC][vLFE][vBL][vBR]join=inputs=6:channel_layout=5.1[s0_pre]")
        _lp=_lim("techo_pres","Sin límite")
        if _lp and (pv>0 or pa>0 or pe>0 or ps>0):P.append(f"[s0_pre]{_lp}[s0]")
        else:P.append("[s0_pre]anull[s0]")

        # ---- Bass Management: redirige graves de los satelites al LFE (parcial segun intensidad) ----
        if bmv==0:P.append("[s0]anull[b1]")
        else:
            P.append("[s0]channelsplit=channel_layout=5.1[bFL][bFR][bFC][bLFE][bBL][bBR]")
            sats=[x_ for x_ in ["FL","FR","FC","BL","BR"] if x_ in act]
            for s_ in ["FL","FR","FC","BL","BR"]:
                if s_ not in sats:P.append(f"[b{s_}]anull[n{s_}]")
            for s_ in sats:
                # cruce Linkwitz-Riley 24 dB/oct: graves (paso bajo) -> LFE; altavoz = mezcla de original y paso alto
                # (las dos salidas LR4 estan en fase: paso alto + (1-a)*paso bajo no produce cancelaciones)
                P.append(f"[b{s_}]asplit=2[t{s_}][h{s_}]")
                P.append(f"[t{s_}]lowpass=f={bmc}:poles=2,lowpass=f={bmc}:poles=2,asplit=2[la{s_}][lb{s_}]")
                P.append(f"[h{s_}]highpass=f={bmc}:poles=2,highpass=f={bmc}:poles=2[hh{s_}]")
                P.append(f"[la{s_}]volume={round(1-bm_a,3)}[na{s_}]")
                P.append(f"[hh{s_}][na{s_}]amix=inputs=2:normalize=0[n{s_}]")
            P.append("".join(f"[lb{s_}]" for s_ in sats)+(f"amix=inputs={len(sats)}:normalize=0," if len(sats)>1 else "")+f"volume={bm_k}[bsum]")
            P.append(f"[bLFE][bsum]amix=inputs=2:normalize=0,{_LFE_LIM}[nLFE]")
            P.append("[nFL][nFR][nFC][nLFE][nBL][nBR]join=inputs=6:channel_layout=5.1[b1]")

        # ---- Double Bass: copia graves del LFE a los altavoces (sin tocar el propio LFE) ----
        if dbv==0:P.append("[b1]anull[db1]")
        else:
            P.append("[b1]channelsplit=channel_layout=5.1[xFL][xFR][xFC][xLFE][xBL][xBR]")
            P.append("[xLFE]asplit=2[xL0][xL1]")
            _ds=[x_ for x_ in ["FL","FR","FC","BL","BR"] if x_ in act]
            _dn=["dd%d"%(i+1) for i in range(len(_ds))]
            P.append(f"[xL1]lowpass=f={dbc}:poles=2,volume={db_g},asplit={len(_ds)}"+"".join(f"[{d_}]" for d_ in _dn))
            # graves de los altavoces -> LFE (se copian, los altavoces los conservan): bajos "dobles"
            for s_ in _ds:P.append(f"[x{s_}]asplit=2[xm{s_}][xg{s_}]")
            P.append("".join(f"[xg{s_}]" for s_ in _ds)+(f"amix=inputs={len(_ds)}:normalize=0," if len(_ds)>1 else "")
                     +f"lowpass=f={dbc}:poles=2,lowpass=f={dbc}:poles=2,volume={db_k}[xgs]")
            P.append(f"[xL0][xgs]amix=inputs=2:normalize=0,{_LFE_LIM}[xL2]")
            for s_,d_ in zip(_ds,_dn):
                P.append(f"[xm{s_}][{d_}]amix=inputs=2:normalize=0[y{s_}]")
            for s_ in ["FL","FR","FC","BL","BR"]:
                if s_ not in _ds:P.append(f"[x{s_}]anull[y{s_}]")
            P.append("[yFL][yFR][yFC][xL2][yBL][yBR]join=inputs=6:channel_layout=5.1[db1]")

        gdf=cfg.get("gdin_front",0);gdt=cfg.get("gdin_tras",0);gdc=cfg.get("gdin_cent",0)
        if up: gdf=gdt=gdc=0 # Incompatible con Upmix
        if "BL" not in act:gdt=0
        if "FC" not in act:gdc=0

        # ---- Gama dinamica: EXPANSION con compand (por grupo) ----
        if gdf==0 and gdt==0 and gdc==0:P.append("[db1]anull[g1_pre]")
        else:
            def cpx(v):
                return f"compand=attacks=0.05:decays=0.4:points={self._gd_points(v)}:soft-knee=6:gain=0:volume=0" if v>0 else None
            cpf=cpx(gdf);cpt=cpx(gdt);cpc=cpx(gdc)
            P.append("[db1]channelsplit=channel_layout=5.1[gFL][gFR][gFC][gLFE][gBL][gBR]")
            for ch_,cp_ in (("FL",cpf),("FR",cpf),("FC",cpc),("BL",cpt),("BR",cpt)):
                P.append(f"[g{ch_}]{cp_}[h{ch_}]" if cp_ else f"[g{ch_}]anull[h{ch_}]")
            P.append("[gLFE]anull[hLFE]")
            P.append("[hFL][hFR][hFC][hLFE][hBL][hBR]join=inputs=6:channel_layout=5.1[g1_pre]")

        gvol=float(cfg.get("gdin_vol",0))
        if gvol<0 and not up:
            P.append(f"[g1_pre]volume={db2lin(gvol)}[g1x]")
        else:
            P.append("[g1_pre]anull[g1x]")
        _lg=_lim("techo_gd","Sin límite")
        if _lg and (gdf>0 or gdt>0 or gdc>0):P.append(f"[g1x]{_lg}[g1]")
        else:P.append("[g1x]anull[g1]")

        eq=[]
        if eb!=0:eq.append(peq(100,eb,1))
        if em!=0:eq.append(peq(1000,em,1))
        if et!=0:eq.append(peq(5000,et,1))
        if not up and self._suav_filtro(cfg.get("suav",0)):eq.append(self._suav_filtro(cfg.get("suav",0)))   # con Upmix no
        if eq:P.append(f"[g1]{','.join(eq)}[e1]")
        else:P.append("[g1]anull[e1]")

        adv_pos=[]
        def get_bands(gk):
            bands=[]
            if (gk=="tras" and "BL" not in act) or (gk=="cent" and "FC" not in act):return bands
            for i in (1,2,3):
                fr=cfg.get(f"eq{gk}_b{i}_f",1000)
                gv=self._eff(cfg.get(f"eq{gk}_b{i}_g",0),10,14)
                if gv!=0:
                    bands.append(peq(fr,gv,1))
                    if gv>0:adv_pos.append(gv)
            return bands

        bF=get_bands("front");bT=get_bands("tras");bC=get_bands("cent")
        dFL=float(cfg.get("delay_fl",0));dFR=float(cfg.get("delay_fr",0))
        dFC=float(cfg.get("delay_fc",0));dBL=float(cfg.get("delay_bl",0));dBR=float(cfg.get("delay_br",0))
        if "FC" not in act:dFC=0.0
        if "BL" not in act:dBL=0.0
        if "BR" not in act:dBR=0.0
        need_split=bool(bF or bT or bC or dFL or dFR or dFC or dBL or dBR)
        if not need_split:P.append("[e1]anull[e2]")
        else:
            P.append("[e1]channelsplit=channel_layout=5.1[qFL][qFR][qFC][qLFE][qBL][qBR]")
            def ch(chain):
                return ",".join(chain) if chain else "anull"
            P.append(f"[qFL]{ch(bF+([f'adelay={int(dFL)}'] if dFL>0 else []))}[rFL]")
            P.append(f"[qFR]{ch(bF+([f'adelay={int(dFR)}'] if dFR>0 else []))}[rFR]")
            P.append(f"[qFC]{ch(bC+([f'adelay={int(dFC)}'] if dFC>0 else []))}[rFC]")
            P.append("[qLFE]anull[rLFE]")
            P.append(f"[qBL]{ch(bT+([f'adelay={int(dBL)}'] if dBL>0 else []))}[rBL]")
            P.append(f"[qBR]{ch(bT+([f'adelay={int(dBR)}'] if dBR>0 else []))}[rBR]")
            P.append("[rFL][rFR][rFC][rLFE][rBL][rBR]join=inputs=6:channel_layout=5.1[e2]")

        # ---- Procesado dinamico: COMPRESION con acompressor ----
        if dm==0:P.append("[e2]anull[d1_pre]")
        else:
            # intensidad propia por grupo: frontales+traseros, central y subwoofer (0 = sin efecto)
            def _lv(k,dd):
                try:return max(0.0,min(10.0,float(cfg.get(k,dd))))
                except (TypeError,ValueError):return float(dd)
            _md=cfg.get("_din_med")
            fft=self._dp(dm,_lv("din_ft",5),med=_md)["f"] or "anull"
            ffc=self._dp(dm,_lv("din_fc",2),med=_md)["f"] or "anull"
            fsw=self._dp(dm,_lv("din_lfe",0),med=_md)["f"] or "anull"
            P.append("[e2]channelsplit=channel_layout=5.1[pFL][pFR][pFC][pLFE][pBL][pBR]")
            for _c in ("FL","FR","BL","BR"):P.append(f"[p{_c}]{fft}[q{_c}]")
            P.append(f"[pFC]{ffc}[qFC]");P.append(f"[pLFE]{fsw}[qLFE]")
            P.append("[qFL][qFR][qFC][qLFE][qBL][qBR]join=inputs=6:channel_layout=5.1[d0]")
            # Techo elegido por el usuario; "Sin limite" = sin limitador (Impacto puede saturar: bajo su responsabilidad)
            _ld=_lim("techo_pd","Sin límite")
            P.append(f"[d0]{_ld}[d1_pre]" if _ld else "[d0]anull[d1_pre]")

        # ---- Compensacion de ganancia: si hay realces, se baja un poco el nivel general ----
        subidas=[x for x in (pv*0.8,pa,pe,eb,em,et) if x>0]+adv_pos
        comp_db=-round(min(2.0,0.2*max(subidas)),1) if (subidas and not up) else 0.0
        dvol=float(cfg.get("din_vol",0))
        tot=(dvol if dvol<0 else 0)+comp_db
        if abs(tot)>0.01 and not up:
            P.append(f"[d1_pre]volume={db2lin(tot)}[d1]")
        else:
            P.append("[d1_pre]anull[d1]")

        _ln_fin=None;_ln_lim=None
        if cfg.get("master_auto") and not up:
            t=_lnt(cfg.get("loudnorm_target"))
            if ln_med is not None:
                # medida previa: ganancia exacta hasta el objetivo; los picos que pasen del techo (True Peak) los recoge el limitador
                try:_g=max(-30.0,min(30.0,float(t['I'])-float(ln_med.get('input_i'))))
                except (TypeError,ValueError):_g=0.0
                ln=f"volume={_g:.2f}dB"
                _ln_lim=round(10**((float(t['TP'])-0.3)/20.0),4)
            else:
                ln=(f"loudnorm=I={t['I']}:TP={t['TP']}:LRA={t['LRA']}:linear=true:print_format=summary")
            _ln_fin=ln
            P.append("[d1]anull[d_final]")
        elif dyn_v>0 and not up:
            # DynAudNorm: iguala lo flojo y lo fuerte. Nivel 1 = suave (ventana larga, poca ganancia) · 10 = fuerte
            # (medido en una pelicula: diferencia flojo/fuerte LRA 19,8 -> 17 en el 1, ~13 en el 5, ~8 en el 10)
            _v=max(1,min(10,dyn_v))
            g=int(round(self._ip(_v,[1,10],[31,9])));g+=1-g%2
            mx=round(self._ip(_v,[1,10],[2.0,8.0]),2)
            P.append(f"[d1]dynaudnorm=f=500:g={g}:p=0.71:m={mx}[d_final]")
        elif sp_v>0 and not up:
            # SpeechNorm (voces): iguala los dialogos. Con canal central se aplica SOLO al central (donde esta la voz);
            # el pico objetivo se centra en el nivel medido del dialogo (+16 dB) para igualar sin desequilibrar la mezcla.
            _v=max(1,min(10,sp_v))
            e=round(self._ip(_v,[1,10],[1.25,6.0]),2);cc=round(self._ip(_v,[1,10],[1.0,2.5]),2);rf=round(self._ip(_v,[1,10],[0.0005,0.004]),4)
            try:_si=float(cfg.get("_spn_i",-27.0))
            except (TypeError,ValueError):_si=-27.0
            pp=round(max(0.05,min(0.71,10**((_si+16.0)/20.0))),3)
            _spn=f"speechnorm=e={e}:c={cc}:r={rf}:f={rf}:p={pp}"
            if "FC" in act:
                P.append("[d1]channelsplit=channel_layout=5.1[sFL][sFR][sFC][sLFE][sBL][sBR]")
                P.append(f"[sFC]{_spn}[sFCn]")
                P.append("[sFL][sFR][sFCn][sLFE][sBL][sBR]join=inputs=6:channel_layout=5.1[d_final]")
            else:
                P.append(f"[d1]{_spn}:l=1[d_final]")
        else:
            P.append("[d1]anull[d_final]")

        # ---- LFE limpio: el subwoofer solo lleva graves (filtro de 36 dB/oct). Elimina restos de medios/agudos
        #      que puedan venir del original, del Bass Management o de los efectos ----
        _src="d_final"
        if "LFE" in act:
            _fg=int(round(1.25*max(150,bmc if bmv>0 else 150)))
            P.append("[d_final]channelsplit=channel_layout=5.1[zFL][zFR][zFC][zLFE][zBL][zBR]")
            P.append(f"[zLFE]lowpass=f={_fg}:poles=2,lowpass=f={_fg}:poles=2,lowpass=f={_fg}:poles=2[zLFEc]")
            P.append("[zFL][zFR][zFC][zLFEc][zBL][zBR]join=inputs=6:channel_layout=5.1[d_lfe]");_src="d_lfe"
        # ---- Disposicion de salida: los canales descartados se SUMAN a los que quedan ----
        _dmx=bool(cfg.get("downmix"))
        if _dmx:
            # 2.0 estereo. Dolby = matriz Pro Logic II (el envolvente queda codificado en Lt/Rt);
            # Simple = suma directa. LFE opcional a -10 dB.
            K="0.707";lf="+0.316*LFE" if (cfg.get("downmix_lfe",True) and not _est) else ""
            if _mono:
                # 1.0 mono = media de un estereo simple (Lo+Ro)/2
                # origen mono: L=R=mono a -3 dB -> 0,7071*(L+R) devuelve exactamente el nivel original
                _pdm=(("pan=mono|c0=0.7071*FL+0.7071*FR" if cfg.get("ent_mono") else "pan=mono|c0=0.5*FL+0.5*FR") if (_est and not up) else
                      "pan=mono|c0=0.5*FL+0.5*FR+0.707*FC+0.354*BL+0.354*BR"+("+0.316*LFE" if cfg.get("downmix_lfe",True) else ""))
            elif _est and not up:
                _pdm="pan=stereo|FL=FL|FR=FR"   # origen estereo: se queda en estereo
            elif str(cfg.get("downmix_modo","dolby"))=="simple":
                _pdm=f"pan=stereo|FL=FL+{K}*FC+{K}*BL{lf}|FR=FR+{K}*FC+{K}*BR{lf}"
            else:
                _pdm=f"pan=stereo|FL=FL+{K}*FC-0.8718*BL-0.4899*BR{lf}|FR=FR+{K}*FC+0.4899*BL+0.8718*BR{lf}"
            P.append(f"[{_src}]{_pdm}[d_fold]");_src="d_fold"
        elif _lay!="5.1":
            K="0.707"
            _PAN={"3.1":f"pan=FL+FR+FC+LFE|FL=FL+{K}*BL|FR=FR+{K}*BR|FC=FC|LFE=LFE",
                  "2.1":f"pan=FL+FR+LFE|FL=FL+{K}*FC+{K}*BL|FR=FR+{K}*FC+{K}*BR|LFE=LFE",
                  "4.0":f"pan=FL+FR+BL+BR|FL=FL+{K}*FC+{K}*LFE|FR=FR+{K}*FC+{K}*LFE|BL=BL|BR=BR",
                  "4.1":f"pan=FL+FR+LFE+BL+BR|FL=FL+{K}*FC|FR=FR+{K}*FC|LFE=LFE|BL=BL|BR=BR"}
            P.append(f"[{_src}]{_PAN[_lay]}[d_fold]");_src="d_fold"

        # ---- Final: volumen + limitador (sin auto-nivel: no sube el volumen) ----
        # Techo elegido por el usuario. El limitador solo se pone si algo puede SUBIR el nivel;
        # sin efectos la salida es identica al original (no se toca la dinamica).
        _ord={"-2 dBFS":0.794,"-1 dBFS":0.891,"-0,5 dBFS":0.944}
        # techo final de seguridad (EQ, master, bass...): el mas permisivo de los techos de los efectos ACTIVOS
        # (Presencia, Gama, Procesado). Si alguno activo esta en «Sin limite», no hay limitador final.
        # Antes solo se ponia si Presencia y Procesado tenian techo a la vez: con Presencia a -1 dBFS y el Master
        # subido despues, la salida podia saturar igualmente.
        _tch=[]
        if (pv or pa or pe or ps):_tch.append(_ord.get(str(cfg.get("techo_pres","Sin límite"))))
        if (gdf>0 or gdt>0 or gdc>0):_tch.append(_ord.get(str(cfg.get("techo_gd","Sin límite"))))
        if dm!=0:_tch.append(_ord.get(str(cfg.get("techo_pd","Sin límite"))))
        _lim_fin=None if (not _tch or None in _tch) else max(_tch)
        _canal_sube=any(float(cfg.get(k,0))>0.001 for k in ("fl","fr","fc","lfe","bl","br"))
        _sube=(up or cfg.get("master_auto") or dyn_v>0 or sp_v>0 or din_act or float(cfg.get("master",0))>0.001
               or _canal_sube or bmv>0 or dbv>0 or ps>0 or any(x>0 for x in (pv,pa,pe,eb,em,et)) or bool(adv_pos))
        LIM=f"alimiter=limit={_lim_fin}:attack=5:release=80:level=0:latency=1" if (_lim_fin and _sube) else "anull"
        if (_lay!="5.1" or (_dmx and not (_est and not up))) and LIM=="anull":
            LIM="alimiter=limit=0.944:attack=5:release=80:level=0:latency=1"  # sumar canales puede subir el nivel: proteccion minima (-0,5 dBFS)
        if _ln_fin:
            if _ln_fin.startswith("volume="):LIM=f"alimiter=limit={_ln_lim}:attack=5:release=80:level=0:latency=1"
            P.append(f"[{_src}]{_ln_fin},aresample=48000,{LIM}[outfinal]")
        elif is_proc:
            P.append(f"[{_src}]volume=1.0,{LIM}[outfinal]")
        else:
            final_m = db2lin(cfg["master"])
            P.append(f"[{_src}]volume={final_m},{LIM}[outfinal]")

        return ";".join(P)

    def _re_cfg(self,cfg,ch=0):
        """resumen legible de los ajustes de una pista (confirmacion y Edit/Log). ch = canales de la entrada (0 = no se sabe)"""
        V=self._vt;e=[]
        ff=cfg.get("fps_from","25");ft=cfg.get("fps_to","25")
        if ff!=ft:
            met=V("con tono","with pitch") if cfg.get("fps_metodo","tono")=="tono" else V("sin tono","without pitch")
            e.append(f"Framerate: {ff} -> {ft} fps ({met})")
        try:
            di=float(cfg.get("delay_init",0))
            if abs(di)>0.001:e.append(V("Delay inicial","Initial delay")+f": {self._fv(di)} ms")
        except Exception:pass

        if cfg.get("master_auto"):
            e.append(f"Loudnorm: {cfg.get('loudnorm_target','')} "+V("(medida exacta)","(exact measurement)"))
        elif cfg.get("dyn_norm",0)>0:
            e.append(f"DynAudNorm: {cfg['dyn_norm']}/10")
        elif cfg.get("speech_norm",0)>0:
            e.append(f"SpeechNorm: {cfg['speech_norm']}/10")
        elif cfg.get("master",0)!=0:
            e.append(f"Master: {self._fv(cfg['master'])} dB")

        for n_,k in [("FL","fl"),("FR","fr"),("FC","fc"),("LFE","lfe"),("BL","bl"),("BR","br")]:
            v=cfg.get(k,0)
            if v!=0:e.append(f"Vol {n_}: {self._fv(v)} dB")
        for n_,k in [(V("Voz","Voice"),"voz"),("Amb","amb"),(V("Efc","Effects"),"efc"),("Sub","sub")]:
            v=cfg.get(k,0)
            if v!=0:e.append(f"{n_}: {self._fv(v)}")
        _tp=str(cfg.get("techo_pres",""))
        if _tp.endswith("dBFS") and any(cfg.get(k,0)!=0 for k in ("voz","amb","efc","sub")):e.append(V("Techo Presencia","Presence ceiling")+f": {_tp}")

        if cfg.get("bm",0)!=0:e.append(f"BM: {cfg['bm']} @ {cfg.get('bm_corte',120)} Hz")
        if cfg.get("db",0)!=0:e.append(f"DB: {cfg['db']} @ {cfg.get('db_corte',90)} Hz")

        if cfg.get("gdin_front",0)>0 or cfg.get("gdin_tras",0)>0 or cfg.get("gdin_cent",0)>0:
            gd=[]
            if cfg.get("gdin_front",0)>0:gd.append(f"F:{cfg['gdin_front']}")
            if cfg.get("gdin_tras",0)>0:gd.append(f"T:{cfg['gdin_tras']}")
            if cfg.get("gdin_cent",0)>0:gd.append(f"C:{cfg['gdin_cent']}")
            _tg=str(cfg.get("techo_gd",""))
            e.append(V("Gama","Range")+": "+" ".join(gd)+(f" · {_tg}" if _tg.endswith("dBFS") else ""))

        if cfg.get("din_modo",0)!=0:
            _td=str(cfg.get("techo_pd",""))
            e.append(f"Dyn: {self._din_nom(cfg['din_modo'])} · F/T {cfg.get('din_ft',5)} · C {cfg.get('din_fc',2)} · Sub {cfg.get('din_lfe',0)}"+(f" · {_td}" if _td.endswith("dBFS") else ""))

        for k,n_ in [("eq_bass",V("EQ G","EQ B")),("eq_mids","EQ M"),("eq_treble",V("EQ A","EQ T"))]:
            v=cfg.get(k,0)
            if v!=0:e.append(f"{n_}: {self._fv(v)} dB")
        if int(cfg.get("suav",0) or 0)>0:e.append(V("Suavizado","Smoothing")+f": {cfg['suav']}")
        for gk,nombre in [("front",V("EQ adv Front","Adv EQ Front")),("tras",V("EQ adv Tras","Adv EQ Rear")),("cent",V("EQ adv Cent","Adv EQ Center"))]:
            bandas=[]
            for i in (1,2,3):
                gv=cfg.get(f"eq{gk}_b{i}_g",0)
                fv=cfg.get(f"eq{gk}_b{i}_f",1000)
                if gv!=0:bandas.append(f"{fv}Hz:{self._fv(gv)}")
            if bandas:e.append(f"{nombre}: "+", ".join(bandas))
        ds=[]
        for n_,k in [("FL","delay_fl"),("FR","delay_fr"),("FC","delay_fc"),("BL","delay_bl"),("BR","delay_br")]:
            v=cfg.get(k,0)
            if v!=0:ds.append(f"{n_}:{self._fv(v)}ms")
        if ds:e.append(V("Delay canal","Channel delay")+": "+" ".join(ds))
        _lz=[]
        if int(cfg.get("limp",0) or 0)>0:_lz.append(V("ruido","noise")+f" {cfg.get('limp')}")
        if cfg.get("declick"):_lz.append(V("clics","clicks"))
        if cfg.get("declip"):_lz.append(V("saturación","clipping"))
        if _lz:e.append(V("Limpieza","Cleanup")+": "+", ".join(_lz))
        if cfg.get("upmix")=="S":
            e.append(V("Upmix estéreo->5.1","Upmix stereo->5.1")+f" ("+V("presencia central","center presence")+f" {cfg.get('upmix_central',5)}/10, "+
                     V("quitar voz F/T","remove voice F/R")+f" {cfg.get('upmix_voz',8)}/10)")
        if cfg.get("layout","5.1")!="5.1" and not cfg.get("downmix"):e.append(V("Salida ","Output ")+str(cfg.get("layout")))
        if cfg.get("downmix"):
            if 0<ch<=2 and cfg.get("upmix")!="S":   # origen mono/estereo: no hay downmix, la salida queda limpia (sin Dolby ni LFE)
                e.append(V("Salida 1.0 mono","Output 1.0 mono") if cfg.get("layout")=="1.0" else V("Salida 2.0 estéreo","Output 2.0 stereo"))
            else:
                e.append((V("Salida 1.0 mono","Output 1.0 mono") if cfg.get("layout")=="1.0" else V("Salida 2.0 estéreo","Output 2.0 stereo")+f" ({cfg.get('downmix_modo','dolby')})")+(" +LFE" if cfg.get("downmix_lfe") else ""))
        return e
    def _re(self):
        """resumen de la pista activa (pestaña Edit/Log): el mismo que el de la confirmacion"""
        e=self._re_cfg(self._snap(),self._ch_pactual())
        return e,len(e)>0
    def _portada_buscar_ap(self):
        """(JMG, 16-11) «🔍 Buscar»: la portada del archivo activo, de TMDB (va en el MKV con «MKV con vídeo»)"""
        if not self.pactual:
            self._toast(T("info_tit"),self._vt("Primero elige un archivo (clic en una pista).","First choose a file (click a track)."),seg=4);return
        a=self.pactual[0]
        def puesto(f,t,y):
