_PUERTO_UNICO=47391
def _instancia_unica(archivos):
    """Una sola ventana: la primera instancia escucha en 127.0.0.1; las siguientes (p. ej. «Abrir con» con varios
    archivos) le pasan sus archivos y se cierran. Devuelve el socket servidor, o None si ya habia otra abierta."""
    import socket
    srv=socket.socket(socket.AF_INET,socket.SOCK_STREAM)
    try:
        srv.bind(("127.0.0.1",_PUERTO_UNICO));srv.listen(8);return srv
    except OSError:
        try:srv.close()
        except Exception:pass
    for _ in range(20):          # otra instancia arrancando a la vez: se reintenta un momento
        try:
            c=socket.create_connection(("127.0.0.1",_PUERTO_UNICO),timeout=1.5)
            c.sendall(json.dumps({"jmg":"ap51","archivos":archivos}).encode("utf-8"));c.close();return None
        except OSError:time.sleep(0.15)
    return False                 # no se pudo ni escuchar ni conectar: se abre normal, sin instancia unica
def rh(cmd,**k):
    k.setdefault("capture_output",True);k.setdefault("text",True)
    k.setdefault("encoding","utf-8");k.setdefault("errors","ignore")
    if sys.platform=="win32":k.setdefault("creationflags",CNW)
    return subprocess.run(cmd,**k)
