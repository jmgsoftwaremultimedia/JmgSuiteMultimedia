    def _cfg_path(self):
        return os.path.join(_data_dir(),"config.json")

    def _vpan_ratio(self):
        try:
            h=self.vpan.winfo_height()
            if h>200:return round(self.vpan.sash_coord(0)[1]/float(h),4)
        except Exception:pass
        return None

    def _vpan_ctx(self):
        try:return "vis" if self.nb.select()==str(self._vis_outer) else "def"
        except Exception:return "def"

    def _vpan_soltar(self,e=None):
        """Al soltar el divisor, recuerda la altura del panel para la pestana actual."""
        r=self._vpan_ratio()
        if r:
            if not hasattr(self,"_vp_r"):self._vp_r={}
            self._vp_r[self._vpan_ctx()]=r
            try:
                if not hasattr(self,'_vp_px'):self._vp_px={}
                self._vp_px[self._vpan_ctx()]=self.vpan.sash_coord(0)[1]
            except Exception:pass

    def _vpan_tab(self,e=None):
        """Visualizacion y el resto de pestanas recuerdan alturas distintas.
        El divisor se coloca en el mismo instante que cambia la pestana (antes iba 250 ms despues y todo 'saltaba')."""
        if not hasattr(self,"_vp_r"):self._vp_r={}
        if not hasattr(self,"_vp_px"):self._vp_px={}
        ctx=self._vpan_ctx()
        prev=getattr(self,"_vp_ctx","def")
        if ctx==prev:return
        try:
            y=self.vpan.sash_coord(0)[1]
            if prev=="def" and y>=90:self._vp_px["def"]=y
        except Exception:pass
        if prev not in self._vp_r:
            r=self._vpan_ratio()
            if r:self._vp_r[prev]=r
        self._vp_ctx=ctx
        self._vpan_aplicar(ctx)

    def _vpan_aplicar(self,ctx):
        try:
            mn=0 if ctx=="vis" else 90
            try:self.vpan.paneconfigure(self._vp_top,minsize=mn)
            except Exception:pass
            if ctx=="vis" and not getattr(self,"_vp_r",{}).get("vis"):
                self.vpan.sash_place(0,0,0)  # Visualizacion: panel de archivos a altura 0, solo queda la barra fina del divisor
                return
            px=getattr(self,"_vp_px",{}).get(ctx)
            if px is None:
                r=getattr(self,"_vp_r",{}).get(ctx)
                h=self.vpan.winfo_height()
                if not r or h<200:return
                px=r*h
            self.vpan.sash_place(0,0,int(max(mn,px)))
        except Exception:pass

    def _vpan_restaurar(self,intento=0):
        return   # (JMG, 9-11) al abrir, la ventana como sale por defecto (para que se vea todo), no la raya de la última vez
        try:
            if self.vpan.winfo_height()<200:
                if intento<10:self.root.after(300,self._vpan_restaurar,intento+1)
                return
            with open(self._cfg_path(),encoding="utf-8") as f:d=json.load(f)
            r=float(d.get("panel_ratio",0))
            if r<=0:return
            h=self.vpan.winfo_height()
            y=int(max(90,min(h-250,r*h)))
            self.vpan.sash_place(0,0,y)
            if not hasattr(self,"_vp_r"):self._vp_r={}
            self._vp_r["def"]=r
        except Exception:pass

