    _VZ_SR=4000;_VZ_B=200   # el escaner trabaja a 4 kHz, con bloques de 50 ms
    def _vz_niveles(self,cmd,K,dur,prog=None):
        """hilo: lee K canales s16 de FFmpeg y devuelve el nivel (dB) de cada uno cada 50 ms, sin cargar la pelicula en memoria. None si se cancela o falla"""
        import math,operator
        from array import array
        kw={"stdout":subprocess.PIPE,"stderr":subprocess.DEVNULL}
        if sys.platform=="win32":kw["creationflags"]=CNW
        pr=subprocess.Popen(cmd,**kw)
        with self._lock:self._procesos.append(pr)
        B=self._VZ_B;paso=B*K*2;fr=[array("f") for i in range(K)];resto=b"";leido=0;mul=operator.mul;lg=math.log10
        tot=max(1.0,dur*self._VZ_SR*K*2)
        try:
            while True:
                q=pr.stdout.read(paso*200)
                if not q:break
                if self._cancelar.is_set():
                    self._matar(pr);return None
                leido+=len(q);q=resto+q;n=len(q)//paso*paso;resto=q[n:]
                x=array("h");x.frombytes(q[:n])
                if sys.byteorder!="little":x.byteswap()
                for j in range(K):
                    v=x[j::K];a=fr[j].append
                    for i in range(0,len(v),B):
                        t=v[i:i+B];e=sum(map(mul,t,t))/B
                        a(10.0*lg(e/1073741824.0) if e>0 else -120.0)
                if prog:prog(min(1.0,leido/tot))
            pr.wait()
        finally:
            with self._lock:
                if pr in self._procesos:self._procesos.remove(pr)
        return fr if pr.returncode==0 else None
    @staticmethod
    def _vz_corr(a,b):
        n=len(a);ma=sum(a)/n;mb=sum(b)/n;sab=saa=sbb=0.0
        for x,y in zip(a,b):
            x-=ma;y-=mb;sab+=x*y;saa+=x*x;sbb+=y*y
        return sab/(saa*sbb)**0.5 if saa>0 and sbb>0 else 0.0
    @classmethod
    def _vz_marcas(cls,c,r,vo,du):
        """bloques de 50 ms con voz del original en un canal -> lista de 0/1. c = el canal · r = el canal por el filtro de voz · vo = el central original
        por el filtro de voz (o None) · du = el central del doblaje por el filtro de voz.
        1) eco: donde el nivel del canal SIGUE a la voz del original, sin llegar a ella (la musica suave no la sigue y los golpes la superan).
        2) voz propia del canal: buena parte del canal pasa el filtro de voz (la voz que no va por el central).
        Las dos solo mientras habla el doblaje: asi se libran las canciones"""
        n=min(len(c),len(r),len(du)) if vo is None else min(len(c),len(r),len(du),len(vo))
        if n<40:return [0]*n
        def ref(v):
            a=sorted(x for x in v[:n] if x>-60)
            return a[int(len(a)*0.9)]-20.0 if len(a)>=10 else None
        rd=ref(du)
        if rd is None:return [0]*n
        hab=[0]*n;i0=-99   # hablando el doblaje, con 1 s de margen a cada lado
        for i in range(n):
            if du[i]>=rd:i0=i
            if i-i0<=20:hab[i]=1
        i0=n+99
        for i in range(n-1,-1,-1):
            if du[i]>=rd:i0=i
            if i0-i<=20:hab[i]=1
        m=[0]*n
        rv=ref(vo) if vo is not None else None
        if rv is not None:
            for w in range(0,n-39,10):
                act=[i for i in range(w,w+40) if vo[i]>=rv]
                if len(act)<10 or not any(hab[i] for i in act):continue
                dif=sorted(c[i]-vo[i] for i in act)
                if dif[len(dif)//2]>-6.0:continue
                pl=sorted(c[w:w+40])
                if pl[35]-pl[4]<6.0:continue   # nivel casi fijo: es musica o ambiente, no un eco que sube y baja con la voz
                if cls._vz_corr([max(vo[i],rv) for i in range(w,w+40)],[max(c[i],-70.0) for i in range(w,w+40)])>=0.5:
                    for i in act:
                        if c[i]<=vo[i]-6.0:m[i]=1
        pc=[0.0];pr=[0.0]
        for i in range(n):
            pc.append(pc[-1]+10.0**(c[i]/10.0));pr.append(pr[-1]+10.0**(r[i]/10.0))
        for i in range(n):   # en el segundo que lo rodea, al menos la cuarta parte de la energia del canal es voz
            a=max(0,i-10);b=min(n,i+10)
            if c[i]>-60 and hab[i] and pr[b]-pr[a]>=0.25*(pc[b]-pc[a]):m[i]=1
        return m
    @staticmethod
    def _vz_env(m,seg,c,db=60.0):
        """marcas de 50 ms -> ganancia cada 10 ms: baja db en lo marcado sin que se note la entrada ni la salida. Sigue en 1 hasta seg.
        Los huecos de menos de 1,5 s se unen (el sube y baja es lo que mas se oye), empieza 0,4 s antes para que la voz ya llegue baja y
        sale con 0,6 s de cola por el eco. La bajada dura 0,4 s y la subida 0,8 s, en curva suave y en dB.
        Lo que suene 10 dB por encima del eco se respeta: un golpe tapa el salto y por eso ahi la ganancia sube de golpe"""
        import math
        from array import array
        n=len(m);h=-99;o=list(m)
        e=sorted(c[i] for i in range(n) if m[i]);e=e[len(e)//2]+10.0 if e else 0.0
        for i in range(n):
            if m[i]:
                if 1<i-h<=30:o[h+1:i]=[1]*(i-h-1)
                h=i
        s=[0]*n;h=-99
        for i in range(n):
            if o[i]:h=i
            if i-h<=12:s[i]=1
        h=n+99
        for i in range(n-1,-1,-1):
            if o[i]:h=i
            if h-i<=8:s[i]=1
        g=array("f");p=0.0;fondo=10.0**(-db/20.0);pi_=math.pi
        for i in range(n):
            if c[i]>e and not m[i]:p=0.0
            q=s[i] and not (c[i]>e and not m[i])
            for k in range(5):
                p=min(1.0,p+1.0/40.0) if q else max(0.0,p-1.0/80.0)
                g.append(1.0 if p==0.0 else (fondo if p==1.0 else 10.0**(-db*(0.5-0.5*math.cos(pi_*p))/20.0)))
        while len(g)<seg*100:g.append(1.0)
        return g
    def _comb_silenciar(self,sel,silv,prog,db=(60.0,60.0)):
        """hilo: busca las voces del original. silv={(archivo, pista): canal de su central o None}, db=(cuanto bajan delanteros, traseros)
        -> ({fila: envolvente en temporal}, lineas de registro); None si se cancela"""
        import tempfile
        V=self._vt;fcs,dfc=next((s,d) for c,s,d in sel if c=="FC" and s);R=_ff_ruta(RNN_VOZ);env={};inf=[]
        rn=f"apad=pad_dur=1,asetnsamples=n=480:p=1,arnndn=m={R}:mix=1"
        pasos=1+len(silv);hecho=[0]
        def p(x):prog((hecho[0]+x)/pasos)
        dur=self._dur(fcs[0])
        g=";".join(self._comb_sub(f"0:a:{fcs[1]}",fcs,"q"))+f";[q]aresample=48000,{rn},highpass=f=250:poles=2,aresample={self._VZ_SR}[o]"
        q=self._vz_niveles([FFMPEG,"-v","error","-i",fcs[0],"-filter_complex",g,"-map","[o]","-f","s16le","-"],1,dur,p)
        if q is None:return None
        du=q[0];hecho[0]=1
        for (ruta,orden),cf in silv.items():
            filas=[(n,c,s[2]) for n,(c,s,d) in enumerate(sel) if s and (s[0],s[1])==(ruta,orden) and c not in ("FC","LFE") and isinstance(s[2],int)
                   and (db[0] if c in ("FL","FR") else db[1])>0]   # en 0, ese grupo no se toca
            if not filas:
                hecho[0]+=1;continue
            cs=[s for n,c,s in filas]
            # arnndn usa un hilo por canal: todos a la vez. Salen primero los canales tal cual y detras los filtrados, el central original el ultimo
            lista=cs+([cf] if cf is not None else [])
            N=len(lista);pan=f"pan={N}c|"+"|".join(f"c{i}=c{x}" for i,x in enumerate(lista))
            g=(f"[0:a:{orden}]aresample=48000,{pan},asplit=2[a][b];[b]{rn}[r];[a]apad=pad_dur=1,asetnsamples=n=480:p=1[e];[e][r]amerge=inputs=2,highpass=f=250:poles=2,aresample={self._VZ_SR}[o]")
            d0=self._dur(ruta)
            q=self._vz_niveles([FFMPEG,"-v","error","-i",ruta,"-filter_complex",g,"-map","[o]","-f","s16le","-"],2*N,d0+1.0,p)
            if q is None:return None
            vo=q[N+len(cs)] if cf is not None else None
            # el doblaje, en los tiempos de esta pista (cada una lleva su inicio y su delay)
            des=int(round((self._ini_ms(fcs[0],fcs[1])+dfc-self._ini_ms(ruta,orden)-next(d for c,s,d in sel if s and (s[0],s[1])==(ruta,orden)))/50.0))
            du_=([-120.0]*des+list(du)) if des>0 else list(du[-des:])
            for j,(n,c,ci) in enumerate(filas):
                m=self._vz_marcas(q[j],q[N+j],vo,du_)
                t=sum(m)*0.05
                inf.append(f"{c}: "+V("voces en ","voices in ")+self._hms(t))
                if t>0:
                    h_,p_=tempfile.mkstemp(prefix="jmg_voz_",suffix=".f32")
                    with os.fdopen(h_,"wb") as fh:self._vz_env(m,d0+30.0,q[j],db[0] if c in ("FL","FR") else db[1]).tofile(fh)
                    env[n]=p_
            hecho[0]+=1
        return env,inf
    @staticmethod
    def _tramos_cad(n,cad,tl,tot):
        """filtros que corrigen por tramos la señal de cad (a 48 kHz, de uno o varios canales) -> (lineas de filtro, cadena de salida).
        tl=[(c0, c1, v0, v1)]: el trozo [c0, c1] de la salida sale de la señal en [c0 + v0, c1 + v1] (v = ms que llegaba tarde):
        si v0 != v1 va un poco mas rapido o mas lento (asetrate entero + aresample: cambio de tono inapreciable).
        Largo exacto a la muestra, y un fundido de 3 ms en cada corte (van en silencios) para que no haga clic"""
        import math
        # seguidos y sin huecos: cada tramo empieza donde acaba el anterior; uno de menos de 20 ms se lo queda el anterior
        tl2=[]
        for c0,c1,v0,v1 in tl:
            if tl2:c0=tl2[-1][1]
            if tl2 and c1-c0<0.02:
                a_,b_,w0,w1=tl2[-1];tl2[-1]=(a_,c1,w0,w1);continue
            tl2.append((c0,c1,v0,v1))
        tl=tl2;P=[]
        pre=max(1,math.ceil(-min(min(c0+v0/1000.0,c1+v1/1000.0) for c0,c1,v0,v1 in tl)+0.1))   # silencio delante (s)
        P.append(cad+f",adelay=delays={pre*48000}S:all=1,asplit={len(tl)}"+"".join(f"[t{n}_{i}]" for i in range(len(tl))))
        for i,(c0,c1,v0,v1) in enumerate(tl):
            ult=i==len(tl)-1
            if ult:c1=max(c0+1.0,tot)
            o0=int(round(c0*48000));o1=int(round(c1*48000));N=o1-o0
            S0=int(round((c0+v0/1000.0+pre)*48000));S1=int(round((c1+v1/1000.0+pre)*48000))
            if N<=0 or abs((S1-S0)-N)>0.01*N:S1=S0+max(N,1)   # resbalon imposible (>1 %): el tramo va a delay fijo
            q=f"[t{n}_{i}]atrim=start_sample={S0}:end_sample={S1},asetpts=PTS-STARTPTS"
            R=int(round(48000.0*(S1-S0)/N)) if N>0 else 48000
            if R!=48000:q+=f",asetrate={R},aresample=48000"
            q+=f",apad=whole_len={max(N,1)},atrim=end_sample={max(N,1)}"
            if N>=960:   # fundidos de 3 ms solo si el tramo dura algo (20 ms o mas)
                if i>0:q+=",afade=t=in:d=0.003"
                if not ult:q+=f",afade=t=out:st={N/48000.0-0.003:.6f}:d=0.003"
            P.append(q+f"[u{n}_{i}]")
        return P,"".join(f"[u{n}_{i}]" for i in range(len(tl)))+f"concat=n={len(tl)}:v=0:a=1"
    def _comb_a_vis(self,ruta):
