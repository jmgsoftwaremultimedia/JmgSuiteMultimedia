            self._toast(T("info_tit"),self._vt(f"Portada de «{t} ({y})». Va en el MKV con «MKV con vídeo».",f"Cover of «{t} ({y})». It goes in the MKV with «MKV with video»."),seg=6)
        self._portada_web(self._clean_base(a),puesto)
    def _add_ext_cover(self):
        if not self.pactual: return
        f = filedialog.askopenfilename(title=self._vt("Seleccionar portada","Select cover"), filetypes=[(self._vt("Imágenes","Images"), "*.jpg *.jpeg *.png"), (T("filtro_todos"), "*.*")])
        if f:
            self.ext_cover[self.pactual[0]] = f
            self._ls(f"[+] Portada externa añadida: {os.path.basename(f)}")
            self.btn_add_cover.configure(text=T("btn_loaded"))

    def _conf(self):
        if self.procesando: return
        if getattr(self,"_combinando",False):
            self._toast(T("warn_tit"),self._vt("Espera a que termine «Combinar» (o cancélalo).","Wait until «Combine» finishes (or cancel it)."),tipo="warning",seg=4);return
        if getattr(self,"_escaneando",False) or getattr(self,"_midiendo_ln",False):
            self._toast(T("warn_tit"),self._vt("Espera a que termine la medida del volumen.","Wait until the loudness measurement finishes."),tipo="warning",seg=4);return
        self._cancelar.clear()
        if not self.files:
            self._toast(T("warn_tit"), T("no_files"), tipo="warning"); return

        sel = list(self.lp.curselection())
        if not sel:
            self._toast(T("warn_tit"), self._vt("Selecciona al menos una pista (clic en la lista)","Select at least one track (click on the list)"), tipo="warning"); return

        if self.var_destino_modo.get()=="personalizada":
            c=self.var_destino_carpeta.get().strip()
            if not c or not os.path.isdir(c):
                self._toast(T("error_tit"),T("dest_inv"),tipo="error",seg=8); return

        self._guardar_conf_pista();self._guardar_titulo()   # pulsar PROCESAR no le quita el foco a la casilla del titulo

        agr = {}
        for i in sel:
            if i >= len(self._multi_tracks): continue
            r, idx = self._multi_tracks[i]
            agr.setdefault(r, []).append(idx)

        # Pistas sin video + «MKV con video»: van DENTRO del MKV del archivo de video de la lista (una combinada, por ejemplo)
        extras={};mux_a={}
        if self.var_remux.get():
            sin_v=[r for r in agr if self._video_idx(r) is None]
            if sin_v:
                vids=[f for f in self.files if f not in sin_v and self._video_idx(f) is not None]
                sel_v=[self.files[i] for i in self.la.curselection() if i<len(self.files) and self.files[i] in vids]
                for r in sin_v:
                    nb=self._clean_base(r)
                    v=vids[0] if len(vids)==1 else next((f for f in vids if nb.startswith(self._clean_base(f))),None) or (sel_v[0] if len(sel_v)==1 else None)
                    if v:mux_a[r]=v
        lin = []
        tot = 0
        quitar=[]
        for r in set(agr)|set(mux_a.values()):
            for idx in sorted((self.excluir_pistas.get(r) or set())-set(agr.get(r,[]))):
                quitar.append(f"    {os.path.basename(r)} #{idx}")
        for r, idxs in agr.items():
            lin.append(f"\n  >> {os.path.basename(r)}"+(self._vt("  → dentro de ","  → into ")+os.path.basename(mux_a[r]) if r in mux_a else ""))
            info = self.pc.get(r, [])
            for idx in sorted(set(idxs)):
                tot += 1
                if idx < len(info):
                    p = info[idx]
                    cab = f"    #{p['orden']}  [{p['lang']}]  {_nombre_codec(p['codec'],p.get('perfil'))}  {p['layout']} ({p['channels']}ch)"
                    if abs(float(p.get("ini",0) or 0))>=0.001:cab+=self._vt("  · inicio %+d ms (se mantiene)","  · start %+d ms (kept)")%int(round(float(p["ini"])*1000))
                else:
                    cab = f"    #{idx}"
                lin.append(cab)
                cfg = self.pconf.get((r, idx)) or self._snap()

                # Estado del original
                excluida = r in self.excluir_pistas and idx in self.excluir_pistas[r]
                estado_orig = self._vt("Sustituido por la procesada","Replaced by the processed one") if excluida else self._vt("Conservado","Kept")
                if cfg.get("formato")=="Passthrough":estado_orig=self._vt("Se copia tal cual","Copied as is")

                lin.append(f"       -> {cfg.get('formato','?')}  {cfg.get('bitrate','?')} (Original: {estado_orig})")
                ef = self._re_cfg(cfg,int(p["channels"] or 0) if idx < len(info) else 0)
                if ef:
                    for e in ef: lin.append(f"         . {e}")
                else:
                    lin.append("         . "+T("sin_efectos"))

        if quitar:lin+=["",self._vt("Se quitan del MKV:","Removed from the MKV:")]+quitar
        dest = (self.var_destino_carpeta.get() if self.var_destino_modo.get()=="personalizada" else T("dest_junto"))
        extra = ""
        if self.var_formato.get()=="Passthrough": extra += T("passthrough_warn")+"\n"
        if self.var_al_terminar.get()=="apagar": extra += T("apagado_warn")+"\n"

        if self.var_dup_modo.get()=="over" and not self.var_remux.get():
            conflictos = []
            for ruta, _ in agr.items():
                d = self._cs(ruta); b = os.path.splitext(os.path.basename(ruta))[0]
                try:
                    _, ex, et = self._ccc()
                    if self.var_formato.get() != "WAV Split":
                        sp = os.path.join(d, f"{b}_{et}.{ex}")
                        if os.path.exists(sp): conflictos.append(os.path.basename(sp))
                except Exception: pass
            if conflictos and not self._confirm(T("conf_sobrescribir_t"), T("conf_sobrescribir_x")): return

        cab = self._vt(f"Archivos: {len(agr)}    Pistas: {tot}    Paralelo: {self.var_workers.get()}\nDestino: {dest}\n",
                       f"Files: {len(agr)}    Tracks: {tot}    Parallel: {self.var_workers.get()}\nDestination: {dest}\n")
        det = cab + "\n".join(lin) + ("\n\n" + extra if extra else "")   # todo, para «🔍 Ver todo» (se puede copiar)
        msg = cab + ("\n" + extra if extra else "") + self._vt("\n«🔍 Ver todo»: cada archivo y cada pista con su formato y sus efectos (se puede copiar).\n\n¿Empezar?",
                                                             "\n«🔍 See everything»: each file and each track with its format and effects (it can be copied).\n\nStart?")

        if self._confirm(T("confirmar_t"), msg, det):
            # Todo lo que el proceso necesita se copia AHORA (hilo principal): si durante el proceso se cambia la
            # seleccion, la pista activa o la pestaña Salida, lo que ya esta en marcha no cambia.
            trabajos=[]
            for r, idxs in agr.items():
                vistos=[]
                for idx in idxs:
                    if idx in vistos: continue
                    vistos.append(idx)
                if vistos:
                    tar=[(idx,dict(self.pconf.get((r,idx)) or self._snap_pista())) for idx in vistos]
                    if r in mux_a:extras.setdefault(mux_a[r],[]).extend((r,i_,c_) for i_,c_ in tar)
                    else:trabajos.append((r,tar))
            for v in extras:   # el video recibe la pista aunque no se haya seleccionado ninguna suya
                if not any(r==v for r,_ in trabajos):trabajos.append((v,[]))
            self._lsnap = {k:getattr(self,"var_"+k).get() for k in
                           ("remux","remux_subs","remux_caps","remux_adj","remux_meta","remux_nucleo","dup_modo",
                            "destino_modo","destino_carpeta","formato","bitrate","workers","al_terminar")}
            self._lsnap.update({"extras":extras,"orden":list(self._multi_tracks),
                                "excluir":{r:set(v) for r,v in self.excluir_pistas.items()},
                                "borrar":{r:set(v) for r,v in self.borrar_pistas.items()},
                                "ptitulo":dict(self.ptitulo),"ext_cover":dict(self.ext_cover),"ext_subs":dict(self.ext_subs)})
            self.procesando = True
            self.btn_p.configure(state="disabled", text=T("procesando_btn"))
            self._bp_poner(True)   # (JMG, 14-11) codificando: solo las pestañas y «Cancelar»
            self.prog["value"] = 0
            self.var_progreso_texto.set("...")
            threading.Thread(target=self._lote, args=(trabajos,), daemon=True).start()

    def _opt(self,k):
        """ajuste de salida: durante el proceso, el copiado al empezar; si no, el de la pantalla"""
        s=getattr(self,"_lsnap",None)
        if s is not None and self.procesando and k in s:return s[k]
        return getattr(self,"var_"+k).get()

    def _lote(self, trabajos):
        if not trabajos:
            self._ui(self._lote_vacio,self._vt("No hay pistas válidas para procesar","No valid tracks to process"))
            return
        total=len(trabajos)
        total_pistas=sum(len(t[1]) for t in trabajos)
        self._ls("\n"+"="*50)
        self._ls(f"START - {total} file(s), {total_pistas} track(s)")
        self._ls("="*50)
        # Duraciones (por archivo * n_pistas para el progreso total)
        ds=[self._dur(a)*(len(t)+len(self._lsnap.get("extras",{}).get(a,[]))+(0.1 if self._opt("remux") else 0)) for a,t in trabajos]   # (JMG, 13-11) + montar el MKV
        dt=sum(ds) or 1
        self._cancelar.clear()
        with self._lock:
            self._procesos=[]
            self._prog={a:0.0 for a,_ in trabajos}
        self._ui(lambda:self.btn_c.configure(state="normal"))
        self._fase={}
        self._ui(self._set_prog,1)
        self._st(self._vt("Preparando...","Preparing..."))
        self._ls("[!] Hilo de procesamiento iniciado...")
        wk=max(1,min(4,int(self._lsnap.get("workers",1))))
        ok=0;er=0
        def cbf(r,i,n):
            def cb(s):
                with self._lock:
                    self._prog[r]=s
                    ga=sum(self._prog.values())
                    p=min(100.0,(ga/dt)*100.0)
                self._ui(self._set_prog,max(1.0,p))
                fa=getattr(self,"_fase",{}).get(r,"")
                self._st(f"[{i}/{total}] {n}"+(f" · {fa}" if fa else "")+f" - {p:.1f}%")
            return cb
        def tarea(i,a,tareas):
            return i,a,self._uno_multi(a,tareas,cbf(a,i,os.path.basename(a)))
        with ThreadPoolExecutor(max_workers=wk) as ex:
            futs={}
            for i,(a,tareas) in enumerate(trabajos,1):
                if self._cancelar.is_set():break
                self._ls(f"  -> [{i}/{total}] {os.path.basename(a)} ({len(tareas)} pista/s)")
                f=ex.submit(tarea,i,a,tareas)
                futs[f]=(i,a)
            for f in as_completed(futs):
                i,a=futs[f]
                try:_,_,o=f.result()
                except Exception as e:o=False;self._ls(f"    [EXC] {e}")
                with self._lock:
                    if o:ok+=1
                    else:er+=1
        self._ui(self._set_prog,100)
        self._st(f"{ok} OK / {er}")
        def fin():
            self.procesando=False;self._bp_poner(False)
            accion=self.var_al_terminar.get()   # lo que este puesto AHORA: se puede cambiar con el proceso en marcha
            self._prog_vaciar()
            est="normal" if len(self.files)>0 else "disabled"
            self.btn_p.configure(state=est,text=T("procesar"))
            try:self.btn_c.configure(state="disabled",text=T("cancelar"))
            except tk.TclError:pass
            if self._cancelar.is_set():
                self._toast(T("cancelado_tit"),T("cancelado_x",ok=ok,er=er),tipo="info")
                return
            if ok and accion!="apagar" and getattr(self,"var_abrir_dest",None) is not None and self.var_abrir_dest.get():
                self._abrir_destinos([a for a,t_ in trabajos])
            if accion=="apagar" and er==0:
                try:self._save_cfg()
                except Exception:pass
                self._apa();return
            elif accion=="apagar" and er>0:
                self._toast(T("apagado_cancelado_tit"),T("apagado_cancelado_x",n=er),tipo="warning");return
            elif accion=="suspender":   # (JMG, 15-11)
                try:self._save_cfg()
                except Exception:pass
                self._toast(T("ok_tit"),T("completado_x",ok=ok,er=er),tipo="info" if not er else "warning")
                self._suspender();return
            elif accion=="salir":
                try:self._save_cfg()
                except Exception:pass
                self._toast(T("ok_tit"),T("completado_x",ok=ok,er=er),tipo="info")
                self.root.after(1500,self.root.destroy);return
            elif accion=="reset":
                self._toast(T("ok_tit"),T("completado_x",ok=ok,er=er),tipo="info")
                self.root.after(500,self._rst);return
            else:
                self._toast(T("ok_tit"),T("completado_x",ok=ok,er=er),tipo="info")
        self._ui(fin)
    def _abrir_destinos(self,archivos):
        """«Abrir la carpeta de destino al terminar»: la carpeta elegida o, junto al original, las de los archivos (como mucho 3)"""
        if self.var_destino_modo.get()=="personalizada" and self.var_destino_carpeta.get().strip():ds=[self.var_destino_carpeta.get().strip()]
        else:ds=list(dict.fromkeys(os.path.dirname(a) for a in archivos))[:3]
        for d_ in ds:
            try:
                if os.path.isdir(d_):_abrir_externo(d_)
            except Exception as e:self._log(f"[!] {e}")
    def _cfg_x(self,k,v=None):
        """ajuste suelto de config.json (carpeta de FFmpeg, donde esta el otro programa); v=None = leer"""
        x=self.__dict__.setdefault("_prefs_x",{})
        if v is None:return x.get(k,"")
        x[k]=v;self._save_cfg()
