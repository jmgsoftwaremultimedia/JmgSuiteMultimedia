                import tempfile
                h_,fc_arch=tempfile.mkstemp(prefix="jmg_comb_",suffix=".txt")
                with os.fdopen(h_,"w",encoding="utf-8") as fh:fh.write(fc)
                cmd+=["-/filter_complex",fc_arch]
            else:cmd+=["-filter_complex",fc]
            cmd+=["-map","[out]"]+args+["-progress","pipe:1","-nostats",s_]
            self._ls(f"[COMBINAR] {lay} {fmt} {br} → {os.path.basename(s_)} ({self._hms(tot)})")
            for n,(c,s,d) in enumerate(sel):
                self._ls(f"    {c}: "+((f"{os.path.basename(s[0])} #{s[1]} "+(V("canal","channel")+f" {s[2]+1}" if isinstance(s[2],int) else
                                        {"C":V("C (voz extraída)","C (extracted voice)"),"L":V("L sin voz","L without voice"),"R":V("R sin voz","R without voice")}.get(s[2],str(s[2]))+
                                        " (upmix %d/%g)"%self._comb_up_params(s[0],s[1]))+(f" · delay {d:+g} ms" if d else "")+
                                        (V(" · gama dinámica "," · dynamic range ")+str(self._comb_gama(gama,c)) if self._comb_gama(gama,c)>0 else "")+
                                        (V(" · solo voz"," · voice only") if (solovoz and c=="FC") else "")+
                                        (V(" · voces silenciadas"," · voices silenced") if n in env else "")+
                                        (V(" · tono: "," · tone: ")+self._tono_resumen(tono[n]) if (tono and tono.get(n)) else "")+
                                        (f" · {len(tramos[(s[0],s[1])])} "+V("tramos","parts") if (tramos and tramos.get((s[0],s[1]))) else "")) if s else V("silencio","silence")))
            self._ui(var_est.set,V("Combinando...","Combining..."))
            def cb(t):self._ui(lambda v=min(100.0,t/tot*100.0):pb.configure(value=v))
            try:ok=self._ffm(cmd,cb)
            finally:
                if fc_arch:
                    try:os.remove(fc_arch)
                    except OSError:pass
            if self._cancelar.is_set():
                try:
                    if s_ and os.path.exists(s_):os.remove(s_)
                except OSError:pass
                self._ui(fin,False,"cancel");return
            if ok:   # el idioma de la combinada es el de su central (WAV y FLAC no lo guardan): para cuando entre en un MKV
                if not hasattr(self,"_comb_lang"):self._comb_lang={}
                fc_=next((s for c,s,d in sel if c=="FC" and s),None)
                if fc_:
                    ps_=self.pc.get(fc_[0]) or []
                    lg=(ps_[fc_[1]].get("lang") if fc_[1]<len(ps_) else "") or "und"
                    if lg=="und":
                        m_=re.search(r"_(spa|eng|cat|fre|fra|ger|deu|ita|por)[_.]",os.path.basename(fc_[0]))
                        if m_:lg=m_.group(1)
