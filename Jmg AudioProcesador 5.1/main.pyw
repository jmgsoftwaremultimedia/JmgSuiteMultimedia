            P.append("".join(f"[c{n}]" for n in range(len(sel)))+f"join=inputs={len(sel)}:channel_layout={cl}:map={mp},atrim=end={tot:.6f}[out]")
            args,ext=self._comb_codec(fmt,br)
            d0=dest or os.path.dirname(prim[0])
            base=self._clean_base(prim[0])
            s_=os.path.join(d0,f"{base}_combinada_{lay}.{ext}")
            if os.path.exists(s_):
                if dup=="rename":
                    i=1
                    while os.path.exists(os.path.join(d0,f"{base}_combinada_{lay}_{i}.{ext}")):i+=1
                    s_=os.path.join(d0,f"{base}_combinada_{lay}_{i}.{ext}")
                else:os.remove(s_)
            cmd=[FFMPEG,"-hide_banner","-y"]
            for e in ent:cmd+=["-i",e]
            for n in env:cmd+=["-f","f32le","-ar","100","-ch_layout","mono","-i",env[n]]
