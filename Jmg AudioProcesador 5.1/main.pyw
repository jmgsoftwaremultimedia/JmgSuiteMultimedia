    def _chk_ff(self):
        try:
            r=rh([FFMPEG,"-version"])
            if r.returncode!=0:raise FileNotFoundError
        except FileNotFoundError:
            messagebox.showerror("Error",self._vt("No se encuentra FFmpeg. Comprueba que ffmpeg.exe y ffprobe.exe están en la carpeta «bin».","FFmpeg not found. Check that ffmpeg.exe and ffprobe.exe are in the «bin» folder."));return
        try:
            t=rh([FFMPEG,"-hide_banner","-h","encoder=truehd"])
            if "truehd" not in (t.stdout or "").lower():self._log("[!] No TrueHD. Fallback DTS.")
        except Exception:pass
    def _det(self,ruta):
        try:
            p=rh([FFPROBE,"-v","error","-show_entries","stream=index,codec_type,codec_name,channels,channel_layout,bit_rate,profile,start_time:stream_disposition=attached_pic:stream_tags=language,title:format=format_name,start_time","-of","json",ruta],timeout=20)
            if p.returncode!=0:return []
            data=json.loads(p.stdout or "{}");out=[]
            def _f(v):
                try:return float(v)
                except (TypeError,ValueError):return None
            # referencia = inicio del video (sin portadas); sin video, 0 (en .ts/.m2ts, el inicio del archivo)
            ref=None
            for s in data.get("streams",[]):
                if s.get("codec_type")=="video" and not (s.get("disposition") or {}).get("attached_pic"):
                    ref=_f(s.get("start_time"));break
            if ref is None:
                fm=data.get("format") or {}
                ref=(_f(fm.get("start_time")) or 0.0) if "mpegts" in str(fm.get("format_name","")) else 0.0
            for s in [x for x in data.get("streams",[]) if x.get("codec_type")=="audio"]:
                t=s.get("tags",{}) or {}
                st=_f(s.get("start_time"));ini=(st-ref) if st is not None else 0.0
                if abs(ini)>60:ini=0.0   # valor raro: no se toca
                out.append({"orden":len(out),"index_global":s.get("index","?"),"codec":(s.get("codec_name") or "?").upper(),"perfil":s.get("profile") or "","channels":s.get("channels","?"),"layout":s.get("channel_layout") or "?","bit_rate":s.get("bit_rate"),"lang":(t.get("language") or "und").lower(),"title":t.get("title") or "","profile":(s.get("profile") or ""),
                            "ini":round(ini,4),"start":st})
            return out
        except Exception as e:self._log(f"[!] {e}");return []
    def _detect_fps(self,ruta):
        """Detecta el framerate del video del archivo (o None)"""
        try:
            p=rh([FFPROBE,"-v","error","-select_streams","v:0",
                  "-show_entries","stream=r_frame_rate,avg_frame_rate",
                  "-of","default=noprint_wrappers=1",ruta],timeout=15)
            if p.returncode!=0:return None
            lineas=(p.stdout or "").strip().splitlines()
            for l in lineas:
                if "=" in l and "frame_rate" in l:
                    val=l.split("=",1)[1].strip()
                    if not val:continue
                    if "/" in val:
                        try:
                            num,den=val.split("/");fps=float(num)/float(den)
                        except Exception:continue
                    else:
                        try:fps=float(val)
                        except Exception:continue
                    # el valor conocido MAS CERCANO (antes 24 salia como 23,976 y 30 como 29,97: estan a menos de 0,1)
                    k,nombre=min(FPS_CONOCIDOS,key=lambda kn:abs(fps-kn[0]))
                    if abs(fps-k)<0.05:
                        return nombre
        except Exception:pass
        return None

    def _detectar_fps_bg(self,rutas):
        for r in rutas:
            if r in self._fps_detectados:continue
            try:fps=self._detect_fps(r)
            except Exception:fps=None
            self._fps_detectados[r]=fps
            if fps:self._ui(self._aplicar_fps_si_activo,r,fps)

    def _aplicar_fps_si_activo(self,ruta,fps):
        """framerate recien detectado: se pone en las pistas de ESE archivo que no tienen conversion elegida
        (De = A). Nunca pisa una conversion que haya puesto el usuario."""
        try:
            for (r,k),c in self.pconf.items():
                if r==ruta and str(c.get("fps_from"))==str(c.get("fps_to")):
                    c["fps_from"]=fps;c["fps_to"]=fps
            if self.pactual and self.pactual[0]==ruta and self.var_fps_from.get()==self.var_fps_to.get():
                self.var_fps_from.set(fps)
                self.var_fps_to.set(fps)
            self._ls(f"[FPS] {fps} fps ({os.path.basename(ruta)})")
        except Exception:pass

    def _ini_ms(self,ruta,idx):
        """inicio de la pista respecto al video, en ms (+ = empieza mas tarde que el video)"""
        try:return float((self.pc.get(ruta) or [])[idx].get("ini",0) or 0)*1000.0
        except Exception:return 0.0
    def _medir_tiempo(self,ruta,idx):
        """(inicio respecto al video en s, duracion exacta en s o None). La duracion sale del ultimo paquete
        de la pista (se lee solo el final del archivo: es rapido aunque sea una pelicula)"""
        p_=(self.pc.get(ruta) or [])[idx];ini=float(p_.get("ini",0) or 0);st=p_.get("start")
        try:
            q=rh([FFPROBE,"-v","error","-show_entries","format=duration,start_time","-of","json",ruta],timeout=15)
            fm=json.loads(q.stdout or "{}").get("format") or {}
            D=float(fm.get("duration") or 0);F0=float(fm.get("start_time") or 0)
            if D<=0 or st is None:return (ini,None)
            fin=None
            for atras in (20,120):
                q=rh([FFPROBE,"-v","error","-select_streams",f"a:{idx}","-read_intervals","%.3f%%"%max(0.0,F0+D-atras),
                      "-show_entries","packet=pts_time,duration_time","-of","csv=p=0",ruta],timeout=40)
                for l in (q.stdout or "").splitlines():
                    try:
                        a_,b_=l.strip().split(",")[:2];e=float(a_)+float(b_ or 0)
                        if fin is None or e>fin:fin=e
                    except (ValueError,IndexError):continue
                if fin is not None:break
            return (ini,(fin-float(st)) if fin is not None else None)
        except Exception:return (ini,None)
    @staticmethod
    def _hms(seg):
        """segundos -> 1:52:03,512"""
        sg="-" if seg<0 else "";ms=int(round(abs(seg)*1000))
        h,ms=divmod(ms,3600000);m_,ms=divmod(ms,60000);s_,ms=divmod(ms,1000)
        return f"{sg}{h}:{m_:02d}:{s_:02d},{ms:03d}"
    def _tiempo_pedir(self):
        """pista activa nueva: mide su tiempo en segundo plano (una vez por pista) y lo muestra"""
        if not hasattr(self,"_tiempos"):self._tiempos={}
        k=self.pactual
        if not k:self.var_tiempo.set("");return
        if k in self._tiempos:self._tiempo_txt();return
        self.var_tiempo.set(self._vt("Midiendo...","Measuring..."))
        def w(k=k):
            try:r=self._medir_tiempo(*k)
            except Exception:r=(0.0,None)
            self._tiempos[k]=r
            self._ui(self._tiempo_txt)
        threading.Thread(target=w,daemon=True).start()
    def _tiempo_txt(self):
        try:
            k=self.pactual;r=getattr(self,"_tiempos",{}).get(k) if k else None
            if not r:return
            ini,dur=r;V=self._vt
            ln=[V("Inicio:    %+d ms respecto al vídeo","Start:     %+d ms relative to the video")%int(round(ini*1000))]
            if dur is None:ln.append(V("Duración:  no se ha podido medir","Duration:  could not be measured"))
            else:
                ln.append(V("Duración:  ","Duration:  ")+self._hms(dur))
                ln.append(V("Fin:       ","End:       ")+self._hms(ini+dur))
                try:
                    ff=_fps_exacto(self.var_fps_from.get());ft=_fps_exacto(self.var_fps_to.get());dl=float(self.var_delay_init.get() or 0)
                    if ff!=ft or abs(dl)>=0.5:
                        ln.append(V("Con la sincronización: fin ","With the sync settings: end ")+self._hms(float((ini+dur)*ff/ft)+dl/1000.0))
                except Exception:pass
            self.var_tiempo.set("\n".join(ln))
        except Exception:pass
    def _dur(self,ruta):
        try:
            p=rh([FFPROBE,"-v","error","-show_entries","format=duration","-of","default=noprint_wrappers=1:nokey=1",ruta],timeout=15)
            return float((p.stdout or "0").strip() or 0)
        except (ValueError,Exception):return 0.0
    def _es_m(self,l):
        return any(k in l.lower() for k in ["5.1","5.0","7.1","6.1","7.0","3.1","4.0","4.1","quad"])
    def _multi_cp(self):
        """Carga las pistas de TODOS los archivos seleccionados"""
        self._guardar_conf_pista()
        self.pactual=None
        self.lp.delete(0,"end")
        self._multi_tracks=[]
        s=self.la.curselection()
        if not s:
            self._reset_vars()
            self._set_enabled(False)
            return
        self._set_enabled(True)
        multi = len(s)>1
        for i in s:
            ruta=self.files[i]
            ps=self.pc[ruta] if ruta in self.pc else self._det(ruta)
            if ruta not in self.pc:self.pc[ruta]=ps
            if not ps:continue
            if ruta not in self.pmark:
                self.pmark[ruta]={k:True for k in range(len(ps))}
                for k in range(len(ps)):self.ptitulo[(ruta,k)]="Jmg AudioProcesador 5.1"
                base_cfg=self._cfg_limpia()   # sin efectos: solo lleva los que tu le pongas
                _f=self._fps_archivo(ruta)
                for k in range(len(ps)):
                    c=self._cfg_nueva(base_cfg,ps[k])
                    # la sincronizacion no se hereda de otro archivo: su propio framerate, sin conversion ni delay
                    c.update({"fps_from":_f,"fps_to":_f,"fps_metodo":"tono","delay_init":0})
                    self.pconf[(ruta,k)]=c
            for p in ps:
                idx=p['orden']
                if idx in self.borrar_pistas.get(ruta,()):continue
                self._multi_tracks.append((ruta,idx))
                bt=f" · {int(p['bit_rate'])//1000} kbps" if p["bit_rate"] else ""
                tt=f" · {p['title']}" if p["title"] else ""
                pref=f"[{os.path.basename(ruta)}] " if multi else ""
                self.lp.insert("end",f"{pref}#{p['orden']}  [{p['lang']}]  {_nombre_codec(p['codec'],p.get('perfil'))}  {p['layout']} ({p['channels']}ch){bt}{tt}")
        self._pintar_pistas()

        # Restaurar selecciones guardadas
        self.lp.selection_clear(0, "end")
        sel_count = 0
        for i, (ruta, idx) in enumerate(self._multi_tracks):
            if ruta in self.sel_por_archivo and idx in self.sel_por_archivo[ruta]:
                self.lp.selection_set(i)
                sel_count += 1

        if sel_count > 0:
            self.lp.activate(self.lp.curselection()[0])
            self._sp()
        elif self._multi_tracks:
            self.lp.selection_set(0)
            self.lp.activate(0)
            self._sp()

        self.var_pista_resumen.set(self._vt(f"{len(self._multi_tracks)} pista(s) en {len(s)} archivo(s)",f"{len(self._multi_tracks)} track(s) in {len(s)} file(s)"))
        try:
            p=[self.files[i] for i in s if i<len(self.files) and self.files[i] not in self._fps_detectados]
            if p:threading.Thread(target=self._detectar_fps_bg,args=(p,),daemon=True).start()
        except Exception:pass

    def _toggle_marca_doble(self,e=None):
        """Doble clic: seleccionar SOLO esa pista"""
        try:
            idx=self.lp.nearest(e.y)
            if idx<0:return
            self.lp.selection_clear(0,"end")
            self.lp.selection_set(idx)
            self.lp.activate(idx)
            self._sp()
        except Exception:pass

    def _menu_titulo(self,e=None):
        """Menu contextual para el campo titulo"""
        m=tk.Menu(self.root,tearoff=0)
        m.add_command(label=self._vt("Cortar","Cut"),command=lambda:self.en_tit.event_generate("<<Cut>>"))
        m.add_command(label=self._vt("Copiar","Copy"),command=lambda:self.en_tit.event_generate("<<Copy>>"))
        m.add_command(label=self._vt("Pegar","Paste"),command=lambda:self.en_tit.event_generate("<<Paste>>"))
        m.add_separator()
        m.add_command(label=self._vt("Seleccionar todo","Select all"),command=lambda:(self.en_tit.select_range(0,"end"),self.en_tit.icursor("end")))
        try:
            if e is not None:
                m.tk_popup(e.x_root,e.y_root)
            else:
                m.tk_popup(self.en_tit.winfo_rootx(),self.en_tit.winfo_rooty())
        finally:m.grab_release()
        return "break"

    def _aplicar_a_todas(self):
        """Copia la config de la pista actual a todas las seleccionadas"""
        if not self.pactual:return
        self._guardar_conf_pista()
        ruta_origen,idx_origen=self.pactual
        cfg_origen=self.pconf.get((ruta_origen,idx_origen))
        if cfg_origen is None:return
        sel=self.lp.curselection()
        count=0
        for i in sel:
            if i >= len(self._multi_tracks):continue
            ruta_dest, idx_dest = self._multi_tracks[i]
            if ruta_dest == ruta_origen and idx_dest == idx_origen: continue
            nueva = dict(cfg_origen)
            vieja = self.pconf.get((ruta_dest, idx_dest)) or {}
            # otro archivo: conserva SU sincronizacion (cada archivo tiene su framerate y su delay)
            if ruta_dest != ruta_origen:
                for k in ("fps_from","fps_to","fps_metodo","delay_init"):
                    if k in vieja: nueva[k] = vieja[k]
                    elif k in ("fps_from","fps_to"): nueva[k] = self._fps_archivo(ruta_dest)
            # distinto numero de canales de entrada: conserva SUS canales de salida y su formato
            if self._nch(ruta_dest, idx_dest) != self._nch(ruta_origen, idx_origen):
                for k in ("layout","downmix","upmix","formato","bitrate"):
                    if k in vieja: nueva[k] = vieja[k]
            self.pconf[(ruta_dest, idx_dest)] = nueva
            self.ptitulo[(ruta_dest, idx_dest)] = self.ptitulo.get((ruta_origen,idx_origen),"")
            count+=1
        self._pintar_pistas()
        self._log(f"[CFG] Aplicados ajustes de la pista a {count} pista(s) mas")
        if count>0:
            self._toast(self._vt("Ajustes aplicados","Settings applied"), self._vt(f"Se han aplicado a {count} pista(s) más.",f"Applied to {count} more track(s)."), tipo="info", seg=4)
        else:
            self._toast(T("warn_tit"), self._vt("No hay otras pistas seleccionadas para aplicar.","No other selected tracks to apply to."), tipo="warning", seg=3)

    def _nch(self,ruta,idx):
        try:return int((self.pc.get(ruta) or [])[idx].get("channels",6))
        except Exception:return 6

    def _sel_todas(self):
        total = self.lp.size()
        if total > 0 and len(self.lp.curselection()) == total:
            self.lp.selection_clear(0, "end")
        else:
            self.lp.selection_set(0, "end")
        self._sp()

    def _subir_pista(self):
        sel = self.lp.curselection()
        if not sel or len(sel) > 1: return
        idx = sel[0]
        if idx > 0:
            self.lp.selection_clear(0, "end")
            self._multi_tracks[idx], self._multi_tracks[idx-1] = self._multi_tracks[idx-1], self._multi_tracks[idx]
            self._pintar_pistas()
            self.lp.selection_set(idx-1)
            self.lp.activate(idx-1)
            self.lp.see(idx-1)
            self._sp_real()

    def _bajar_pista(self):
        sel = self.lp.curselection()
        if not sel or len(sel) > 1: return
        idx = sel[0]
        if idx < len(self._multi_tracks)-1:
            self.lp.selection_clear(0, "end")
            self._multi_tracks[idx], self._multi_tracks[idx+1] = self._multi_tracks[idx+1], self._multi_tracks[idx]
            self._pintar_pistas()
            self.lp.selection_set(idx+1)
            self.lp.activate(idx+1)
            self.lp.see(idx+1)
            self._sp_real()

    def _borrar_pista_total(self):
        """la pista desaparece: de la lista, de Combinar y del MKV. Un archivo sin video que se queda sin pistas sale de la lista"""
        sel = self.lp.curselection()
        if not sel: return
        self._guardar_conf_pista()
        toc=set()
        for i in sel:
            if i < len(self._multi_tracks):
                ruta, idx = self._multi_tracks[i]
                self.borrar_pistas.setdefault(ruta,set()).add(idx);toc.add(ruta)
                if ruta in self.excluir_pistas:self.excluir_pistas[ruta].discard(idx)
                if ruta in self.sel_por_archivo:self.sel_por_archivo[ruta].discard(idx)
        vac=[r for r in toc if len(self.borrar_pistas[r])>=len(self.pc.get(r) or []) and self._video_idx(r) is None]
        if vac:
            self.la.selection_clear(0,"end")
            for r in vac:self.la.selection_set(self.files.index(r))
            self._del();self._vis_chk_files()
        else:self._multi_cp()

    def _eliminar_pista(self):
        sel = self.lp.curselection()
        if not sel: return
        self._guardar_conf_pista()
        for i in sel:
            if i < len(self._multi_tracks):
                ruta, idx = self._multi_tracks[i]
                if ruta not in self.excluir_pistas:
                    self.excluir_pistas[ruta] = set()
                if idx in self.excluir_pistas[ruta]:
                    self.excluir_pistas[ruta].remove(idx) # Si ya estaba, lo desmarcamos
                else:
                    self.excluir_pistas[ruta].add(idx) # Si no, lo marcamos para borrar
                    # sin seleccionar sale del MKV sin mas; si se vuelve a seleccionar, la procesada ocupa su lugar
                    self.lp.selection_clear(i)
                    if ruta in self.sel_por_archivo:self.sel_por_archivo[ruta].discard(idx)
        self._pintar_pistas()

    def _guardar_titulo(self,e=None):
        if not self.pactual:return
        ruta,idx=self.pactual
        self.ptitulo[(ruta,idx)]=self.var_titulo_pista.get()

    def _pintar_pistas(self):
        if not self._multi_tracks:return
        try:sel=set(self.lp.curselection())
        except Exception:return
        multi = len(self.la.curselection())>1
        for i in range(self.lp.size()):
            if i >= len(self._multi_tracks):break
            ruta, idx = self._multi_tracks[i]
            ps = self.pc.get(ruta, [])
            if idx >= len(ps):continue
            p = ps[idx]
            bt=f" · {int(p['bit_rate'])//1000} kbps" if p["bit_rate"] else ""
            tt=f" · {p['title']}" if p["title"] else ""
            pref=f"[{os.path.basename(ruta)}] " if multi else ""

            is_excluded = ruta in self.excluir_pistas and idx in self.excluir_pistas[ruta]

            if is_excluded:
                txt=f"[-] {pref}#{p['orden']}  [{p['lang']}]  {_nombre_codec(p['codec'],p.get('perfil'))}  {p['layout']} ({p['channels']}ch){bt}{tt}"
                bg=CDN; fg=CAV
            elif i in sel:
                txt=f"* {pref}#{p['orden']}  [{p['lang']}]  {_nombre_codec(p['codec'],p.get('perfil'))}  {p['layout']} ({p['channels']}ch){bt}{tt}"
                bg=CASB; fg=CASF
            else:
                txt=f"  {pref}#{p['orden']}  [{p['lang']}]  {_nombre_codec(p['codec'],p.get('perfil'))}  {p['layout']} ({p['channels']}ch){bt}{tt}"
                bg=CDN; fg=CT

            try:
                self.lp.delete(i);self.lp.insert(i,txt)
                self.lp.itemconfig(i,bg=bg,fg=fg)
            except Exception:pass
        self.lp.selection_clear(0,"end")
        for i in sel:self.lp.selection_set(i)

    def _actualizar_pista_ui(self):
        """Actualiza el campo titulo + checkbox procesar de la pista actual"""
        try:
            if not self.pactual:return
            ruta,idx=self.pactual
            # Checkbox procesar
            m=self.pmark.get(ruta,{}).get(idx,True)
            self.var_procesar.set(m)
            # Titulo
            t=self.ptitulo.get((ruta,idx),"")
            self.var_titulo_pista.set(t)
            # Asegurar que el campo esta activo
            self.en_tit.configure(state="normal",bg=CDN,fg=CT,insertbackground=CT)

            # Contador de marcadas
            total=len(self.pmark.get(ruta,{}))
            self.lbl_marcadas.configure(text=self._vt(f"{total} pista(s)",f"{total} track(s)"))
            self._sinc_lista();self._sinc_txt()
        except Exception:pass

    def _sarch(self,e=None):
        self._refs()
        s=self.la.curselection()
        if not s:return
        self._multi_cp()
    def _refs(self,e=None):
        try:
            ss=set(self.la.curselection())
            for i in range(self.la.size()):
                self.la.itemconfig(i,bg=CASB,fg=CASF,selectbackground=CASB,selectforeground=CASF) if i in ss else self.la.itemconfig(i,bg=CDN,fg=CT)
        except tk.TclError:pass
        # Refrescar colores de la lista de pistas
        try:self._refrescar_colores_pistas()
        except Exception:pass

    def _refrescar_colores_pistas(self):
        return
    def _layp(self,i):
        if self.aa and self.aa in self.pc:
            ps=self.pc[self.aa]
            if 0<=i<len(ps):
                p=ps[i];self.var_layout.set(f"{p.get('layout','?')} ({p.get('channels','?')} ch)");self._upmix();return
        self.var_layout.set("—");self._upmix()
    def _upmix(self):
        if not self.files:
            return
        if self._es_m(self.var_layout.get()):
            self.var_upmix.set("N")
            self._cfgw(self.rb_no,state="disabled");self._cfgw(self.rb_si,state="disabled")
            self._cfgw(self.sl_uc,state="disabled");self._cfgw(self.en_uc,state="disabled")
            self._cfgw(self.lbl_up,text=self._vt("(no disponible: el origen ya es multicanal)","(not available: the source is already multichannel)"),foreground=CA)
        else:
            self._cfgw(self.rb_no,state="normal");self._cfgw(self.rb_si,state="normal")
            st="normal" if self.var_upmix.get()=="S" else "disabled"
            self._cfgw(self.sl_uc,state=st);self._cfgw(self.en_uc,state=st)
            lt=self.var_layout.get().lower()
            self._cfgw(self.lbl_up,text="" if lt in ("—","") else self._vt("(entrada: %s)","(input: %s)")%self.var_layout.get(),foreground=CA)
        self._lay_estado();self._canales_ui()
    def _sp(self,e=None):
        # Defer para que el listbox actualice activate primero
        try:self.root.after_idle(self._sp_real)
        except Exception:pass

    def _sp_real(self):
        sel=self.lp.curselection()
        if not sel:
            self._pintar_pistas()
            self.pactual=None
            self.var_pista_resumen.set(self._vt("0 pistas seleccionadas","0 tracks selected"))
            return

        # Guardar que pistas estan seleccionadas en los archivos actualmente visibles
        archivos_visibles = [self.files[i] for i in self.la.curselection() if i < len(self.files)]   # rutas (no numeros de fila)
        for ruta in archivos_visibles:
            self.sel_por_archivo[ruta] = set()
        for i in sel:
            if i < len(self._multi_tracks):
                ruta, idx = self._multi_tracks[i]
                if ruta in archivos_visibles:
                    if ruta not in self.sel_por_archivo:
                        self.sel_por_archivo[ruta] = set()
                    self.sel_por_archivo[ruta].add(idx)

        try:i=self.lp.index("active")
        except Exception:i=sel[-1]
        if i not in sel:i=sel[-1]
        self._guardar_conf_pista()
        if i < len(self._multi_tracks):
            ruta, idx_real = self._multi_tracks[i]
            self.aa = ruta
            self.pactual=(ruta, idx_real)
            _nueva=(ruta,idx_real) not in self.pconf
            self._cargar_conf_pista(ruta, idx_real)
            self._layp(idx_real)
            self._dmm()   # los formatos dependen de los canales de ESTA pista (2.0: tambien Passthrough), y hasta aqui no se sabian
            if _nueva:self._lay_def_aplicar()   # pista nueva: la salida tiene los mismos canales que la entrada
            self._actualizar_pista_ui()
            try:self._ex_eqvol()
            except Exception:pass
            self._tiempo_pedir()
            self._pintar_pistas()
            n_sel=len(sel)
            total=len(self._multi_tracks)
            self.var_pista_resumen.set(self._vt(f"{n_sel}/{total} pistas seleccionadas",f"{n_sel}/{total} tracks selected"))

    # ---------- Deshacer / Rehacer: las ultimas 5 acciones, de cualquier tipo (ajustes de cualquier pista, añadir o quitar archivos,
    #            eliminar pistas, titulos, marcas...), en todas las pestañas menos Visualizacion (que tiene los suyos) ----------
    _UD_MAX=5
    _UD_ARCH=("ppa","usp","ext_subs","ext_cover","pmark","ptramos","ptitulo","borrar_pistas","excluir_pistas","sel_por_archivo")
    _UD_GLOB=("remux","remux_subs","remux_caps","remux_adj","remux_meta","remux_nucleo","destino_modo","destino_carpeta","dup_modo","al_terminar")
    def _ud_tick(self):
        try:self._ud_reg(False);self._ud_botones()
        except Exception:pass
        try:self.root.after(300,self._ud_tick)
        except Exception:pass
    def _ud_estado(self):
        """foto de todo lo que se puede deshacer"""
        import copy
        pc_={k:dict(v) for k,v in self.pconf.items()}
        if self.pactual:pc_[self.pactual]=self._snap_pista()   # lo que hay en pantalla, aunque aun no se haya guardado en la pista
        s_=self._snap()
        e={"files":list(self.files),"pc":{f:self.pc.get(f) for f in self.files},"pconf":pc_,"glob":{k:s_[k] for k in self._UD_GLOB if k in s_}}
        for nm in self._UD_ARCH:e[nm]=copy.deepcopy(getattr(self,nm,{}))
        try:e["la_sel"]=list(self.la.curselection())
        except Exception:e["la_sel"]=[]
        return e
    @staticmethod
    def _ud_firma(e):
        """lo que cuenta como accion: no la seleccion, ni lo que el programa mide solo (el framerate del archivo)"""
        pc_={k:{x:v for x,v in c.items() if x not in ("fps_from","fps_to")} for k,c in e["pconf"].items()}
        return repr((e["files"],sorted(pc_.items(),key=lambda q:repr(q[0])),e["glob"],[(nm,e[nm]) for nm in ("pmark","ptramos","ptitulo","borrar_pistas","excluir_pistas","usp","ext_subs","ext_cover")]))
    def _ud_reg(self,ya=True):
        """apunta la accion cuando se queda quieta 0,6 s (al arrastrar un deslizador no se apunta cada paso). ya=True: ahora mismo"""
        if self.procesando or getattr(self,"_ud_poniendo",False):return
        if not hasattr(self,"_ud_h"):self._ud_h=[];self._ud_r=[];self._ud_cand=None
        e=self._ud_estado();f=self._ud_firma(e)
        if self._ud_h and self._ud_h[-1][0]==f:
            self._ud_cand=None;self._ud_h[-1]=(f,e);return   # misma accion: se queda la foto mas nueva (seleccion incluida)
        if not self._ud_h:self._ud_h.append((f,e));return   # punto de partida
        if ya or (self._ud_cand and self._ud_cand[0]==f and time.time()-self._ud_cand[1]>=0.6):
            self._ud_h.append((f,e));del self._ud_h[:-(self._UD_MAX+1)];self._ud_r.clear();self._ud_cand=None
        elif not self._ud_cand or self._ud_cand[0]!=f:self._ud_cand=(f,time.time())
    def _ud_puede(self):
        try:vis=self.nb.select()==str(self._vis_outer)
        except Exception:vis=False
        if vis or self.procesando or not hasattr(self,"_ud_h"):return False,False
        return len(self._ud_h)>=2,bool(self._ud_r)
    def _ud_botones(self):
        u,r=self._ud_puede()
        for b,ok in ((getattr(self,"btn_ud",None),u),(getattr(self,"btn_ur",None),r)):
            if b is None:continue
            st="normal" if ok else "disabled"
            try:
                if str(b.cget("state"))!=st:b.configure(state=st)
            except Exception:pass
    def _deshacer(self):self._ud_mover(-1)
    def _rehacer(self):self._ud_mover(1)
    def _ud_tecla(self,e,sen):
        """Ctrl+Z / Ctrl+Y en la ventana principal (en un texto, lo suyo)"""
        if getattr(self,"_bp_prev",None) is not None:return "break"   # (JMG, 14-11) codificando
        try:
            if e.widget.winfo_class()=="Text" or e.widget.winfo_toplevel() is not self.root:return None
        except Exception:return None
        self._ud_mover(sen);return "break"
    def _ud_mover(self,sen):
        if self._bloq():return
        self._ud_reg(True)   # lo ultimo que has hecho, aunque no hayan pasado 0,6 s
        u,r=self._ud_puede()
        if not (u if sen<0 else r):return
        if sen<0:self._ud_r.append(self._ud_h.pop())
        else:self._ud_h.append(self._ud_r.pop())
        self._ud_poner(self._ud_h[-1][1])
        e=self._ud_estado();self._ud_h[-1]=(self._ud_firma(e),e)   # lo que ha quedado (con lo que arrastra) es el punto de partida
        self._ud_botones()
    def _ud_poner(self,e):
        """vuelve a dejar el programa como en la foto e"""
        import copy
        self._ud_poniendo=True
        try:
            self.pactual=None   # que al recargar no se guarde encima lo que hay en pantalla
            self.files[:]=list(e["files"])
            for f,ps in e["pc"].items():
                if ps is not None:self.pc[f]=ps
            self.pconf.clear();self.pconf.update({k:dict(v) for k,v in e["pconf"].items()})
            for nm in self._UD_ARCH:
                d_=getattr(self,nm,None)
                if isinstance(d_,dict):d_.clear();d_.update(copy.deepcopy(e[nm]))
            for k,v in e["glob"].items():
                try:getattr(self,"var_"+k).set(v)
                except Exception:pass
            self.la.delete(0,"end")
            for f in self.files:self.la.insert("end",os.path.basename(f))
            for i in e["la_sel"]:
                if i<len(self.files):self.la.selection_set(i)
            if self.files and not self.la.curselection():self.la.selection_set(0)
            self._cnt();self._multi_cp()
            for f_ in (self._dst,self._rmx,self._ex,self._vis_chk_files):
                try:f_()
                except Exception:pass
        finally:
            self._ud_poniendo=False
    def _fv(self,v):
        try:
            f=float(v);return str(int(f)) if f==int(f) else f"{f:.1f}"
        except (ValueError,TypeError):return str(v)
    def _ui(self,fn,*args):
        """pide al hilo principal que ejecute fn(*args). Seguro desde cualquier hilo
        (llamar a Tk desde otro hilo puede quedarse esperando hasta que se mueve el raton)."""
        try:self._uiq.put((fn,args))
        except AttributeError:
            try:self.root.after_idle(fn,*args)
            except Exception:pass
    def _ui_poll(self):
        try:
            for _ in range(200):
                fn,args=self._uiq.get_nowait()
                try:fn(*args)
                except Exception as e:
                    try:self._log("[UI] %s"%e)
                    except Exception:pass
        except Exception:pass
        try:self.root.after(40,self._ui_poll)
        except Exception:pass
    def _cmb_sin_foco(self,e=None):
        """tras elegir en un desplegable, quitar la seleccion azul del texto y el foco"""
        try:
            w=e.widget;w.selection_clear();w.icursor("end")
            self.root.after_idle(self.root.focus_set)
        except Exception:pass
    def _hid(self,p):
        """marco que nunca se muestra: aloja los antiguos deslizadores de Atenuacion (retirados)"""
        k="_hid_"+str(p)
        fr=getattr(self,"_hidd",{}).get(k)
        if fr is None or not fr.winfo_exists():
            fr=ttk.Frame(p)
            if not hasattr(self,"_hidd"):self._hidd={}
            self._hidd[k]=fr
        return fr
    def _cfgw(self,w,**kw):
        """configure solo si algo cambia: reconfigurar un deslizador mientras se arrastra hace que salte"""
        ch={}
        for k,v in kw.items():
            try:
                if str(w.cget(k))!=str(v):ch[k]=v
            except Exception:ch[k]=v
        if ch:w.configure(**ch)
    def _tra(self,var,cb,w):
        """trace_add que se elimina sola al destruir el widget (evita trazas duplicadas al cambiar tema/idioma)"""
        tid=var.trace_add("write",cb)
        def _rm(ev,v=var,t=tid):
            if ev.widget is w:
                try:v.trace_remove("write",t)
                except Exception:pass
        w.bind("<Destroy>",_rm,add="+")
        return tid
    def _raw(self,var):
        """valor real de la variable (IntVar.get() trunca 8.8 -> 8)"""
        try:return float(self.root.globalgetvar(str(var)))  # global: durante el arrastre Tcl esta dentro de un proc de ttk
        except Exception:
            try:return float(var.get())
            except Exception:return 0.0
    def _sl(self,p,lbl,var,a,b,r,d=0,cl=0,cs=1,cv=2,lw=22,sl=200,step=0):
        if not step and isinstance(var,tk.IntVar):step=1
        if lbl:(ttk.Label(p,text=lbl) if lw>=20 else ttk.Label(p,text=lbl,width=lw)).grid(row=r,column=cl,sticky="w",padx=5,pady=3)
        e=ttk.Scale(p,from_=a,to=b,variable=var,orient="horizontal",length=int(sl*0.75))
        e.grid(row=r,column=cs,padx=(5,1),pady=3)
        ve=tk.StringVar(value=self._fv(var.get()))
        en=tk.Entry(p,textvariable=ve,width=6,justify="center",bg=CDN,fg=CT,insertbackground=CT,relief="flat",highlightthickness=1,highlightbackground=CSB,highlightcolor=CID,borderwidth=0,readonlybackground=CDN,disabledbackground=CDN)
        en.grid(row=r,column=cv,padx=(1,5),pady=3)
        def rv():
            x=self._raw(var)
            if step:x=max(a,min(b,int(round(x/float(step))*step)))
            return x
        def oc(*_):
            x=rv()
            try:ac=float(ve.get().replace(",","."))
            except ValueError:ac=None
            if ac is None or abs(ac-x)>0.001:ve.set(self._fv(x))
        self._tra(var,oc,e)
        def ap(e_=None):
            try:v=float(ve.get().replace(",","."))
            except ValueError:ve.set(self._fv(rv()));self.root.focus_set();return
            if step:v=int(round(v/float(step))*step)
            v=max(a,min(b,v));var.set(v);ve.set(self._fv(v))
            try:e.set(v)
            except Exception:pass
            if e_ and e_.keysym in ("Return", "KP_Enter"):
                self.root.focus_set()
        en.bind("<Return>",ap);en.bind("<FocusOut>",ap);en.bind("<KP_Enter>",ap)
        def dbl(ev=None):
            var.set(d);ve.set(self._fv(d))
            try:e.set(d)
            except Exception:pass
        e.bind("<Double-Button-1>",dbl)
        if step:
            _g=[False]
            def snap(*_):
                if _g[0]:return
                x=self._raw(var)
                sv=max(a,min(b,int(round(x/float(step))*step)))
                if abs(sv-x)>1e-6:
                    _g[0]=True
                    try:var.set(sv)
                    finally:_g[0]=False
            self._tra(var,snap,e)
            def soltar(ev=None):
                # al soltar el raton, la barra queda exactamente en el valor redondeado (una sola vez, sin bucles)
                try:
                    sv=max(a,min(b,int(round(self._raw(var)/float(step))*step)))
                    if abs(float(e.get())-sv)>1e-6:e.set(sv)
                except Exception:pass
            e.bind("<ButtonRelease-1>",soltar,add="+")
        # flechas del teclado: clic en el deslizador y ← → (o ↑ ↓) lo mueven de uno en uno
        paso=step or (0.5 if isinstance(var,tk.DoubleVar) and (b-a)<=40 else 1)
        e.configure(takefocus=1);e.bind("<Button-1>",lambda ev:e.focus_set(),add="+")
        def mv(ev,s):
            try:
                if "disabled" in e.state():return "break"
            except Exception:pass
            v=max(a,min(b,round(self._raw(var)/paso)*paso+s*paso))
            var.set(int(v) if float(paso).is_integer() else v)
            return "break"
        for k_,s_ in (("<Left>",-1),("<Down>",-1),("<Right>",1),("<Up>",1)):e.bind(k_,lambda ev,s_=s_:mv(ev,s_))
        e.configure(cursor="hand2");return e,en
    def _caja_auto(self,p,cmd):
        """(JMG, 14-11) «Auto» del mismo ancho y alto que las casillas de valor (una tk.Entry de 6): un marco de ese tamaño exacto con el
        botón dentro, sea cual sea la escala de la pantalla -> (marco para colocar, botón)"""
        ref=tk.Entry(p,width=6,relief="flat",highlightthickness=1,borderwidth=0);w_,h_=ref.winfo_reqwidth(),ref.winfo_reqheight();ref.destroy()
        fr=ttk.Frame(p,width=w_,height=h_);fr.pack_propagate(False)
        b=ttk.Button(fr,text="Auto",style="Auto.TButton",command=cmd);b.pack(fill="both",expand=True)
        return fr,b
    def _btn_auto(self,p,ef):
        """boton «Auto» de un efecto: ajusta segun la medida de la pista -> el marco del tamaño de una casilla (para colocarlo)"""
        fr,b=self._caja_auto(p,(lambda:self._auto_canales(ef)) if ef in ("tono","vol") else (lambda:self._auto_efecto(ef)))
        self._auto_bts[ef]=b
        if not getattr(self,"_auto_bucle_on",False):self._auto_bucle_on=True;self.root.after(600,self._auto_bucle)
        return fr
    def _auto_pintar(self):
        """(JMG, 8-11) el «Auto» que está puesto en la pista activa: el rayo y la palabra en verde"""
        h=getattr(self,"_auto_hecho",{})
        for ef,b in list(getattr(self,"_auto_bts",{}).items()):
            try:
                a=h.get((self.pactual,ef)) if self.pactual else None
                st_="AutoOn.TButton" if (a is not None and self._auto_sigue(a)) else "Auto.TButton"
                if str(b.cget("style"))!=st_:b.configure(style=st_)
            except Exception:pass
    def _auto_sigue(self,a):
        """(JMG, 8-11) lo que puso el «Auto» sigue en pantalla (tocado a mano o reseteado: ya no está puesto)"""
        try:return all(self._igual_v(getattr(self,"var_"+x).get(),v) for x,v in a.items() if hasattr(self,"var_"+x))
        except Exception:return False
    def _auto_tras_reset(self,todo):
        """después de «Resetear»: se olvidan los «Auto» que ya no están (con «Todo», todos)"""
        h=getattr(self,"_auto_hecho",None)
        if not h:return
        for (k,ef),a in list(h.items()):
            if todo or (k==self.pactual and (not a or not self._auto_sigue(a))):h.pop((k,ef),None)
        self._auto_pintar()
    def _auto_bucle(self):
        try:
            if self.root.winfo_exists():self._auto_pintar();self.root.after(400,self._auto_bucle)
        except Exception:pass
    def _tit_auto(self,p,row,txt,ef,pady=(4,2),padx=5,col=2):   # (JMG, 13-11) col 2: un poco más a la izquierda (no se corta)
        """titulo de una seccion con su boton «Auto» en la columna de botones: todos alineados"""
        ttk.Label(p,text=txt,font=("",10,"bold")).grid(row=row,column=0,columnspan=2,sticky="w",padx=padx,pady=pady)
        self._btn_auto(p,ef).grid(row=row,column=col,padx=(1,5),pady=pady)   # (JMG, 14-11) como las casillas de valor: misma columna y margen
    def _gcols(self,f):
        """columnas comunes de la columna izquierda (mismas posiciones en todas las pestañas)"""
        for i,w in enumerate(G_COLS):f.columnconfigure(i,minsize=w,weight=0)
    def _dos_cols(self,f):
        """columna izquierda | raya vertical centrada en el hueco | columna derecha (misma posicion en todas)"""
        f.columnconfigure(0,weight=0);f.columnconfigure(1,weight=1,minsize=40);f.columnconfigure(2,weight=0,minsize=G_RW)
        f.rowconfigure(0,weight=1)
        L=ttk.Frame(f);L.grid(row=0,column=0,sticky="nw",padx=(4,0),pady=(0,4))
        ttk.Separator(f,orient="vertical").grid(row=0,column=1,sticky="ns",pady=(8,8))
        R=ttk.Frame(f,width=G_RW-12);R.grid(row=0,column=2,sticky="new",padx=(0,12),pady=5)
        self._gcols(L)
        return L,R
    def _unif_r(self,R):
        """columna derecha: la ultima columna absorbe el ancho y las rayas la cruzan entera"""
        try:
            nc=max(1,R.grid_size()[0])
            R.columnconfigure(nc-1,weight=1)
            for w in R.grid_slaves():
                if w.winfo_class()=="TSeparator" and str(w.cget("orient"))=="horizontal":
                    w.grid_configure(column=0,columnspan=nc,sticky="ew")
        except Exception:pass
    def _unif(self,f):
        """rayas y textos de la columna izquierda: rayas = ancho completo; textos largos partidos al mismo ancho"""
        # filas con algo propio en la columna 3 (p. ej. «Medir y ajustar Master»): ahi no se ensancha nada
        occ=set()
        for w in f.grid_slaves():
            gi=w.grid_info();c=int(gi["column"]);cs=int(gi.get("columnspan",1));r=int(gi["row"]);rs=int(gi.get("rowspan",1))
            if c==3:occ.update(range(r,r+rs))
        for w in f.grid_slaves():
            try:
                gi=w.grid_info();r=int(gi["row"]);rs=int(gi.get("rowspan",1))
                if int(gi["column"])==0 and int(gi.get("columnspan",1))==3 and w.winfo_class()=="TFrame" and not (occ & set(range(r,r+rs))):
                    w.grid_configure(columnspan=4)
            except Exception:pass
        for w in f.grid_slaves():
            try:
                gi=w.grid_info();cs=int(gi.get("columnspan",1))
                if w.winfo_class()=="TSeparator" and str(w.cget("orient"))=="horizontal":
                    w.grid_configure(column=0,columnspan=4,sticky="ew")
                elif w.winfo_class()=="TLabel" and cs>=3 and int(gi.get("column",0))==0:
                    w.grid_configure(columnspan=4)
                    if not str(w.cget("textvariable")) or str(w.cget("wraplength")) not in ("","0"):
                        w.configure(wraplength=G_WRAP,justify="left")
            except Exception:pass
    def _techo_box(self,p,row,var,ncol=3):
        fr=ttk.Frame(p);fr.grid(row=row,column=1,columnspan=ncol,sticky="w",padx=5)
        ttk.Label(fr,text=T("techo"),foreground=CA).pack(side="left",padx=(0,6))
        _sl=self._vt("Sin límite","No limit")
        if var.get() in ("Sin límite","No limit",""):var.set(_sl)   # el motor trata cualquier valor que no sea dBFS como «sin límite»
        cb=ttk.Combobox(fr,values=["-2 dBFS","-1 dBFS","-0,5 dBFS",_sl],width=11,state="readonly",textvariable=var);cb.pack(side="left")
        self._ayuda_flotante(cb,self._vt("Ningún pico pasará de este nivel. «Sin límite» puede saturar si subes mucho el efecto.","No peak will go above this level. «No limit» can clip if you raise the effect a lot."))
        return cb
    def _build(self):
        self._cw={"FC":[],"LFE":[],"BL":[],"BR":[],"BMDB":[]};self._px={};self._gx={};self._eqr={}
