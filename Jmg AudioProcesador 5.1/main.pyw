    def _addl(self,rs):
        ad=0;du=0;pr=None;malos=[]
        for r in rs:
            rn=os.path.normpath(os.path.abspath(r))
            if rn in self.files:du+=1;continue
            # sin pistas de audio (video mudo, archivo dañado o que no es multimedia): no se añade
            try:ps=self.pc[rn] if rn in self.pc else self._det(rn)
            except Exception:ps=[]
            if not ps:
                malos.append(os.path.basename(rn));self.pc.pop(rn,None);continue
            self.pc[rn]=ps
            self.files.append(rn);self.la.insert("end",os.path.basename(rn))
            if rn not in self.ppa:self.ppa[rn]=0
            if pr is None:pr=rn
            ad+=1
        self._cnt()
        if ad:
            self._log(f"[+] {ad} added")
            if pr:
                i=self.files.index(pr);self.la.selection_clear(0,"end");self.la.selection_set(i);self.la.see(i)
                self._multi_cp();self.root.after(50,self._refs)
        if du:self._log(f"[!] {du} duplicate(s)")
        if malos:
            self._log("[!] Sin audio / no se puede leer: "+", ".join(malos))
            self._toast(T("warn_tit"),self._vt("No se han añadido (no tienen pistas de audio o no se pueden leer):\n","Not added (no audio tracks or unreadable):\n")+"\n".join(malos[:8])+("\n..." if len(malos)>8 else ""),tipo="warning",seg=8)
    def _del(self):
        if self._bloq():return
        s=list(self.la.curselection())
        if not s:return
        for i in sorted(s,reverse=True):
            r=self.files[i];self.la.delete(i);del self.files[i]
            self.ppa.pop(r,None);self.pc.pop(r,None);self.usp.pop(r,None)
            self.sel_por_archivo.pop(r,None)
            self.excluir_pistas.pop(r,None)
            self.borrar_pistas.pop(r,None)
            self.ext_subs.pop(r,None)
            self.ext_cover.pop(r,None)
            self._olvidar_pistas(r)
