    def _cf(self,pista,cfg=None,ln_med=None):
        if cfg is None:cfg=self._snap()
        cfg=dict(cfg)
        for _k in ("loudnorm_vol","norm_vol","gdin_vol","din_vol"):cfg[_k]=0   # atenuadores retirados
        def db2lin(db):return round(10**(db/20.0),6)

        dyn_v=int(cfg.get("dyn_norm",0));sp_v=int(cfg.get("speech_norm",0))
        din_act = int(cfg.get("din_modo",0))!=0
        _lay=str(cfg.get("layout","5.1"))
        _mono=(_lay=="1.0")   # 1.0: se procesa como 5.1 (o estereo) y al final se suma todo en un canal
        if _lay not in ("5.1","3.1","2.1","4.0","4.1"):_lay="5.1"
        _est=bool(cfg.get("ent_estereo"))
        # estereo de origen: Upmix 5.1 O una disposicion 2.1/3.1/4.0/4.1 (ambas crean los canales con el motor de Upmix)
        up = cfg.get("upmix","N")=="S" or (_est and _lay!="5.1")
        _ACT={"5.1":("FL","FR","FC","LFE","BL","BR"),"3.1":("FL","FR","FC","LFE"),"2.1":("FL","FR","LFE"),
              "4.0":("FL","FR","BL","BR"),"4.1":("FL","FR","LFE","BL","BR")}
        # canales que existen en la SALIDA; los controles de los demas no se aplican
        act=set(_ACT[_lay]) if (up or not _est) else {"FL","FR"}

        # Normalizaciones (Loudnorm / DynAudNorm / SpeechNorm): ellas fijan el nivel y el Master no se aplica.
        # Con Gama dinamica o Procesado dinamico el Master SI se aplica (su deslizador sigue activo).
        is_proc = (cfg.get("master_auto") or dyn_v>0 or sp_v>0) and not up

        # Volumenes por canal (el master se aplica UNA sola vez al final)
        gFL=db2lin(cfg["fl"]) if "FL" in act else 1.0;gFR=db2lin(cfg["fr"]) if "FR" in act else 1.0
        gFC=db2lin(cfg["fc"]) if "FC" in act else 1.0
        gLFE=db2lin(cfg["lfe"]) if "LFE" in act else 1.0
        gBL=db2lin(cfg["bl"]) if "BL" in act else 1.0;gBR=db2lin(cfg["br"]) if "BR" in act else 1.0

        # Presencia -> dB reales (curva progresiva)
        pv=0.0 if "FC" not in act else self._eff(cfg["voz"],8,24)   # tambien con Upmix: va despues, sobre sus 6 canales
        pa=self._eff(cfg["amb"],7,14)
        pe=self._eff(cfg["efc"],7,14)
        ps=0.0 if "LFE" not in act else self._eff(cfg["sub"],9,20)
        lm=round(gLFE*db2lin(ps),6)

        bmv=0 if ("LFE" not in act or up) else 2*max(0,min(5,int(cfg["bm"])));bmc=int(cfg["bm_corte"])   # con Upmix no
        dbv=0 if ("LFE" not in act or up) else 2*max(0,min(5,int(cfg["db"])));dbc=int(cfg["db_corte"])
        # Nivel 1..5 (bmv/dbv = 2..10). Medido en pelicula 5.1: BM sube el LFE ~+1,5 dB en el 1 y ~+8 dB en el 5;
        # DB lo sube ~+1 / ~+6 dB y ademas refuerza los graves de los altavoces.
        _bl=bmv/2.0;_dl=dbv/2.0
        bm_a=round(self._ip(_bl,[1,5],[0.35,1.0]),3)      # parte de los graves que se QUITA a los altavoces
        bm_k=round(self._ip(_bl,[1,5],[0.5,2.0]),3)       # cuanto de esos graves entra en el LFE
        db_g=round(self._ip(_dl,[1,5],[0.12,0.6]),3)      # graves del LFE que se copian a los altavoces
        db_k=round(self._ip(_dl,[1,5],[0.4,1.6]),3)       # graves de los altavoces que se copian al LFE (sin quitarlos)
        _LFE_LIM="alimiter=limit=0.944:attack=10:release=150:level=0:latency=1"  # el LFE reforzado nunca satura
        dm=int(cfg["din_modo"]) if not up else 0
        eb=self._eff(cfg["eq_bass"],10,14);em=self._eff(cfg["eq_mids"],10,14);et=self._eff(cfg["eq_treble"],10,14)
        uc=int(cfg.get("upmix_central",5))
        P=[]

        fps_f=_fps_exacto(cfg.get("fps_from","25"))
        fps_t=_fps_exacto(cfg.get("fps_to","25"))
        metodo=cfg.get("fps_metodo","tono")
        dl_init=float(cfg.get("delay_init",0))
        pre=[]
        # Inicio de la pista respecto al video (solo al procesar): FFmpeg lo pierde al convertir y la pista
        # saldria adelantada (o atrasada). Se rellena con silencio (o se recorta) para que salga en su sitio.
        _ini=float(cfg.get("_ini_ms",0) or 0)
        if _ini>=1:pre.append(f"adelay=delays={int(round(_ini))}:all=1")
        elif _ini<=-1:pre.append(f"atrim=start={abs(_ini)/1000.0:.3f},asetpts=PTS-STARTPTS")
        # Limpieza de audio (lo primero): saturacion -> clics -> ruido de fondo
        if cfg.get("declip") and not up:pre.append("adeclip")   # con Upmix no hay Limpieza
        if cfg.get("declick") and not up:pre.append("adeclick=w=10:o=50")
        try:_lp=max(0,min(10,int(round(float(cfg.get("limp",0) or 0)))))
        except (TypeError,ValueError):_lp=0
        if _lp>0 and not up:
            try:_nf=float(cfg.get("_ruido_nf",-50.0))
            except (TypeError,ValueError):_nf=-50.0
