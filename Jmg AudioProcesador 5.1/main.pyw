        fmt_actual=(cfg or {}).get("formato") or self._opt("formato")
        if fmt_actual in ("WAV Split","Passthrough"):
            # Nombre propio por pista (sufijo _aN + idioma): con varias pistas ya no se pisan entre si
            _ps=self.pc.get(a,[]);_lg="und"
            if _ps and 0<=p<len(_ps):_lg=_ps[p].get("lang") or "und"
            bn=f"{b}{suffix}"+(f"_{_lg}" if _lg!="und" else "")
            if fmt_actual=="WAV Split":
                ok=self._split(a,d,bn,p,cb,cfg)
                return (ok,None)
            if remux:
