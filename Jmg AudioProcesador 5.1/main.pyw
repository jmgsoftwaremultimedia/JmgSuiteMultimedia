    def _snap(self):
        # con todo lo de _cfgd: sin ello, las bandas del EQ avanzado y el delay por canal no llegaban a cada pista ni al procesar
        return {"aften":dict(getattr(self,"_aften",AFTEN_DEF)),"opc_aud":{k:dict(v) for k,v in (getattr(self,"_opc_aud",{}) or {}).items()},**self._cfgd(),"master":self.var_master.get(),"master_auto":self.var_master_auto.get(),"loudnorm_target":self.var_loudnorm_target.get(),"loudnorm_passes":self.var_loudnorm_passes.get(),"dyn_norm":self.var_dyn_norm.get(),"speech_norm":self.var_speech_norm.get(),"norm_vol":self.var_norm_vol.get(),"fl":self.var_fl.get(),"fr":self.var_fr.get(),"fc":self.var_fc.get(),"lfe":self.var_lfe.get(),"bl":self.var_bl.get(),"br":self.var_br.get(),"voz":self.var_voz.get(),"amb":self.var_amb.get(),"efc":self.var_efc.get(),"sub":self.var_sub.get(),"eq_bass":self.var_eq_bass.get(),"eq_mids":self.var_eq_mids.get(),"eq_treble":self.var_eq_treble.get(),"bm":self.var_bm.get(),"bm_corte":self.var_bm_corte.get(),"db":self.var_db.get(),"db_corte":self.var_db_corte.get(),"gdin_front":self.var_gdin_front.get(),"gdin_tras":self.var_gdin_tras.get(),"gdin_cent":self.var_gdin_cent.get(),"din_modo":self.var_din_modo.get(),"din_val":self.var_din_val.get(),"din_fc":self.var_din_fc.get(),"din_ft":self.var_din_ft.get(),"din_lfe":self.var_din_lfe.get(),"limp":self.var_limp.get(),"declick":self.var_declick.get(),"declip":self.var_declip.get(),"suav":self.var_suav.get(),"gdin_vol":self.var_gdin_vol.get(),"din_vol":self.var_din_vol.get(),"upmix":self.var_upmix.get(),"upmix_central":self.var_upmix_central.get(),"upmix_voz":self.var_upmix_voz.get(),"formato":self.var_formato.get(),"bitrate":self.var_bitrate.get(),"dup_modo":self.var_dup_modo.get(),"downmix":self.var_downmix.get(),"layout":self.var_layout_sal.get(),"downmix_modo":self.var_downmix_modo.get(),"downmix_lfe":self.var_downmix_lfe.get(),"fps_from":self.var_fps_from.get(),"fps_to":self.var_fps_to.get(),"fps_metodo":self.var_fps_metodo.get(),"delay_init":self.var_delay_init.get(),"techo_pres":self.var_techo_pres.get(),"techo_gd":self.var_techo_gd.get(),"techo_pd":self.var_techo_pd.get()}
    def _ln_fc(self,arch,pista,cfg,seg=None):
        """cadena de filtros SIN loudnorm: la senal tal como llega al loudnorm (con EQ, volumenes, disposicion...)"""
        c=dict(self._cfe(arch,pista,cfg or self._snap(),seg))
        c["master_auto"]=False;c["master"]=0;c["techo_pres"]="Sin límite";c["techo_pd"]="Sin límite"
        return self._cf(pista,c,None)
    def _ln_key(self,arch,pista,tk_,cfg,seg=None):
        try:return (arch,pista,hash(self._ln_fc(arch,pista,cfg,seg)),seg or 0)
        except Exception:return (arch,pista,0,seg or 0)
    def _ln(self,arch,pista,tk_,cb=None,cfg=None,seg=None,vis_gid=None):
        """Mide el volumen (EBU R128) de la señal tal como llega a la normalizacion. Rapido (ebur128) y en cache:
        «Normalizar», la Visualizacion y PROCESAR comparten la medida. Devuelve {"input_i","input_tp","input_lra"} o None."""
        fcm=self._ln_fc(arch,pista,cfg,seg)
        ck=(arch,pista,hash(fcm),seg or 0)
        if ck in self.lnc:return self.lnc[ck]
        cmd=[FFMPEG,"-hide_banner"]+(["-t",str(seg)] if seg else [])+["-i",arch]+self._fc_arg(fcm+";[outfinal]ebur128=peak=true:framelog=quiet[lnm]")+[
             "-map","[lnm]","-progress","pipe:1","-nostats","-f","null",("NUL" if sys.platform=="win32" else "/dev/null")]
        kw={"stdout":subprocess.PIPE,"stderr":subprocess.PIPE,"text":True,"encoding":"utf-8","errors":"ignore","bufsize":1}
        if sys.platform=="win32":kw["creationflags"]=CNW
        try:pr=subprocess.Popen(cmd,**kw)
        except Exception as e:self._ls(f"    [ERR] medida de volumen: {e}");return None
        with self._lock:self._procesos.append(pr)
        sl=[]
        def dr():
            try:
                for l in pr.stderr:sl.append(l)
            except Exception:pass
        def ro():
            try:
                for l in pr.stdout:
                    l=l.strip()
                    if l.startswith("out_time_ms=") or l.startswith("out_time_us="):
                        try:
                            us=int(l.split("=",1)[1])
                            if cb:cb(us/1_000_000.0)
                        except (ValueError,IndexError):pass
                    elif l=="progress=end":break
            except Exception:pass
        t_err=threading.Thread(target=dr,daemon=True);t_err.start()
        t_out=threading.Thread(target=ro,daemon=True);t_out.start()
        while pr.poll() is None:
            if self._cancelar.is_set() or (vis_gid is not None and vis_gid!=self._vis_gen):
                try:pr.kill()
                except Exception:pass
                break
            time.sleep(0.15)
        try:pr.wait(timeout=5)
        except Exception:
            try:pr.kill()
            except Exception:pass
        t_out.join(timeout=2);t_err.join(timeout=2)
        with self._lock:
            if pr in self._procesos:self._procesos.remove(pr)
        if self._cancelar.is_set() or (vis_gid is not None and vis_gid!=self._vis_gen) or pr.returncode!=0:return None
        txt="".join(sl)
        try:
            I=float(re.findall(r"I:\s+(-?[\d.]+)\s+LUFS",txt)[-1])
            _tp=re.findall(r"Peak:\s+(-?[\d.]+)",txt);TP=float(_tp[-1]) if _tp else 0.0
            LRA=float(re.findall(r"LRA:\s+([\d.]+)\s+LU",txt)[-1])
        except (IndexError,ValueError):return None
        if I<=-69.0:return None          # silencio: no hay nada que normalizar
        d={"input_i":I,"input_tp":TP,"input_lra":LRA}
        self.lnc[ck]=d;return d
    # ---------- intensidad progresiva (de menos a mas, sin exagerar) ----------
    @staticmethod
    def _ip(u,xs,ys):
        """Interpolacion lineal (u en la escala 0-5 'antigua'; el deslizador 1-10 equivale a u=n/2)."""
        if u<=xs[0]:return ys[0]
        for i in range(1,len(xs)):
            if u<=xs[i]:
                t=(u-xs[i-1])/float(xs[i]-xs[i-1]);return ys[i-1]+t*(ys[i]-ys[i-1])
        return ys[-1]

    @staticmethod
    def _eff(v,top_pos,top_neg=None,expo=1.4):
        """Valor del deslizador (-10..10) -> dB reales (el 10 da el mismo efecto maximo que antes el 20). Curva suave: poco efecto al principio,
        mas marcado al final, y nunca por encima de 'top' (positivo) / 'top_neg' (negativo)."""
        try:v=float(v)
        except Exception:return 0.0
        if abs(v)<0.05:return 0.0
        top=top_pos if v>0 else (top_neg if top_neg is not None else top_pos)
        return round((1 if v>0 else -1)*top*(min(abs(v),10.0)/10.0)**expo,2)

    @staticmethod
    def _suav_filtro(n):
        """Suavizado digital (1-5): un filtro que corta los agudos (no un ecualizador), en todos los canales menos el subwoofer. Sin retraso apreciable"""
        try:n=max(0,min(5,int(n or 0)))
        except (TypeError,ValueError):n=0
        if not n:return ""
        return f"lowpass=f={AudioProcessorGUI._SUAV_FC[n-1]}:poles=2:c=FL+FR+FC+BL+BR+SL+SR"
    _SUAV_FC=(7500,6000,5000,4300,3600)   # corte del Suavizado 1-5: en las eses (5,6-11 kHz) quita lo mismo que el de antes, sin tocar la voz
    @staticmethod
    def _resp_db(f,filtros):
        """ganancia (dB) en la frecuencia f de los filtros [("peq", f0, dB) con Q=1 | ("lp", corte) de 2 polos], los mismos biquads que FFmpeg a 48 kHz"""
        import cmath,math
        fs=48000.0;z=cmath.exp(-1j*2*math.pi*min(float(f),23000.0)/fs);tot=0.0
        for t in filtros:
            if t[0]=="peq":
                A=10**(t[2]/40.0);w=2*math.pi*t[1]/fs;al=math.sin(w)/2.0;c=math.cos(w)
                b_=(1+al*A,-2*c,1-al*A);a_=(1+al/A,-2*c,1-al/A)
            else:
                w=2*math.pi*t[1]/fs;al=math.sin(w)/(2*0.7071);c=math.cos(w)
                b_=((1-c)/2,1-c,(1-c)/2);a_=(1+al,-2*c,1-al)
            h=(b_[0]+b_[1]*z+b_[2]*z*z)/(a_[0]+a_[1]*z+a_[2]*z*z)
            tot+=20*math.log10(max(abs(h),1e-9))
        return tot
    def _esp_con(self,c,v,cfg,ef):
        """espectro de octavas del canal c como queda con los otros ajustes de tono que ya tiene la pista (no el del propio «Auto»):
        EQ de 3 bandas, EQ avanzado de su grupo y Suavizado digital (que no toca el subwoofer)"""
        if not v or not cfg:return v
        fl=[]
        if ef!="eq3":
            for f0,k in ((100,"eq_bass"),(1000,"eq_mids"),(5000,"eq_treble")):
                g=self._eff(cfg.get(k,0) or 0,10,14)
                if g:fl.append(("peq",f0,g))
        gk={"FL":"front","FR":"front","FC":"cent","BL":"tras","BR":"tras","SL":"tras","SR":"tras"}.get(c)
        if ef!="tono" and gk:
            for i in (1,2,3):
                g=self._eff(cfg.get(f"eq{gk}_b{i}_g",0) or 0,10,14)
                if g:fl.append(("peq",float(cfg.get(f"eq{gk}_b{i}_f",1000) or 1000),g))
        try:ns=int(cfg.get("suav",0) or 0)
        except (TypeError,ValueError):ns=0
        if ef!="suav" and c!="LFE" and 1<=ns<=5:fl.append(("lp",self._SUAV_FC[ns-1]))
        if not fl:return v
        # cada banda de octava: la ganancia media en toda la banda, pesada con la pendiente del propio espectro (la musica tiene mas
        # energia abajo: en la banda de 8 kHz, un paso bajo a 5 kHz quita menos de lo que dice su centro)
        import math
        out=[]
        for i,(x,f) in enumerate(zip(v,self._TONO_F)):
            if x is None:out.append(None);continue
            a=v[i-1] if i>0 else None;b_=v[i+1] if i+1<len(v) else None
            pend=(b_-a)/2.0 if (a is not None and b_ is not None) else ((b_-x) if b_ is not None else ((x-a) if a is not None else 0.0))
            num=den=0.0
            for k in range(9):
