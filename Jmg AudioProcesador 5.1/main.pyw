    def _ask_str(self,titulo,mensaje):
        """Dialogo propio para pedir un string (con tema oscuro)"""
        res={"v":None}
        top=tk.Toplevel(self.root);top.title(titulo);top.configure(bg=CF)
        top.transient(self.root);top.resizable(False,False);top.attributes("-topmost",True)
        top.geometry("480x180")
        try:
            self.root.update_idletasks()
            x=self.root.winfo_rootx()+(self.root.winfo_width()-480)//2
            y=self.root.winfo_rooty()+(self.root.winfo_height()-180)//2
            top.geometry(f"+{x}+{y}")
        except Exception:pass
        ttk.Label(top,text=mensaje,background=CF,foreground=CT,font=("",10)).pack(pady=(20,10),padx=20,anchor="w")
        var=tk.StringVar()
        en=tk.Entry(top,textvariable=var,width=40,bg=CDN,fg=CT,insertbackground=CT,
                    relief="flat",highlightthickness=1,highlightbackground=CSB,highlightcolor=CID,borderwidth=0)
        en.pack(padx=20,pady=5,ipady=3);en.focus_set()
        def ok(e=None):
            res["v"]=var.get();top.destroy()
        def cancel(e=None):
            res["v"]=None;top.destroy()
        bf=tk.Frame(top,bg=CF);bf.pack(side="bottom",pady=(10,20))
        ttk.Button(bf,text="OK",command=ok).pack(side="left",padx=6)
        ttk.Button(bf,text=T("cerrar"),command=cancel).pack(side="left",padx=6)
        en.bind("<Return>",ok)
        try:top.grab_set()
        except Exception:pass
        try:top.wait_window()
        except Exception:pass
        return res["v"]

    def _gp(self):
        n=self._ask_str(T("guardar_p_tit"),T("guardar_p_x"))
        if not n:return
        n=n.strip();nf="".join(c for c in n if c.isalnum() or c in " -_").rstrip()
        if not nf:self._toast(T("inv_tit"),T("inv_x"),tipo="warning");return
        r=os.path.join(self.pdir,f"{nf}.json")
        try:
            with open(r,"w",encoding="utf-8") as f:json.dump(self._cfgd(),f,indent=2,ensure_ascii=False)
            self._log(T("log_g",n=nf));self._toast("OK",T("guardado_x",r=r),tipo="info")
        except Exception as e:messagebox.showerror(T("error_tit"),f"{e}")
    def _mp(self):
        if not os.path.isdir(self.pdir):return
        a=sorted(f for f in os.listdir(self.pdir) if f.lower().endswith(".json"))
        if not a:self._toast(T("info_tit"),self._vt("No hay presets guardados.","No saved presets."),tipo="info");return
        m=tk.Menu(self.root,tearoff=0)
        for n in a:m.add_command(label=n[:-5],command=lambda x=n:self._cpres(x))
        m.add_separator();m.add_command(label=self._vt("📁 Abrir carpeta de presets","📁 Open presets folder"),command=self._ap)
        try:
            x=self.btn_cp.winfo_rootx();y=self.btn_cp.winfo_rooty()+self.btn_cp.winfo_height()
            m.tk_popup(x,y)
        finally:m.grab_release()
    def _cpres(self,n):
        r=os.path.join(self.pdir,n)
        try:
            with open(r,"r",encoding="utf-8") as f:d=json.load(f)
            self._dictc(d);self._log(T("log_c",n=n))
        except Exception as e:messagebox.showerror(T("error_tit"),f"{e}")
    def _ap(self):
        try:
            if not _abrir_externo(self.pdir):self._toast(T("info_tit"),self.pdir,tipo="info")
        except Exception as e:self._toast(T("info_tit"),f"{self.pdir}\n\n{e}",tipo="info")
    def _traces(self):
        self.var_master_auto.trace_add("write",lambda *a:(self._mst(),self._nm()))
        self.var_dyn_norm.trace_add("write",lambda *a:self._nm())
        self.var_speech_norm.trace_add("write",lambda *a:self._nm())
        self.var_destino_modo.trace_add("write",lambda *a:self._dst())
        self.var_upmix.trace_add("write",lambda *a:(self._umx(),self._ex()))
    def _mst(self):
        if not self.files:
            self._cfgw(self.sl_m,state="disabled")
            self._cfgw(self.en_m,state="disabled")
            self._cfgw(self.btn_scan,state="disabled")
            for b_ in list(self._auto_bts.values())+self._sinc_bts:self._cfgw(b_,state="disabled")
            try:self._cfgw(self.btn_norm,state="disabled")
            except Exception:pass
            self._cfgw(self.cmb_ln,state="disabled")
            if hasattr(self,"cmb_pass"): self._cfgw(self.cmb_pass,state="disabled")
            self._cfgw(self.sl_ln_vol,state="disabled")
            self._cfgw(self.en_ln_vol,state="disabled")
            self._cfgw(self.sl_nv,state="disabled")
            self._cfgw(self.en_nv,state="disabled")
            return

        _ao="disabled" if getattr(self,"_escaneando",False) else "normal"
        for b_ in list(self._auto_bts.values())+self._sinc_bts:self._cfgw(b_,state=_ao)
        loud = self.var_master_auto.get()
        dv = self.var_dyn_norm.get() > 0
        sv = self.var_speech_norm.get() > 0
        norm_act = loud or dv or sv

        try:self._cfgw(self.btn_norm,state="normal" if (loud and not getattr(self,"_midiendo_ln",False)) else "disabled")   # solo Loudnorm necesita medir antes
        except Exception:pass
        if norm_act:
            self._cfgw(self.sl_m,state="disabled")
            self._cfgw(self.en_m,state="readonly",readonlybackground=CDN,bg=CDN,fg=CA)
            self._cfgw(self.btn_scan,state="disabled")
        else:
            self._cfgw(self.sl_m,state="normal")
            self._cfgw(self.en_m,state="normal",bg=CDN,fg=CT,insertbackground=CT)
            self._cfgw(self.btn_scan,state="normal")

        if loud:
            self._cfgw(self.cmb_ln,state="readonly")
            if hasattr(self,"cmb_pass"): self._cfgw(self.cmb_pass,state="readonly")
            self._cfgw(self.sl_ln_vol,state="normal")
            self._cfgw(self.en_ln_vol,state="normal",bg=CDN,fg=CT,insertbackground=CT)
            # Si Loudnorm está activo, el atenuador compartido de Dyn/Speech se apaga
            self._cfgw(self.sl_nv,state="disabled")
            self._cfgw(self.en_nv,state="readonly",readonlybackground=CDN,bg=CDN,fg=CA)
        else:
            self._cfgw(self.cmb_ln,state="disabled")
            if hasattr(self,"cmb_pass"): self._cfgw(self.cmb_pass,state="disabled")
            self._cfgw(self.sl_ln_vol,state="disabled")
            self._cfgw(self.en_ln_vol,state="readonly",readonlybackground=CDN,bg=CDN,fg=CA)
            # Si Dyn o Speech están activos, encendemos su atenuador compartido
            if dv or sv:
                self._cfgw(self.sl_nv,state="normal")
                self._cfgw(self.en_nv,state="normal",bg=CDN,fg=CT,insertbackground=CT)
            else:
                self._cfgw(self.sl_nv,state="disabled")
                self._cfgw(self.en_nv,state="readonly",readonlybackground=CDN,bg=CDN,fg=CA)
    def _dst(self):
        if not self.files:return
        try:
            if self.var_destino_modo.get()=="personalizada":
                self.en_d.configure(state="normal");self.btn_d.configure(state="normal")
                self.en_d.configure(bg=CDN,fg=CT,readonlybackground=CDN,disabledbackground=CDN)
            else:
                self.en_d.configure(state="readonly")
                self.btn_d.configure(state="disabled")
        except AttributeError:pass
    def _uv_sync(self):
        try:
            self._cfgw(self.sl_uv,state=str(self.sl_uc.cget('state')))
            if str(self.sl_uc.cget('state'))=='disabled':self._cfgw(self.en_uv,state='readonly',readonlybackground=CDN,bg=CDN,fg=CA)
            else:self._cfgw(self.en_uv,state='normal',bg=CDN,fg=CT,insertbackground=CT)
        except Exception:pass
    def _umx(self):
        try:self._lay_estado()
        except Exception:pass
        try:self._canales_ui()
        except Exception:pass
        try:
            if self._es_m(self.var_layout.get()):
                self._cfgw(self.sl_uc,state="disabled");self._cfgw(self.en_uc,state="disabled")
            elif self.var_upmix.get()=="S":
                self._cfgw(self.sl_uc,state="normal")
                self._cfgw(self.en_uc,state="normal",bg=CDN,fg=CT,insertbackground=CT)
            else:
                self._cfgw(self.sl_uc,state="disabled")
                self._cfgw(self.en_uc,state="readonly",readonlybackground=CDN,bg=CDN,fg=CA)
        except AttributeError:pass
        self._uv_sync()
    def _excl(self):
        # Grupo B: cualquier cambio -> refrescar exclusiones
        for v in (self.var_voz,self.var_amb,self.var_efc,self.var_sub,
                  self.var_gdin_front,self.var_gdin_tras,self.var_gdin_cent,
                  self.var_master_auto,self.var_dyn_norm,self.var_speech_norm,
                  self.var_din_modo,self.var_limp,self.var_declick,self.var_declip):
            v.trace_add("write",lambda *a:self._ex())
        for _v in (self.var_din_val,self.var_din_ft,self.var_din_fc,self.var_din_lfe):_v.trace_add("write",lambda *a:self._din_lbl())
        for _v in [self.var_eq_bass,self.var_eq_mids,self.var_eq_treble,self.var_suav,self.var_master,self.var_fl,self.var_fr,self.var_fc,self.var_lfe,self.var_bl,self.var_br]+\
                  [getattr(self,f"var_eq{g}_b{i}_g") for g in ("front","tras","cent") for i in (1,2,3)]:
            _v.trace_add("write",lambda *a:self._ex_eqvol())
