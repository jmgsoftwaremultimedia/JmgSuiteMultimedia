    def _ex_eqvol(self):
        """lo que no va junto: el EQ de 3 bandas y el avanzado; el Master y el volumen por canal; el Suavizado con los ecualizadores y la
        Limpieza; la Limpieza con los ecualizadores, Gama y Procesado. Mientras uno tiene algo puesto, el otro queda apagado (si los dos
        tienen algo, de una configuracion antigua, los dos se pueden tocar para quitar uno)"""
        if not self.files or not hasattr(self,"_w_eq3") or not hasattr(self,"_w_vch"):return
        def no0(*vs):
            for v in vs:
                try:
                    if float(v.get())!=0:return True
                except (tk.TclError,ValueError):pass
            return False
        e3=no0(self.var_eq_bass,self.var_eq_mids,self.var_eq_treble)
        ea=no0(*[getattr(self,f"var_eq{g}_b{i}_g") for g in ("front","tras","cent") for i in (1,2,3)])
        su=no0(self.var_suav);li=no0(self.var_limp) or bool(self.var_declick.get()) or bool(self.var_declip.get())
        ga=no0(self.var_gdin_front,self.var_gdin_tras,self.var_gdin_cent);di=no0(self.var_din_modo)
        # Suavizado: ni con los ecualizadores ni con la Limpieza. Limpieza: ni con los ecualizadores, ni con Gama ni con Procesado
        self._cw_set(self._w_eq3,e3 or not (ea or su or li));self._cw_set(self._w_eqa,ea or not (e3 or su or li))
        try:up=bool(self._lay_up())
        except Exception:up=False
        # con Upmix, ni Suavizado ni Limpieza
        if hasattr(self,"_w_suav"):self._cw_set(self._w_suav,not up and (su or not (e3 or ea or li)))
        if hasattr(self,"_w_limp"):self._cw_set(self._w_limp,not up and (li or not (e3 or ea or su or ga or di)))
        ma=no0(self.var_master);ca=no0(self.var_fl,self.var_fr,self.var_fc,self.var_lfe,self.var_bl,self.var_br)
        act=self._out_act()
        self._cw_set([self.sl_m,self.en_m],ma or not ca)
        for c,ws in self._w_vch.items():self._cw_set(ws,(ca or not ma) and (c in ("FL","FR") or c in act))
    def _ex0(self):
        if not self.files:
            return
        up = self._lay_up()

        if up:
            # Con Upmix solo van Presencia, los volumenes y los ecualizadores: lo demas se apaga y se pone a 0
            for v in (self.var_master_auto, self.var_dyn_norm, self.var_speech_norm, self.var_din_modo):
                try:
                    if v.get()!=0 and v.get()!=False: v.set(0 if v!=self.var_master_auto else False)
                except Exception:pass
            for v in (self.var_gdin_front,self.var_gdin_tras,self.var_gdin_cent,self.var_bm,self.var_db,self.var_suav,self.var_limp):
                try:
                    if v.get()!=0: v.set(0)
                except Exception:pass
            for v in (self.var_declick,self.var_declip):
                try:
                    if v.get(): v.set(False)
                except Exception:pass

            try:self._setp("normal")   # Presencia si
            except Exception:pass
            for w in self._wg:
                try:self._cfgw(w,state="disabled")
                except Exception:pass
            try:self._cw_set(self._cw.get("BMDB",[]),False)   # Bass Management y Double Bass no
            except Exception:pass
            try:
                self._cfgw(self.chk_ln,state="disabled")
                self._cfgw(self.sl_dn,state="disabled");self._cfgw(self.sl_sn,state="disabled")
                self._cfgw(self.cmb_din_modo,state="disabled")
                self._cfgw(self.sl_din_val,state="disabled")
                self._cfgw(self.sl_din_lfe,state="disabled")
                self._cfgw(self.sl_gv_vol,state="disabled"); self._cfgw(self.en_gv_vol,state="readonly",readonlybackground=CDN,bg=CDN,fg=CA)
                self._cfgw(self.sl_dv_vol,state="disabled"); self._cfgw(self.en_dv_vol,state="readonly",readonlybackground=CDN,bg=CDN,fg=CA)
            except Exception:pass
            try:
                self.var_ga.set("X");self._cfgw(self.lbl_ga,foreground=CAV)
                self.var_pa.set("")
            except Exception:pass
        else:
            norm_on = self.var_master_auto.get() or self.var_dyn_norm.get()>0 or self.var_speech_norm.get()>0
            pres_act = any(v.get()!=0 for v in (self.var_voz,self.var_amb,self.var_efc,self.var_sub))
            gama_on = self.var_gdin_front.get()>0 or self.var_gdin_tras.get()>0 or self.var_gdin_cent.get()>0
            din_on = self.var_din_modo.get()!=0
            limp_on = self.var_limp.get()>0 or bool(self.var_declick.get()) or bool(self.var_declip.get())   # la Limpieza no va con Gama ni Procesado

            # Exclusión mutua: Si hay normalización, apagar presencia/gama/dinámica
            if norm_on:
                if gama_on:
                    self.var_gdin_front.set(0); self.var_gdin_tras.set(0); self.var_gdin_cent.set(0)
                if din_on:
                    self.var_din_modo.set(0)
                gama_on = din_on = False
            # Si hay gama/dinámica, apagar normalización (Presencia va con todo)
            elif gama_on or din_on:
                if norm_on:
                    self.var_master_auto.set(False)
                    self.var_dyn_norm.set(0)
                    self.var_speech_norm.set(0)
                norm_on = False

            activos = [("gama",gama_on),("din",din_on),("limp",limp_on)]
            n_act = sum(1 for _,v in activos if v)

            def editable(mi_activo):
                if n_act==0: return True
                if mi_activo: return True
                return False

            st_p="normal"   # Presencia es compatible con todos los efectos
            try:self._setp(st_p)
            except Exception:pass

            # Lógica Gama Dinámica
            ed=editable(gama_on)
            st_g="normal" if (ed and not norm_on) else "disabled"
            for w in self._wg:
                try:
                    self._cfgw(w,state=st_g)
                    if w.winfo_class()=="Entry" and st_g=="normal":
                        self._cfgw(w,bg=CDN,fg=CT,insertbackground=CT)
                except Exception:pass

            # Lógica Procesado Dinámico
            ed=editable(din_on)
            st_d="normal" if (ed and not norm_on) else "disabled"
            try:
                self._cfgw(self.cmb_din_modo,state="readonly" if st_d=="normal" else "disabled")
                st_d_val = st_d if din_on else "disabled"
                self._cfgw(self.sl_din_val,state=st_d_val)
                self._cfgw(self.en_din_val,state=st_d_val)
                self._cfgw(self.sl_din_lfe,state=st_d_val)
                self._cfgw(self.en_din_lfe,state=st_d_val)
            except Exception:pass

            # Lógica de atenuadores (solo activos si el efecto está activo y no bloqueado)
            try:
                st_gv = "normal" if (gama_on and editable(gama_on) and not norm_on) else "disabled"
                self._cfgw(self.sl_gv_vol,state=st_gv)
                if st_gv=="normal": self._cfgw(self.en_gv_vol,state="normal",bg=CDN,fg=CT,insertbackground=CT)
                else: self._cfgw(self.en_gv_vol,state="readonly",readonlybackground=CDN,bg=CDN,fg=CA)

                st_dv = "normal" if (din_on and editable(din_on) and not norm_on) else "disabled"
                self._cfgw(self.sl_dv_vol,state=st_dv)
                if st_dv=="normal": self._cfgw(self.en_dv_vol,state="normal",bg=CDN,fg=CT,insertbackground=CT)
                else: self._cfgw(self.en_dv_vol,state="readonly",readonlybackground=CDN,bg=CDN,fg=CA)
            except Exception:pass

            try:
                if n_act>0 and not gama_on:
                    self.var_ga.set("X");self._cfgw(self.lbl_ga,foreground=CAV)
                else:self.var_ga.set("")
                self.var_pa.set("")
            except Exception:pass

        try:self._mst();self._nm()
        except Exception:pass
    def _setp(self,st):
        for w in self._wp:
            try:
                if w.winfo_class()=="Entry" and st=="disabled":
                    self._cfgw(w,state="readonly",readonlybackground=CDN,bg=CDN,fg=CA)
                else:
                    self._cfgw(w,state=st)
                    if w.winfo_class()=="Entry":
                        self._cfgw(w,bg=CDN,fg=CT,insertbackground=CT,
                                    highlightbackground=CSB,highlightcolor=CID)
            except tk.TclError:pass
    # ---------- (JMG, 14-11) mientras codifica: no funciona nada de la ventana principal menos cambiar de pestaña (y «Cancelar») ----------
    _BP_TAG="JmgBloqueoProc"
    _BP_ESTADO=("TButton","TCheckbutton","TRadiobutton","TCombobox","TEntry","TSpinbox","TScale","TMenubutton",
                "Button","Checkbutton","Radiobutton","Entry","Spinbox","Scale","Menubutton")
    _BP_RUEDA=("TCombobox","TSpinbox","TScale","Scale","Spinbox")   # la rueda cambiaría su valor (en las listas solo desplaza)
    _BP_LIBRES=("TNotebook","TScrollbar","Scrollbar")
    _BP_REFRESCAR=("_refrescar_estado","_estado_video","_opc_v_estado","_ex_suav_eq","_lay_estado","_ud_botones","_aften_estado")   # los que haya en cada programa
    # ---------- (JMG, 13-11) «⏸ Pausa»: para el procesado y lo sigue donde estaba ----------
    def _pausa_raices(self):
        """los procesos del procesado en marcha (los que «Cancelar» pararía)"""
        with self._lock:ps=list(self._procesos)
        return [p.pid for p in ps if p.poll() is None]
    def _pausa_pulsar(self):
        if getattr(self,"_pausa_on",False):self._pausa_poner(False)
        elif getattr(self,"procesando",False) and not self._cancelar.is_set():self._pausa_poner(True)
    def _pausa_poner(self,on):
        V=self._vt
        if on:
            if getattr(self,"_pausa_on",False):return
            self._pausa_on=True;self._pausa_pids=set();self._pausas=getattr(self,"_pausas",[])+[[time.time(),None]]
            self._pausa_suspender()
            m=V("⏸ En pausa: «▶ Continuar» lo sigue donde estaba.","⏸ Paused: «▶ Resume» carries on where it was.")
        else:
            if not getattr(self,"_pausa_on",False):return
            self._pausa_on=False
            for pid in list(getattr(self,"_pausa_pids",())):_pausar_pid(pid,False)
            self._pausa_pids=set()
            for x in getattr(self,"_pausas",[]):
                if x[1] is None:x[1]=time.time()
            m=V("▶ Sigue el procesado.","▶ Processing goes on.")
        try:
            self._ls("[PAUSA] "+m)
        except Exception:pass
        self._pausa_boton()
    def _pausa_suspender(self):
        for pid in _arbol_pids(self._pausa_raices()):
            if pid not in self._pausa_pids and _pausar_pid(pid,True):self._pausa_pids.add(pid)
    def _pausa_desde(self,t0):
        """segundos en pausa desde t0 (lo que queda no los cuenta)"""
        a=time.time();return sum(max(0.0,(f or a)-max(i,t0)) for i,f in list(getattr(self,"_pausas",[])))
    def _pausa_boton(self):
        b=getattr(self,"btn_pausa",None)
        if b is None:return
        try:
            on=getattr(self,"_pausa_on",False)
            t=("▶ "+self._vt("Continuar","Resume")) if on else ("⏸ "+self._vt("Pausa","Pause"))
            if str(b.cget("text"))!=t:b.configure(text=t)
            q=bool(getattr(self,"procesando",False)) and not self._cancelar.is_set()
            if q==b.instate(["disabled"]):b.state(["!disabled"] if q else ["disabled"])
        except Exception:pass
    def _trabajando(self):
        """(JMG, 13-11) hay algo largo en marcha: el PC no debe suspenderse"""
        return bool(self._ocupado())
    def _pausa_tick(self):
        """cada medio segundo: el botón al día; en pausa, también los procesos que empiecen después; al acabar, fuera la pausa"""
        try:
            if getattr(self,"_pausa_on",False):
                if not getattr(self,"procesando",False) or self._cancelar.is_set():self._pausa_poner(False)
                else:self._pausa_suspender()
            self._pausa_boton()
        except Exception:pass
        try:_no_dormir(self._trabajando())   # (JMG, 13-11) que el PC no se suspenda mientras trabaja
        except Exception:pass
        try:self.root.after(500,self._pausa_tick)
        except Exception:pass
    def _bp_libres(self):
        """lo que sigue funcionando mientras codifica (además de las pestañas y las barras de desplazamiento)"""
        return [w for w in (getattr(self,"btn_c",None),getattr(self,"btn_pausa",None),getattr(self,"cmb_fin",None)) if w is not None]   # (JMG, 13-11) y «Pausa» y «Al terminar»
    def _bp_aplicar(self):
        """recorre la ventana principal: desactiva lo que esté activo y pone el freno de clics, teclas y rueda donde no esté
        (también lo que el programa haya vuelto a activar o haya creado después de empezar)"""
        r=self.root;libres={str(w) for w in self._bp_libres()};prev=self._bp_prev;tags=self._bp_tags;pila=[r]
        while pila:
            w=pila.pop()
            try:pila+=[h for h in w.winfo_children() if not isinstance(h,tk.Toplevel)]
            except Exception:pass
            if str(w) in libres:continue
            try:cl=w.winfo_class()
            except Exception:continue
            if cl in self._BP_LIBRES:continue
            try:
                bt=tuple(w.bindtags())
                if self._BP_TAG not in bt:w.bindtags((self._BP_TAG,)+bt);tags.append(w)
            except Exception:pass
            if cl in self._BP_ESTADO:
                try:
                    if cl.startswith("T"):
                        if not w.instate(["disabled"]):
                            w.state(["disabled"])
                            if str(w) not in prev:prev[str(w)]=(w,None)
                    else:
                        s=str(w.cget("state"))
                        if s!="disabled":
                            w.configure(state="disabled")
                            if str(w) not in prev:prev[str(w)]=(w,s)
                except Exception:pass
    def _bp_poner(self,on):
        """(JMG, 14-11) codificando, la ventana principal no hace nada salvo cambiar de pestaña y «Cancelar»: sus controles se
        desactivan (y al terminar vuelven como estaban, y cada programa recalcula los que dependen de algo) y los clics, teclas y la
        rueda de lo demás (listas, gráficos, enlaces, atajos) no llegan. Las ventanas aparte (Combinar...) siguen con lo suyo.
        Una vigilancia lo mantiene mientras dura y lo quita sola al acabar."""
        r=self.root
        if on:
            if getattr(self,"_bp_prev",None) is not None:return
            if not getattr(self,"_bp_tag_hecho",False):
                for ev in ("<ButtonPress>","<ButtonRelease>","<Double-ButtonPress>","<Triple-ButtonPress>","<B1-Motion>","<B2-Motion>","<B3-Motion>","<KeyPress>","<KeyRelease>"):
                    r.bind_class(self._BP_TAG,ev,lambda e:"break")
                def rueda(e):
                    try:return "break" if e.widget.winfo_class() in self._BP_RUEDA else None
                    except Exception:return None
                r.bind_class(self._BP_TAG,"<MouseWheel>",rueda)
                self._bp_tag_hecho=True
            self._bp_prev={};self._bp_tags=[]
            self._bp_aplicar()
            r.after(700,self._bp_vigilar)
        else:
            prev=getattr(self,"_bp_prev",None)
            if prev is None:return
            self._bp_prev=None
            for w,s in prev.values():
                try:
                    if s is None:
                        if w.instate(["disabled"]):w.state(["!disabled"])
                    elif str(w.cget("state"))=="disabled":w.configure(state=s)
                except Exception:pass
            for w in getattr(self,"_bp_tags",[]):
                try:w.bindtags(tuple(t for t in w.bindtags() if t!=self._BP_TAG))
                except Exception:pass
            self._bp_tags=[]
            for f in self._BP_REFRESCAR:
                try:getattr(self,f)()
                except Exception:pass
    def _bp_vigilar(self):
        """mientras dura el bloqueo: lo mantiene (lo que se haya vuelto a activar o sea nuevo) y, si ya no se está codificando
        (por donde sea que haya terminado), lo quita"""
        if getattr(self,"_bp_prev",None) is None:return
        if not (getattr(self,"procesando",False) or getattr(self,"_combinando",False)):self._bp_poner(False);return
        try:self._bp_aplicar()
        except Exception:pass
        self.root.after(700,self._bp_vigilar)
    # ---------- (JMG, 16-11) «📀 DVD/BD...», como en Jmg VideoEncoder: el audio de la película principal de un DVD o Blu-ray ----------
    @staticmethod
    def _dvd_titulo(carpeta):
        """VOB de la película principal de un DVD (el VTS que más ocupa), en orden; de un Blu-ray, los .m2ts de su lista más larga"""
        if not os.path.isdir(os.path.join(carpeta,"VIDEO_TS")) and (os.path.isdir(os.path.join(carpeta,"BDMV")) or os.path.basename(carpeta.rstrip("\\/")).upper()=="BDMV"):
            return _bd_titulo(carpeta)[0]
        d=os.path.join(carpeta,"VIDEO_TS") if os.path.isdir(os.path.join(carpeta,"VIDEO_TS")) else carpeta
        g={}
        try:
            for n in os.listdir(d):
                m=re.match(r"VTS_(\d\d)_([1-9])\.VOB$",n,re.I)
                if m:g.setdefault(m.group(1),[]).append((int(m.group(2)),os.path.join(d,n)))
        except OSError:return []
        if not g:return []
        best=max(g.values(),key=lambda l:sum(os.path.getsize(p) for _,p in l))
        return [p for _,p in sorted(best)]
    def _discos_video(self):
        """[(raíz, etiqueta)] de los lectores con un DVD o Blu-ray de vídeo dentro (también las imágenes montadas)"""
        l=[]
        if sys.platform!="win32":return l
        import ctypes,string
        k=ctypes.windll.kernel32;viejo=k.SetErrorMode(0x8001)   # sin el aviso «no hay disco en la unidad»
        try:
            for c in string.ascii_uppercase:
                r_=c+":\\"
                try:
                    if k.GetDriveTypeW(ctypes.c_wchar_p(r_))!=5:continue
                    nom=ctypes.create_unicode_buffer(261)
                    if not k.GetVolumeInformationW(ctypes.c_wchar_p(r_),nom,261,None,None,None,None,0):continue
                    if os.path.isdir(os.path.join(r_,"VIDEO_TS")) or os.path.isdir(os.path.join(r_,"BDMV")):l.append((r_,nom.value.strip()))
                except Exception:continue
        finally:k.SetErrorMode(viejo)
        return l
