            prim=next(s for c,s,d in sel if s)
            P=[];ee={n:len(ent)+k for k,n in enumerate(env)}   # las envolventes de «Silenciar voces» entran detras de los archivos
            for n,(c,s,d) in enumerate(sel):
                if s:
