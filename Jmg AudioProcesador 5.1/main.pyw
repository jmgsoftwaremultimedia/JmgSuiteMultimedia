                num+=w*10**(self._resp_db(f*2**o,fl)/10.0);den+=w
            out.append(x+10*math.log10(num/den))
        return out

    @staticmethod
    def _gd_curva(v):
        """pivote y curva (dB de entrada -> dB de salida) de la gama dinamica en el nivel v (0-10)"""
        vn=max(0.0,min(10.0,float(v)))
        v=vn/2.0  # nivel 1-10 -> escala interna 0-5
        P=-28+3.2*v;sd=1.0+0.45*v
        # refuerzo (v.74): los flojos bajan un poco mas, proporcional al nivel: 0,3 dB en el 1 ... 3 dB en el 10
        # (entra poco a poco en los 6 dB por debajo del pivote: la curva sigue siendo continua)
        xg=3.0*vn/10.0
        def o(x):return P+sd*(x-P)-xg*min(1.0,(P-x)/6.0) if x<P else x
        return P,o
    def _gd_points(self,v):
        """Curva de EXPANSION para compand (de menos a mas segun el nivel 1-10).
        Por debajo del pivote los sonidos flojos BAJAN mucho (pendiente 1.45 ... 3.25 dB por dB);
        por encima del pivote la salida es igual que la entrada (los fuertes se quedan como estan).
        El pivote sube con el nivel: -24.8 dBFS (nivel 1) ... -12 dBFS (nivel 5)."""
        P,o=self._gd_curva(v)
        xs=[-90,-70,-55,-45,-35,-28,-20,P,-8,-3,0]
        xs=sorted(set(round(x,1) for x in xs))
        pts=[]
        for x in xs:
            y=max(-110.0,o(x))
            pts.append(f"{x}/{round(y,1)}")
        return "|".join(pts)

    def _dp(self,m=None,v=None,k=1.0,med=None):
        """Procesado dinamico (curva compand por canal):
          1 Elevacion: sube los sonidos bajos (compresion ascendente); los fuertes no se tocan.
          2 Impacto:   AUMENTA mucho la dinamica: los fuertes suben (picos +2 a +8 dB) y los debiles bajan.
          3 Elevacion + Impacto.
        v = intensidad 0-10 (0 = sin efecto). med = {"I": LUFS, "TP": pico} medidos del archivo."""
        if m is None:m=int(self.var_din_modo.get())
        if v is None:v=self.var_din_ft.get()
        m=int(m)
        try:vn=max(0,min(10,int(round(float(v)))))
        except (TypeError,ValueError):vn=0
        if m==0 or vn==0:return {"f":None,"d":"Off","nom":"Off"}
        u=(vn-1)/9.0
        L=lambda a,b:a+(b-a)*u
        med=med or {}
        try:I=float(med.get("I",-23.0))
        except (TypeError,ValueError):I=-23.0
        try:TP=min(0.0,float(med.get("TP",0.0)))
        except (TypeError,ValueError):TP=0.0
        P=max(-32.0,min(-14.0,I-2.0))          # nivel medio del programa (por canal)
        # refuerzo (v.74): efecto mas notable, proporcional al nivel: +0,6 dB en el 1 ... +6 dB en el 10
        xtra=6.0*vn/10.0
        up55=L(2.5,13)+xtra;up40=L(2,9)+xtra;up30=L(1,4.5)+xtra
        Pe=min(P,-24.0)
        ex=[q for q in [(-90,-90),(-72,-72+up55*0.3),(-55,-55+up55),(-40,-40+up40),(-30,-30+up30)] if q[0]<Pe-1]+[(Pe,Pe),(0,0),(20,20)]
        # la curva nunca se da la vuelta: un sonido mas fuerte siempre sale mas fuerte (pendiente minima 0,25)
        for i in range(len(ex)-2,0,-1):
            (x0,y0),(x1,y1)=ex[i],ex[i+1]
            if y0>y1-0.25*(x1-x0):ex[i]=(x0,y1-0.25*(x1-x0))
        def elev(x):
            for (x0,y0),(x1,y1) in zip(ex,ex[1:]):
                if x<=x1:return y0+(y1-y0)*(x-x0)/(x1-x0)
            return x
        # Impacto (estilo "inverse"): los fuertes SUBEN (picos +upk dB) y los debiles BAJAN (expansion hacia abajo).
        # Los picos pueden pasar de 0 dBFS: el techo del limitador decide ("Sin limite" = puede saturar).
        upk0=L(3.0,9.0)                # subida de los fuertes (dB en el pico)
        upk=upk0+xtra                  # con el refuerzo de la v.74
        rl=1.0+L(0.10,0.55)            # pendiente por debajo del nivel medio (>1 = los debiles bajan)
        def imp(x):
            if x<=P:return P-(P-x)*rl
            # refuerzo: entra en los 8 dB por encima del nivel medio y desde ahi los fuertes llevan los +xtra enteros
            if x<=TP:return P+(x-P)*((TP+upk0)-P)/max(0.1,(TP-P))+xtra*min(1.0,(x-P)/8.0)
            return x+upk
        def mix(x):   # Elevacion + Impacto: suben los debiles (Elevacion) y suben los fuertes (Impacto)
            return elev(x) if x<=P else imp(x)
        f={1:elev,2:imp,3:mix}.get(m,elev)
        X=sorted(set([-90,-72,-55,-40,-30,round(P,1),round((P+TP)/2,1),round(TP,1),0,20]))
        pts=[(a,f(a)) for a in X]
        k=max(0.0,min(1.0,float(k)))
        pts=[(a,a+(b-a)*k) for a,b in pts]
        ps="|".join(f"{a:g}/{b:.1f}" for a,b in pts)
        nom=self._din_nom(m)
        d=[]
        _sb=elev(-45.0)+45.0   # subida real de un sonido bajo (-45 dBFS)
        if m in (1,3):d.append(self._vt(f"bajos +{_sb:.1f} dB",f"quiet +{_sb:.1f} dB"))
        if m in (2,3):d.append(self._vt(f"fuertes +{upk:.1f} dB",f"loud +{upk:.1f} dB"))
        if m==2:d.append(self._vt(f"débiles -{(rl-1)*20:.1f} dB",f"weak -{(rl-1)*20:.1f} dB"))
        _att="0.002" if m in (2,3) else "0.008"   # Impacto: ataque rapido para que los picos suban de verdad
        return {"f":f"compand=attacks={_att}:decays=0.25:points={ps}:soft-knee=4:gain=0:volume=-30","nom":nom,"d":" · ".join(d)}

    def _run_c(self,cmd):
        """subprocess cancelable: se corta al pulsar Cancelar (o si la Visualizacion se cancela/regenera)"""
        kw={"stdout":subprocess.PIPE,"stderr":subprocess.PIPE,"text":True,"encoding":"utf-8","errors":"ignore"}
        if sys.platform=="win32":kw["creationflags"]=CNW
        pr=subprocess.Popen(cmd,**kw)
        with self._lock:self._procesos.append(pr)
        so=[];se=[]
        def rd(f,acc):
            try:
                for l in f:acc.append(l)
            except Exception:pass
        t1=threading.Thread(target=rd,args=(pr.stdout,so),daemon=True);t2=threading.Thread(target=rd,args=(pr.stderr,se),daemon=True)
        t1.start();t2.start()
        g0=getattr(self,"_vis_gen",0);vis=bool(getattr(self,"_vis_run",False)) and not getattr(self,"procesando",False)
        cancel=False
        while pr.poll() is None:
            if self._cancelar.is_set() or (vis and getattr(self,"_vis_gen",0)!=g0):
                cancel=True
                try:pr.kill()
                except Exception:pass
                break
            time.sleep(0.15)
        try:pr.wait(timeout=5)
        except Exception:pass
        t1.join(timeout=2);t2.join(timeout=2)
        with self._lock:
            if pr in self._procesos:self._procesos.remove(pr)
        if self._cancelar.is_set():cancel=True   # Cancelar puede haber matado el proceso desde fuera
        if cancel:raise RuntimeError("cancelado")
        self._run_rc=pr.returncode
        return "".join(so),"".join(se)
    def _ruido_medir(self,arch,pista,seg=None):
        """nivel del ruido de fondo: 5% mas silencioso de ventanas de 0,4 s (canal mas fuerte). En cache."""
        if not hasattr(self,"_rmc"):self._rmc={}
        k=(arch,pista,seg or 0)
        if k in self._rmc:return self._rmc[k]
        kw={"capture_output":True,"text":True,"encoding":"utf-8","errors":"ignore"}
        if sys.platform=="win32":kw["creationflags"]=CNW
        nf=-50.0
        try:
            r=self._run_c([FFMPEG,"-hide_banner","-nostats"]+(["-t",str(seg)] if seg else [])+["-i",arch,"-map",f"0:a:{pista}","-af",
                              "aresample=48000,asetnsamples=n=19200:p=0,astats=metadata=1:reset=1:measure_perchannel=RMS_level:measure_overall=none,ametadata=mode=print:file=-",
                              "-f","null","-"])[0]
            vent=[];cur=[]
            for l in r.splitlines():
                if l.startswith("frame:"):
                    if cur:vent.append(max(cur));cur=[]
                    continue
                m=re.match(r"lavfi\.astats\.\d+\.RMS_level=(\S+)",l)
                if m:
                    try:v=float(m.group(1))
                    except ValueError:continue
                    if v==v and v>-120:cur.append(v)
            if cur:vent.append(max(cur))
            vent=sorted(v for v in vent if v>-90)
            if vent:
                p5=vent[max(0,int(len(vent)*0.05)-1)];med=vent[len(vent)//2]
                # Si no hay pasajes tranquilos (musica continua, mezcla densa) el 5 % mas bajo no es ruido:
                # el umbral nunca pasa de 15 dB por debajo del nivel medio ni de -42 dBFS (no se come la señal)
                nf=min(p5,med-15.0,-42.0)
        except RuntimeError:return nf      # cancelado: no se guarda en cache
        except Exception:pass
        self._rmc[k]=nf;return nf
    def _spn_medir(self,arch,pista,seg=None):
        """nivel (LUFS) del dialogo: canal central si existe, si no la mezcla. En cache. Para centrar SpeechNorm."""
        if not hasattr(self,"_spc"):self._spc={}
