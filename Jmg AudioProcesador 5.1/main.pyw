    def _nm_pon(self,v,x):
        """apaga una normalizacion. Si se hace dentro de la traza de esa misma variable, Tcl no avisa a su deslizador ni a su casilla
        (se quedaban marcando lo de antes): se vuelve a poner en cuanto acaba, y entonces si se dibujan bien"""
        try:v.set(x)
        except Exception:pass
        def otra():
            try:
                if v.get()==x:v.set(x)
            except Exception:pass
        self.root.after_idle(otra)
    def _nm(self):
        if not self.files:
            self._cfgw(self.chk_ln,state="disabled")
            self._cfgw(self.sl_dn,state="disabled")
            self._cfgw(self.sl_sn,state="disabled")
            self._cfgw(self.en_dn,state="disabled")
            self._cfgw(self.en_sn,state="disabled")
            return

        loud=self.var_master_auto.get()
        dv=self.var_dyn_norm.get()
        sv=self.var_speech_norm.get()
        try:up=bool(self._lay_up())
        except Exception:up=False
        if up:   # con Upmix no hay normalizaciones: apagadas, a 0 y sin tocar
            for v_,x in ((self.var_master_auto,False),(self.var_dyn_norm,0),(self.var_speech_norm,0)):
                if v_.get():self._nm_pon(v_,x)
            for w in (self.chk_ln,self.cmb_ln,self.sl_dn,self.sl_sn,getattr(self,"btn_norm",None)):
                if w is not None:self._cfgw(w,state="disabled")
            for en in (self.en_dn,self.en_sn):self._cfgw(en,state="readonly",readonlybackground=CDN,bg=CDN,fg=CA)
            self._mst()
            for w in (self.chk_ln,self.cmb_ln,getattr(self,"btn_norm",None)):
                if w is not None:self._cfgw(w,state="disabled")
            return

        if loud:
            if dv!=0:self._nm_pon(self.var_dyn_norm,0)
            if sv!=0:self._nm_pon(self.var_speech_norm,0)
            dv=0;sv=0
        if dv>0:
            if sv!=0:self._nm_pon(self.var_speech_norm,0)
            if loud:self._nm_pon(self.var_master_auto,False)
            loud=False;sv=0
        if sv>0:
            if dv!=0:self._nm_pon(self.var_dyn_norm,0)
            if loud:self._nm_pon(self.var_master_auto,False)
            loud=False;dv=0

        # Si hay Gama o Dinamica, bloquear Normalizacion (la Presencia va con todo)
        gama_on = self.var_gdin_front.get()>0 or self.var_gdin_tras.get()>0 or self.var_gdin_cent.get()>0
        din_on = self.var_din_modo.get()!=0
        otros_act = gama_on or din_on

        # Los deslizadores de Dyn/Speech solo se activan si NO hay otros efectos
        disable_dn = loud or sv>0 or otros_act
        disable_sn = loud or dv>0 or otros_act

