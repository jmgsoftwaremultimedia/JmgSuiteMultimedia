                elif b_.denominator==1:   # 48000/f entero: se remuestrea a 48000/f y se reetiqueta como 48 kHz
                    pre.append(f"aresample={b_.numerator},asetrate=48000")
                else:                     # (casi nunca: p. ej. 24 <-> 29,97) redondeo al entero mas cercano, error < 1 ppm
                    pre.append(f"aresample=48000,asetrate={int(round(float(a_)))},aresample=48000")
            else:
