                    pb.configure(value=100 if res else 0)
                    if not res:var_est.set("\n".join(inf));return
                    var_est.set("\n".join(("✓ " if cl=="ok" else "⚠ ")+f"{os.path.basename(k[0])} #{k[1]}: "+txt for k,med,(cl,txt) in res))
                    self._comp_ventana(top,grupos[0],res)
                except Exception:pass
            self._combinando=True;self._cancelar.clear();self._bp_poner(True)
            botones(False)
