        try:
            r=self._run_c([FFMPEG,"-hide_banner","-nostats"]+(["-t",str(seg)] if seg else [])+["-i",arch,"-map",f"0:a:{pista}","-af","ebur128=peak=true","-f","null","-"])[1]
