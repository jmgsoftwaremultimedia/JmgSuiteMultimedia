        def comprobar():
            if self.procesando or getattr(self,"_combinando",False):
                self._toast(T("warn_tit"),V("Espera a que termine el proceso en marcha.","Wait until the running process finishes."),tipo="warning",seg=4);return
            # pistas de origen con su delay (el del primer canal que sale de cada una); la referencia es la que da mas canales
            cuenta={};dels={}
            for c,vs,vd in rows:
                s_=src_de.get(vs.get())
                if not s_:continue
                k=(s_[0],s_[1]);cuenta[k]=cuenta.get(k,0)+1
                if k not in dels:
                    try:dels[k]=float((vd.get() or "0").strip().replace(",","."))
                    except ValueError:
                        self._toast(T("warn_tit"),V("Delay no válido en el canal ","Invalid delay in channel ")+c,tipo="warning",seg=4);return
            if len(cuenta)<2:
                self._toast(T("warn_tit"),V("Los canales salen de una sola pista: no hay nada que sincronizar.","All channels come from a single track: there is nothing to sync."),tipo="warning",seg=5);return
            grupos=sorted(cuenta,key=lambda k:-cuenta[k])
            def acabado(res,inf):
                if res=="prog":
