        self._mst(); self._nm(); self._ex()
    def _fps_archivo(self,ruta=None):
        """framerate detectado del archivo (de la pista activa si no se indica), o 25"""
        if ruta is None:ruta=self.pactual[0] if self.pactual else None
        return getattr(self,"_fps_detectados",{}).get(ruta) or "25"
    def _snap_pista(self):
        """Solo config de pista (sin globales como formato/bitrate/remux/destino...)"""
        s=self._snap()
        # Quitar SOLO los globales reales. Formato/bitrate y la sincronizacion (fps y delay inicial) son de cada pista:
        # cada archivo tiene su framerate.
        for k in ("remux","remux_subs","remux_caps","remux_adj","remux_meta","remux_nucleo",
                  "destino_modo","destino_carpeta","dup_modo","al_terminar"):
            s.pop(k,None)
        return s

    def _guardar_conf_pista(self):
        """Guarda la config de la pista actual (solo ajustes de pista)"""
        if self.pactual is None:return
        try:
            ruta,idx=self.pactual
            self.pconf[(ruta,idx)]=self._snap_pista()
        except Exception:pass

    def _cargar_conf_pista(self,ruta,idx):
        """Carga la config de la pista sin tocar los ajustes globales"""
        key=(ruta,idx)
        if key in self.pconf:
            try:
                # Guardar valores globales
                globales={k:getattr(self,"var_"+k).get() for k in
                          ("remux","remux_subs","remux_caps","remux_adj","remux_meta","remux_nucleo",
                           "destino_modo","destino_carpeta","dup_modo","al_terminar")}
                # Cargar
                self._dictc(self.pconf[key])
                # Restaurar globales
                for k,v in globales.items():
                    try:getattr(self,"var_"+k).set(v)
                    except Exception:pass
            except Exception:
                self._reset_vars()
        else:
            self._reset_vars()

    def _rst(self):
        self._log(T("reset_log"))
        _todo=bool(getattr(self,"var_reset_all",None) and self.var_reset_all.get());self.root.after_idle(lambda:self._auto_tras_reset(_todo))   # (JMG, 8-11) el verde de los «Auto» se apaga

        # 1. Si la casilla "Todo" está marcada, reseteo completo del programa
        if hasattr(self, 'var_reset_all') and self.var_reset_all.get():
            if self._bloq():return
            self._reset_vars()
            self.var_formato.set(DEF_FMT)
            self.var_bitrate.set("640 kbps")
            self.var_remux.set(True)
            self.var_remux_subs.set(True)
            self.var_remux_caps.set(True)
            self.var_remux_adj.set(True)
            self.var_remux_meta.set(True)
            self.var_destino_modo.set("original")
            self.var_destino_carpeta.set("")
            self.var_dup_modo.set("rename")
            self.var_al_terminar.set("nada")
            self.var_upmix.set("N")
            self.var_downmix.set(False);self.var_layout_sal.set('5.1')
            self.var_downmix_modo.set("dolby")
            self.var_downmix_lfe.set(True)
            self.var_guardar_sal.set("defecto")

            try:
                self.cmb_f.set(DEF_FMT)
                self.cmb_b.configure(values=self.formatos[DEF_FMT])
                self.cmb_b.set("640 kbps")
            except Exception:pass

            self._clr()
            try:   # visualizacion fuera del todo: se para la escucha y vuelve el zoom a x1
                self._vis_parar();self._vis_audio_cerrar();self._vis_data=None;self._vis_geom=None;self._vis_sig=None
                self._vz=1.0;self._vv0=0.0;self.var_vis_zh.set("x1");self._vis_modo_txt()
                self.var_vis_estado.set("");self.prog_vis["value"]=0;self._vis_dibujar()
            except Exception:pass
            if hasattr(self, "txt_log"): self.txt_log.delete("1.0", "end")
            self._rmx(); self._dst(); self._umx(); self._dmm(); self._mst(); self._nm(); self._ex()
            self.var_reset_all.set(False)   # «Todo» se desmarca: el siguiente Resetear vuelve a ser solo de la pestaña
            return

        # 2. Si no, reseteo solo la pestaña activa
        # (JMG, 22-11) la pestaña, por su NOMBRE (no por su posición: si cambia el orden de las pestañas, sigue bien)
        try:_nom=self.nb.tab(self.nb.select(),"text")
        except Exception:_nom=T("vol")
        tab={T("vol"):0,T("peq"):1,T("din"):2,T("vis"):3,T("sal"):4,T("log"):5}.get(_nom,-1)   # _RST_TAB

        if tab == 0: # Volumen
            self.var_master.set(0); self.var_master_auto.set(False)
            self.var_norm_vol.set(0)
            self.var_loudnorm_target.set(list(LNT.keys())[2])
            self.var_loudnorm_passes.set(T("ln_p2"))
            self.var_dyn_norm.set(0); self.var_speech_norm.set(0)
            for v in [self.var_fl,self.var_fr,self.var_fc,self.var_lfe,self.var_bl,self.var_br,self.var_suav]: v.set(0)
            _f=self._fps_archivo();self.var_fps_from.set(_f); self.var_fps_to.set(_f); self.var_fps_metodo.set("tono"); self.var_delay_init.set(0)
            if self.pactual:self.ptramos.pop(self.pactual,None)
            self._sinc_txt()

        elif tab == 1: # Presencia / EQ (con su Techo, el Delay por canal y la Limpieza de audio)
            for v in [self.var_voz,self.var_amb,self.var_efc,self.var_sub, self.var_eq_bass,self.var_eq_mids,self.var_eq_treble]: v.set(0)
            for gk in ("front","tras","cent"):
                for i in (1,2,3):
                    getattr(self,f"var_eq{gk}_b{i}_f").set([100,1000,5000][i-1])
                    getattr(self,f"var_eq{gk}_b{i}_g").set(0)
            for v in (self.var_delay_fl,self.var_delay_fr,self.var_delay_fc,self.var_delay_bl,self.var_delay_br): v.set(0)
            self.var_limp.set(0);self.var_declick.set(False);self.var_declip.set(False)
            self.var_techo_pres.set(self._vt("Sin límite","No limit"))

        elif tab == 2: # Dinámica / Bass (con los Techos de Gama y Procesado)
            self.var_bm.set(0); self.var_bm_corte.set(120)
            self.var_db.set(0); self.var_db_corte.set(90)
            self.var_gdin_front.set(0); self.var_gdin_tras.set(0); self.var_gdin_cent.set(0)
            self.var_gdin_vol.set(0)
            self.var_din_modo.set(0); self.var_din_val.set(1); self.var_din_vol.set(0); self.var_din_fc.set(2); self.var_din_ft.set(5); self.var_din_lfe.set(0)
            _sl=self._vt("Sin límite","No limit");self.var_techo_gd.set(_sl);self.var_techo_pd.set(_sl)

        elif tab == 3: # Visualizacion: borrar la visualizacion y su audio
            try:
                if self._vis_run:self._vis_cancelar()
                self._vis_audio_cerrar();self._vis_data=None;self._vis_geom=None;self._vis_modo_txt()
                self._vz=1.0;self._vv0=0.0;self.var_vis_zh.set("x1")
                self.var_vis_estado.set("");self.prog_vis["value"]=0;self._vis_dibujar()
            except Exception:pass
        elif tab == 4: # Salida
            self.var_formato.set(DEF_FMT)
            self.var_bitrate.set("640 kbps")
            self._lay_def_aplicar()
            try:
                self.cmb_f.set(DEF_FMT)
                self.cmb_b.configure(values=self.formatos[DEF_FMT])
                self.cmb_b.set("640 kbps")
            except Exception:pass
            self.var_remux.set(True)
            self.var_remux_subs.set(True)
            self.var_remux_caps.set(True)
            self.var_remux_adj.set(True)
            self.var_remux_meta.set(True)
            self.var_destino_modo.set("original")
            self.var_destino_carpeta.set("")
            self.var_dup_modo.set("rename")
            self.var_al_terminar.set("nada")
            self.var_upmix.set("N")
            self.var_downmix.set(False);self.var_layout_sal.set('5.1')
            self.var_downmix_modo.set("dolby")
            self.var_downmix_lfe.set(True)
            self._rmx(); self._dst(); self._umx(); self._dmm()
            try:   # (revisión, 17-11) con una pista estéreo o mono: el bitrate de partida de sus canales (se quedaba en 640)
                self.var_bitrate.set(self._br_defecto(DEF_FMT,list(self.cmb_b.cget("values"))) or "640 kbps");self._guardar_conf_pista()
            except Exception:pass

        elif tab == 5: # Edit / Log
            if hasattr(self, "txt_log"): self.txt_log.delete("1.0", "end")

        # Refrescar la interfaz general
        self._mst(); self._nm(); self._ex()
        try:self._update_editlog()
        except Exception:pass

def _escuchar_instancias(srv,app):
    """recibe los archivos de otras instancias y los añade en esta ventana (hilo aparte -> cola segura de la UI)"""
    while True:
        try:c,_=srv.accept()
        except OSError:return
        try:
            c.settimeout(3);b=b""
            while True:
                d=c.recv(65536)
                if not d:break
                b+=d
            m=json.loads(b.decode("utf-8") or "{}")
            if m.get("jmg")=="ap51":
                arch=[a for a in m.get("archivos",[]) if isinstance(a,str) and os.path.isfile(a)]
                app._ui(app._traer_al_frente,arch)
        except Exception:pass
        finally:
            try:c.close()
            except Exception:pass

if __name__=="__main__":
    try:
        # Abrir archivos pasados por linea de comandos («Abrir con...», arrastrar sobre el icono)
        archivos=[os.path.abspath(a) for a in sys.argv[1:] if os.path.isfile(a)]
        srv=_instancia_unica(archivos)
        if srv is None:sys.exit(0)          # ya habia una ventana abierta: los archivos se han enviado alli
        root=TkinterDnD.Tk()
        # la ventana se muestra cuando ya esta montada y coloreada: si aparece mientras el programa aun esta
        # ocupado preparandose, Windows deja congelado el ultimo puntero (se veian unas flechas <-> al abrir)
        root.withdraw()
        cerrar_inicio=_inicio_abrir(root,"Jmg AudioProcesador 5.1",f"v{VERSION_PROG} · Jmg SuiteMultimedia {SUITE_VER}")   # (JMG, 13-11)
        app=AudioProcessorGUI(root)
        if srv:threading.Thread(target=_escuchar_instancias,args=(srv,app),daemon=True).start()
        def _ver_ya():
            app._mostrar()
            if archivos:root.after(100, lambda: app._addl(archivos))
        cerrar_inicio(_ver_ya)
        root.after(4000, app._ver_nueva)   # solo al arrancar el programa de verdad (las pruebas no lo llaman)
        root.after(7000, app._apoyo_aviso)   # (JMG, 13-11) el recordatorio de contribuir, cada 45 días
        root.mainloop()
    except Exception as e:
        import traceback
        messagebox.showerror("Error",f"{e}\n\n{traceback.format_exc()}")
