        def pistas_y_delays():
            """(grupos con la referencia primero, delay de cada pista) o None si avisa"""
            cuenta={};dels={}
            for c,vs,vd in rows:
                s_=src_de.get(vs.get())
                if not s_:continue
                k=(s_[0],s_[1]);cuenta[k]=cuenta.get(k,0)+1
                if k not in dels:
                    try:dels[k]=float((vd.get() or "0").strip().replace(",","."))
                    except ValueError:
                        self._toast(T("warn_tit"),V("Delay no válido en el canal ","Invalid delay in channel ")+c,tipo="warning",seg=4);return None
            if len(cuenta)<2:
                self._toast(T("warn_tit"),V("Los canales salen de una sola pista: no hay nada que sincronizar.","All channels come from a single track: there is nothing to sync."),tipo="warning",seg=5);return None
            return sorted(cuenta,key=lambda k:-cuenta[k]),dels
        def corregir():
            if self.procesando or getattr(self,"_combinando",False):
                self._toast(T("warn_tit"),V("Espera a que termine el proceso en marcha.","Wait until the running process finishes."),tipo="warning",seg=4);return
            pd=pistas_y_delays()
            if not pd:return
            grupos,dels=pd
            if tramos and var_tram.get() and tram_ref[0]==(list(grupos),dict(dels)):
                m_=V("Ya está corregido por tramos con estos orígenes y delays: se aplicará al combinar. No hace falta volver a medirlo.",
                     "It is already fixed by parts with these sources and delays: it will be applied when combining. No need to measure it again.")
                var_est.set(m_);self._toast(T("info_tit"),m_,tipo="info",seg=6);return
            def acabado(res,inf):
                if res=="prog":
                    try:var_est.set(inf[0]);pb.configure(value=100*inf[1])
                    except Exception:pass
