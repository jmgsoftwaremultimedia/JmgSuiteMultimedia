    def _set_enabled(self,activo):
        """Habilita o deshabilita todos los controles de las pestanas"""
        estado="normal" if activo else "disabled"
        for tab_id in self.nb.tabs():
            try:
                tab_frame=self.nb.nametowidget(tab_id)
                self._rec_set_enabled(tab_frame,estado)
            except Exception:pass
        # Fuera de las pestañas: Quitar, Limpiar, presets, acciones de pista, titulo, Resetear, Todo y Al terminar
        for w in getattr(self,"_sin_arch",[]):
            try:
                if w.winfo_class()=="TCombobox":w.configure(state="readonly" if activo else "disabled")
                elif w.winfo_class()=="Entry":
                    if activo:w.configure(state="normal",bg=CDN,fg=CT,insertbackground=CT)
                    else:w.configure(state="disabled",disabledbackground=CDN,disabledforeground=CA)
                else:w.configure(state=estado)
            except Exception:pass
        if activo:
            try:self._ex_eqvol()
            except Exception:pass

    def _rec_set_enabled(self,padre,estado):
        for w in padre.winfo_children():
            cls=w.winfo_class()
            try:
                if w==getattr(self,"en_tit",None) or w==getattr(self,"lbl_marcadas",None):
                    continue
            except Exception:pass
            try:
                if cls=="TCombobox":
                    w.configure(state="readonly" if estado=="normal" else "disabled")   # nunca editables a mano
                elif cls in ("TScale","Scale","TEntry","Entry","TCheckbutton","TRadiobutton","TButton","Button"):
                    w.configure(state=estado)
            except Exception:pass
            try:
                self._rec_set_enabled(w,estado)
            except Exception:pass
    def _scrollable(self,parent):
