                    n=max([len(v) for v in tramos.values()] or [0])
                    lin=[];hay=False
                    for k,tl in tramos.items():
                        es_=[dels.get(k,0.0)-v for c0,c1,v0,v1 in tl for v in (v0,v1)]
                        igual=len(tl)==1 and abs(tl[0][2]-tl[0][3])<0.5
                        hay=hay or not igual
                        lin.append(f"✂ {os.path.basename(k[0])} #{k[1]}: "+(V(f"{len(tl)} tramos, delay de {min(es_):+.0f} a {max(es_):+.0f} ms.",
