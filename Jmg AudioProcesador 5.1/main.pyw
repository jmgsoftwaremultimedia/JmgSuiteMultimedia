    # ---------- Editor: subir o bajar un trozo de uno o varios canales de un WAV o FLAC, sin perdidas ----------
    # Los cambios son una lista; el archivo solo se escribe con Guardar, a «nombre_retocada» (la original no se toca).
    # Todo lo que no se ha cambiado sale identico, muestra a muestra: el audio pasa por aqui en crudo y solo se toca lo marcado.
    _ED_LAY={1:"mono",2:"stereo",3:"2.1",4:"3.1",5:"4.1",6:"5.1",8:"7.1"}
    def _ed_info(self,ruta,idx):
        """datos del archivo para editarlo, o None si no es un WAV / FLAC de una sola pista"""
        ext=os.path.splitext(ruta)[1].lower()
        if ext not in (".wav",".flac",".w64") or len(self.pc.get(ruta) or [])!=1:return None
        try:
            r=rh([FFPROBE,"-v","error","-select_streams","a:0","-show_entries","stream=codec_name,sample_rate,channels,channel_layout,sample_fmt,bits_per_raw_sample","-of","json",ruta],timeout=20)
            s=json.loads(r.stdout or "{}")["streams"][0]
            cod=s["codec_name"];sr=int(s["sample_rate"]);n=int(s["channels"]);fs=s.get("sample_fmt") or ""
        except Exception:return None
        if cod=="flac":
            try:bits=int(s.get("bits_per_raw_sample") or 0)
            except ValueError:bits=0
            bits=bits or (16 if fs.startswith("s16") else 24)
        elif cod in ("pcm_s16le","pcm_s24le","pcm_s32le"):bits=int(cod[5:7])
        elif cod=="pcm_f32le":bits=0
        else:return None
        cru={16:("s16le","h",1),24:("s32le","i",256),32:("s32le","i",1),0:("f32le","f",0)}.get(bits)
        if not cru:return None
        return {"ruta":ruta,"idx":idx,"cod":cod,"sr":sr,"n":n,"bits":bits,"cru":cru,"ext":ext,"lay":s.get("channel_layout") or self._ED_LAY.get(n,f"{n}c"),
                "noms":[self._vis_can(x) for x in self._vis_nom_ent(n,(self.pc[ruta][idx] or {}).get("layout"))]}
    def _ed_activo(self):
        d_=self._vis_data;i=self._ed_inf
        return bool(self.var_ed.get() and d_ and i and d_.get("ruta")==i["ruta"] and d_.get("idx")==i["idx"] and float(d_.get("dur",0))<self._dur_ed()+1.5)
    def _dur_ed(self):
        i=self._ed_inf
        if not i.get("dur"):i["dur"]=self._dur(i["ruta"])
        return i["dur"]
    def _ed_hist(self):
        i=self._ed_inf
        return self._ed_por.setdefault((i["ruta"],i["idx"]),{"hechos":[],"rehacer":[]})
    def _ed_barra(self):
        try:
            on=bool(self.var_ed.get())
            if on:
                self.fr_ed.pack(fill="x",padx=8,pady=(0,2),after=self._ed_rd);self.lbl_ed.pack(side="left",padx=(14,0))
            else:
                self.fr_ed.pack_forget();self.lbl_ed.pack_forget()
            if on and self._ed_inf:
                self._ed_cs=set(range(len(self._ed_inf["noms"])));self._ed_estado()   # hasta marcar un trozo, todos los canales
        except Exception:pass
    def _ed_cambio(self):
        if self.var_ed.get():self._ed_abrir(True)
        else:
            self._ed_barra();self._vis_dibujar()
    def _ed_abrir(self,generar):
        """entra en edicion con la pista activa: al marcar la casilla (generar) se ve entera; dentro, se respeta el tramo que elijas"""
        V=self._vt
        if not self.pactual:
            self.var_ed.set(False);self._ed_barra()
            self._toast(T("warn_tit"),V("Selecciona primero un archivo y una pista.","Select a file and a track first."),tipo="warning");return
        inf=self._ed_info(*self.pactual)
        if not inf:
            self.var_ed.set(False);self._ed_inf=None;self._ed_barra();self._vis_dibujar()
            self._toast(T("warn_tit"),V("El editor trabaja con archivos WAV, W64 o FLAC de una sola pista, porque no pierden calidad. Combina la película en uno de esos formatos y edita la pista combinada.",
                                        "The editor works with single-track WAV, W64 or FLAC files, because they lose no quality. Combine the movie in one of those formats and edit the combined track."),tipo="warning",seg=8);return
        self._ed_inf=inf;self._ed_det=None;self._ed_detno=False
        self._ed_barra()
        if self._ed_activo() and (not generar or float(self._vis_data.get("dur",0))>self._dur_ed()-1.5):self._vis_dibujar();return
        if generar and self._vis_genera():self._vis_cancelar()
        if generar and not self._vis_run:
            self.var_vis_tramo_i.set(0);self.cmb_vis_tramo.current(0)
            self._vis_generar()
    @staticmethod
    def _ed_leer(s):
        """segundos de «h:mm:ss.d», «mm:ss» o «ss», o None"""
        try:
            p=[float(x) for x in s.strip().replace(",",".").split(":")]
            if not 1<=len(p)<=3 or min(p)<0:return None
            t=0.0
            for x in p:t=t*60+x
            return t
        except ValueError:return None
    def _ed_tx(self,e):
        g=self._vis_geom
        if not g:return None
        ML,ancho=g[0],g[1];x=self.cv_vis.canvasx(e.x);v0,v1,dur=self._vis_rango()
        return max(0.0,min(dur,v0+(x-ML)/float(ancho)*(v1-v0)))
    def _ed_carril(self,e):
        """canal bajo el raton (el primero o el ultimo si se sale por arriba o por abajo)"""
        L_=getattr(self,"_vis_lanes",[]);yc=self.cv_vis.canvasy(e.y)
        for q in L_:
            if yc<q[1]:return q[3]
        return L_[-1][3] if L_ else None
    def _ed_borde(self,e):
        """borde de la seleccion bajo el raton, sobre los canales marcados: (borde que se queda fijo, borde agarrado), o None"""
        g=self._vis_geom;s=self._ed_sel
        if not g or not s or e.state&1 or not self._ed_activo():return None
        yc=self.cv_vis.canvasy(e.y)
        if not any(ya<=yc<yb and i_ in self._ed_cs for (ya,yb,tipo,i_,nm) in getattr(self,"_vis_lanes",[])):return None
        ML,ancho=g[0],g[1];v0,v1,_d=self._vis_rango();x=self.cv_vis.canvasx(e.x)
        da=abs(x-(ML+(s[0]-v0)/max(1e-9,v1-v0)*ancho));db=abs(x-(ML+(s[1]-v0)/max(1e-9,v1-v0)*ancho))
        if min(da,db)>6:return None
        return (s[1],s[0]) if da<db else (s[0],s[1])
    def _ed_tsel(self,e):
        """instante que marca el raton (agarrando un borde, el borde no salta hasta el raton)"""
        return max(0.0,min(self._vis_rango()[2],self._ed_tx(e)+self._ed_bo))
    def _ed_down(self,e):
        t=self._ed_tx(e)
        if t is None:return
        b=self._ed_borde(e);self._ed_ev=e
        if b:   # un borde: el otro se queda quieto y el trozo crece o encoge con el raton
            self._ed_bo=b[1]-t;self._ed_ar=(b[0],e.x,None,True);return
        self._ed_bo=0.0;self._ed_ar=(t,e.x,self._ed_carril(e),False)
    def _ed_mueve(self,e):
        p=self._ed_ar
        if not p:return
        t0,x0,ich,mv=p
        if not mv and abs(e.x-x0)<4:return
        j=self._ed_carril(e)   # el canal donde empieza el arrastre, y los que cruce en vertical
        if ich is not None and j is not None:self._ed_cs=set(range(min(ich,j),max(ich,j)+1))
        self._ed_ar=(t0,x0,ich,True);self._ed_pon_sel(t0,self._ed_tsel(e));self._ed_ev=e
        if self._ed_av is None:self._ed_avanza()
    def _ed_avanza(self):
        """con zoom, si el raton se sale de la onda al marcar, la onda le sigue, mas deprisa cuanto mas lejos"""
        self._ed_av=None;p=self._ed_ar;e=self._ed_ev;g=self._vis_geom
        if not p or not g or self._vz<=1.0:return
        x=self.cv_vis.canvasx(e.x);sal=min(0.0,x-g[0]) or max(0.0,x-g[0]-g[1])
        if not sal:return
        v0,v1,dur=self._vis_rango();w=v1-v0
        self._vv0=max(0.0,min(dur-w,v0+w*max(-0.1,min(0.1,sal/2000.0))))
        self._vis_dibujar();self._ed_pon_sel(p[0],self._ed_tsel(e))
        self._ed_av=self.root.after(50,self._ed_avanza)
    def _ed_up(self,e):
        p=self._ed_ar;self._ed_ar=None
        if p and p[3]:
            self._ed_pon_sel(p[0],self._ed_tsel(e));return
        self._vis_clic(e)
    def _ed_quita(self):
        """fuera la seleccion: vuelven todos los canales"""
        self._ed_sel=None;self.var_ed_de.set("");self.var_ed_a.set("");self._ed_cs=set(range(len(self._ed_inf["noms"])));self._ed_marca()
    def _ed_pon_sel(self,a,b):
        a,b=min(a,b),max(a,b);self._ed_sel=(a,b)
        self.var_ed_de.set(self._hms(a));self.var_ed_a.set(self._hms(b));self._ed_marca()
    def _ed_marca(self):
        """selección sobre los canales marcados"""
        cv=self.cv_vis;g=self._vis_geom;cv.delete("edsel")
        if not g or not self._ed_sel or not self._ed_activo():return
        ML,ancho=g[0],g[1];v0,v1,_d=self._vis_rango()
        x0=ML+(self._ed_sel[0]-v0)/max(1e-9,v1-v0)*ancho;x1=ML+(self._ed_sel[1]-v0)/max(1e-9,v1-v0)*ancho
        x0=max(ML,x0);x1=min(ML+ancho,x1)
        if x1<=x0:return
        for (ya,yb,tipo,i_,nm) in getattr(self,"_vis_lanes",[]):
            if i_ in self._ed_cs:
                cv.create_rectangle(x0,ya+1,x1,yb-1,outline="#ffb020",width=2,fill="#ffb020",stipple="gray25",tags="edsel")
    def _ed_estado(self):
        if not self._ed_inf:return
        n=len(self._ed_hist()["hechos"])
        self.var_ed_est.set(self._vt("Sin cambios","No changes") if not n else self._vt(f"{n} cambio(s) sin guardar",f"{n} unsaved change(s)"))
        self._vis_botones()
    def _ed_oye(self,cual):
        """con cambios sin guardar, «Escuchar con cambios» y el clic en un canal suenan ya con ellos"""
        if cual=="oir":return self._ed_activo()
        return cual in ("despues","solo") and self._ed_activo() and bool(self._ed_hist()["hechos"])
    def _ed_graf(self,pos,solo,mc):
        """filtros de la escucha con los cambios puestos: cada canal con su volumen a lo largo del tiempo (fundidos de 20 ms, como al guardar).
        solo = los canales que se oyen (None = todos)"""
        i=self._ed_inf;n=i["n"];t_=f"(t+{pos:.3f})"
        if solo is not None and len(solo)>=n:solo=None
        P=["[0:a:0]asetnsamples=n=480:p=0"+(f",channelsplit=channel_layout={i['lay']}"+"".join(f"[c{k}]" for k in range(n)) if n>1 else "[c0]")]
        for k in range(n):
            ga=[f"(1+({10.0**(db/20.0):.6f}-1)*clip(min(({t_}-{a:.3f})/0.02,({b:.3f}-{t_})/0.02),0,1))" for a,b,chs,db in self._ed_hist()["hechos"] if k in chs]
