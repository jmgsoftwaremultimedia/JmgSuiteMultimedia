    def _din_nom(self,m):
        return {1:self._vt("Elevación","Lift"),2:self._vt("Impacto","Impact"),3:self._vt("Elevación + Impacto","Lift + Impact")}.get(int(m),self._vt("Elevación","Lift"))
    def _din_lbl(self):
