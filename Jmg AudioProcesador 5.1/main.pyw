                        cad+=f",apad=pad_dur=1,asetnsamples=n=480:p=1,arnndn=m={_ff_ruta(RNN_VOZ)}:mix=1,atrim=start_sample=480,asetpts=PTS-STARTPTS"
                    gv=self._comb_gama(gama,c)
