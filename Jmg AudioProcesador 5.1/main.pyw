    def _sinc_lista(self):
        """pistas con las que comparar la activa. Si no hay ninguna elegida, sale otra del mismo archivo"""
        m_={}
        for ruta in self.files:
            for p in self.pc.get(ruta) or []:
                k=(ruta,p["orden"])
                if k!=self.pactual and p["orden"] not in self.borrar_pistas.get(ruta,()):
                    m_[f"{os.path.basename(ruta)} · #{p['orden']} [{p['lang']}] {p['layout']}"]=k
        self._sinc_map=m_;self.cmb_sinc.configure(values=list(m_))
        if self.var_sinc_ref.get() not in m_:
            mis=[e for e,k in m_.items() if self.pactual and k[0]==self.pactual[0]]
            self.var_sinc_ref.set((mis or list(m_) or [""])[0])
    def _sinc_txt(self):
        """lo que hay puesto en la pista activa"""
        V=self._vt;t_=self.ptramos.get(self.pactual) if self.pactual else None
        try:
            if not t_:
                self.fr_sinc_q.pack_forget();self.var_sinc_txt.set("");return
            ok=abs(self._raw(self.var_delay_init)-t_["d"])<0.5 and str(self.var_fps_from.get())==str(self.var_fps_to.get())
            self.var_sinc_txt.set(V(f"✂ {len(t_['tl'])} tramos: se aplicarán al procesar",f"✂ {len(t_['tl'])} parts: they will be applied when processing") if ok else
                                  V("⚠ Tramos sin efecto: has cambiado el delay o el framerate. Vuelve a medir.","⚠ Parts have no effect: you changed the delay or framerate. Measure again."))
            self.fr_sinc_q.pack(anchor="w",pady=(4,0),after=self._sinc_f2)
        except Exception:pass
    def _sinc_quita(self):
        if self.pactual:self.ptramos.pop(self.pactual,None)
        self._sinc_txt()
    def _sinc_par(self):
        """(referencia, pista activa) o None si avisa"""
        V=self._vt
        if self._ocupado():
            self._toast(T("warn_tit"),V("Espera a que termine el proceso en marcha.","Wait until the running process finishes."),tipo="warning",seg=4);return None
        if not self.pactual:
            self._toast(T("warn_tit"),V("Selecciona al menos una pista primero","Select at least one track first"),tipo="warning");return None
        self._sinc_lista();ref=self._sinc_map.get(self.var_sinc_ref.get())
        if not ref:
            self._toast(T("warn_tit"),V("Hace falta otra pista con la que comparar: añade a la lista la del idioma original.","Another track is needed to compare with: add the original-language track to the list."),tipo="warning",seg=6);return None
        return ref,self.pactual
    def _sinc_em(self,on,txt=""):
        self._escaneando=on;self._mst()
        est="normal" if on else "disabled"
        self.btn_cancel_scan.configure(state=est);self.btn_c.configure(state=est)
        if on:
            self._cancelar.clear();self.btn_scan.configure(state="disabled")
        self._set_prog(0);self._st(txt)
    def _sinc_pon(self,k,d):
        """deja el delay en la pista (y en el deslizador si sigue siendo la activa)"""
        if k not in self.pconf:self.pconf[k]=self._snap_pista()
        self.pconf[k]["delay_init"]=d
        if self.pactual==k:self.var_delay_init.set(d)
    def _sinc_calc(self):
        """«Calcular delay»: el de Combinar, para la pista activa contra la de referencia"""
        V=self._vt;q=self._sinc_par()
        if not q:return
        ref,k=q;self._guardar_conf_pista()
        def fin(res,inf):
            if res=="prog":
                self._set_prog(100.0*inf[1]);self._st(inf[0]);return
            self._sinc_em(False)
            if inf==["cancel"]:
                self._toast(T("cancelado_tit"),V("Medida cancelada.","Measurement cancelled."),tipo="info",seg=3);return
            if not res or k not in res:
                self._toast(T("warn_tit"),"\n".join(inf) or V("No se ha podido calcular.","Could not calculate."),tipo="warning",seg=8);return
            d_=int(res[k]-res.get(ref,0))
            if abs(d_)>6000:
                self._toast(T("warn_tit"),V(f"Sale un desfase de {d_:+d} ms, más que el máximo del Delay inicial. Comprueba que sean la misma versión de la película.",
                                            f"The offset is {d_:+d} ms, more than the Initial delay maximum. Check they are the same version of the movie."),tipo="warning",seg=8);return
            self.ptramos.pop(k,None);self._sinc_pon(k,d_);self._sinc_txt()
            self._toast(T("info_tit"),"\n".join([V(f"Delay inicial: {d_:+d} ms",f"Initial delay: {d_:+d} ms"),V("Queda en el deslizador: puedes retocarlo a mano.","It stays on the slider: you can adjust it by hand.")]+inf),tipo="info",seg=8)
        self._sinc_em(True,V("Comparando las pistas...","Comparing the tracks..."))
        threading.Thread(target=self._comb_sinc,args=([ref,k],fin),daemon=True).start()
    def _sinc_tramos(self):
        """«Corregir por tramos»: el de Combinar, para la pista activa contra la de referencia. Se aplica al procesar"""
        V=self._vt;q=self._sinc_par()
        if not q:return
        ref,k=q;self._guardar_conf_pista()
        if str(self.var_fps_from.get())!=str(self.var_fps_to.get()):
            self._toast(T("warn_tit"),V("Con cambio de framerate no se puede: convierte antes la pista y mide la convertida.","Not possible with a framerate change: convert the track first and measure the converted one."),tipo="warning",seg=6);return
        d_=float(self._raw(self.var_delay_init));dels={ref:0.0,k:d_}
        t_=self.ptramos.get(k)
        if t_ and abs(d_-t_["d"])<0.5 and t_.get("ref",ref)==ref:
            self._toast(T("info_tit"),V(f"Esta pista ya está corregida por tramos ({len(t_['tl'])} tramos) y se aplicará al procesar: no hace falta volver a medirla. Si quieres medirla otra vez, pulsa antes «Quitar».",
                                        f"This track is already fixed by parts ({len(t_['tl'])} parts) and it will be applied when processing: no need to measure it again. To measure it again, press «Remove» first."),tipo="info",seg=8);return
        def fin(res,inf):
            if res=="prog":
                self._set_prog(100.0*inf[1]);self._st(inf[0]);return
            self._sinc_em(False)
            if inf==["cancel"]:
                self._toast(T("cancelado_tit"),V("Medida cancelada.","Measurement cancelled."),tipo="info",seg=3);return
            tl=(res or {}).get(k)
            if not tl:
                self._toast(T("warn_tit"),"\n".join(inf) or V("No se ha podido calcular.","Could not calculate."),tipo="warning",seg=8);return
            if len(tl)==1 and abs(tl[0][2]-tl[0][3])<0.5:   # igual en toda la pelicula: basta con un delay
                n_=int(round(d_-tl[0][2]));self.ptramos.pop(k,None);self._sinc_pon(k,n_);self._sinc_txt()
                self._toast(T("info_tit"),V(f"Va igual en toda la película: basta con un Delay inicial de {n_:+d} ms, y ya está puesto.",f"It is the same throughout the movie: an Initial delay of {n_:+d} ms is enough, and it is set."),tipo="info",seg=8);return
            self.ptramos[k]={"tl":[tuple(q_) for q_ in tl],"d":d_,"ref":ref};self._sinc_txt()
            self._tramos_ventana(self.root,{k:tl},{k:d_},("Se aplica al procesar.","It is applied when processing."))
        self._sinc_em(True,V("Midiendo el desfase por toda la película...","Measuring the offset throughout the movie..."))
        threading.Thread(target=self._comb_tramos,args=([ref,k],dels,fin),daemon=True).start()
    # ---------- «▶ Revisar sincronización»: la película con la pista, en una ventana de vídeo con sonido (ffplay) ----------
    def _rev_ventana(self,nombre,dur,tl,dl,ref_txt,jugar,parar,sal0="mc"):
        """ventana comun (igual en Jmg AudioProcesador y Jmg VideoEncoder): desde donde, que se oye y por donde.
        jugar(pos, modo, sal) con modo corr / sin / ref y sal mc / st; parar() corta la reproduccion"""
        V=self._vt;hm=lambda s:"%d:%02d:%02d"%(int(s)//3600,int(s)%3600//60,int(s)%60)
        try:
            w0=getattr(self,"_rev_top",None)
            if w0 is not None and w0.winfo_exists():w0.destroy()
        except Exception:pass
        parar()
        w=tk.Toplevel(self.root);w.title(V("Revisar sincronización","Check synchronization"));w.configure(bg=CF);w.transient(self.root);self._rev_top=w
        f=ttk.Frame(w);f.pack(fill="both",expand=True,padx=14,pady=12)
        ttk.Label(f,text="▶ "+V("Revisar sincronización","Check synchronization")+" · "+nombre,font=("",10,"bold")).grid(row=0,column=0,columnspan=4,sticky="w")
