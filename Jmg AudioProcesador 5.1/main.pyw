        except Exception:ch=6
        af=("aformat=channel_layouts='5.1|5.1(side)',pan=mono|c0=FC," if ch>=3 else "")+"ebur128=framelog=quiet"
        try:
            r=self._run_c([FFMPEG,"-hide_banner","-nostats"]+(["-t",str(seg)] if seg else [])+["-i",arch,"-map",f"0:a:{pista}","-af",af,"-f","null","-"])[1]
            I=float(re.findall(r"I:\s+(-?[\d.]+)\s+LUFS",r)[-1])
