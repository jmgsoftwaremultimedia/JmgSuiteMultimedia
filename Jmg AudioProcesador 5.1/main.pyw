            threading.Thread(target=self._comb_tramos,args=(grupos,dels,acabado),daemon=True).start()
        def igualar_tono():
            if self.procesando or getattr(self,"_combinando",False):
                self._toast(T("warn_tit"),V("Espera a que termine el proceso en marcha.","Wait until the running process finishes."),tipo="warning",seg=4);return
            self._guardar_conf_pista()   # el upmix de la pista activa (para «C (voz extraída)», «L/R sin voz») sin leer Tk desde el hilo
            # referencia = la pista que da mas canales; se igualan los canales que vienen de OTRA pista, midiendo cada uno contra
            # el mismo canal de la referencia (aunque no vaya a la mezcla). Si la referencia no tiene ese canal (traseros ingleses con
            # delanteros de un doblaje 2.0): la diferencia de tono entre las dos pistas, de media, en los canales que comparten
            cuenta={}
            for c,vs,vd in rows:
                s_=src_de.get(vs.get())
                if s_:cuenta[(s_[0],s_[1])]=cuenta.get((s_[0],s_[1]),0)+1
            if len(cuenta)<2:
                self._toast(T("warn_tit"),V("Los canales salen de una sola pista: no hay tono que igualar.","All channels come from a single track: there is no tone to match."),tipo="warning",seg=5);return
            ref=max(cuenta,key=lambda k:cuenta[k])
            de_ref={s[3]:s for e,s in fuentes if (s[0],s[1])==ref}
            alt={"BL":"SL","BR":"SR","SL":"BL","SR":"BR"}
            trabajos=[]
            for n,(c,vs,vd) in enumerate(rows):
                s_=src_de.get(vs.get())
                if not s_ or (s_[0],s_[1])==ref or c=="LFE":continue
                r_=de_ref.get(c) or de_ref.get(alt.get(c,"")) or (de_ref.get("") if len(de_ref)==1 else None)
                if r_:trabajos.append((n,c,[((s_[0],s_[1],s_[2]),(r_[0],r_[1],r_[2]))]));continue
                de_src={s[3]:s for e,s in fuentes if (s[0],s[1])==(s_[0],s_[1]) and isinstance(s[2],int)}
                pares=[]
                for nm in ("FL","FR","FC","BL","BR","SL","SR"):
                    a_=de_src.get(nm)
                    b_=de_ref.get(nm) or de_ref.get(alt.get(nm,"")) or (de_ref.get("C~") if nm=="FC" else None) or (de_ref.get("") if (nm=="FC" and len(de_ref)==1) else None)
                    if a_ and b_:pares.append(((a_[0],a_[1],a_[2]),(b_[0],b_[1],b_[2])))
                if pares:trabajos.append((n,c,pares))
            if not trabajos:
                self._toast(T("warn_tit"),V("No hay canales que igualar: las dos pistas no comparten ningún canal.","No channels to match: the two tracks do not share any channel."),tipo="warning",seg=5);return
            def acabado(res,inf):
                if res=="prog":
                    try:var_est.set(inf[0]);pb.configure(value=100*inf[1])
                    except Exception:pass
                    return
                self._combinando=False
                try:
                    botones(True)
                    if inf==["cancel"]:var_est.set(V("Cancelado.","Cancelled."));pb.configure(value=0);return
                    pb.configure(value=100 if res else 0)
                    for n,g in (res or {}).items():
                        curvas[n]=g;vtonos[n].set(self._tono_resumen(g))
                    if res:var_tono.set(True)
                    var_est.set("\n".join(([V("Tono medido respecto a ","Tone measured against ")+f"{os.path.basename(ref[0])} #{ref[1]}"+
                                            V(". Se aplicará al combinar (casilla «Aplicar la igualación de tono»).",". It will be applied when combining («Apply the tone matching» box).")] if res else [])+list(inf)))
                except Exception:pass
            self._combinando=True;self._cancelar.clear();self._bp_poner(True)
            botones(False)
            pb.configure(value=0);var_est.set(V("Midiendo el tono...","Measuring the tone..."))
            threading.Thread(target=self._comb_tono,args=(trabajos,acabado),daemon=True).start()
        def auto_gama(silv=False):
