    def _aften_args(self,cs,af_=None):
        """(argumentos de FFmpeg en lugar de «-c:a ac3 -b:a Nk», orden de Aften) para «Aften Dolby Digital»; None si no hay Aften.
        af_ = los ajustes de Aften de la pista (JMG, 10-11: cada pista los suyos)"""
        a=dict(AFTEN_DEF);a.update(af_ if isinstance(af_,dict) else getattr(self,"_aften",{}))
        if not AFTEN:return None
        t=cs.split()
        if "-c:a" not in t or t[t.index("-c:a")+1]!="ac3":return None
        b="640"
        if "-b:a" in t:b=t[t.index("-b:a")+1].rstrip("k")
        resto=[];i=0
        while i<len(t):
            if t[i] in ("-c:a","-b:a"):i+=2;continue
            resto.append(t[i]);i+=1
        ac=[AFTEN,"-v","0","-readtoeof","1"]+(["-q",str(int(a["q"]))] if a["modo"]=="vbr" else ["-b",b])+self._aften_opciones(a)+["-","-"]
        return ["-c:a","pcm_f32le"]+resto+(["-ar",str(int(a["frec"]))] if a.get("frec") else []),ac   # (JMG, 15-11) su frecuencia
    def _ffm_aften(self,cmd,ac,sal,cb=None):
        """FFmpeg (WAV en coma flotante por su salida) -> Aften -> el AC3, que guarda Python. El progreso, de FFmpeg (por stderr)"""
        try:self._ls("    CMD: "+" ".join(str(c) for c in cmd)+"  |  "+" ".join(str(c) for c in ac))
        except Exception:pass
        kw={"creationflags":CNW} if sys.platform=="win32" else {}
        try:
            pf=subprocess.Popen(cmd,stdout=subprocess.PIPE,stderr=subprocess.PIPE,**kw)
            pa=subprocess.Popen(ac,stdin=pf.stdout,stdout=subprocess.PIPE,stderr=subprocess.PIPE,**kw)
        except Exception as e:self._ls(f"    [ERR] {e}");return False
        try:pf.stdout.close()   # que Aften vea el final cuando FFmpeg acabe
        except Exception:pass
        with self._lock:self._procesos+= [pf,pa]
        err_f=[];err_a=[];escrito=[0];fallo=[None]
        def lee_ff():
            try:
                for l in pf.stderr:
                    l=l.decode("utf-8","ignore").strip()
                    if l.startswith("out_time_us=") or l.startswith("out_time_ms="):
                        try:
                            if cb:cb(int(l.split("=",1)[1])/1_000_000.0)
                        except (ValueError,IndexError):pass
                    elif l and "=" not in l:err_f.append(l)
            except Exception:pass
        def lee_af():
            try:
                with open(sal,"wb") as fo:
                    while True:
                        b_=pa.stdout.read(1<<16)
                        if not b_:break
                        fo.write(b_);escrito[0]+=len(b_)
            except Exception as e:fallo[0]=e
        def err_af():
            try:err_a.extend(x.decode("utf-8","ignore") for x in pa.stderr)
            except Exception:pass
        hs=[threading.Thread(target=x,daemon=True) for x in (lee_ff,lee_af,err_af)]
        for h in hs:h.start()
        while pa.poll() is None:
            if self._cancelar.is_set():break
            if pf.poll() not in (None,0):break   # FFmpeg ha fallado: Aften se quedaría esperando
            time.sleep(0.15)
        for p_ in (pf,pa):
            if p_.poll() is None and (self._cancelar.is_set() or pf.returncode not in (None,0)):self._matar(p_)
        for p_ in (pf,pa):
            try:p_.wait(timeout=10)
            except Exception:self._matar(p_)
        for h in hs:h.join(timeout=5)
        with self._lock:
            for p_ in (pf,pa):
                if p_ in self._procesos:self._procesos.remove(p_)
        ok=pf.returncode==0 and pa.returncode==0 and escrito[0]>0 and fallo[0] is None and not self._cancelar.is_set()
        if not ok:
            for _i in range(10):
                try:
                    if os.path.isfile(sal):os.remove(sal)
                    break
                except OSError:time.sleep(0.3)
            if self._cancelar.is_set():self._ls("    [X] Cancelado")
            else:
                self._ls(f"    [ERR] ffmpeg {pf.returncode} · aften {pa.returncode}")
                for l in (err_f[-8:]+[x.strip() for x in err_a if x.strip() and "SIMD" not in x and "Threads" not in x][-6:]):self._ls("      "+l)
        return ok
    def _uno_multi(self,a,tareas,cb):
        """Procesa todas las pistas marcadas de un archivo. tareas=[(idx,cfg),...]"""
        d=self._cs(a);b=self._clean_base(a)
        n=len(tareas)
        dur=self._dur(a)
        procesadas=[]
        rmx=bool(self._opt("remux"));vi=None
        ext=(getattr(self,"_lsnap",None) or {}).get("extras",{}).get(a,[]);ext_hechas=[]
        if rmx:
            vi=self._video_idx(a)
            if vi is None:   # archivo sin video (.ac3, .flac, .mka...): no hay MKV que montar -> se guarda el audio
                rmx=False
                self._ls("    "+self._vt("[i] Sin vídeo: se guarda solo el audio procesado (no se monta MKV).","[i] No video: only the processed audio is saved (no MKV)."))
        def _lim_tmp():
            # Si se cancela o falla: en modo MKV las pistas ya hechas son intermedias (iban a entrar en el MKV) -> se borran;
            # los temporales de passthrough, siempre
            for _i,_pth in procesadas+[(x[1],x[2]) for x in ext_hechas]:
                if os.path.basename(_pth).startswith("_tmp_") or rmx:
                    try:os.remove(_pth)
                    except OSError:pass
        for k,(idx,cfg) in enumerate(tareas):
            if self._cancelar.is_set():
                _lim_tmp();return False
            def cb_t(seg,k=k,dur=dur):
                if cb:cb(k*dur+seg)
            suf=f"_a{idx}" if n>1 else ""
            self._ls(f"    → Pista #{idx}")
            res=self._uno(a,idx,cb_t,cfg,suffix=suf,remux=rmx)
            ok,path=res if isinstance(res,tuple) else (res,None)
            if not ok:
                _lim_tmp();return False
            if path:procesadas.append((idx,path))
        for k,(r2,idx2,cfg2) in enumerate(ext):
            if self._cancelar.is_set():
                _lim_tmp();return False
            def cb_x(seg,k=k+n,dur=dur):
                if cb:cb(k*dur+seg)
            self._ls(f"    → {os.path.basename(r2)} #{idx2} "+self._vt("(para el MKV)","(for the MKV)"))
            res=self._uno(r2,idx2,cb_x,cfg2,suffix=f"_x{k}",remux=True)
            ok,path=res if isinstance(res,tuple) else (res,None)
            if not ok:
                _lim_tmp();return False
            if path:ext_hechas.append((r2,idx2,path))
        # Remux si aplica
        if rmx and (procesadas or ext_hechas):
            base_=(n+len(ext))*dur   # (JMG, 13-11) montar el MKV cuenta dentro del avance de ESTE archivo (con varios, la barra no salta)
            if cb:cb(base_)
            else:self._set_prog(95)
            self._st(self._vt("Montando el MKV...","Building the MKV..."))
            return self._remux_multi(a,procesadas,d,b,tareas,vi,ext_hechas,cb_ext=(lambda t,base_=base_,dur=dur:cb(base_+0.1*max(0.0,min(t,dur)))) if (cb and dur>0) else None)
        return True


    def _remux_multi(self,a,procesadas,d,b,tareas=None,vi=None,ext_hechas=(),cb_ext=None):
        b = self._clean_base(a)
        import json as _json
        pistas_info=self.pc.get(a,[])
        if not pistas_info:
            self._ls("    [MUX] No hay info de pistas")
            return False

        self._ls("    [MUX] Iniciando compilación del MKV...")
        L = getattr(self,"_lsnap",None) or {}   # copia de los ajustes hecha al pulsar PROCESAR

        ext_sub = L.get("ext_subs",self.ext_subs).get(a)
        ext_cover = L.get("ext_cover",self.ext_cover).get(a)

        # Streams del original: portada (attached_pic) y adjuntos (fuentes de subtitulos...)
        portada_tmp=None;n_adj=0;vinfo={}
        try:
            rp=rh([FFPROBE,"-v","error","-show_entries",
                   "stream=index,codec_type,codec_name:stream_disposition=attached_pic",
                   "-of","json",a],timeout=15)
            vinfo=_json.loads(rp.stdout or "{}")
            n_adj=sum(1 for s_ in vinfo.get("streams",[]) if s_.get("codec_type")=="attachment")
        except Exception as e:
            self._ls(f"    [MUX] ffprobe: {e}")
        if not ext_cover:
            try:
                for vs in vinfo.get("streams",[]):
                    if vs.get("codec_type")=="video" and vs.get("disposition",{}).get("attached_pic",0)==1:
                        codec=vs.get("codec_name","mjpeg")
                        ext="jpg" if "mjpeg" in codec or "jpeg" in codec else "png"
                        portada_tmp=os.path.join(d,f"_portada_{b}.{ext}")
                        rx=rh([FFMPEG,"-hide_banner","-y","-i",a,"-map",f"0:{vs.get('index')}",
                               "-c","copy",portada_tmp],timeout=30)
                        if rx.returncode!=0 or not os.path.exists(portada_tmp):
                            portada_tmp=None
                        else:
                            self._ls("    [MUX] Portada original extraida")
            except Exception as e:
                self._ls(f"    [MUX] Error portada: {e}")

        if not ext_cover and not portada_tmp:   # (JMG, 16-11) sin portada: la que haya junto al archivo (cover.jpg, folder.jpg...)
            ext_cover=_portada_junto(a)
            if ext_cover:self._ls(f"    [MUX] Portada junto al archivo: {os.path.basename(ext_cover)}")

        # Nombre de salida
        tiene_upmix = any(c.get("upmix")=="S" for idx, c in (tareas or []))
        sufijo = " (upmix)" if tiene_upmix else " (Jmg AudioProcesador)"   # (JMG, 9-11)
        nombre = f"{b}{sufijo}.mkv"
        salida = os.path.join(d, nombre)

        if os.path.exists(salida):
            if self._opt("dup_modo")=="rename":
                i=1
                while True:
                    prueba=os.path.join(d,f"{b}{sufijo}_{i}.mkv")
                    if not os.path.exists(prueba):break
                    i+=1
                salida=prueba
            else:
                try:os.remove(salida)
                except OSError:pass

        # Comando
        cmd=[FFMPEG,"-hide_banner","-y","-i",a]
        input_map={}
        n_inputs=1

        # Cargar subtitulo externo si lo hay
        sub_input_idx = None
        if ext_sub and self._opt("remux_subs"):
            cmd+=["-i", ext_sub]
            sub_input_idx = n_inputs
            n_inputs += 1
            self._ls(f"    [MUX] Cargando subtitulo externo: {os.path.basename(ext_sub)}")

        # Ordenar procesadas según el orden de la lista al pulsar PROCESAR (copia: no cambia si se toca la lista)
        orden_lista = L.get("orden", self._multi_tracks)
        procesadas_ord = []
        for track in orden_lista:
            for idx, path in procesadas:
                if track == (a, idx):
                    procesadas_ord.append((idx, path))
        for idx, path in procesadas:   # seguridad: ninguna pista procesada se queda fuera del MKV
            if (idx, path) not in procesadas_ord:
                procesadas_ord.append((idx, path))

        # Cargar los archivos procesados como nuevas entradas (-i)
        for idx, path in procesadas_ord:
            if path.endswith("_passthrough.mka"):
                # copia sin convertir: el temporal empieza en 0, se le devuelve su inicio respecto al video
                _o=self._ini_ms(a,idx)/1000.0
                if abs(_o)>=0.001:cmd+=["-itsoffset","%.3f"%_o]
            cmd+=["-i",path]
            input_map[idx]=n_inputs
            n_inputs+=1

        # Pistas de archivos sin video (la combinada, por ejemplo)
        ext_map=[]
        for r2,idx2,path in ext_hechas:
            cmd+=["-i",path]
            ext_map.append(n_inputs)
            n_inputs+=1

        # 1) Video principal (el primer video real, nunca la portada)
        cmd+=["-map","0:%d"%vi if vi is not None else "0:v:0"]

        # 2) Audios PROCESADOS primero (en el nuevo orden): los que vienen de fuera del MKV, delante de todo
        for ii in ext_map:
            cmd+=["-map",f"{ii}:a:0"]
        for idx, path in procesadas_ord:
            ii=input_map[idx]
            cmd+=["-map",f"{ii}:a:0"]

        # 3) Audios ORIGINALES despues (quitando los marcados)
        excluir = L.get("excluir", self.excluir_pistas).get(a, set())
        borrar = L.get("borrar", self.borrar_pistas).get(a, set())
        originales_ord = []
        for track in orden_lista:
            if track[0] == a:
                idx = track[1]
                if idx not in excluir and idx not in borrar:
                    originales_ord.append(idx)
        for p in pistas_info:
            if p["orden"] not in originales_ord and p["orden"] not in excluir and p["orden"] not in borrar:
                originales_ord.append(p["orden"])
        # una pista copiada tal cual (Passthrough) ya esta dentro: el original seria la misma pista dos veces
        copiadas={idx for idx,path in procesadas_ord if path.endswith("_passthrough.mka")}
        originales_ord=[o for o in dict.fromkeys(originales_ord) if o not in copiadas]
        for orden in originales_ord:
            cmd+=["-map",f"0:a:{orden}"]
        nucleos=[o for o in originales_ord if self._opt("remux_nucleo") and "DTS-HD" in str((next((x for x in pistas_info if x["orden"]==o),None) or {}).get("perfil",""))]   # (JMG, 15-11)
        for orden in nucleos:cmd+=["-map",f"0:a:{orden}"]   # el núcleo DTS de las DTS-HD, aparte (sin recomprimir)

        # 4) Subtitulos originales
        if self._opt("remux_subs"):
            cmd+=["-map","0:s?"]

        # 5) Subtitulo externo
        if sub_input_idx is not None:
            cmd+=["-map", f"{sub_input_idx}:s:0"]

        # 5b) Adjuntos del original (fuentes de los subtitulos ASS, etc.): con «Adjuntos» o con «Subtitulos»
        n_adj_map = n_adj if (n_adj and (self._opt("remux_adj") or self._opt("remux_subs"))) else 0
        if n_adj_map:
            cmd+=["-map","0:t?"]

        # Metadatos globales y capitulos: solo si estan marcados (los idiomas/titulos de cada pista se conservan)
        cmd+=["-map_metadata","0"] if self._opt("remux_meta") else ["-map_metadata:g","-1"]
        cmd+=["-map_chapters","0" if self._opt("remux_caps") else "-1"]
        cmd+=["-c","copy","-max_interleave_delta","0"]

        # 6) Metadata audios
        k=0
        def _tit(c):   # el nombre por defecto solo si nadie lo ha tocado: borrado de la casilla, la pista sale sin nombre
            v=L.get("ptitulo",self.ptitulo).get(c)
            return "Jmg AudioProcesador 5.1" if v is None else v
        for r2,idx2,path in ext_hechas:
            ps2=self.pc.get(r2) or [];p2=ps2[idx2] if idx2<len(ps2) else {}
            idioma=p2.get("lang") or "und"
            if idioma=="und":idioma=getattr(self,"_comb_lang",{}).get(r2,"und")
            cmd+=["-metadata:s:a:%d"%k,"language="+idioma]
            cmd+=["-metadata:s:a:%d"%k,"title="+_tit((r2,idx2))]
            k+=1
        for idx,path in procesadas_ord:
            p=next((x for x in pistas_info if x["orden"]==idx),None)
            idioma=(p.get("lang") if p else None) or "und"
            cmd+=["-metadata:s:a:%d"%k,"language="+idioma,"-metadata:s:a:%d"%k,"title="+_tit((a,idx))]
            k+=1
        for orden in originales_ord:
            p=next((x for x in pistas_info if x["orden"]==orden),None)
            idioma=(p.get("lang") if p else None) or "und"
            tit=(p.get("title") if p else None) or ""
            cmd+=["-metadata:s:a:%d"%k,"language="+idioma]
            if tit:cmd+=["-metadata:s:a:%d"%k,"title="+tit]
            k+=1
        for orden in nucleos:   # (JMG, 15-11) el núcleo: el idioma de su pista y «DTS (núcleo)» en el título
            p=next((x for x in pistas_info if x["orden"]==orden),None)
            idioma=(p.get("lang") if p else None) or "und";tit=(p.get("title") if p else None) or ""
            cmd+=["-bsf:a:%d"%k,"dca_core","-metadata:s:a:%d"%k,"language="+idioma,"-metadata:s:a:%d"%k,"title="+(tit+" · " if tit else "")+self._vt("DTS (núcleo)","DTS (core)")]
            k+=1

        # 7) Disposition
        cmd+=["-disposition:v:0","default"]
        cmd+=["-disposition:a:0","default"]
        for kk in range(1,len(ext_hechas)+len(procesadas_ord)+len(originales_ord)+len(nucleos)):
            cmd+=["-disposition:a:%d"%kk,"0"]

        # 8) Portada (externa o extraida)
        cover_to_attach = ext_cover if ext_cover else portada_tmp
        if cover_to_attach and self._opt("remux_adj") and os.path.exists(cover_to_attach):
            cmd+=["-attach",cover_to_attach]
            ext=os.path.splitext(cover_to_attach)[1].lower().lstrip(".")
            mime="image/jpeg" if ext in ("jpg","jpeg") else "image/png"
            st_=f"-metadata:s:t:{n_adj_map}"   # la portada va DETRAS de los adjuntos copiados del original
            cmd+=[st_,"mimetype="+mime]
            cmd+=[st_,"filename=cover."+ext]
            if ext_cover: self._ls("    [MUX] Usando portada externa.")

        # 9) Salida
        cmd+=["-progress","pipe:1","-nostats",salida]
        self._ls(f"    [MUX] {os.path.basename(salida)}")

        try:dur=self._dur(a)   # una sola vez (antes se lanzaba ffprobe en cada aviso de progreso)
        except Exception:dur=0
        def cb_mux(t):
            if cb_ext:   # (JMG, 13-11) dentro del avance de su archivo
                try:cb_ext(t)
                except Exception:pass
            elif dur>0:
                pct=95+(t/dur)*4
                try:self._set_prog(min(99,pct))
                except Exception:pass
        ok=self._ffm(cmd,cb_mux)

        if ok and os.path.exists(salida):
            self._ls(f"    [MUX] OK - archivo creado ({os.path.getsize(salida)//1024} KB)")

        for path in [x[1] for x in procesadas]+[x[2] for x in ext_hechas]:
            try:
                if os.path.exists(path):os.remove(path)
            except OSError:pass
        if portada_tmp:
            try:
                if os.path.exists(portada_tmp):os.remove(portada_tmp)
            except OSError:pass
        try:cb_ext(dur) if cb_ext else self._set_prog(100)
        except Exception:pass
        return ok
    def _pass(self,a,s,p,cb=None,tmp=False):
        """Copia la pista p sin convertir. s = ruta de salida (.mka)"""
        if os.path.exists(s):
            if not tmp and self._opt("dup_modo")=="rename":
                r,e=os.path.splitext(s);i=1
                while os.path.exists(f"{r}_{i}{e}"):i+=1
                s=f"{r}_{i}{e}"
                self._ls(f"    [!] Existe. Renombrado a {os.path.basename(s)}")
            else:
                try:os.remove(s)
                except OSError as e:self._ls(f"    [WARN] {e}")
        cmd=[FFMPEG,"-hide_banner","-y","-i",a,"-map",f"0:a:{p}","-c:a","copy","-progress","pipe:1","-nostats",s]
        self._ls(f"    → {os.path.basename(s)} (passthrough"+(", para el MKV)" if tmp else ")"))
        return self._ffm(cmd,cb)

    @staticmethod
    def _matar(pr):
        """mata el proceso y lo que haya lanzado (en Windows, el ffmpeg de un .bat no muere con el cmd)"""
        try:
            if sys.platform=="win32":subprocess.run(["taskkill","/F","/T","/PID",str(pr.pid)],creationflags=CNW,capture_output=True,timeout=15)
            else:pr.kill()
        except Exception:
            try:pr.kill()
            except Exception:pass
    def _ffm_bat(self,cmd,cb=None):
        """Ejecuta ffmpeg via .bat UTF-8 (para nombres/titulos con acentos en Windows)"""
        import tempfile
        bat=None;errf=None
        try:
            fd,bat=tempfile.mkstemp(suffix=".bat",prefix="ffbat_")
            os.close(fd)
            fd,errf=tempfile.mkstemp(suffix=".err",prefix="fferr_")
            os.close(fd)
            with open(bat,"w",encoding="utf-8",newline="\r\n") as f:
                f.write("@echo off\n")
                f.write("chcp 65001 > nul\n")
                partes=[]
                for a in cmd:
                    s=str(a).replace("%","%%")
                    if any(c in s for c in ' \t"&|<>^()'):
                        s='"'+s.replace('"','\\"')+'"'
                    partes.append(s)
                f.write(" ".join(partes)+' 2> "'+errf+'"\n')
            self._ls("    [UTF-8 via bat]")
            kw={"stdout":subprocess.PIPE,"stderr":subprocess.PIPE,"text":True,"encoding":"utf-8","errors":"ignore","bufsize":1}
            if sys.platform=="win32":kw["creationflags"]=CNW
            pr=subprocess.Popen([bat],**kw)
            with self._lock:self._procesos.append(pr)

            def ro():
                try:
                    for l in pr.stdout:
                        l=l.strip()
                        if l.startswith("out_time_ms=") or l.startswith("out_time_us="):
                            try:
                                us=int(l.split("=",1)[1])
                                if cb:cb(us/1_000_000.0)
                            except (ValueError,IndexError):pass
                        elif l=="progress=end":break
                except Exception:pass
            t_out=threading.Thread(target=ro,daemon=True);t_out.start()

            if cb:
                try:cb(0)
                except Exception:pass
            while pr.poll() is None:
                if self._cancelar.is_set():
                    self._matar(pr)
                    break
                time.sleep(0.15)
            try:pr.wait(timeout=5)
            except Exception:self._matar(pr)
            t_out.join(timeout=2)
            with self._lock:
                if pr in self._procesos:self._procesos.remove(pr)
            if self._cancelar.is_set():
                o=str(cmd[-1])
                for _ in range(10):   # Windows: esperar a que se libere el archivo
                    try:
                        time.sleep(0.3)
                        if o not in ("-","NUL","/dev/null") and os.path.isfile(o):
                            os.remove(o);self._ls(f"    [X] Borrado incompleto: {os.path.basename(o)}")
                        break
                    except OSError:continue
                self._ls("    [X] Cancelado");return False
            if cb:
                try:cb(1)
                except Exception:pass
            if pr.returncode!=0:
                self._ls(f"    [ERR] ffmpeg {pr.returncode}")
                try:
                    with open(errf,encoding="utf-8",errors="ignore") as f:
                        for l in f:
                            l=l.rstrip()
                            if l:self._ls("      "+l)
                except Exception:pass
                return False
            self._ls("    [OK]")
            return True
        except Exception as e:
            self._ls(f"    [ERR] bat: {e}")
            return False
        finally:
            for tmp in (bat,errf):
                if tmp:
                    try:os.remove(tmp)
                    except Exception:pass

    def _fc_arg(self,fc):
        """con muchos tramos el filtro no cabe en la linea de ordenes (ni en un .bat): va en un archivo"""
        if len(fc)<=6000:return ["-filter_complex",fc]
        import tempfile
        h_,p=tempfile.mkstemp(prefix="jmg_comb_",suffix=".txt")
        with os.fdopen(h_,"w",encoding="utf-8") as fh:fh.write(fc)
        if not hasattr(self,"_tmp_arch"):self._tmp_arch=[]
        self._tmp_arch.append(p);return ["-/filter_complex",p]
    def _ffm(self,cmd,cb=None):
        # Si hay caracteres no-ASCII en Windows, usar .bat UTF-8
        if sys.platform=="win32":
            hay_nonascii=False
            for c in cmd:
                try:str(c).encode("ascii")
                except UnicodeEncodeError:hay_nonascii=True;break
            if hay_nonascii:
                return self._ffm_bat(cmd,cb)
        try:self._ls("    CMD: "+" ".join(str(c) for c in cmd))
        except Exception:pass
        kw={"stdout":subprocess.PIPE,"stderr":subprocess.PIPE,"text":True,"encoding":"utf-8","errors":"ignore","bufsize":1}
        if sys.platform=="win32":kw["creationflags"]=CNW
        try:pr=subprocess.Popen(cmd,**kw)
        except FileNotFoundError:self._ls("    [ERR] ffmpeg");return False
        except Exception as e:self._ls(f"    [ERR] {e}");return False
        with self._lock:self._procesos.append(pr)
        sl=[]
        def dr():
            try:
                for l in pr.stderr:sl.append(l)
            except Exception:pass
        def ro():
            try:
                for l in pr.stdout:
                    l=l.strip()
                    if l.startswith("out_time_ms=") or l.startswith("out_time_us="):
                        try:
                            us=int(l.split("=",1)[1])
                            if cb:cb(us/1_000_000.0)
                        except (ValueError,IndexError):pass
                    elif l=="progress=end":break
            except Exception:pass
        t_err=threading.Thread(target=dr,daemon=True);t_err.start()
        t_out=threading.Thread(target=ro,daemon=True);t_out.start()
        while pr.poll() is None:
            if self._cancelar.is_set():
                self._matar(pr)
                break
            time.sleep(0.15)
        try:pr.wait(timeout=5)
        except Exception:
            self._matar(pr)
            try:pr.wait(timeout=2)
            except Exception:pass
        t_out.join(timeout=2);t_err.join(timeout=2)
        try:pr.stdout.close()
        except Exception:pass
        try:pr.stderr.close()
        except Exception:pass
        with self._lock:
            if pr in self._procesos:self._procesos.remove(pr)
        if self._cancelar.is_set():
            # el archivo que se estaba escribiendo queda a medias: se borra (Windows puede tardar en soltarlo)
            o=str(cmd[-1])
            for _i in range(10):
                try:
                    if o not in ("-","NUL","/dev/null") and os.path.isfile(o):
                        os.remove(o);self._ls(f"    [X] Borrado incompleto: {os.path.basename(o)}")
                    break
                except OSError:time.sleep(0.3)
            self._ls("    [X] Cancelado");return False
        se="".join(sl)
        if pr.returncode!=0:
            self._ls(f"    [ERR] ffmpeg {pr.returncode}")
            self._ls("    [DIAGNOSTICO FFMPEG] Se muestran los ultimos errores. Revisa los filtros.")
            for l in (se or "").strip().splitlines()[-15:]:self._ls("      "+l)
            return False
        self._ls("    [OK]");return True
    def _split(self,a,d,b,p,cb=None,cfg=None):
        br=(cfg or {}).get("bitrate") or self.var_bitrate.get()
        if "float" in br and "32" in br:codec="pcm_f32le"
        elif "24" in br:codec="pcm_s24le"
        else:codec="pcm_s16le"
        tw=os.path.join(d,f"_tmp_{b}_split.wav")
        _ce=self._cfe(a,p,cfg);_ce["_ini_ms"]=self._ini_ms(a,p)
        fc=self._cf(p,_ce,None)
        _lay=self._cfg_lay(cfg)
        _cs20=["FL","FR"] if _lay=="2.0" else (["FC"] if _lay=="1.0" else None)
        if _lay not in LAY_ACT:_lay='5.1'
        cs=list(_cs20 or LAY_ACT[_lay])
        # «Renombrar»: si ya existe algun canal con ese nombre, se busca un nombre libre para TODOS (_1, _2...)
        if self._opt("dup_modo")=="rename" and any(os.path.exists(os.path.join(d,f"{b}_{c}.wav")) for c in cs):
            i=1
            while any(os.path.exists(os.path.join(d,f"{b}_{i}_{c}.wav")) for c in cs):i+=1
            b=f"{b}_{i}";self._ls(f"    [!] Existe. Renombrado a {b}_*.wav")
        # -rf64 auto: el WAV intermedio de una pelicula larga puede pasar de 4 GB
        cmd1=[FFMPEG,"-hide_banner","-y","-i",a]+self._fc_arg(fc)+["-map","[outfinal]","-c:a",codec,"-rf64","auto","-progress","pipe:1","-nostats",tw]
        self._ls("    Step 1/2...")
        if not self._ffm(cmd1,cb):
            if os.path.exists(tw):
                try:os.remove(tw)
                except OSError:pass
            return False
        if _cs20:
            cmd2=[FFMPEG,"-hide_banner","-y","-i",tw,"-filter_complex","asplit=%d%s;"%(len(cs),"".join("[s%d]"%i for i in range(len(cs))))+";".join("[s%d]pan=mono|c0=c%d[%s]"%(i,i,c) for i,c in enumerate(cs))]
        elif _lay=="5.1":
            cmd2=[FFMPEG,"-hide_banner","-y","-i",tw,"-filter_complex","channelsplit=channel_layout=5.1[FL][FR][FC][LFE][BL][BR]"]
        else:
            cmd2=[FFMPEG,"-hide_banner","-y","-i",tw,"-filter_complex","asplit=%d%s;"%(len(cs),"".join("[s%d]"%i for i in range(len(cs))))+";".join("[s%d]pan=mono|c0=c%d[%s]"%(i,i,c) for i,c in enumerate(cs))]
        for c in cs:cmd2+=["-map",f"[{c}]","-c:a",codec,os.path.join(d,f"{b}_{c}.wav")]
        self._ls("    Step 2/2...")
        try:
            self._run_c(cmd2);rc=self._run_rc
        except RuntimeError:
            rc=None
        try:os.remove(tw)
        except OSError:pass
        if rc is None:   # cancelado: fuera los canales a medias
            for c in cs:
                try:os.remove(os.path.join(d,f"{b}_{c}.wav"))
                except OSError:pass
            self._ls("    [X] Cancelado");return False
        if rc!=0:self._ls(f"    [ERR] step 2 {rc}");return False
        self._ls(f"    [OK] → {b}_{cs[0]}.wav ... {b}_{cs[-1]}.wav");return True
    def _set_prog(self,v):self._ui(lambda v=v:self.prog.configure(value=v))   # seguro desde el hilo de trabajo
    def _prog_vaciar(self,ms=1200):
        """al terminar, la barra se ve llena un momento y luego se vacia (el texto de estado se queda)"""
        def v():
            if not self._ocupado():
                try:self.prog.configure(value=0)
                except Exception:pass
        try:self.root.after(ms,v)
        except Exception:pass
    def _st(self,m):self._ui(self.var_progreso_texto.set,m)
    def _ls(self,m):self._ui(self._log,m)
    def _fin_vals(self):
        return [T("al_nada"),T("al_salir"),T("al_apagar"),T("al_suspender")]

    def _fin_label(self,v):
