                if not s:continue
                k=(s[0],s[1])
                if k not in self._tiempos:self._tiempos[k]=self._medir_tiempo(*k)
                ini,du=self._tiempos[k]
                if du is None:du=max(0.0,self._dur(s[0])-ini)
