                    con_tl=bool(tl and (len(tl)>1 or abs(tl[0][2])>=0.5 or abs(tl[0][3])>=0.5))
                    # el tono va DESPUES de unir los tramos (es igual en todo momento): delante del reparto en tramos, este FFmpeg
                    # daba «Invalid data found when processing input» al pasar al segundo tramo
                    if tono and tono.get(n) and not con_tl:cad+=","+self._tono_filtro(tono[n])
                    if ms>=1:cad+=f",adelay=delays={int(round(ms))}:all=1"
                    elif ms<=-1:cad+=f",atrim=start={abs(ms)/1000.0:.3f},asetpts=PTS-STARTPTS"
                    if con_tl:
                        # por tramos: el trozo [c0, c1] de la salida sale de la pista en [c0 + v0, c1 + v1] (v = ms que llegaba tarde):
                        # si v0 != v1 va un poco mas rapido o mas lento (asetrate entero + aresample: cambio de tono inapreciable).
                        # Largo exacto a la muestra, y un fundido de 3 ms en cada corte (van en silencios) para que no haga clic.
