    def _rev_lanzar(self,c,tit):
        """FFmpeg prepara la imagen y el sonido -> ffplay los enseña en su ventana"""
        V=self._vt;self._rev_parar()
        ff=[FFPLAY,"-hide_banner","-loglevel","error","-autoexit","-window_title",tit,"-x","1280","-y","720","-i","-"]
        try:
            p1=subprocess.Popen(c,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,creationflags=CNW)
            p2=subprocess.Popen(ff,stdin=p1.stdout,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,creationflags=CNW)
            p1.stdout.close();self._rev_proc=(p1,p2)
            self._log("[REVISAR] "+subprocess.list2cmdline(c))
        except FileNotFoundError:
            self._toast(T("warn_tit"),V("No se encuentra ffplay (tiene que estar en la carpeta «bin», junto a ffmpeg).","ffplay not found (it must be in the «bin» folder, next to ffmpeg)."),tipo="warning",seg=6)
        except Exception as e:self._toast(T("error_tit"),str(e),tipo="error")
    def _rev_parar(self):
        for p in getattr(self,"_rev_proc",()) or ():
            try:
                if p.poll() is None:p.kill()
            except Exception:pass
        self._rev_proc=()
    _REV_VID=["-vf","scale=w=min(1280\\,iw):h=-2,format=yuv420p","-sn","-dn","-c:v","libx264","-preset","ultrafast","-tune","zerolatency","-crf","20","-c:a","pcm_s16le","-f","matroska","-"]
    def _rev_info(self,ruta):
        """(indice del video o None, su inicio, inicio del archivo, duracion) de un archivo: para alinear la imagen y la pista"""
        try:
            p=rh([FFPROBE,"-v","error","-show_entries","stream=index,codec_type,start_time:stream_disposition=attached_pic:format=duration,start_time,format_name","-of","json",ruta],timeout=20)
            d=json.loads(p.stdout or "{}");fm=d.get("format") or {}
            num=lambda v,o=0.0:(float(v) if v not in (None,"","N/A") else o)
            f0=num(fm.get("start_time"))
            for s in d.get("streams",[]):
                if s.get("codec_type")=="video" and not (s.get("disposition") or {}).get("attached_pic"):
                    return s.get("index"),num(s.get("start_time"),f0),f0,num(fm.get("duration"))
            return None,(f0 if "mpegts" in str(fm.get("format_name","")) else 0.0),f0,num(fm.get("duration"))
        except Exception:return None,0.0,0.0,0.0
    def _rev_cmd(self,vid,aud,ai,pos,dl=0.0,tl=None,ff="25",ft="25",met="tono",sal="mc"):
        """orden de FFmpeg: la imagen de vid desde pos y la pista ai de aud como saldra: framerate, delay inicial y tramos.
        vid / aud = (ruta, _rev_info). Se busca en la pista el segundo que tiene que sonar en pos (sin procesar la pelicula entera).
        Con tramos, la misma correccion que al procesar (_tramos_cad), desde M s antes (que se recortan): al pasar un corte
        cambia el delay igual que en la pista procesada"""
        from fractions import Fraction
        fa=_fps_exacto(ff);fb=_fps_exacto(ft);fac=Fraction(fb)/Fraction(fa) if fa!=fb else Fraction(1)
        M=min(5.0,pos) if tl else 0.0;A=pos-M
        t_=A-dl/1000.0   # segundo de la pista ya convertida que suena en A (antes de los tramos)
        af=[]
        if fac!=1:   # el mismo cambio de framerate que al procesar
            if met=="tono":
                a_=48000*fac;b_=48000/fac
                if a_.denominator==1:af.append(f"aresample=48000,asetrate={a_.numerator},aresample=48000")
                elif b_.denominator==1:af.append(f"aresample={b_.numerator},asetrate=48000")
                else:af.append(f"aresample=48000,asetrate={int(round(float(a_)))},aresample=48000")
            else:af.append(f"atempo={float(fac):.12f}")
        if t_<0:af.append(f"adelay=delays={int(round(-t_*1000))}:all=1");t_=0.0   # empieza antes que la pista: silencio delante
        (rv,(vi,vs,vf0,vd)),(ra,(_,ars,af0,_))=vid,aud
        pv=max(0.0,pos+vs-vf0);pa=max(0.0,t_*float(fac)+ars-af0)
        c=[FFMPEG,"-hide_banner","-v","error","-ss",f"{pv:.3f}","-i",rv,"-ss",f"{pa:.3f}","-i",ra,"-map",f"0:{vi}"]
        if tl:
            tot=max(1.0,(vd or tl[-1][1])-A)
            t2=[(c0-A,c1-A,v0,v1) for c0,c1,v0,v1 in tl if c1-A>0]
            if not t2:t2=[(0.0,tot,tl[-1][3],tl[-1][3])]
            t2[0]=(max(0.0,t2[0][0]),)+tuple(t2[0][1:]);t2=[q for q in t2 if q[0]<tot] or t2[:1]
            P,s_=self._tramos_cad("r",f"[1:a:{ai}]"+",".join(af+["aresample=48000"]),t2,tot)
            c+=["-filter_complex",";".join(P)+";"+s_+f",atrim=start={M:.3f},asetpts=PTS-STARTPTS[ra]","-map","[ra]"]
        else:
            c+=["-map",f"1:a:{ai}"]+(["-af",",".join(af)] if af else [])
        if sal=="st":c+=["-ac","2"]
        return c+self._REV_VID
    def _sinc_revisar(self):
        """«▶ Revisar sincronización»: la película con la pista activa, como saldrá, para verlo con los ojos"""
        V=self._vt
        if not self.pactual:
            self._toast(T("warn_tit"),V("Selecciona al menos una pista primero","Select at least one track first"),tipo="warning");return
        self._guardar_conf_pista();k=self.pactual
        self._sinc_lista();ref=self._sinc_map.get(self.var_sinc_ref.get());ref_txt=self.var_sinc_ref.get() if ref else ""
        vid=None
        for r in [k[0]]+([ref[0]] if ref else [])+[x for x in self.files if x not in (k[0],ref and ref[0])]:
            inf=self._rev_info(r)
            if inf[0] is not None:vid=(r,inf);break
        if not vid:
            self._toast(T("warn_tit"),V("Para revisar la sincronización hace falta la imagen: añade a la lista la película (el archivo con el vídeo).",
                                        "To check the synchronization the picture is needed: add the movie (the file with the video) to the list."),tipo="warning",seg=7);return
        def conf():
            if self.pactual==k:
                c={"delay_init":self._raw(self.var_delay_init),"fps_from":self.var_fps_from.get(),"fps_to":self.var_fps_to.get(),"fps_metodo":self.var_fps_metodo.get()}
            else:c=self.pconf.get(k) or {}
            t_=self.ptramos.get(k);dl=float(c.get("delay_init",0) or 0)
            tl=t_["tl"] if t_ and abs(dl-t_["d"])<0.5 and str(c.get("fps_from"))==str(c.get("fps_to")) else []
            return c,dl,tl
        c,dl,tl=conf()
        def jugar(pos,modo,sal):
            self._rev_sal=sal
            if modo=="ref" and ref:
                cmd=self._rev_cmd(vid,(ref[0],self._rev_info(ref[0])),ref[1],pos,sal=sal);q=ref
            else:
                c,dl,tl=conf();q=k
                if modo=="corr":cmd=self._rev_cmd(vid,(k[0],self._rev_info(k[0])),k[1],pos,dl,tl,c.get("fps_from","25"),c.get("fps_to","25"),c.get("fps_metodo","tono"),sal)
                else:cmd=self._rev_cmd(vid,(k[0],self._rev_info(k[0])),k[1],pos,sal=sal)
            tit=("Jmg AudioProcesador · "+{"corr":V("corregida","corrected"),"sin":V("sin corregir","uncorrected"),"ref":V("referencia","reference")}[modo]+
                 f" · {os.path.basename(q[0])} #{q[1]}")
            self._rev_lanzar(cmd,tit)
        sal0=getattr(self,"_rev_sal",None) or ("mc" if getattr(getattr(self,"var_vis_sal",None),"get",lambda:"mc")()=="mc" else "st")
        self._rev_ventana(f"{os.path.basename(k[0])} #{k[1]}",vid[1][3],tl,dl,ref_txt,jugar,self._rev_parar,sal0)
    def _escanear_vol(self):
        if self.procesando or getattr(self,"_escaneando",False) or getattr(self,"_midiendo_ln",False):return
        sel = self.lp.curselection()
        if not sel:
            self._toast(T("warn_tit"),self._vt("Selecciona al menos una pista primero","Select at least one track first"),tipo="warning")
            return

        pistas_a_escanear = []
        for i in sel:
            if i < len(self._multi_tracks):
                pistas_a_escanear.append(self._multi_tracks[i])

        if not pistas_a_escanear: return

        self._cancelar.clear()
        self._escaneando = True
        self.btn_scan.configure(state="disabled",text=T("escaneando"))
        self.btn_cancel_scan.configure(state="normal")
        self.btn_c.configure(state="normal")
        self._ls(f"[SCAN] Iniciando escaneo rápido de {len(pistas_a_escanear)} pista(s)...")

        self._set_prog(0)
        self._st(self._vt("Escaneando volumen: 0%","Scanning loudness: 0%"))
        t=_lnt(self.var_loudnorm_target.get())

        def tarea():
            try:
                resultados = []
                for k, (ruta, idx) in enumerate(pistas_a_escanear):
                    if self._cancelar.is_set(): break

                    self._ls(f"[SCAN] Analizando pista #{idx} de {os.path.basename(ruta)}")
                    dur = self._dur(ruta)
                    # con los demas ajustes de la pista (volumen por canal, Presencia, EQ, Suavizado...): lo que llega al Master, sin el Master ni las normalizaciones
                    cfg_=dict(self.pconf.get((ruta,idx)) or {})
                    if cfg_:
                        def cb_(sec,k=k,dur=dur):
                            if dur>0:
                                tp_=(k+min(0.99,sec/dur))/len(pistas_a_escanear)*100.0
                                self._ui(self._set_prog,tp_);self._ui(self._st,self._vt(f"Escaneando volumen: {tp_:.0f}%",f"Scanning loudness: {tp_:.0f}%"))
                        lm_=self._ln(ruta,idx,cfg_.get("loudnorm_target"),cb=cb_,cfg=cfg_)
                        if self._cancelar.is_set():break
                        try:
                            resultados.append((ruta,idx,float(lm_["input_i"]),float(lm_["input_tp"])))
                            self._ls(f"[SCAN] Pista #{idx} medida con sus ajustes: {float(lm_['input_i']):.1f} LUFS / {float(lm_['input_tp']):.1f} dBTP");continue
                        except (KeyError,TypeError,ValueError):pass   # si no se puede, como antes: la pista tal cual

                    # Volvemos a ebur128 (rápido) pero con aresample=192000 para True Peak real
                    filtro="aformat=channel_layouts=5.1|stereo,ebur128=framelog=quiet:peak=true"
                    nul="NUL" if sys.platform=="win32" else "/dev/null"
                    cmd=[FFMPEG,"-hide_banner","-threads","0","-i",ruta,"-map",f"0:a:{idx}","-vn",
                         "-af",filtro,"-progress","pipe:1","-nostats","-f","null",nul]
                    kw={"stdout":subprocess.PIPE,"stderr":subprocess.PIPE,"text":True,"encoding":"utf-8","errors":"ignore","bufsize":1}
                    if sys.platform=="win32":kw["creationflags"]=CNW
                    pr=subprocess.Popen(cmd,**kw)

                    with self._lock: self._procesos.append(pr)

                    sl=[]
                    def dr():
                        try:
                            for line in pr.stderr:sl.append(line)
                        except Exception:pass
                    ts=threading.Thread(target=dr,daemon=True);ts.start()

                    for line in pr.stdout:
                        if self._cancelar.is_set():
                            try: pr.kill()
                            except Exception:pass
                            break
                        line=line.strip()
                        if line.startswith("out_time_ms="):
                            try:
                                us=int(line.split("=",1)[1])
                                sec=us/1_000_000.0
                                if dur > 0:
                                    pct=min(99.0,(sec/dur)*100.0)
                                    total_pct = (k + pct/100.0) / len(pistas_a_escanear) * 100.0
                                    self._ui( self._set_prog, total_pct)
                                    self._ui( self._st, self._vt(f"Escaneando volumen: {total_pct:.0f}%",f"Scanning loudness: {total_pct:.0f}%"))
                            except Exception:pass
                        elif line=="progress=end":break

                    pr.wait()
                    ts.join(timeout=2)
                    with self._lock:
                        if pr in self._procesos: self._procesos.remove(pr)

                    if self._cancelar.is_set(): break

                    txt="".join(sl)

                    # Buscamos el resumen final con un regex más flexible (acepta enteros, decimales y -inf)
                    m_i = re.findall(r"I:\s+(-?\d+(?:[.,]\d+)?|-inf)\s+LUFS", txt)
                    m_tp = re.findall(r"Peak:\s+(-?\d+(?:[.,]\d+)?|-inf)\s+dBFS", txt)

                    if m_i and m_tp:
                        try:
                            str_i = m_i[-1].replace(',', '.')
                            str_tp = m_tp[-1].replace(',', '.')
                            val_i = -99.0 if str_i == "-inf" else float(str_i)
                            val_tp = -99.0 if str_tp == "-inf" else float(str_tp)
                            resultados.append((ruta, idx, val_i, val_tp))
                            self._ls(f"[SCAN] Pista #{idx} medida: {val_i:.1f} LUFS / {val_tp:.1f} dBTP")
                        except Exception as e:
                            self._ls(f"[SCAN ERROR] Fallo al convertir valores: {e}")
                    else:
                        self._ls(f"[SCAN ERROR] No se pudo medir la pista #{idx}. Sin datos.")
                        self._ls(f"[SCAN DEBUG] FFmpeg dijo: {txt[-200:]}")

                self._ui( self._finalizar_escaneo, resultados, t)
            except Exception as e:
                self._ls(f"[SCAN EXCEPTION] {e}")
                self._ui( self._finalizar_escaneo, [], t)

        threading.Thread(target=tarea,daemon=True).start()

    def _finalizar_escaneo(self, resultados, target):
        self._escaneando = False
        self.btn_scan.configure(state="normal", text=T("escanear"))
        self.btn_cancel_scan.configure(state="disabled")
        self.btn_c.configure(state="disabled")
        self._set_prog(0)
        self._st("")

        if self._cancelar.is_set():
            self._ls("[SCAN] Escaneo cancelado por el usuario.")
            self._toast(T("cancelado_tit"), self._vt("Escaneo cancelado.","Scan cancelled."), tipo="info", seg=3)
            return

        if not resultados:
            self._scan_err(self._vt("No se pudo medir. Revisa el registro (pestaña Edit/Log).","Could not measure. Check the log (Edit/Log tab)."))
            return

        ac=True   # anticlipping automatico (siempre)
        gains = []
        for _, _, val_i, val_tp in resultados:
            gain_lufs = target['I'] - val_i
            # Anticlipping: 1.0 dB extra de margen de seguridad al True Peak
            gain_tp = (target['TP'] - 1.0) - val_tp
            gains.append(min(gain_lufs, gain_tp) if ac else gain_lufs)

        diff = min(gains)
        diff = max(0.0, min(20.0, diff))  # el escaneo nunca baja el volumen

        self._scan_ok(resultados, target, diff)

    def _scan_ok(self, resultados, target, diff_global):
        self.btn_scan.configure(state="normal",text=T("escanear"))
        msg = ""
        for ruta, idx, val_i, val_tp in resultados:
            gain_lufs = target['I'] - val_i
            gain_tp = (target['TP'] - 1.0) - val_tp
            ac=True   # anticlipping automatico (siempre)
            track_diff = min(gain_lufs, gain_tp) if ac else gain_lufs
            track_diff = max(0.0, min(20.0, track_diff))  # el escaneo nunca baja el volumen
            import math as _m
            track_diff = _m.floor(track_diff*10.0)/10.0

            if (ruta,idx) not in self.pconf:
                self.pconf[(ruta,idx)] = self._snap_pista()
            self.pconf[(ruta,idx)]['master'] = track_diff

            msg += self._vt(f"Pista #{idx} ({os.path.basename(ruta)}):\n",f"Track #{idx} ({os.path.basename(ruta)}):\n")
            msg += self._vt(f"  Actual: {val_i:.1f} LUFS | Ajuste: {track_diff:+.1f} dB\n",f"  Current: {val_i:.1f} LUFS | Adjustment: {track_diff:+.1f} dB\n")
            if track_diff<=0.0:
                if gain_lufs<=0:msg += self._vt("  (ya está al nivel del objetivo o por encima: el escaneo nunca baja el volumen)\n","  (already at or above the target: the scan never lowers the volume)\n")
                else:msg += self._vt("  (los picos ya están al límite: subir saturaría. Sin cambio)\n","  (peaks already at the limit: raising it would clip. No change)\n")

            if self.pactual == (ruta, idx):
                self.var_master.set(round(track_diff,1))

        msg += self._vt(f"\nObjetivo: {target['I']:.1f} LUFS | Anticlipping: pico max {target['TP']-1.0:.1f} dBTP\n",
                        f"\nTarget: {target['I']:.1f} LUFS | Anti-clipping: max peak {target['TP']-1.0:.1f} dBTP\n")
        msg += self._vt("El Master de la pantalla muestra el de la pista activa.","The Master on screen is the one of the active track.")
        self._log(f"[SCAN] {len(resultados)} pista(s) medida(s) y guardadas individualmente.")
        self._toast(T("escaneo_t"),msg,tipo="info",seg=8)

    # ---------- «Ajustar canales» y «Ajustar tono»: miden los canales y dejan el resultado en los deslizadores ----------
    _VOL_OBJ={"FL":-3.0,"FR":-3.0,"BL":-7.0,"BR":-7.0,"LFE":-6.0}   # dB respecto al central: una mezcla de cine
    # objetivos de los botones «Auto»: vol = dB respecto al central de frontales, traseros y subwoofer · voz, amb, efc = dB de Presencia ·
    # lra = rango dinamico deseado (LU) · gama, bm = topes de Gama dinamica y Bass Management · corte en Hz
    _AUTO_OBJ={"vol":(-3.0,-7.0,-6.0),"voz":2.0,"lra":17.0,"gama":4,"bm":3,"corte":120,"db":3,"db_corte":90}
    _AUTO_TXT="Auto"
    def _auto_pista(self,ruta,idx):
        """(pista de FFmpeg, {canal: indice}) de una pista de la lista"""
        p=(self.pc.get(ruta) or [])[idx]
        try:n=int(p.get("channels") or 0)
        except (TypeError,ValueError):n=0
        chs={}
        for i,nm in enumerate(self._vis_nom_ent(n,p.get("layout")) if n>0 else []):chs.setdefault(self._vis_can(nm),i)
        for a,b in (("BL","SL"),("BR","SR")):
            if a not in chs and b in chs:chs[a]=chs[b]
        return p.get("orden",idx),chs
    def _vol_canales(self,ruta,orden,cs,prog=None):
        """volumen (LUFS) de cada canal, cs=[(nombre, indice)]: {nombre: LUFS} o None"""
        r=self._vol_medida(ruta,orden,cs,prog)
        return r[0] if r else None
    def _vol_medida(self,ruta,orden,cs,prog=None):
        """volumen (LUFS) y rango dinamico (LU) de cada canal: 24 trozos de 15 s repartidos por todo el archivo. ({nombre: LUFS}, {nombre: LRA}) o None"""
        dur=self._dur(ruta)
        if dur<=1:return None
        n,L,pos=self._trozos(dur,24,15.0)
        cmd=[FFMPEG,"-hide_banner","-nostats"]
        for p in pos:cmd+=["-ss",f"{p:.3f}","-t",f"{L:.3f}","-i",ruta]
        g="".join(f"[{i}:a:{orden}]aresample=48000[s{i}];" for i in range(n))
        g+="".join(f"[s{i}]" for i in range(n))+f"concat=n={n}:v=0:a=1,asplit={len(cs)}"+"".join(f"[b{j}]" for j in range(len(cs)))
        for j,(c,ci) in enumerate(cs):
            g+=f";[b{j}]pan=mono|c0=c{ci},ebur128=framelog=quiet"+("[o]" if j==len(cs)-1 else ",anullsink")
        cmd+=["-filter_complex",g,"-map","[o]","-stats_period","0.2","-progress","pipe:1","-f","null","-"]
        txt=self._ffm_texto(cmd,(lambda t:prog(min(1.0,t/(n*L)))) if prog else None)
        val={};lra={}
        for m_ in re.finditer(r"\[Parsed_ebur128_(\d+)[^\]]*\]\s*Summary:\s*Integrated loudness:\s*I:\s*(-?\d+(?:[.,]\d+)?|-?inf|nan)[\s\S]*?LRA:\s*(\d+(?:[.,]\d+)?)",txt):
            try:v=float(m_.group(2).replace(",","."))
            except ValueError:v=-99.0
            val[int(m_.group(1))]=v if v==v else -99.0
            lra[int(m_.group(1))]=float(m_.group(3).replace(",","."))
        if len(val)!=len(cs):
            if not self._cancelar.is_set():self._ls(f"[CANALES] [ERR] {os.path.basename(ruta)} #{orden}: "+" | ".join(txt.strip().splitlines()[-3:]))
            return None
        return {cs[j][0]:val[k] for j,k in enumerate(sorted(val))},{cs[j][0]:lra[k] for j,k in enumerate(sorted(val))}
    def _vol_ajustes(self,med):
        """deslizadores de canal para el equilibrio: el central manda (no se toca) y los demas van a su sitio respecto a el.
        Un canal casi mudo se deja en 0. Maximo +-6 dB (subwoofer +-3), de 0,5 en 0,5"""
        fc=med.get("FC",-99.0)
        if fc<=-60:return None
        res={}
        for c,obj in self._VOL_OBJ.items():
            if c not in med:continue
            lim=3.0 if c=="LFE" else 6.0
            g=0.0 if med[c]<=-60 else max(-lim,min(lim,fc+obj-med[c]))
            res[c.lower()]=round(g*2)/2.0
        return res
    @staticmethod
    def _eff_inv(db,top_pos,top_neg,expo=1.4):
        """lo contrario de _eff: valor del deslizador (entero, -10..10) que da mas o menos esos dB"""
        if abs(db)<0.05:return 0
        t=top_pos if db>0 else top_neg
        return int((1 if db>0 else -1)*round(10.0*(min(abs(db),t)/t)**(1.0/expo)))
    def _tono_grupos(self,med):
        """med={grupo: [espectros de sus canales]}: dB de las 3 bandas (100, 1000 y 5000 Hz) de cada grupo para acercarlo a la media de todos.
        Suave a proposito (+-3 dB): la voz del central y los traseros no tienen por que sonar igual que los frontales"""
        F=len(self._TONO_F);S={};m=lambda a:sum(a)/len(a)
        for g,ls in med.items():
            ls=[q for q in ls if q]
            if ls:S[g]=[None if any(q[i] is None for q in ls) else m([q[i] for q in ls]) for i in range(F)]
        if len(S)<2:return {}
        ref=[None if any(v[i] is None for v in S.values()) else m([v[i] for v in S.values()]) for i in range(F)]
        res={}
        for g,v in S.items():
            c=self._tono_curva(v,ref)
            if c:res[g]=[max(-3.0,min(3.0,m(a))) for a in (c[1:3],c[4:7],c[7:9])]
        return res
    # lo que pone cada «Auto»: con la segunda pulsacion vuelve a como sale de fabrica
    _AUTO_PROPIAS={"pres":("voz","amb","efc","sub"),"eq3":("eq_bass","eq_mids","eq_treble"),
                   "tono":tuple(f"eq{g}_b{i}_{x}" for g in ("front","tras","cent") for i in (1,2,3) for x in ("g","f")),
                   "suav":("suav",),"limp":("limp",),"gama":("gdin_front","gdin_tras","gdin_cent"),"din":("din_modo","din_ft","din_fc","din_lfe"),
                   "bm":("bm","bm_corte"),"db":("db","db_corte"),"vol":("fl","fr","fc","lfe","bl","br"),"norm":("master_auto","dyn_norm","speech_norm")}
    @staticmethod
    def _igual_v(a,b):
        try:return abs(float(a)-float(b))<1e-6
        except (TypeError,ValueError):return str(a)==str(b)
    def _auto_toggle(self,ef,tareas):
        """segunda pulsacion de un «Auto» sin haber tocado nada desde la primera: quita lo que puso (vuelve a 0). True si lo ha hecho"""
        if not hasattr(self,"_auto_hecho"):self._auto_hecho={}
        self._guardar_conf_pista()
        for k in tareas:
            a=self._auto_hecho.get((k,ef));c=self.pconf.get(k) or {}
            if not a or any(not self._igual_v(c.get(x),v) for x,v in a.items()):return False
        lim=self._cfg_limpia();ks_=self._AUTO_PROPIAS.get(ef,())
        if all(all(self._igual_v(v,lim[x]) for x,v in self._auto_hecho[(k,ef)].items() if x in lim) for k in tareas):
            # (JMG, 8-11) lo había dejado todo como sin efecto (a 0): otra vez = apagarlo, sin volver a medir (antes seguía en verde)
            for k in tareas:self._auto_hecho.pop((k,ef),None)
            try:self._auto_pintar()
            except Exception:pass
            self._toast(T("info_tit"),self._vt("«Auto» otra vez: se apaga (ya estaba todo a 0).","«Auto» again: it goes off (everything was already at 0)."),tipo="info",seg=4)
            return True
        for k in tareas:
            c=self.pconf.setdefault(k,self._snap_pista())
            for x in ks_:
                if x in lim:c[x]=lim[x]
            self._auto_hecho.pop((k,ef),None)
            if self.pactual==k:
                for x in ks_:
                    if x in lim:
                        try:getattr(self,"var_"+x).set(lim[x])
                        except Exception:pass
        self._ex()
        self._toast(T("info_tit"),self._vt("«Auto» otra vez: se quita lo que puso y vuelve a 0.","«Auto» again: what it set is removed and it goes back to 0."),tipo="info",seg=4)
        return True
    def _auto_canales(self,modo):
        """«Ajustar canales» (modo vol) y «Ajustar tono» (modo tono) en las pistas seleccionadas"""
        V=self._vt
        if self.procesando or getattr(self,"_escaneando",False) or getattr(self,"_midiendo_ln",False) or getattr(self,"_combinando",False):return
        tareas=[self._multi_tracks[i] for i in self.lp.curselection() if i<len(self._multi_tracks)]
        if not tareas:
            self._toast(T("warn_tit"),V("Selecciona al menos una pista primero","Select at least one track first"),tipo="warning");return
        if self._auto_toggle(modo,tareas):return
        self._guardar_conf_pista()
        self._cancelar.clear();self._escaneando=True
        btn=self._auto_bts.get(modo)
        self._mst()
        if btn is not None:btn.configure(text="...")
        self.btn_scan.configure(state="disabled");self.btn_cancel_scan.configure(state="normal");self.btn_c.configure(state="normal")
        self._set_prog(0);self._st(V("Midiendo los canales: 0%","Measuring the channels: 0%"))
        N=len(tareas)
        def tarea():
            res=[];inf=[]
            try:
                for k,(ruta,idx) in enumerate(tareas):
                    if self._cancelar.is_set():break
                    nom=f"{os.path.basename(ruta)} #{idx}";orden,chs=self._auto_pista(ruta,idx)
                    def pct(x,k=k):
                        v=100.0*(k+x)/N;self._set_prog(v);self._st(V(f"Midiendo los canales: {v:.0f}%",f"Measuring the channels: {v:.0f}%"))
                    # la muestra con los demas ajustes de la pista aplicados (si no se puede, el original)
                    mp=self._muestra_proc(ruta,idx,orden,self.pconf.get((ruta,idx)) or {},modo,lambda x,pct=pct:pct(0.5*x))
                    if self._cancelar.is_set():break
                    r_,o_=(mp,0) if mp else (ruta,orden)
                    if mp and getattr(self,"_muestra_chs",{}).get(mp):chs=self._muestra_chs[mp]   # con Upmix, los canales del 5.1
                    pct2=(lambda x,pct=pct:pct(0.5+0.5*x)) if mp else pct
                    if modo=="vol":
                        if "FC" not in chs:
                            inf.append("⚠ "+nom+": "+V("no tiene canal central, que es la referencia del equilibrio.","it has no center channel, which is the reference of the balance."));continue
                        med=self._vol_canales(r_,o_,[(c,chs[c]) for c in ("FC","FL","FR","LFE","BL","BR") if c in chs],pct2)
                        if self._cancelar.is_set():break
                        aj=self._vol_ajustes(med) if med else None
                        if not aj:
                            inf.append("⚠ "+nom+": "+V("no se ha podido medir (el central está mudo o mira Edit/Log).","could not be measured (the center is silent, or see Edit/Log)."));continue
                        self._ls("[CANALES] "+nom+": "+" ".join(f"{c} {v:.1f}" for c,v in med.items())+" LUFS")
                        res.append((ruta,idx,aj));inf.append(nom+":\n  "+" · ".join(f"{c.upper()} {v:+.1f}" for c,v in aj.items())+" dB")
                    else:
                        lista=[(g,c) for g,cc in (("front",("FL","FR")),("tras",("BL","BR")),("cent",("FC",))) for c in cc if c in chs]
                        if len({g for g,c in lista})<2:
                            inf.append("⚠ "+nom+": "+V("hacen falta frontales y central o traseros para equilibrar el tono.","fronts plus center or surrounds are needed to balance the tone."));continue
                        med={}
                        for j,(g,c) in enumerate(lista):
                            if self._cancelar.is_set():break
                            med.setdefault(g,[]).append(self._esp_con(c,self._tono_medir(r_,o_,chs[c],prog=lambda x,j=j,pct2=pct2:pct2((j+x)/len(lista))),
                                                                      {} if mp else (self.pconf.get((ruta,idx)) or {}),"tono"))   # sin muestra procesada, con el EQ y el Suavizado calculados
                        if self._cancelar.is_set():break
                        gr=self._tono_grupos(med)
                        if not gr:
                            inf.append("⚠ "+nom+": "+V("no se ha podido medir el tono (mira Edit/Log).","could not measure the tone (see Edit/Log)."));continue
                        aj={}
                        for g,dbs in gr.items():
                            for i,db in enumerate(dbs):
                                aj[f"eq{g}_b{i+1}_f"]=[100,1000,5000][i];aj[f"eq{g}_b{i+1}_g"]=self._eff_inv(db,10,14)
                        res.append((ruta,idx,aj));inf.append(nom+":")
                        for g,dbs in gr.items():
                            nm={"front":T("eq_g_front"),"tras":T("eq_g_tras"),"cent":T("eq_g_cent")}[g]
                            self._ls(f"[TONO] {nom} {nm}: "+" ".join(f"{v:+.1f}" for v in dbs)+" dB")
                            inf.append(f"  {nm}: "+V("graves ","bass ")+"%+.1f · "%dbs[0]+V("medios ","mids ")+"%+.1f · "%dbs[1]+V("agudos ","treble ")+"%+.1f dB"%dbs[2])
            except Exception as e:
                self._ls(f"[CANALES] [ERR] {e}");inf.append(V("No se ha podido medir (mira Edit/Log).","Could not measure (see Edit/Log)."))
            self._ui(self._auto_fin,modo,res,inf)
        threading.Thread(target=tarea,daemon=True).start()
    def _auto_fin(self,modo,res,inf,ef=None):
        V=self._vt;self._escaneando=False;ef=ef or modo
        if not hasattr(self,"_auto_hecho"):self._auto_hecho={}
        for b_ in self._auto_bts.values():b_.configure(text=self._AUTO_TXT)
        self.btn_cancel_scan.configure(state="disabled");self.btn_c.configure(state="disabled")
        self._mst()
        if self._cancelar.is_set():
            self._set_prog(0);self._st("");self._toast(T("cancelado_tit"),V("Medida cancelada.","Measurement cancelled."),tipo="info",seg=3);return
        for ruta,idx,aj in res:
            c0=self.pconf.get((ruta,idx)) or {}
            # los dos ecualizadores no van juntos, ni el Master con el volumen por canal
            if modo=="tono" and any(v for k,v in aj.items() if k.endswith("_g")):   # el EQ avanzado no va con el de 3 bandas, el Suavizado ni la Limpieza
                for ks,nm in ((("eq_bass","eq_mids","eq_treble"),T("eq3")),(("suav",),V("Suavizado digital","Digital smoothing")),(("limp","declick","declip"),T("limp_tit"))):
                    if any(c0.get(k) for k in ks):
                        aj={**aj,**{k:(False if k in ("declick","declip") else 0) for k in ks}}
                        m_=V(f"Se apaga {nm}: no va junto con el EQ avanzado.",f"{nm} switched off: it does not go together with the advanced EQ.")
                        if m_ not in inf:inf.append(m_)
            if modo=="vol" and c0.get("master") and any(aj.get(k) for k in ("fl","fr","fc","lfe","bl","br")):
                aj={**aj,"master":0};m_=V("El Master se pone a 0: no va junto con el volumen por canal.","Master set to 0: it does not go together with the volume per channel.")
                if m_ not in inf:inf.append(m_)
            if (ruta,idx) not in self.pconf:self.pconf[(ruta,idx)]=self._snap_pista()
            self.pconf[(ruta,idx)].update(aj)
            if self.pactual==(ruta,idx):
                for k,v in aj.items():getattr(self,"var_"+k).set(v)
            self._auto_hecho[((ruta,idx),ef)]={x:v for x,v in aj.items() if x in self._AUTO_PROPIAS.get(ef,())}   # para saber si se vuelve a pulsar sin tocar nada
        self._ex()
        if self.pactual:   # lo que ha quedado de verdad en pantalla (los deslizadores redondean)
            self._guardar_conf_pista()
            for (k,e_),a in list(self._auto_hecho.items()):
                if k==self.pactual and e_==ef:self._auto_hecho[(k,e_)]={x:(self.pconf.get(k) or {}).get(x,v) for x,v in a.items()}
        self._set_prog(100 if res else 0);self._prog_vaciar();self._st("")
        pie=V("Queda en los deslizadores de cada canal: puedes retocarlo a mano.","It stays on each channel's sliders: you can adjust it by hand.") if modo=="vol" else \
            (V("Queda en el EQ Avanzado por grupo: puedes retocarlo a mano.","It stays in the Advanced EQ per group: you can adjust it by hand.") if modo=="tono" else
             V("Queda en sus controles: puedes retocarlo a mano.","It stays on its controls: you can adjust it by hand."))
        self._toast(T("info_tit") if res else T("warn_tit"),"\n".join(inf+([pie] if res else [])),tipo="info" if res else "warning",seg=10)
    def _auto_efecto(self,ef):
        """boton «Auto» de un efecto en las pistas seleccionadas: mide y ajusta; pulsado otra vez sin tocar nada, lo quita"""
        V=self._vt
        if self.procesando or getattr(self,"_escaneando",False) or getattr(self,"_midiendo_ln",False) or getattr(self,"_combinando",False):return
        tareas=[self._multi_tracks[i] for i in self.lp.curselection() if i<len(self._multi_tracks)]
        if not tareas:
            self._toast(T("warn_tit"),V("Selecciona al menos una pista primero","Select at least one track first"),tipo="warning");return
        if self._auto_toggle(ef,tareas):return
        self._guardar_conf_pista()
        cfgs={k:dict(self.pconf.get(k) or {}) for k in tareas}
        self._cancelar.clear();self._escaneando=True
        self._mst();self._auto_bts[ef].configure(text="...")
        self.btn_scan.configure(state="disabled");self.btn_cancel_scan.configure(state="normal");self.btn_c.configure(state="normal")
        self._set_prog(0);self._st(V("Midiendo: 0%","Measuring: 0%"))
        N=len(tareas)
        def tarea():
            res=[];inf=[]
            try:
                for k,(ruta,idx) in enumerate(tareas):
                    if self._cancelar.is_set():break
                    nom=f"{os.path.basename(ruta)} #{idx}";orden,chs=self._auto_pista(ruta,idx)
                    def pct(x,k=k):
                        v=100.0*(k+x)/N;self._set_prog(v);self._st(V(f"Midiendo: {v:.0f}%",f"Measuring: {v:.0f}%"))
                    # la muestra con los demas ajustes de la pista aplicados (si no se puede, el original)
                    mp=self._muestra_proc(ruta,idx,orden,cfgs[(ruta,idx)],ef,lambda x,pct=pct:pct(0.5*x))
                    if self._cancelar.is_set():break
                    m=self._peli_medir(mp,0,(getattr(self,"_muestra_chs",{}).get(mp) or chs),ef,lambda x,pct=pct:pct(0.5+0.5*x)) if mp else self._peli_medir(ruta,orden,chs,ef,pct)
                    if m and mp:m["proc"]=True
                    if self._cancelar.is_set():break
                    aj,txt=self._auto_calc(ef,m,cfgs[(ruta,idx)]) if m else (None,V("no se ha podido medir (mira Edit/Log).","could not be measured (see Edit/Log)."))
                    if aj is None:
                        inf.append("⚠ "+nom+": "+txt);continue
                    self._ls(f"[AUTO] {ef} {nom}: {txt}")
