            import ctypes,ctypes.wintypes as W_
            class _PE(ctypes.Structure):
                _fields_=[("dwSize",W_.DWORD),("cntUsage",W_.DWORD),("th32ProcessID",W_.DWORD),("th32DefaultHeapID",ctypes.c_size_t),("th32ModuleID",W_.DWORD),
