# ---------- framerate de las pistas (la de Jmg AudioProcesador): 25 -> 23,976 y al reves ----------
FPS_OPS=[("23.976","23,976"),("24","24"),("25","25"),("29.97","29,97"),("30","30"),("50","50"),("59.94","59,94"),("60","60")]
def _fps_fr(v):
