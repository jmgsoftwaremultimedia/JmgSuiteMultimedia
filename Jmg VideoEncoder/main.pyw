    s=os.path.basename(str(nombre).rstrip("\\/"))
    s=re.sub(r"\.(mkv|mp4|m4v|avi|mov|m2ts|mts|ts|webm|wmv|mpg|mpeg|vob|iso|mka|ac3|dts|flac|wav)$","",s,flags=re.I)
