ICO_B64V={16:{"🎬":"","🎵":""},20:{"🎬":"","🎵":""},24:{"🎬":"","🎵":""},32:{"🎬":"","🎵":""}}
_TTK_BOTON=getattr(ttk.Button,"_ico_base",ttk.Button)   # (árbitro) el ttk.Button de verdad, aunque otro programa del mismo proceso ya lo haya cambiado
_ICO_IMG={}
def _ico_tam(w):
    try:esc=float(w.tk.call("tk","scaling"))/(96.0/72.0)
    except Exception:esc=1.0
    return min(ICO_B64,key=lambda s:abs(s-16*esc))
def _ico_alto(w):
    """el alto de una línea de texto del botón: el icono no pasa de ahí (así un botón con icono no es más alto que uno sin él)"""
    try:
        import tkinter.font as tkf
        f=ttk.Style(w).lookup(_TTK_BOTON.cget(w,"style") or "TButton","font") or "TkDefaultFont"
        return int(tkf.Font(root=w,font=f).metrics("linespace"))
    except Exception:return 0
def _ico_img(ch,w,verde=False):
    """(icono, icono desactivado) de un símbolo, o None. verde: el del botón que lleva al otro programa, en el verde del logo"""
    try:
        if ch not in ICO_B64[16]:return None
        b=_ico_tam(w);h=_ico_alto(w);v=bool(verde and ch in ICO_B64V[b]);k=(ch,b,h,v,id(w.tk))
        if k not in _ICO_IMG:
            par=[]
            for D in ((ICO_B64V if v else ICO_B64),ICO_B64D):
                im=tk.PhotoImage(master=w,data=D[b][ch])
                if 0<h<b:   # se quita el margen vacío de arriba y abajo (y de los lados, lo mismo): queda cuadrado y centrado
                    c=(b-h)//2;im2=tk.PhotoImage(master=w,width=h,height=h);im2.tk.call(im2,"copy",im,"-from",c,c,c+h,c+h,"-to",0,0);im=im2
                par.append(im)
            _ICO_IMG[k]=tuple(par)
        return _ICO_IMG[k]
    except Exception:return None
_ICO_VERDE=("🎬 VideoEncoder","🎵 AudioProcesador")   # (JMG, 29-11) el botón que lleva al otro programa: el icono en el verde del logo
# (JMG, 29-11: «mejor que no se encienda el botón de verde, dejémoslo»: al pasar y apretar, como los demás botones)
def _ico_partir(t):
    """«📂 Seleccionar...» -> ("📂", "Seleccionar..."); sin símbolo -> (None, texto)"""
    t=str(t)
    if t and t[0] in ICO_B64[16]:
        r=t[1:]
        if r[:1]=="️":r=r[1:]
        if r=="":return t[0],""
        if r[:1]==" ":return t[0],r[1:]
    return None,t
def _ico_ancho(w,b,w0):
    """el ancho (en caracteres) para un botón con icono: el de siempre menos lo que ocupa el icono, para que no crezca"""
    try:
        if w0 in ("",None):w0=_TTK_BOTON.cget(w,"style") or "TButton";w0=ttk.Style(w).lookup(w0,"width") or ttk.Style(w).lookup("TButton","width")
        n=int(str(w0))
        if n==0:return ""
        import tkinter.font as tkf
        f=ttk.Style(w).lookup(_TTK_BOTON.cget(w,"style") or "TButton","font") or "TkDefaultFont"
        k=-(-(b+4)//max(1,tkf.Font(root=w,font=f).measure("0")))
        return -max(1,abs(n)-k) if n<0 else max(1,n-k)
    except Exception:return ""
class _BotonIco(_TTK_BOTON):
    _ico_base=_TTK_BOTON
    def __init__(self,master=None,cnf=None,**kw):
        if cnf:kw=dict(cnf,**kw)
        self._ico_t=None;self._ico_propio=bool(kw.get("image"));self._ico_puesto=False;self._ico_w0=kw.get("width","")
        t=kw.pop("text",None) if not kw.get("textvariable") else None
        _TTK_BOTON.__init__(self,master,**kw)
        if t is not None:self._ico_poner(t)
    def _ico_poner(self,t):
        self._ico_t=str(t);ch,r=_ico_partir(t);vd=self._ico_t in _ICO_VERDE
        par=_ico_img(ch,self,vd) if (ch and not self._ico_propio) else None
        if par:
            _TTK_BOTON.configure(self,text=r,image=(par[0],"disabled",par[1]),compound=("left" if r else "image"),
                                 width=(_ico_ancho(self,par[0].width(),self._ico_w0) if r else self._ico_w0));self._ico_puesto=True
        else:
            if self._ico_puesto:_TTK_BOTON.configure(self,image="",compound="none",width=self._ico_w0);self._ico_puesto=False
            _TTK_BOTON.configure(self,text=self._ico_t)
    def configure(self,cnf=None,**kw):
        if isinstance(cnf,str):
            r=_TTK_BOTON.configure(self,cnf)
            if cnf=="text" and self._ico_t is not None and isinstance(r,tuple):r=r[:4]+(self._ico_t,)
            return r
        if cnf:kw=dict(cnf,**kw)
        if not kw:return _TTK_BOTON.configure(self)
        if "image" in kw:self._ico_propio=bool(kw["image"]);self._ico_puesto=False
        if "width" in kw:self._ico_w0=kw["width"]
        t=kw.pop("text",None)
        if kw:_TTK_BOTON.configure(self,**kw)
        if t is None and "width" in kw and self._ico_puesto:t=self._ico_t   # el ancho se vuelve a ajustar al icono
        if t is not None:self._ico_poner(t)
    config=configure
    def cget(self,key):
        if key=="text" and self._ico_t is not None:return self._ico_t
        return _TTK_BOTON.cget(self,key)
    def __getitem__(self,key):return self.cget(key)
    def __setitem__(self,key,v):self.configure({key:v})
ttk.Button=_BotonIco
