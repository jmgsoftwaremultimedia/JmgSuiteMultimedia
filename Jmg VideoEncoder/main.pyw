    def _drop(self,e):
        try:fs=list(self.root.tk.splitlist(e.data))
        except Exception:fs=[]
        try:self.la.configure(bg=CDN)
        except Exception:pass
        if self.procesando:return   # (JMG, 14-11) codificando: no se añade nada
        self._addl(fs)
