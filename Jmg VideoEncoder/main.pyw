        self._log("[i] "+self._vt("H.266 / VVC es muy lento: una pasada y velocidad «Rápida» (puedes cambiarlo).","H.266 / VVC is very slow: one pass and «Fast» speed (you can change it)."))
    def _estado_general(self):
