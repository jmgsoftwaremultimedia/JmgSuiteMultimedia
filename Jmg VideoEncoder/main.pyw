    def _vvc_def(self,*_):
        """(JMG, 23-11) «en el VVC, la opción por defecto: una pasada y rápida» (es muy lento): al pasar a VVC desde otro códec.
        Al cargar un vídeo o deshacer (_cargando) solo se apunta el códec, y se respeta lo que tenía"""
