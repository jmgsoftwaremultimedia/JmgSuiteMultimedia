    pa=[c for c in cs if c.group(0)[:1] in "(["];cs=pa or [c for c in cs if c.start()>0]   # entre paréntesis; si no, el último que no abre el nombre
    m=cs[-1] if cs else None;anio=m.group(1) if m else ""
